                    The ID of the user who updated the entry. This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TrafficEntryType">
                <xsd:annotation>
                    <xsd:documentation>
				The information about the Transit Time Override Breakdown between two address points.
				Used also by processRetrieveDistanceTransitTime operation for output.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="DayOfWeekTrafficEnumVal" type="cis:DayOfWeekTrafficEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Start day for calendar week.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TimeOfDay" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Considering 15 minutes interval in format(HH:MM) in a day like 00:15,00:30 and so on.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransitTime" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Transit time between location within specific interval.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TrafficTransitOverrideBreakdownType">
                <xsd:annotation>
                    <xsd:documentation>
				The information about the Transit Time between two address points within interval.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="TrafficDefaultTransitTime" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The value is used to pre-populate the traffic breakdown string for *all* time segments so that users are not required to provide TrafficEntry data for all 672 time segments. Then each input TrafficEntry segment will set the transit time for that segment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrafficEntry" type="cis:TrafficEntryType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The List of Traffic breakdowns provided by users. If not provided then consider transit time as default from trafficDefaultTransitTime  and override on breakdowns.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="UserType">
                <xsd:annotation>
                    <xsd:documentation>
            A person who is using this system. Mandatory field.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
