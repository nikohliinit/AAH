            <xsd:complexType name="getUserProfileType">
                <xsd:annotation>
                    <xsd:documentation>
		Profile of a user.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
