                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockLoadingType" type="cis:DockLoadingTypeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
