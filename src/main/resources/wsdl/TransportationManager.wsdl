                    </xsd:annotation>
                    <xsd:sequence>
                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                Operation header.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ReleaseSameJobFlag" type="xsd:boolean" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                                  This flag controls whether to release other requests with the same job name if the job name
                                  of the current request is not empty.
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="RequestID" type="cis:KeyStringType" maxOccurs="unbounded">
                            <xsd:annotation>
                                <xsd:documentation>
                                 A collection of schedule run request IDs.
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
