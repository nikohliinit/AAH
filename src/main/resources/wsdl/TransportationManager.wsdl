                            <xsd:documentation>
                    The lane ID used in the shipment rating (if any). Read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PreconsolidatedAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The total charge before pre-consolidation for the shipment. Expressed in the tariff rating currency. Read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateCode" type="cis:RateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The rate code used in the shipment rating (if any). Read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemCalculatedAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The gross rated amount for the shipment. Expressed in the tariff rating currency. Read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system generated numerical tariff ID used in the shipment rating (if any). Read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateCodeTariffID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system generated numerical tariff ID for Rate Code of this shipment. Read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityPickSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
