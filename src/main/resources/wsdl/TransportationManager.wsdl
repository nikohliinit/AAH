                            <xsd:documentation>
                                  The load filtering criteria which is used to filter loads that otherwise meet basic re-planning eligibility requirements. It will be used only when the buildTripsFlag is true.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OnlyLoadsCompatibleWithSelectedShipmentsFlag" type="xsd:boolean" minOccurs="0">
