                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="numberOfEntitiesType">
                <xsd:annotation>
                    <xsd:documentation>
		Defines search criteria.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Operation header.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EntityType" type="cis:TMEntityEnumValType">
                        <xsd:annotation>
                            <xsd:documentation>
			Type of entities to select.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Filter" type="cis:FilterType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
			Filtering condition for entities to select.
			Designed to express simple constraints. When you need to express complex constraints then use Condition.
			Uses implicit AND for all child members.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Condition" type="cis:NaryExprType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Filtering condition for entities to select.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="getEnumValuesType">
                <xsd:annotation>
                    <xsd:documentation>
		Defines set of enumerated types to retrieve.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Operation header.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Kind" type="cis:EnumKindType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                Kind of enumeration requested. All CIS API enumerated types may be used
                (their name ends with "EnumValType"),
                all TM domain value types (their name ends with "DomainValueType" and "StatusValType") and
                also some specific types, that may be not even mapped to domain tables,
                but are convenient to be considered as enumerated types:
                CarrierCodeType, ChargeCodeType, CommodityCodeType, ComponentTypeGroupType, CountryCodeType, CustomerCodeType, DivisionCodeType, EquipmentCodeType, EquipmentTypeCodeType, EventCodeType, ExternalEngineVersionCodeType (only for Rating Engine), FreightClassCodeType, JourneyTemplateCodeType, LogisticGroupCodeType, ManifestLoadGroupCodeType, OrderType, OrderVersionCodeType, ServiceCodeType, TariffCodeType, UserGroupCodeType, ZoneGroupCodeType, RangeCodeType, RestrictionTemplateCodeType.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveOnly" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Restricts enum values to active entries. Default is false.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="convertUOMType">
                <xsd:annotation>
                    <xsd:documentation>
		Defines set of values to convert from source to target UOM.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Operation header.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Uom" type="cis:UOMValueType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
			Values to convert from source to target UOM.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRateGroupCode" type="cis:ExchangeRateGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The exchange rate group ID. Optional.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRateDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date for exchange rate. Optional. By default, current date is used.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="getCountriesAndStatesType">
                <xsd:annotation>
                    <xsd:documentation>
		Defines set of countries for whch to retrieve the information.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Operation header.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
			Set of countries for which states must be returned.
			If this parameter is omitted then all countries are returned.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="getEventCodesType">
                <xsd:annotation>
                    <xsd:documentation>
		Defines set of event codes to receive.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Operation header.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Status" type="xsd:string" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
			Status for which events are requested.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="getUIScreenOperationsSecurityType">
                <xsd:annotation>
                    <xsd:documentation>
		Defines set of screen elements for which you want to receive information about operations (buttons) security.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Operation header.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ScreenElement" type="cis:ScreenElementType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
			Screen element for which to request information.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="SelectClauseType">
                <xsd:annotation>
                    <xsd:documentation>
		Defines set of members of an entity that will be returned in the response.
		If members are not listed explicitly, then all non-collection persistent members will be returned.
		It's more efficient to define explicit list of members to retrieve.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Name" type="cis:ElementNameType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
			Defines name of entity component to return in the result.\n
			Name may be a compound name, like Address.Block.
			If name denotes sub-entity then all members of this subentity will be returned.
			If component is a collection, then use "collection" construct.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Collection" type="cis:RetrieveChildCollectionType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
			Define component that is a collection.\n
			Name may be a compound name.
			In addition to a name of component this construct allows to define 
			additional constraints, ordering, etc.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="FilterType">
                <xsd:sequence>
                    <xsd:element name="Name" type="cis:ElementNameType">
                        <xsd:annotation>
                            <xsd:documentation>
			Name of the member that is tested.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Op" type="cis:FilterOpEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			What operation to use for filter. Default value is Eq.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Value" type="xsd:string" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
			Value.\n
			Date, time and datetime values must follow XSD agreements about format.\n
			Date and dateTime values support Relative keyword search in format of RELATIVE_DATE_TYPE:DAYS:HOURS\n
				Supported Keywords:\n
					NOW,TODAY,N_MIDNIGHT,C_MONDAY,C_MONTH\n
			One space is interpreted as empty value.\n
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="NaryExprType">
                <xsd:sequence>
                    <xsd:element name="O" type="cis:ExprType" minOccurs="0" maxOccurs="unbounded"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="BinaryExprType">
                <xsd:sequence>
                    <xsd:element name="O" type="cis:ExprType" maxOccurs="2"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="UnaryExprType">
                <xsd:sequence>
                    <xsd:element name="O" type="cis:ExprType"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ExprType">
                <xsd:annotation>
                    <xsd:documentation>
		One and only one member must be used. This version of API has 
		limited support for complex expressions. Limitations are described in each operation.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="And" type="cis:NaryExprType" minOccurs="0"/>
                    <xsd:element name="Or" type="cis:NaryExprType" minOccurs="0"/>
                    <xsd:element name="Eq" type="cis:BinaryExprType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			First operand is expected to be a member while second a value.\n
			When value includes % then EQ will be translated into SQL's LIKE operation.\n
			When value is empty then EQ will be translated into SQL's IS NULL operation.\n
			When value is of type Date then EQ will be done with the precision of dates.\n
			When value is of type Datetime then EQ will be done with the precision of minutes.\n
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EqOrNull" type="cis:BinaryExprType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Works the same way as operation EQ plus includes all NULL values.\n
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Ne" type="cis:BinaryExprType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			First operand is expected to be a member while second a value.\n
			When value includes % then NE will be translated into SQL's NOT LIKE operation.\n
			When value is empty then NE will be translated into SQL's IS NOT NULL operation.\n
			When value is of type Date then EQ will be done with the precision of dates.\n
			When value is of type Datetime then EQ will be done with the precision of minutes.\n
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NeOrNull" type="cis:BinaryExprType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Works the same way as operation NE plus includes all NULL values.\n
			Normally operation NE would not include NULL values into the result. 
			If you want NULL values to be also included then you need to use this operator.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Le" type="cis:BinaryExprType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			First operand is expected to be a member while second a value.\n
			When value is of type Date then comparison will be done with the presion 
			of date and time portion of database value will be discregarded.\n
			When value is of type Datetime then comparison will be done with the presion 
			of date and time portion of database value will be discregarded.\n
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Ge" type="cis:BinaryExprType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			First operand is expected to be a member while second a value.\n
			When value is of type Date then comparison will be done with the presion 
			of date and time portion of database value will be discregarded.\n
			When value is of type Datetime then comparison will be done with the presion 
			of date and time portion of database value will be discregarded.\n
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="In" type="cis:NaryExprType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			First operand is expected to be a column while all others are values.\n
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NotIn" type="cis:NaryExprType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			First operand is expected to be a column while all others are values.\n
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IsNull" type="cis:UnaryExprType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Operand is expected to be a member.\n
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IsNotNull" type="cis:UnaryExprType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Operand is expected to be a member.\n
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Exists" type="cis:ExistsOpType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Operand allows to define constraints on child collections.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NotExists" type="cis:ExistsOpType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Operand allows to define constraints on child collections.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Value" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Value.\n
			Date, time and datetime values must follow XSD agreements about format.\n
			One space is interpreted as empty value.\n
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Name" type="cis:ElementNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Represent path to a member.\n
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ExistsOpType">
                <xsd:sequence>
                    <xsd:element name="Name" type="cis:ElementNameType">
                        <xsd:annotation>
                            <xsd:documentation>
			Child member which is a collection.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Condition" type="cis:NaryExprType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Filtering condition for entities to select.
			Uses implicit AND for all child members.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="OrderByType">
                <xsd:sequence>
                    <xsd:element name="Asc" type="xsd:boolean" minOccurs="0"/>
                    <xsd:element name="Name" type="cis:ElementNameType"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="OrderByClauseType">
                <xsd:sequence>
                    <xsd:element name="Order" type="cis:OrderByType" maxOccurs="unbounded"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="PageClauseType">
                <xsd:sequence>
                    <xsd:element name="StartAtRow" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Response will return data for the page that includes specified row.
			Rows are numbered from 0.\n
			Value must be integer or omitted. Type of the member is defined as a string 
			to support omitted values.
			This value will be adjusted to page starting row.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaxRows" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Page size.\n
			Value must be integer or omitted. Type of the member is defined as a string 
			to support omitted values.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalRowCount" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Total number of rows.\n
			Value must be integer or omitted. Type of the member is defined as a string 
			to support omitted values.
			If value is not defined or -1 then server will calculate this value every time 
			with findEntities request. To avoid calculation of total number of pages, 
			when you are not interested in this information and want to avoid associated 
			performance impact, set this value to a value greater then 0.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="RetrieveChildCollectionType">
                <xsd:annotation>
                    <xsd:documentation>
		Defines selection for collection.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Name" type="cis:ElementNameType">
                        <xsd:annotation>
                            <xsd:documentation>
			Name of the collection child of a parent entity.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Select" type="cis:SelectClauseType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			List of fields to select.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Filter" type="cis:FilterType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
			Filtering condition for entities to select.
			Designed to express simple constraints. When you need to express complex constraints then use Condition.
			Uses implicit AND for all child members.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Condition" type="cis:NaryExprType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Filtering condition for entities to select.
			Uses implicit AND for all child members.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OrderBy" type="cis:OrderByClauseType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Ordering condition.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Page" type="cis:PageClauseType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Allows to limit number of returned rows or to specify what page to return.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="StateType">
                <xsd:annotation>
                    <xsd:documentation>
			State information.
			Available only via UI-oriented API.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Country code.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Code" type="cis:StateCodeType">
                        <xsd:annotation>
                            <xsd:documentation>
				State code.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Name" type="cis:NameType">
                        <xsd:annotation>
                            <xsd:documentation>
				State name.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="CountryType">
                <xsd:annotation>
                    <xsd:documentation>
			Country information.
			Available only via UI-oriented API.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Internal ID.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Code" type="cis:CountryCodeType">
                        <xsd:annotation>
                            <xsd:documentation>
				Country code.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Name" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Country name.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryISO2CharacterCode" type="cis:ISO2CharacterCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Country ISO 2 Character code.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemProvidedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the country is maintained by the system.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GeoCodesRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether geo-codes are required for the country.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryISO3DigitCode" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Country ISO 3 Digit code.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryUNCode" type="cis:CountryUNCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Country UN code.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryFIPSCode" type="cis:CountryFIPSCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Country FIPS code.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultLatitude" type="cis:LatitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Default latitude for the country.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultLongitude" type="cis:LongitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Default longitude for the country.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryISO3CharacterCode" type="cis:ISO3CharacterCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Country ISO 3 Character code.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PostalHierarchyFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether postal code hierarchical numbering system is supported for the country.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PostalCodeRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether postal codes are required for the country.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AddressFormatOverriddenFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether address format is overridden for the country.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GeoCodeDistanceEngine" type="cis:ExternalEngineVersionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The distance engine used for geo-codes.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceTimDistanceEngine" type="cis:ExternalEngineVersionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The distance engine used for distance and transit time calculations.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PostalAndCityDataExistFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether postal and city data exist for the country.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OnlyCityDataExistFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether only city data exist for the country.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnforcePostalCodeRangeLengthMatchingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether length matching is enforced for zip/postal code ranges of the country.
                Setting of true is currently applicable only for country GBR.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="State" type="cis:StateType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				States or provinces for the country.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessHours" type="cis:BusinessHoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The business hours of the country. Read only.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The date and time that the country was created. Read only field.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The date and time that the country was updated. Read only field.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID of the user who created this country.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID of the user who updated this country.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="EnumElementType">
                <xsd:annotation>
                    <xsd:documentation>
		One element of enumerated type, which consists of code, value and desciption.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			ID of enumerated value. Used in TM database tables to represent this enumerated value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Code" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Code of enumerated value. Used by TM Web UI to show on a screen. 
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Value" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			TM CIS API value of enumerated value. Is different from Code and 
			Value for all CIS API enumerated types. In all other cases is the same as Code.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Desc" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Description of enumerated value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Type" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Type of the enumerated value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="EnumType">
                <xsd:annotation>
                    <xsd:documentation>
		Enumerated type.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Kind" type="cis:EnumKindType">
                        <xsd:annotation>
                            <xsd:documentation>
			Kind of enumerated type.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Elem" type="cis:EnumElementType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
			Values of enumerated type.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="WeightUOMValueType">
                <xsd:annotation>
                    <xsd:documentation>
		Describes conversion of weight value from one UOM to another.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="UomFrom" type="cis:WeightUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			UOM of source value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UomTo" type="cis:WeightUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			UOM of target value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ValueFrom" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Source value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ValueTo" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Target value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="LengthUOMValueType">
                <xsd:annotation>
                    <xsd:documentation>
		Describes conversion of length value from one UOM to another.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="UomFrom" type="cis:LengthUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			UOM of source value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UomTo" type="cis:LengthUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			UOM of target value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ValueFrom" type="cis:LengthType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Source value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ValueTo" type="cis:LengthType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Target value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="VolumeUOMValueType">
                <xsd:annotation>
                    <xsd:documentation>
