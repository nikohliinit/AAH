                            <xsd:documentation>
            Total distance between the origin and destination for this shipment computed using the Distance Engine used by routing for the selected tariff.     
            Expressed in the system distance unit of measure. Read-only.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumOrderValue" type="cis:DollarType" minOccurs="0">
