                            <xsd:documentation>
									Total laden length of the dropped shipments at the stop. Expressed in base system units of measure.
								</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DroppedFlexibleQuantity1" type="cis:QuantityExType" minOccurs="0">
