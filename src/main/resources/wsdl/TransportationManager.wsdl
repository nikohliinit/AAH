                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ValueTo" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Target value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
