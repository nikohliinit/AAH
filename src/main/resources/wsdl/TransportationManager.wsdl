                        <xsd:annotation>
                            <xsd:documentation>
                                    Indicates whether charge overrides (below) should be ignored. True by default.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeOverrides" type="cis:ChargeOverrideType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                    The charge overrides for the loads of this trip rate request. Optional.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnRoutingMessageLogFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether diagnostic messages should be generated.
                    Not allowed if more than one trip is included in the request.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processTripCreateType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of Create Trip or Booking requests.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripCreateData" type="cis:TripCreateDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    The data about each trip or booking to be created. The collection must have at least one element.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processTripUpdateType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of Update Trip or Booking requests.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripUpdateData" type="cis:TripUpdateDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    The data about each trip or booking to be updated. The collection must have at least one element.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventSourceEnumVal" type="cis:EventSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates the source of the event as originating from an application feed (i.e., UI or API) or a specific partner integration.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAddLoadsToTripType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of Add Loads To Trip/Booking requests.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AddLoadsToTripData" type="cis:AddLoadsToTripDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    The data about each trip/booking and loads to be added to it. The collection must have at least one element.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processTripReSequenceType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of Re-Sequence Trip requests.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripReSequenceData" type="cis:TripReSequenceDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    The data about each trip to be re-sequenced. The collection must have at least one element.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processTripCancelType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of Cancel Trip or Booking requests.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the trip or booking to be canceled.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SECInformation" type="cis:SECInformationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Reason Code information. Note that only SECCode and movementDateTime are used at this time.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processOptimizationRequestDetailsRetrieveType">
                <xsd:annotation>
                    <xsd:documentation>
                Retrieves information about loads and shipment legs for an optimization request.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemOptimizationRequestID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The optimization request ID. Mandatory
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processRateQuotationRetrieveType">
                <xsd:annotation>
                    <xsd:documentation>
                Retrieves existing rate quotation(s).
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemRateQuotationID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of rate quotation IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processRateQuotationUpdateType">
                <xsd:annotation>
                    <xsd:documentation>
                Updates existing rate quotation(s).
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateQuotationUpdateData" type="cis:RateQuotationUpdateDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of update rate quotation data structures.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processRateQuotationDeleteType">
                <xsd:annotation>
                    <xsd:documentation>
                Deletes existing rate quotation(s).
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemRateQuotationID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of rate quotation IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processRateQuotationSetStatusType">
                <xsd:annotation>
                    <xsd:documentation>
                Activates or closes existing rate quotation(s).
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemRateQuotationID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of rate quotation IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateQuotationStatusEnumVal" type="cis:RateQuotationStatusEnumValType">
                        <xsd:annotation>
                            <xsd:documentation>
                    The rate quotation status to set.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAPVoucherRetrieveType">
                <xsd:annotation>
                    <xsd:documentation>
                        A collection of AP Voucher retrieval requests.
                        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemVoucherID" type="cis:VoucherNumberType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                 A collection of voucher IDs.
                                 Field is mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAPVoucherCreateType">
                <xsd:annotation>
                    <xsd:documentation>
                        A collection of AP Voucher creation requests.
                        Even though collection of requests is supported, it is not recommended if it is running while other TM processes (UI) are also running.
                        The reason is to avoid deadlock.
                        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherCategory" type="cis:VoucherCategoryEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                  Voucher category which indicates the category of the vouchers to be created.
                                  Support only Post Charge Voucher and Miscellaneous Voucher only.
                                  Field is mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APPostChargeVoucherCreateData" type="cis:APPostChargeVoucherCreateDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                  A collection of AP Post Charge Voucher creation structures.
                                  Required when voucher category is Post Charge Voucher. Ignored otherwise.
                                  Field is mandatory when voucher category is Post Charge Voucher.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APMiscVoucherCreateData" type="cis:APMiscVoucherCreateDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                  A collection of AP Miscellaneous Voucher creation structures.
                                  Required when voucher category is Miscellaneous Voucher. Ignored otherwise.
                                  Field is mandatory when voucher category is Miscellaneous Voucher.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExemptFromCostAdjustmentApprovalFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    If true, updates required to initiate cost adjustment approval process will not be applied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAPVoucherChargeCreateType">
                <xsd:annotation>
                    <xsd:documentation>
                        A collection of AP Voucher charge creation requests.
                        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Operation header.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemVoucherID" type="cis:VoucherNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                 The ID of the voucher on which the charges will be created.
                                 Field is mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APVoucherCharge" type="cis:VoucherChargeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                  A collection of AP Voucher charges.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExemptFromCostAdjustmentApprovalFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    If true, updates required to initiate cost adjustment approval process will not be applied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAPVoucherChargeDeleteType">
                <xsd:annotation>
                    <xsd:documentation>
                        A collection of AP Voucher charge deletion requests.
                        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Operation header.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemChargeDetailID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                  A collection of AP Voucher charge IDs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAPVoucherChargeUpdateType">
                <xsd:annotation>
                    <xsd:documentation>
                        A collection of AP Voucher charge update requests.
                        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Operation header.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APVoucherCharge" type="cis:VoucherChargeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                  A collection of AP Voucher charges.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAPVoucherChargeCancelType">
                <xsd:annotation>
                    <xsd:documentation>
                Cancels existing voucher charge(s).
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemChargeDetailID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of system-generated charge detail IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAPVoucherChargeReactivateType">
                <xsd:annotation>
                    <xsd:documentation>
                Re-activates existing voucher charge(s).
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APVoucherCharge" type="cis:VoucherChargeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of AP Voucher charges.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAPVoucherChargeApprovalChainResponseType">
                <xsd:annotation>
                    <xsd:documentation>
                Triggers updates of existing voucher charge(s) for approval chain response.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemChargeDetailID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of system-generated charge detail IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherChargeApprovalActionEnumVal" type="cis:VoucherChargeApprovalActionEnumValType">
                        <xsd:annotation>
                            <xsd:documentation>
                    The action required by the approval chain response. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApprovalActionDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the action for approval chain response was triggered.
                    Ignored when VoucherChargeApprovalActionEnumVal is VCHRCHRGAPVLACTION_PENDING.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApprovedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The user ID who approved the charge.
                    Ignored when VoucherChargeApprovalActionEnumVal is VCHRCHRGAPVLACTION_PENDING. Otherwise mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAPVoucherGenerateType">
                <xsd:annotation>
                    <xsd:documentation>
                        A collection of AP Voucher generate requests.
                        Even though collection of requests is supported, it is not recommended if it is running while other TM processes (e.g. UI) are also running.
                        The reason is to avoid deadlock.
                        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Operation header.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                 A collection of load IDs. Load ID can be either built load or manifest load.
                                 Either load IDs or trip ID must be provided.
                                 Load on trip should not be put here.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                 A collection of trip IDs.
                                 Either load IDs or trip ID must be provided.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAPVoucherUpdateType">
                <xsd:annotation>
                    <xsd:documentation>
                        A collection of AP Voucher creation requests.
                        Even though collection of requests is supported, it is not recommended if it is running while other TM processes (UI) are also running.
                        The reason is to avoid deadlock.
                        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherCategory" type="cis:VoucherCategoryEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                  Voucher category which indicates the category of the vouchers to be updated.
                                  Support all AP voucher categories.
                                  Field is mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APInitialVoucherUpdateData" type="cis:APInitialVoucherUpdateDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                  A collection of AP Initial Voucher Update structures.
                                  Required when voucher category is Initial Voucher. Ignored otherwise.
                                  Field is mandatory when voucher category is Initial Voucher.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APPostChargeVoucherUpdateData" type="cis:APPostChargeVoucherUpdateDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                  A collection of AP Post Charge Voucher Update structures.
                                  Required when voucher category is Post Charge Voucher. Ignored otherwise.
                                  Field is mandatory when voucher category is Post Charge Voucher.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APMiscVoucherUpdateData" type="cis:APMiscVoucherUpdateDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                  A collection of AP Miscellaneous Voucher Update structures.
                                  Required when voucher category is Miscellaneous Voucher. Ignored otherwise.
                                  Field is mandatory when voucher category is Miscellaneous Voucher.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExemptFromCostAdjustmentApprovalFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    If true, updates required to initiate cost adjustment approval process will not be applied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAPVoucherCancelType">
                <xsd:annotation>
                    <xsd:documentation>
                        A collection of AP Voucher cancellation requests.
                        Even though collection of requests is supported, it is not recommended if it is running while other TM processes (e.g. UI) are also running.
                        The reason is to avoid deadlock.
                        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemVoucherID" type="cis:VoucherNumberType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                 A collection of voucher IDs.
                                 Field is mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAPVoucherReverseType">
                <xsd:annotation>
                    <xsd:documentation>
                        A collection of AP Voucher reversal requests.
                        Even though collection of requests is supported, it is not recommended if it is running while other TM processes (e.g. UI) are also running.
                        The reason is to avoid deadlock.
                        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Operation header.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                 A collection of load IDs. Load ID can be either built load or manifest load.
                                 Either load IDs or trip ID must be provided.
                                 Load on trip should not be put here.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                 A collection of trip IDs.
                                 Either load IDs or trip ID must be provided.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAPVoucherDeleteType">
                <xsd:annotation>
