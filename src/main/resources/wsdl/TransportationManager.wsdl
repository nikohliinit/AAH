            <xsd:element name="getEnumValues">
                <xsd:complexType>
                    <xsd:annotation>
                        <xsd:documentation>
		Defines set of enumerated types to retrieve.
		</xsd:documentation>
                    </xsd:annotation>
                    <xsd:sequence>
                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
			Operation header.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="Kind" type="cis:EnumKindType" maxOccurs="unbounded">
                            <xsd:annotation>
                                <xsd:documentation>
                Kind of enumeration requested. All CIS API enumerated types may be used
                (their name ends with "EnumValType"),
                all TM domain value types (their name ends with "DomainValueType" and "StatusValType") and
                also some specific types, that may be not even mapped to domain tables,
                but are convenient to be considered as enumerated types:
                CarrierCodeType, ChargeCodeType, CommodityCodeType, ComponentTypeGroupType, CountryCodeType, CustomerCodeType, DivisionCodeType, EquipmentCodeType, EquipmentTypeCodeType, EventCodeType, ExternalEngineVersionCodeType (only for Rating Engine), FreightClassCodeType, JourneyTemplateCodeType, LogisticGroupCodeType, ManifestLoadGroupCodeType, OrderType, OrderVersionCodeType, ServiceCodeType, TariffCodeType, UserGroupCodeType, ZoneGroupCodeType, RangeCodeType, RestrictionTemplateCodeType.
            </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ActiveOnly" type="xsd:boolean" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
			Restricts enum values to active entries. Default is false.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="getEnumValuesResponse">
                <xsd:complexType>
                    <xsd:annotation>
                        <xsd:documentation>
		List of requested enumerated types.
		</xsd:documentation>
                    </xsd:annotation>
                    <xsd:sequence>
                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation> 
                                Indicates if the operation was successful. May contain a list of errors. 
                        </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ResponseHeader" type="cis:ResponseHeaderType">
                            <xsd:annotation>
                                <xsd:documentation>
			Indicates if the operation was successful. May contain a list of errors.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="Enums" type="cis:EnumType" minOccurs="0" maxOccurs="unbounded">
                            <xsd:annotation>
                                <xsd:documentation>
			Requested enumerated types.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="getCountriesAndStates">
                <xsd:complexType>
