                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the shipment is a stand-alone shipment..
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The load ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The sequence number of the shipment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipFromLocationTypeEnumVal" type="cis:ShipFromPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the shipment's origin point.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipFromLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the shipment's origin point.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliverySequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The delivery sequence number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipToLocationTypeEnumVal" type="cis:ShipToPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the shipment's destination point.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipToLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the shipment's destination point.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrentShipmentLegOperationalStatusEnumVal" type="cis:ShipmentLegOperationalStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The current operational status of the shipment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID code of the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCommittedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the carrier is committed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The service code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCommittedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the service code is committed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The trailer equipment type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCommittedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the trailer equipment type has been committed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorEquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The tractor equipment type code.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorEquipmentTypeCommittedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the tractor equipment type is committed.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransitModeEnumVal" type="cis:TransitModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The transit mode.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransitModeCommittedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the transit mode has been committed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PickStopSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The sequence number on the load itinerary for the stop where the shipment will be picked-up.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryStopSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The sequence number on the load itinerary for the stop where the shipment will be delivered.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ShipmentLegMaintainDataType">
                <xsd:annotation>
                    <xsd:documentation>
				Information required to perform Update, Split or Delete for a standalone shipment leg.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemShipmentID" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated numeric shipment ID or the reference number used to identify the shipment. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentNumber" type="cis:ShipmentNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shipment ID used to identify the shipment. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shipment tracking number used to identify the shipment. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The division code used to identify the shipment. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated shipment leg ID used to identify the shipment leg. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shipment leg sequence number used to identify the shipment leg. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityPickSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The commodity pick sequence number. Used only for Update Shipment Leg. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The carrier ID. Used for Update Shipment Leg and for Split Shipment Leg where it applies to the original shipment leg. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The service ID. Used for Update Shipment Leg and for Split Shipment Leg where it applies to the original shipment leg. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The trailer equipment type ID. Used for Update Shipment Leg and for Split Shipment Leg where it applies to the original shipment leg. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorEquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tractor equipment type ID. Used for Update Shipment Leg and for Split Shipment Leg where it applies to the original shipment leg. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransitModeEnumVal" type="cis:TransitModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The transit mode. Used only for Update Shipment Leg. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode2" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The carrier ID for the new shipment leg. Used only for Split Shipment Leg. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode2" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The service ID for the new shipment leg. Used only for Split Shipment Leg. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode2" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The trailer equipment type ID for the new shipment leg. Used only for Split Shipment Leg. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorEquipmentTypeCode2" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tractor equipment type ID for the new shipment leg. Used only for Split Shipment Leg. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ScheduleActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether scheduling is active for the shipment leg. Used only for Update Shipment Leg. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingThroughPointEnumVal" type="cis:ShipThruPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The intermediate point type for Split Shipment Leg (Hub or DC).
                    If not specified and ShippingThroughPointLocationCode is specified for Split Shipment Leg,
                    one and only one shipping location with the specified code should exist.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingThroughPointLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The intermediate shipping location ID. Mandatory for Split Shipment Leg, ignored otherwise.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ShipmentUpdateProgressDataType">
                <xsd:annotation>
                    <xsd:documentation>
				The data for updating progress of a shipment, setting a shipment to Delivered or for proof of delivery (POD).
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier code. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentID" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipment ID. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentNumber" type="cis:ShipmentNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipment number. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipment tracking number. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The division code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BilllOfLadingNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The carrier bill of lading number generated during shipment leg confirmation. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipment leg ID. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipment leg sequence number. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A shipment memo for this update. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SECInformation" type="cis:SECInformationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The service event code information. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ProofOfDelivery" type="cis:ProofOfDeliveryType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The proof of delivery information. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TPSoftConstraintViolationsType">
                <xsd:annotation>
                    <xsd:documentation>
			The soft constraint violations identified and generated by Transportation Planner during Optimization or Route Rate Scheduling.
        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Internal ID. Applicable only for UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemViolationID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The unique identifier for this soft constraint violation; this ID is system-assigned.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created this soft constraint violation; for violations created by optimization, this will be the user that initiated the optimization request.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who was last updated this soft constraint violation (not currently active).
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time this soft constraint violation was created.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time this soft constraint violation was last updated (not currently active).
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The load ID for this soft constraint violation; this will contain a value when the violation is associated with a load not attached to a trip or booking, or it is applicable to a specific load on a trip or booking.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The trip or booking ID for this soft constraint violation; this will contain a value when the violation is associated with a trip or booking; the soft violation could also be associated with a load.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ViolationInformation" type="cis:TPAdditionalInfoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The soft constraint violation message from Transportation Planner.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ViolationSourceEnumVal" type="cis:ViolationSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The source for the soft constraint violation; potential values are: optimization, routing/rating/scheduling, routing/rating, scheduling.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ViolationSourceEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for tpSoftConstraintViolationSourceEnumVal. Read-only. Available only through UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Load" type="cis:LoadType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Load the entry belongs to.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="StopType">
                <xsd:annotation>
                    <xsd:documentation>
				A load has two or more stops. It starts at one shipping location and ends at another. Each of these locations is a stop for the load. Multi-stop loads have intermediate stops to pick up or drop off additional shipments.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemStopID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the stop. Mandatory. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the load.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopSequenceNumber" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The position of the stop within the sequence of stops of the load.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountOfShipmentsPickedAtStop" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total number of picked shipments for the stop. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountOfShipmentsDroppedAtStop" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total number of dropped shipments for the stop. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The type of shipping point for the stop. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for shippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActualDateTimeOfArrival" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time that the load is scheduled to arrive at the stop, as computed by the scheduling process.
                    This value will be cleared when rating results for the load are cleared. Expressed in the time zone of the location. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActualDateTimeOfDeparture" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time that the load is scheduled to depart from the stop, as computed by the scheduling process.
                    This value will be cleared when rating results for the load are cleared. Expressed in the time zone of the location. Read-only..
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PickConfirmedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the pick stop is confirmed. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PickConfirmedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time of the pick stop confirmation. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PickConfirmedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The user who confirmed the pick stop. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Address" type="cis:AddressType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The address of the stop. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the shipping point of the stop. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PickShipmentLegID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The IDs of the shipment legs for a pick stop. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DropShipmentLegID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The IDs of the shipment legs for a drop stop. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The primary shipping location code. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The primary shipping location type. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for primaryShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeekendHolidayBreakHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The weekend holiday break hours.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StartDateTimeWeekendHolidayBreak" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The start date and time for weekend holiday break. Read-only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EndDateTimeWeekendHolidayBreak" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The end date and time for weekend holiday break. Read-only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeekendHolidayBreakOrientationEnumVal" type="cis:WeekendHolidayBreakOrientationEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
