                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="SystemRoutingRequestID" type="cis:KeyStringType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
					The routing, rating and scheduling request ID for detailed diagnostic messages.
					Populated only if requested.
					The detailed diagnostic messages are temporarily stored in Transportation Manager database and
