                            <xsd:documentation>
                                Scheduled loading hours.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnloadingHours" type="cis:HoursWithNegativeType" minOccurs="0">
