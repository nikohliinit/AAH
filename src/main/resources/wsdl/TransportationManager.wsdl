                    A collection of shipment update progress information.
                    Within the structure, ProofOfDelivery is ignored,
                    all fields of SECInformation except for SECCode and MovementDateTime are also ignored.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentIDType" type="cis:ShipmentIdEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    An enumerated value defining how the shipment should be identified.
                    
                        SI_NULL - No shipments are retrieved.
                        
                        SI_ID - The shipments to be identified by their IDs.
                        
                        SI_NUM - The shipments to be identified by their shipment numbers.
                        
                        SI_RFRC - The shipments to be identified by their reference numbers.
                        
                        SI_RFRC_DIV - The shipments to be identified by their reference numbers and Division ID.
                        If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then a division can be omitted or, if specified, should match the division to which the user is restricted.
                        
                        SI_TRKG_NUM - The shipments to be identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.

                        SI_TRKG_NUM_DIV - The shipments to be identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.
                        If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then the division can be omitted or, if specified, it should match the division to which the user is restricted.

                        SI_LEG_ID - The shipment legs to be identified by their shipment leg IDs.
                        
                        SI_BOL_NUM_CARR - The shipment legs to be identified by their Carrier Codes and Bill Of Lading Numbers.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IDsAreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether shipments should be identified by their reference numbers instead of their ID numbers.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberTypeCode" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The type of reference numbers used to identify the shipments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processShipmentReturnToDeliveredType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to return existing shipment legs to Delivered status.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentUpdateProgressData" type="cis:ShipmentUpdateProgressDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of shipment update progress information.
                    The proofOfDelivery element is not used, only SECCode and movementDateTime in the SECInformation element are used.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentIDType" type="cis:ShipmentIdEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    An enumerated value defining how the shipment should be identified.
                    
                        SI_NULL - No shipments are retrieved.
                        
                        SI_ID - The shipments to be identified by their IDs.
                        
                        SI_NUM - The shipments to be identified by their shipment numbers.
                        
                        SI_RFRC - The shipments to be identified by their reference numbers.
                        
                        SI_RFRC_DIV - The shipments to be identified by their reference numbers and Division ID.
                            If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then a division can be omitted or, if specified, should match the division to which the user is restricted.
                            
                        SI_TRKG_NUM - The shipments to be identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.
                        
                        SI_TRKG_NUM_DIV - The shipments to be identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.
                            If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then the division can be omitted or, if specified, it should match the division to which the user is restricted.
                            
                        SI_LEG_ID - The shipment legs to be identified by their shipment leg IDs.
                        
                        SI_BOL_NUM_CARR - The shipment legs to be identified by their Carrier Codes and Bill Of Lading Numbers.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IDsAreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether shipments should be identified by their reference numbers instead of their ID numbers.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberTypeCode" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The type of reference numbers used to identify the shipments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processShipmentReturnToInTransitType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to return existing shipment legs to In Transit status.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentUpdateProgressData" type="cis:ShipmentUpdateProgressDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of shipment update progress information.
                    The proofOfDelivery element is not used, only SECCode and movementDateTime in the SECInformation element are used.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentIDType" type="cis:ShipmentIdEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    An enumerated value defining how the shipment should be identified.
                    
                        SI_NULL - No shipments are retrieved.
                        
                        SI_ID - The shipments to be identified by their IDs.
                        
                        SI_NUM - The shipments to be identified by their shipment numbers.
                        
                        SI_RFRC - The shipments to be identified by their reference numbers.
                        
                        SI_RFRC_DIV - The shipments to be identified by their reference numbers and Division ID.
                            If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then a division can be omitted or, if specified, should match the division to which the user is restricted.
                            
                        SI_TRKG_NUM - The shipments to be identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.
                        
                        SI_TRKG_NUM_DIV - The shipments to be identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.
                            If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then the division can be omitted or, if specified, it should match the division to which the user is restricted.
                            
                        SI_LEG_ID - The shipment legs to be identified by their shipment leg IDs.
                        
                        SI_BOL_NUM_CARR - The shipment legs to be identified by their Carrier Codes and Bill Of Lading Numbers.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IDsAreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether shipments should be identified by their reference numbers instead of their ID numbers.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberTypeCode" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The type of reference numbers used to identify the shipments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processShipmentUpdateProgressType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of requests to update the progress information for existing shipment legs.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentUpdateProgressData" type="cis:ShipmentUpdateProgressDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                 A collection of shipment update progress information.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentIDType" type="cis:ShipmentIdEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                 An enumerated value defining how the shipment should be identified.
                 
                    SI_NULL - Equivalent to omitting this field which will be defaulted to SI_NUM.
                    
                    SI_ID - The shipments are identified by their IDs.
                    
                    SI_NUM - The shipments are identified by their shipment numbers.
                    
                    SI_RFRC - The shipments are identified by their reference numbers.
                    
                    SI_RFRC_DIV - The shipments are identified by their reference numbers and Division ID. If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then a division can be omitted or, if specified, should match the division to which the user is restricted.
                    
                    SI_TRKG_NUM - The shipments are identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.

                    SI_TRKG_NUM_DIV - The shipments are identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure. If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then the division can be omitted or, if specified, it should match the division to which the user is restricted.

                    SI_LEG_ID - The shipment legs to be identified by their shipment leg IDs.
                    
                    SI_BOL_NUM_CARR - The shipment legs to be identified by their Carrier Codes and Bill Of Lading Numbers.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IDsAreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                 Indicates whether shipments should be identified by their reference numbers instead of their ID numbers.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberTypeCode" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  The type of reference numbers used to identify the shipments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processShipmentConfirmType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of requests to confirm existing shipment legs.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentConfirmData" type="cis:ShipmentConfirmDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of shipment confirmation information.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processShipmentLegActualsType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of requests to update, report or reverse the details for existing shipment legs.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentLegActualsData" type="cis:ShipmentLegActualsType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of shipment details information.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentIDType" type="cis:ShipmentIdEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  The method of identifying the shipment leg to be updated.
                  
                   SI_NULL - Equivalent to omitting this field which is defaulted to SI_LEG_ID.
                   
                   SI_LEG_ID - The Shipment Leg System Id specifies the Shipment Leg
                   
                   SI_ID - The shipments to be retrieved are identified by their IDs and the leg by
                   
                   SI_NUM - The shipments to be retrieved are identified by their shipment numbers.
                   
                   SI_RFRC - The shipments to be retrieved are identified by their reference numbers.
                   
                   SI_RFRC_DIV - The shipments to be retrieved are identified by their reference numbers and Division ID. If a user is not restricted to a division, then a division must be specified in the input.
                   If a user is restricted to a division, then a division can be omitted or, if specified, should match the division to which the user is restricted.
                   
                   SI_TRKG_NUM - The shipments to be retrieved are identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.
                   
                   SI_TRKG_NUM_DIV - The shipments to be retrieved are identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.
                   If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then the division can be omitted or, if specified, it should match the division to which the user is restricted.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentLegActualsOperationType" type="cis:ShipmentLegActualsOperationEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  The method of identifying the action to be taken when updating.
                   SD_UPDATE - Update the Details only.
                   SD_REPORT_DETAIL - Report Details and if provided update details.
                   SD_REVERSE - Revers the Details Reporting.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processRetrieveProofOfDeliveryInformationType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to retrieve proof of delivery information.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of system-generated shipment leg IDs.
                    One of SystemShipmentLegID or SystemShipmentLegContainerID collections should not be empty but not both.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegContainerID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of system-generated shipment leg container IDs.
                    One of SystemShipmentLegID or SystemShipmentLegContainerID collections should not be empty but not both.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processShipmentLegContainerUpdateProgressType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to update the progress information for existing shipment leg containers.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentLegContainerUpdateProgressData" type="cis:ShipmentLegContainerUpdateProgressDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of shipment leg container update progress information.
                    At least one of Memo and SECInformation elements should not be empty.
                    ProofOfDelivery and ContainerTrackingNumber are ignored.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processSetShipmentLegContainerToDeliveredType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to set the status of existing shipment leg containers to Delivered.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentLegContainerUpdateProgressData" type="cis:ShipmentLegContainerUpdateProgressDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of shipment leg container update progress information.
                    SECInformation should not be empty.
                    ProofOfDelivery and ContainerTrackingNumber are ignored.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processSetShipmentLegContainerProofOfDeliveryType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to set Proof of Delivery (POD) information for existing shipment leg containers.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentLegContainerUpdateProgressData" type="cis:ShipmentLegContainerUpdateProgressDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of shipment leg container update progress information.
                    SECInformation and ProofOfDelivery should not be empty.
                    ContainerTrackingNumber is ignored.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processShipmentLegContainerReturnToDeliveredType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to return the status of existing shipment leg containers to Delivered.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentLegContainerUpdateProgressData" type="cis:ShipmentLegContainerUpdateProgressDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of shipment leg container update progress information.
                    SECInformation should not be empty.
                    ProofOfDelivery and ContainerTrackingNumber are ignored.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processShipmentLegContainerReturnToInTransitType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to return the status of existing shipment leg containers to In Transit.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentLegContainerUpdateProgressData" type="cis:ShipmentLegContainerUpdateProgressDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of shipment leg container update progress information.
                    SECInformation should not be empty.
                    ProofOfDelivery and ContainerTrackingNumber are ignored.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processContainerTrackingNumberUpdateType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to update container tracking numbers of existing shipment leg containers.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentLegContainerUpdateProgressData" type="cis:ShipmentLegContainerUpdateProgressDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of shipment leg container update progress information.
                    ContainerTrackingNumber should not be empty.
                    Memo, SECInformation and ProofOfDelivery are ignored.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAddressFormatType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to format addresses.
                An address is formatted according to the format specification configured for the country.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Address" type="cis:AddressType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    An address to be formatted.
                    Only block, street, unit, city, state, countryCode and postalCode are used for this operation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MultiLineFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the formatted string will be multi-line (when supported by the format specification)
                    rather than single-line.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAddressValidateType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of requests to validate addresses.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Address" type="cis:AddressType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of addresses to be validated.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AddressValidateMode" type="cis:AddressCheckEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The validation mode, either AddrSrvc::POSTAL or AddrSrvc::STREET. In POSTAL mode, the zip/postal code information is assumed to be correct and is validated against the rest of the address. In STREET mode, the street information is assumed to be correct and is validated against the rest of the address.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processPostalDataAddType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to add postal data.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The country ID. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RebuildPostalCodeRangesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether postal code ranges will be re-created for the country.
                    If not specified, assumed to be true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PostalDataEntry" type="cis:PostalDataEntryType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                     A collection of postal data entries.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processPostalCodeRangesRebuildType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to re-create postal code ranges.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The country ID. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processPostalDataReplaceType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to replace postal data.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The country ID. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RebuildPostalCodeRangesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether postal code ranges will be re-created for the country.
                    If not specified, assumed to be true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PostalDataEntry" type="cis:PostalDataEntryType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                     A collection of postal data entries.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processPostalDataRemoveType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to remove postal data.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RebuildPostalCodeRangesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether postal code ranges will be re-created or removed for the country.
                    If not specified, assumed to be true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PostalDataEntry" type="cis:PostalDataEntryType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                     A postal data entry to represent criteria to remove records.
                     The following sets of criteria are allowed:
                        CountryCode;
