                    Existing notes for this shipment. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NewNote" type="cis:NoteType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
