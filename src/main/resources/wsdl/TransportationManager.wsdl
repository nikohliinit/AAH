            <xsd:complexType name="AlertType">
                <xsd:annotation>
                    <xsd:documentation>
				The information about Proactive Monitoring Alert (Monitoring Activity).
				Applicable only for UI-oriented APIs.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemAlertID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					System-generated Alert (Monitoring Activity) ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the alert was created.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the alert was last updated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SeverityReevaluationPendingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the severity of this monitoring activity is pending automatic re-evaluation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SeverityLastChangedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the alert severity was last changed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AcknowledgedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the alert was acknowledged.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AcknowledgedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who acknowledged the alert.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertSeverityEnumVal" type="cis:AlertSeverityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The alert severity.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertSeverityEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for AlertSeverityEnumVal. Read-only. Available only through UI-oriented APIs. 
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EscalatedToGreenDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the alert was escalated to 'green' severity.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EscalatedToYellowDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the alert was escalated to 'yellow' severity.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EscalatedToRedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the alert was escalated to 'red' severity.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertCategoryEnumVal" type="cis:AlertCategoryEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The alert category.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertCategoryEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for AlertCategoryEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertStatusEnumVal" type="cis:AlertStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The alert status.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for AlertStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SeverityEvaluationBasisDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time used as a basis to compare with escalation basis date and time for severity evaluation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EscalationBasisDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time used as a basis for severity escalation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated ID of the trip associated with the alert.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The sequence number of the trip itinerary for the load associated with the alert.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated ID of the load associated with the alert.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemStopID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated ID of the stop associated with the alert.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopSequenceNumber" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The sequence number of the load itinerary for the stop associated with the alert.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated ID of the shipment leg associated with the alert.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentNumber" type="cis:ShipmentNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipment number of the shipment associated with the alert.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The carrier ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The customer ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The logistics group ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastSECCode" type="cis:SECCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The reason code associated with the most recent event that impacted this alert.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastSECDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The reason description associated with the most recent event that impacted this alert. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AcknowledgedReasonCode" type="cis:SECCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					User provided reason code when acknowledging an alert.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The service ID associated with the alert.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NonLivePickupFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the alert is associated with non live pick up.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NonLiveDropoffFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the alert is associated with non live drop off.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertTypeCode" type="cis:AlertTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The alert type ID associated with the alert.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertTypeDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The description associated with the alert. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripEntityTypeEnumVal" type="cis:TripEntityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The trip type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripEntityTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for TripEntityTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDockCommitmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated ID of the dock commitment associated with the alert.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDriverAssignmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated ID of the asset assignment associated with the alert.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                	A memo.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertTextType" type="cis:AlertTextType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    free form text associated with an alert.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertSourceTypeEnumVal" type="cis:EventSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates the source of the alert as originating from the application or a specific partner integration.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertSourceTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for alertEntityTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="APOperationalStatusTransitionType">
                <xsd:annotation>
                    <xsd:documentation>
            The information about an operational status transition for an A/P transactional entity (trip, load, shipment leg, shipment leg container).
            Applicable only for UI-oriented APIs.
        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Internal ID.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemStatusTransitionID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                System-generated status transition ID.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StatusTransitionDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The date and time when the status transition has occurred.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID of the user who created the status transition.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReportedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The date and time when the status transition was reported.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who updated the status transition.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the status transition was updated.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventControlEnumVal" type="cis:EventControlEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The event type.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventControlEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for EventControlEnumVal. Read-only. Available only through UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventReasonCode" type="cis:EventCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The event reason code for the status transition.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventReasonDesc" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The event reason description for the status transition. Read-only. Available only through UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrentStatusEnumVal" type="cis:APOperationalStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The current (after the event) operational status of the transactional entity.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrentStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for CurrentStatusEnumVal. Read-only. Available only through UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CityName" type="cis:CityNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The city name for the current location.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StateCode" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The state or province code for the current location.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The country code for the current location.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EstimatedOriginArrivalDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The estimated arrival time for the origin location.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EstimatedDestinationArrivalDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The estimated arrival time for the destination location.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The carrier code.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The system-generated ID of the trip for which the status transition occurred.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The system-generated ID of the load for which the status transition occurred.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The system-generated ID of the shipment leg for which the status transition occurred.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentNumber" type="cis:ShipmentNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The shipment number of the shipment leg for which the status transition occurred.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The system-generated shipment ID of the shipment leg for which the status transition occurred.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegContainerID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The system-generated ID of the shipment leg container for which the status transition occurred.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerTrackingNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The tracking number of the shipment leg container for which the status transition occurred.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlternateSystemTripID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The system-generated ID of the trip.
                Populated when the status transition occurred for the trip, one of its loads
                or one of the shipment legs of its loads.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlternateSystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The system-generated ID of the load.
                Populated when the status transition occurred for the load
                or one of the shipment legs of the load.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlternateSystemShipmentLegID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The system-generated ID of the shipment leg.
                Populated when the status transition occurred for the shipment leg
                or one of the shipment leg containers of the shipment leg.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlternateTripEntityTypeEnumVal" type="cis:TripEntityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The trip type.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlternateTripEntityTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for AlternateTripEntityTypeEnumVal. Read-only. Available only through UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The shipping location ID for the current location.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The shipping location type for the current location.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for ShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationName" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shipping location description for the current location.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventStatusEnumVal" type="cis:EventStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The status of this status transition record.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for eventStatusEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventSourceEnumVal" type="cis:EventSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the source of the event as originating from an application feed (i.e., UI or API) or a specific partner integration.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventSourceEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for eventSourceEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Latitude" type="cis:LatitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The latitude value for the current location.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Longitude" type="cis:LongitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The longitude value for the current location.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDriverCodes" type="cis:DriverCodeStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID codes of the asset.Comma separated asset IDs can be given
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Load" type="cis:LoadType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Associated load.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentLeg" type="cis:ShipmentLegType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Associated shipment leg.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Trip" type="cis:TripType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Associated trip.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventText" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Free form text in Events describing reason codes.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="AROperationalStatusTransitionType">
                <xsd:annotation>
                    <xsd:documentation>
				The information about an operational status transition for an A/R transactional entity (shipment, shipment container, shipment item).
				Applicable only for UI-oriented APIs.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemStatusTransitionID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					System-generated status transition ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StatusTransitionDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the status transition has occurred.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the status transition.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReportedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the status transition was reported.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who updated the status transition.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the status transition was updated.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventControlEnumVal" type="cis:EventControlEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The event type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventControlEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for EventControlEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventReasonCode" type="cis:EventCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The event reason code for the status transition.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrentStatusEnumVal" type="cis:AROperationalStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The current (after the event) operational status of the transactional entity.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrentStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for CurrentStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated ID of the shipment for which the status transition occurred.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemContainerID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated ID of the container for which the status transition occurred.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentItemID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated ID of the shipment item for which the status transition occurred.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventStatusEnumVal" type="cis:EventStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The status of this status transition record.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for eventStatusEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventSourceEnumVal" type="cis:EventSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the source of the event as originating from an application feed (i.e., UI or API) or a specific partner integration.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventSourceEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for eventSourceEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventText" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Free form text in Events describing reason codes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ConfigurationVariableType">
                <xsd:annotation>
                    <xsd:documentation>
				Transportation Manager Configuration Variable for URL and URL Parameters.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ConfigurationVariableID" type="cis:FunctionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The configuration variable ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ConfigurationVariableDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The configuration variable description.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ConfigurationVariableValue" type="cis:ConfigurationVariableValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The configuration variable value.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EligibleForUseInFunctionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the configuration variable is eligible for use in a function.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EligibleForUseInScreenOperationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the configuration variable is eligible for use in a screen element version operation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemProvidedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the configuration variable is system-provided.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the configuration variable was created.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the configuration variable was last updated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created this configuration variable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who most recently updated this configuration variable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="EventControlType">
                <xsd:annotation>
                    <xsd:documentation>
				The event control information for controling behavour of certain events.
				This is a system table, i.e. Not updatable.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventControl" type="cis:EventControlEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The enumerated event type. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The description of the event.Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnableFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether this event is enabled. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserReasonCodeAllowedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether user event reason code for this event is allowed. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Statuses" type="cis:EventControlStatusType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                Set of event control statuses for this event control.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="EventControlStatusType">
                <xsd:annotation>
                    <xsd:documentation>
				The control information for controling behavour of certain event control and status combinations.
				This is a system table, i.e. Not updatable.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemEventControlStatusID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The system ID of this event control and status combination. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventControl" type="cis:EventControlEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The enumerated event type. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventControlStatus" type="cis:EventControlStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The enumerated event control status type. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnableFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether this event status combination is enabled. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserReasonCodeAllowedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether user event reason code for this event status combination is allowed. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReasonCodes" type="cis:EventControlStatusReasonCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                Set of event reason codes for this event control status.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ParentEvent" type="cis:EventControlType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Parent event control.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="GlobalDefaultsType">
                <xsd:annotation>
                    <xsd:documentation>
				Global default values.
				This is a singleton (only one record exists) with ID equal to C0.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CompanyName" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The company name.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The currency type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for CurrencyCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnitOfMeasure" type="cis:UnitOfMeasureType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The unit of measurement structure.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VolumeUnitOfMeasureEnumVal" type="cis:VolumeUnitOfMeasureEnumValType" minOccurs="0">
