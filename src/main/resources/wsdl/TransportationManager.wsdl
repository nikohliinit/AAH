                        <xsd:annotation>
                            <xsd:documentation>
				The service type of this itinerary from an external system.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WebSchedulingRRSRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Web Scheduling RR and S Required.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalEquipmentTareWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The total tare weight for all equipments used by the load.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VerifiedGrossMass" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The verified gross mass of the container and all shipments, used in ocean transportation.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VGMAuthorizer" type="cis:VarChar280" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The name of the person who verified the VGM (Verified Gross Mass) measurement.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VGMWeighingMethod" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The method (1 or 2) used when calculating the VGM (Verified Gross Mass).
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VGMWeighingDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date the VGM (Verified Gross Mass) was measured.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VGMVerificationDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date the VGM (Verified Gross Mass) was verified.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionRRSBypassFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                indicates 'true' on any load attached to a booking that has been modified through the booking revisions workflows while bypassing routing, rating and scheduling; will be 'false' on any load attached to a booking that has been updated by routing, rating and scheduling results, either in or beyond booking revision workflows; not set in any other cases
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadConfiguratorTypeEnumVal" type="cis:LoadConfiguratorTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether the load has 3D load configuration or not.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadConfiguratorTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for LoadConfiguratorTypeEnumVal. Read-only. Available only through UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BaseAdditionalChargesAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The additional charges for the load. Expressed in the system currency.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionSchedulingOverriddenFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                This column will be true when a planner has decided execution mode scheduling is required to overcome one or more violations not allowed in planning/confirmation mode scheduling; applicable to loads not otherwise qualified for execution scheduling.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffRestrictionsOverriddenFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                This column will be true when restrictions associated with the applicable tariff service, tariff service/equipment or tariff lane have been overridden.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingInstructionDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The date and time on which the shipping instruction document must be sent by the shipper to the carrier.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastRatedServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The service ID that was selected when routing was most recently performed successfully for this load (will not be removed if rating results for load are cleared).
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierMovementTypeEnumVal" type="cis:CarrierMovementTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates how the carrier assigned to the load will handle the movement; direct indicates that the assigned carrier will handle the freight for the duration; indirect indicates the assigned carrier will pass the freight off to another carrier at some point; partner indicates the assigned carrier will pass the freight off to a partner at some point; only applicable to loads which have been rated externally.
            </xsd:documentation>
                        </xsd:annotation>
