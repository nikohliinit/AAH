            <xsd:element name="processMaintainEntityNoteResponse">
                <xsd:complexType>
                    <xsd:annotation>
                        <xsd:documentation>
			A collection of load creation responses.
			</xsd:documentation>
                    </xsd:annotation>
                    <xsd:sequence>
                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation> 
                    Header information. For example, name of the operation, ID, etc. 
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ResponseHeader" type="cis:ResponseHeaderType">
