				The itinerary associated with the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateQuotationLeg" type="cis:RateQuotationLegType" minOccurs="0" maxOccurs="unbounded">
