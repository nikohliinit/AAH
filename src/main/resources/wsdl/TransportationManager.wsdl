                    <xsd:element name="ChargeDetailTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for chargeDetailTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AdjustmentLevelEnumVal" type="cis:ChargeDetailAdjustEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The adjustment level.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AdjustmentLevelEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for adjustmentLevelEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransactionID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The transaction ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeCode" type="cis:ChargeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The charge ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    A description of the charge. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightClassCode" type="cis:FreightClassCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight class ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatedAsFreightClassCode" type="cis:FreightClassCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The Rate As Freight class code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemStopID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the stop.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopSequenceNumber" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The position of the stop within the sequence of stops of the load.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The type of shipping point for the stop.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for ShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the shipping point of the stop.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    A description of the shipping location. Read only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The equipment type code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The equipment type description. Read only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatedAsEquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The code for Rated As Equipment Type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatedAsEquipmentTypeDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The description for Rated As Equipment Type. Read only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripLevelChargeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicate whether this charge is a trip level charge.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemContainerID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The container ID.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrePurchasedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the amounts are pre-purchased.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IsTaxFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the charge is a tax charge. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OptionsAppliedLevelEnumVal" type="cis:OptionsAppliedEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Option Apply Level.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OptionsAppliedLevelEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for optionsAppliedLevelEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatingUnits" type="cis:NumberOfUnitsWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of units at which this charge is rated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargedUnitRate" type="cis:RatePerUnitType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The charged unit rate..
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnitRate" type="cis:RatePerUnitType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The rate at which each unit is charged..
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReasonCode" type="cis:AdjustmentReasonCodeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The reason code for the voucher charge. 
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReasonCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for reasonCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherChargeApprovalStatusEnumVal" type="cis:VoucherChargeApprovalStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The approval status for the voucher charge. 
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherChargeApprovalStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for VoucherChargeApprovalStatusEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApprovalByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who approved the charge detail. 
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApprovalDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the charge detail was approved. 
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerChargeGeneratedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the AR charge has been created or not. 
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AccruedExpenseOrRevenueGLAccountNumber" type="cis:GLAccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Accrued expense account number.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AccruedLiabilityOrAssetGLAccountNumber" type="cis:GLAccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Accrued liability account number.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExpenseOrRevenueGLAccountNumber" type="cis:GLAccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Expense account number.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiabilityOrAssetGLAccountNumber" type="cis:GLAccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Liability account number.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateRange" type="cis:NumberofUnitsType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The rate range for calculating the charge. 
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PaymentAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The charged amount in payment currency.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatingInfoID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The Rating Info ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BasedSystemChargeDetailID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The charge detail ID which this charge is based upon, if the charge is surcharge based charge.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResponsibleCustomerOverrideID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The Responsible Customer Override ID.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegContainerID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The system shipment leg container ID if the charge is associated with a shipment leg container.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrentStatusEnumVal" type="cis:ChargeDetailStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The current status of the charge detail.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrentStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for CurrentStatusEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherNumberAP" type="cis:VoucherNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The A/P voucher number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalCurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The original currency. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalCurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for OriginalCurrencyCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalCurrencyExchangeRate" type="cis:ExchangeRateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The exchange rate for the original currency.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalCurrencyDiscountAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The surcharge/discount amount in original currency.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalCurrencyNetAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The net amount in original currency (after applying surcharge or discount).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated tariff ID. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargePriority" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Charge priority. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByRatingUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user that created the charge detail (when charge detail was created based on a routing, rating and scheduling request). Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time the charge was created. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time the charge was updated. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The user that created the charge. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The user that last updated the charge. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalChargeCode" type="cis:ExternalChargeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The external charge code for this charge detail (applicable only when charge is retrieved from an external source which supports detailed charges).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Load" type="cis:LoadType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated load.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NonOperationalFreightAR" type="cis:NonOperationalFreightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated Non Operational Freight (NOF) for A/R.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NonOperationalFreightAP" type="cis:NonOperationalFreightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated Non Operational Freight (NOF) for A/P.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentLeg" type="cis:ShipmentLegType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated shipment leg.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Shipment" type="cis:ShipmentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated shipment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Tariff" type="cis:TariffType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated tariff.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="AdditionalDataType">
                <xsd:annotation>
                    <xsd:documentation>
				Generally usable table. Stores a CLOB which can be referenced by other tables, without detrimental system performance impacts. Used in situations when a large amount of data must be supported.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemAdditionalDataID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					the system-assigned ID for this data.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Data" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					the data that this record stores.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					the date/time this data was created; in system time zone.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="AddressType">
                <xsd:annotation>
                    <xsd:documentation>
			A physical address of an entity.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AddressCode" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Unique ID of the address. May be only read.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Block" type="cis:BlockNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The block (street) number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Street" type="cis:StreetNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The street name. Mandatory for a new Address. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Unit" type="cis:UnitNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The unit number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="City" type="cis:CityNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The city name. Mandatory for a new Address. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="State" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The state or province. Mandatory for a new Address. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The country. Mandatory for a new Address. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PostalCode" type="cis:PostalCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The zip or postal code.
				Mandatory for a new Address if postal codes are required for the country.
				Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AddressNotes" type="cis:AddressNoteType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Additional address information such as a dock or gate number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Latitude" type="cis:LatitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The latitude value.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Longitude" type="cis:LongitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The longitude value.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GeoCodeOverridenFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the latitude or longitude values have been manually overridden.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GeoCodeRecalculateFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether latitude and longitude values are to be recalculated using a distance engine. May be present for change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResidentialFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the address is a residential address. If omitted from input, false will be assumed.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A description (name) of the corresponding shipping location (if any). Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TimeZoneOffset" type="cis:TimezoneOffsetType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The number of hours offset due to time zone differences. Read-only. Available only through UI-oriented APIs
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="AlternateLanguageEntityDescriptionType">
                <xsd:annotation>
                    <xsd:documentation>
                Entity description in an alternate language.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemAlternateLanguageEntityDescriptionID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated Alternate Language Entity Description ID.
                    Ignored for Create, otherwise mandatory if not all identification fields are supplied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCode" type="cis:LanguageDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The language for the entry.
                    Mandatory for Create.
                    This field is one of the identification fields, if all identification fields are supplied,
                    SystemAlternateLanguageEntityDescriptionID is not required to identify an existing entry.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for languageCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageDescriptionEntityEnumVal" type="cis:LanguageDescriptionEntityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Entity type for the entry.
                    Mandatory for Create.
                    This field is one of the identification fields, if all identification fields are supplied,
                    SystemAlternateLanguageEntityDescriptionID is not required to identify an existing entry.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageDescriptionEntityEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for LanguageDescriptionEntityEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageDescriptionEntityCode1" type="cis:LanguageDescriptionEntityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The primary key of the entity or the first part of the entity compound primary key for the entry.
                    Mandatory for Create.
                    This field is one of the identification fields, if all identification fields are supplied,
                    SystemAlternateLanguageEntityDescriptionID is not required to identify an existing entry.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageDescriptionEntityCode2" type="cis:LanguageDescriptionEntityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The second part of the entity compound primary key for the entry.
                    Currently, it can be state/province ID for a state/province or domain value number for a domain value.
                    If the entity has a compound key, this is mandatory for Create.
                    Also, if the entity has a compound key, this fields is one of the identification fields, if all identification fields are supplied,
                    SystemAlternateLanguageEntityDescriptionID is not required to identify an existing entry.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The country ID. Used for Create only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DescriptionValue" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The description string to be provided in the alternate language. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemProvidedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the entry is system-provided. Input applicable for Create only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether a system-provided entry has been updated. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the entry was created.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the entry was updated.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created the entry.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who updated the entry.
                </xsd:documentation>
