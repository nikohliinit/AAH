                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="getEntity">
                <xsd:complexType>
                    <xsd:annotation>
                        <xsd:documentation>
		Defines what entity to load.
		</xsd:documentation>
                    </xsd:annotation>
                    <xsd:sequence>
                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
			Operation header.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="EntityType" type="cis:TMEntityEnumValType">
                            <xsd:annotation>
                                <xsd:documentation>
			Type of entities to select.
			</xsd:documentation>
                            </xsd:annotation>
