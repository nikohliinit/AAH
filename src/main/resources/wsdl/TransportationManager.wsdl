<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:soapenc="http://schemas.xmlsoap.org/soap/encoding/" xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:http="http://schemas.xmlsoap.org/wsdl/http/" xmlns:saxon="http://icl.com/saxon" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:cis="http://www.i2.com/cis" xmlns:mime="http://schemas.xmlsoap.org/wsdl/mime/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" targetNamespace="http://www.i2.com/cis">
    <types>
        <xsd:schema targetNamespace="http://www.i2.com/cis" elementFormDefault="qualified">
            <xsd:complexType name="addEntityType">
                <xsd:annotation>
                    <xsd:documentation>
             A collection of entity creation requests
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Entity" type="cis:EntityType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                   A collection of entities.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="queryEntityType">
                <xsd:annotation>
                    <xsd:documentation>
                   A collection of entity query requests.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Entity" type="cis:EntityType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                   A collection of entities.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="changeEntityType">
                <xsd:annotation>
                    <xsd:documentation>
                   A collection of entity change requests.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Entity" type="cis:EntityType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                   A collection of entities.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RejectUpdatesDuringOptFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  Indicates whether to reject updates during optimization.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="deleteEntityType">
                <xsd:annotation>
                    <xsd:documentation>
                   A collection of entity deletion requests.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Entity" type="cis:EntityType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                   A collection of entities.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processShipmentOrderCreateType">
                <xsd:annotation>
                    <xsd:documentation>
                   A collection of shipment creation requests.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Shipment" type="cis:ShipmentType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                   A collection of shipments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAllShipmentReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether shipment reference numbers should be ignored. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecuteAPRatingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether A/P rating is to be performed for the shipments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecuteARRatingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether A/R rating is to be performed for the shipments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResultContents" type="cis:ShipmentOrderResultContentEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The type of information that is in shipment output file.
RES_NULL and RES_NONE - Only IDs of new shipments are sent to the client.
RES_SHIPMENT_HEADER - Partial information (the shipment header) regarding created shipments is sent to the client.
RES_SHIPMENT_FULL - All the information about created shipments is sent to the client.
RES_SHIPMENTLEG_HEADER - Partial information (the shipment leg header) regarding the shipment legs for created shipments is sent to the client.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ValidateCarrierServiceEquipmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether to perform carrier/service/equipment checks before updating a Shipment. Optional, defaults to true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processShipmentOrderDeleteType">
                <xsd:annotation>
                    <xsd:documentation>
                   A collection of shipment deletion requests.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Shipment" type="cis:ShipmentType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                   A collection of shipments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentIDType" type="cis:ShipmentIdEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    An enumerated value defining how the shipment should be identified.

                    SI_NULL - Equivalent to omitting this field which will be defaulted to SI_NUM.

                    SI_ID - The shipments are identified by their IDs.

                    SI_NUM - The shipments are identified by their shipment numbers.

                    SI_RFRC - The shipments are identified by their reference numbers.

                    SI_RFRC_DIV - The shipments are identified by their reference numbers and Division ID.
                    If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then a division can be omitted or, if specified, should match the division to which the user is restricted.

                    SI_TRKG_NUM - The shipments are identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.

                    SI_TRKG_NUM_DIV - The shipments are identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.
                    If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then the division can be omitted or, if specified, it should match the division to which the user is restricted.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SearchReferenceNumberType" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                 The type of reference number to search.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RejectUpdatesDuringOptFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether to reject this request during optimization.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SkipLoadSuspensionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether all changes related to load suspension should be bypassed. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processShipmentOrderRetrieveType">
                <xsd:annotation>
                    <xsd:documentation>
                   A collection of shipment retrieval requests.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Shipment" type="cis:ShipmentType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                   A collection of shipments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentIDType" type="cis:ShipmentIdEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The method of identifying the shipments to be retrieved.
                    
                    SI_NULL - Equivalent to omitting this field which will be defaulted to SI_NUM.
                    
                    SI_ID - The shipments to be retrieved are identified by their IDs.
                    
                    SI_NUM - The shipments to be retrieved are identified by their shipment numbers.
                    
                    SI_RFRC - The shipments to be retrieved are identified by their reference numbers.
                    
                    SI_RFRC_DIV - The shipments to be retrieved are identified by their reference numbers and Division ID.
                    If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then a division can be omitted or, if specified, should match the division to which the user is restricted.
                    
                    SI_TRKG_NUM - The shipments to be retrieved are identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.

                    SI_TRKG_NUM_DIV - The shipments to be retrieved are identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.
                    If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then the division can be omitted or, if specified, it should match the division to which the user is restricted.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResultContents" type="cis:ShipmentOrderResultContentEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    An enumerated value defining the results of the shipment retrieval requests.
RES_NULL and RES_NONE - Only IDs of new shipments are sent to the client.
RES_SHIPMENT_HEADER - Partial information (the shipment header) regarding created shipments is sent to the client.
RES_SHIPMENT_FULL - All the information about created shipments is sent to the client.
RES_SHIPMENTLEG_HEADER - Partial information (the shipment leg header) regarding the shipment legs for created shipments is sent to the client.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnContainersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
If True and ResultContents is RES_SHIPMENT_FULL, then information about all containers included in this shipment is retrieved. Otherwise, only header or shipment legs information is produced.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processShipmentOrderUpdateType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of shipment update requests.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Shipment" type="cis:ShipmentType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                   A collection of shipments IDS.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentIDType" type="cis:ShipmentIdEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    An enumerated value defining how the shipment should be identified.
                    
                    SI_NULL - Equivalent to omitting this field which will be defaulted to SI_NUM.
                    
                    SI_ID - The shipments are identified by their IDs.
                    
                    SI_NUM - The shipments are identified by their shipment numbers.
                    
                    SI_RFRC - The shipments are identified by their reference numbers.
                    
                    SI_RFRC_DIV - The shipments are identified by their reference numbers and Division ID.
                    If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then a division can be omitted or, if specified, should match the division to which the user is restricted.
                    
                    SI_TRKG_NUM - The shipments are identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.

                    SI_TRKG_NUM_DIV - The shipments are identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.
                    If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then the division can be omitted or, if specified, it should match the division to which the user is restricted.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SearchReferenceNumberType" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                 A request to search shipment reference numbers.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SECCode" type="cis:SECCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Service Exception Code for the request.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreShipmentHeaderFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  Indicates whether to ignore the shipment header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAllShipmentReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether to ignore the shipment reference numbers. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAllContainersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  Indicates whether to ignore all the containers.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAllThroughPointsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  Indicates whether to ignore all the through points.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RejectUpdatesDuringOptFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  Indicates whether to reject updates during optimization.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecuteAPRatingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether A/P rating is to be performed for the shipments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecuteARRatingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether A/R rating is to be performed for the shipments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecuteLoadRatingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether rating is to be performed for the Loads.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ValidateCarrierServiceEquipmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether to perform carrier/service/equipment checks before updating a Shipment. Optional, defaults to true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processShipmentOrderMaintainType">
                <xsd:annotation>
                    <xsd:documentation>
                  A collection of shipment order maintenance requests.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ProcessShipmentOrderCreate" type="cis:processShipmentOrderCreateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of shipment creation requests.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ProcessShipmentOrderUpdate" type="cis:processShipmentOrderUpdateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of shipment update requests.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ProcessShipmentOrderDelete" type="cis:processShipmentOrderDeleteType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of shipment deletion requests.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processShipmentContainerMaintainType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of shipment container maintenance requests.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerActionEnumVal" type="cis:ReferenceNumberActionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maintenance action type - add, update or delete. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated numerical ID of the shipment to add containers to.
                    Mandatory for adding containers, ignored otherwise.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAllReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether to ignore all input reference numbers.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RejectUpdatesDuringOptFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether to reject updates during optimization.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecuteAPRatingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether A/P rating is to be performed or suppressed.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecuteARRatingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether A/R rating is to be performed or suppressed.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Container" type="cis:ContainerType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Container information.
                    For Delete, only container ID is used.
                    At least one element is required.
                    All containers should belong to the same shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecuteLoadRatingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether rating is to be performed for the Loads.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processShipmentOrderCancelType">
                <xsd:annotation>
                    <xsd:documentation>
           A collection of shipment cancellation requests.
        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Shipment" type="cis:ShipmentType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
           A collection of shipments.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentIDType" type="cis:ShipmentIdEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The method of identifying the shipments to be cancelled.
                    
                    SI_NULL - Equivalent to omitting this field which will be defaulted to SI_NUM.
                    
                    SI_ID - The shipments to be cancelled are identified by their IDs.
                    
                    SI_NUM - The shipments to be cancelled are identified by their shipment numbers.
                    
                    SI_RFRC - The shipments to be cancelled are identified by their reference numbers.
                    
                    SI_RFRC_DIV - The shipments to be cancelled are identified by their reference numbers and Division ID.
                    If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then a division can be omitted or, if specified, should match the division to which the user is restricted.
                    
                    SI_TRKG_NUM - The shipments to be cancelled are identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.

                    SI_TRKG_NUM_DIV - The shipments to be cancelled are identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.
                    If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then the division can be omitted or, if specified, it should match the division to which the user is restricted.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SearchReferenceNumberType" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
         The type of reference number to search if ShipmentIdEnumValType is SI_RFRC.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RejectUpdatesDuringOptFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  Indicates whether to reject updates during optimization.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SkipLoadSuspensionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether all changes related to load suspension should be bypassed. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventInformation" type="cis:EventInformationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Reason Code information.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="addPreBuiltLoadType">
                <xsd:annotation>
                    <xsd:documentation>
                  A collection of pre-built load creation requests.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Shipment" type="cis:ShipmentType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                 A collection of shipment IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadCreateData" type="cis:LoadCreateDataType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                 The load creation data.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadStatus" type="cis:PreBuiltLoadStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                 The status of the pre-built load.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnableLoadLevelNotificationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Indicates whether load notification is enabled.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResultContents" type="cis:ShipmentOrderResultContentEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The results of the load creation request.
RES_NULL and RES_NONE - Only IDs of new shipments are sent to the client.
RES_SHIPMENT_HEADER - Partial information (the shipment header) regarding created shipments is sent to the client.
RES_SHIPMENT_FULL - All the information about created shipments is sent to the client.
RES_SHIPMENTLEG_HEADER - Partial information (the shipment leg header) regarding the shipment legs for created shipments is sent to the client.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnRoutingMessageLogFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether diagnostic messages should be generated for routing, rating and scheduling.
                    Ignored if pre-built load status is OPEN.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processLoadCompositionUpdateType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of load composition update requests.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Shipment" type="cis:ShipmentType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of shipments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system load ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResultContents" type="cis:ShipmentOrderResultContentEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    An enumerated value defining the output type for the created shipments.

                    RES_NULL and RES_NONE - Only IDs of new shipments are sent to the client.
                    RES_SHIPMENT_HEADER - Partial information (the shipment header) regarding created shipments is sent to the client.
                    RES_SHIPMENT_FULL - All the information about created shipments is sent to the client.
                    RES_SHIPMENTLEG_HEADER - Partial information (the shipment leg header) regarding the shipment legs for created shipments is sent to the client.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAssignToLoadType">
                <xsd:annotation>
                    <xsd:documentation>
                 A collection of requests to assign an existing shipment leg to an existing load.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                 A collection of shipment leg IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  The system load ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DiscardConflictingAppointmentsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  Indicates to discard any conflicting appointments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAssignToPlannedLoadType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to add shipment legs to a planned load.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssignToPlannedLoadData" type="cis:AssignToPlannedLoadDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of shipment legs to be added to a planned load.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processRemoveFromPlannedLoadType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of requests to remove shipments from a planned load.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RemoveFromPlannedLoadData" type="cis:RemoveFromPlannedLoadDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
            A collection of shipments to be removed from a planned load.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processSetLoadToPlannedType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of requests to advance an Open load to Planned status and remove it from its associated plan.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of load IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TenderFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the load should be automatically tendered (unconditionally).
                    Not allowed to be true if at least one load is assigned to trip or booking.
                    If this flag is set to false, loads will not be tendered.
                    If this flag is not specified, the automatic tendering rules based on Global Defaults will apply.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoAcceptControlEnumVal" type="cis:AutoAcceptControlEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether tenders are automatically accepted if load is unconditionally tendered.
                    Ignored if TenderFlag is false.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TenderAcceptedBy" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The name of the employee who accepted the tender if load is unconditionally tendered.
                    Mandatory if load is unconditionally tendered and AutoAcceptControlEnumVal is set to AUTOACCEPTCTRL_TRUE.
                    Ignored if TenderFlag is false.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FaxFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether to fax a tender report if load is unconditionally tendered.
                    Ignored if TenderFlag is false.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EmailFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether to email a tender report if load is unconditionally tendered.
                    Ignored if TenderFlag is false.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventNotificationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether to set an EDI flag in the Event Notification data for Tender if load is unconditionally tendered.
                    Ignored if TenderFlag is false.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processBookingSetToPlannedType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to advance booking and its loads to Planned status and remove the loads from their associated plans.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of system-generated booking IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processPlanType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of load plan creation requests.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Plan" type="cis:PlanType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of load plan IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processGetPossibleChargesType">
                <xsd:annotation>
                    <xsd:documentation>
             A collection of requests to retrieve a list of possible charges.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeCriteria" type="cis:ChargeCriteriaType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  Optional criteria that limits which charges to obtain. This service requires an origin point (LoadAtCode or HubFromCode), and a destination point (ConsigneeCode or HubToCode).
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processRateQuotationType">
                <xsd:annotation>
                    <xsd:documentation>
            A request to retrieve a set of valid lanes and the cost of each.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateCriteria" type="cis:RateCriteriaType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  The input criteria describing what is being shipped and how it should be shipped.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnDiagnosticsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                 Indicates whether diagnostic messages should be generated.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processLoadCreateType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of load creation requests.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadCreateData" type="cis:LoadCreateDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of load creation structures which define the new loads to be created.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processTenderType">
                <xsd:annotation>
                    <xsd:documentation>
                A collections of trip/booking or load tender requests.
                Either a collection of trip/booking tender data or a collection of load tender data
                is allowed, but not both.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripTenderData" type="cis:TripTenderDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of trip/booking tender information.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadTenderData" type="cis:LoadTenderDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of load tender information.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoAcceptFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether tenders are automatically accepted.  This applies to all values in LoadTenderData or TripTenderData.

                    This flag does not disable an auto-accept specified by the associated tariff. Both this flag and the tariff's auto-accept flag must be False to stop a tender from being automatically accepted.

                    This flag is obsolete, using AutoAcceptControlEnumVal is recommended.
                    If both values are used, they should be compatible.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoAcceptControlEnumVal" type="cis:AutoAcceptControlEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether tenders are automatically accepted. This applies to all values in LoadTenderData or TripTenderData.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processTenderUpdateType">
                <xsd:annotation>
                    <xsd:documentation>
                A collections of trip/booking or load tender update requests.
                Either a collection of trip/booking tender data or a collection of load tender data
                is allowed, but not both.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripTenderData" type="cis:TripTenderDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of trip/booking tender information.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadTenderData" type="cis:LoadTenderDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of load tender information.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoAcceptFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether tenders are automatically accepted.  This applies to all values in loadTenderData or tripTenderData.

                    This flag does not disable an auto-accept specified by the associated tariff. Both this flag and the tariff's auto-accept flag must be False to stop a tender from being automatically accepted.

                    This flag is obsolete, using AutoAcceptControlEnumVal is recommended.
                    If both values are used, they should be compatible.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoAcceptControlEnumVal" type="cis:AutoAcceptControlEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether tenders are automatically accepted. This applies to all values in LoadTenderData or TripTenderData.
                    Auto Accept is unconditionally disabled (and cannot be forced) for loads assigned to bookings or for loads with tender requests at trip level.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processTenderAcceptType">
                <xsd:annotation>
                    <xsd:documentation>
                A collections of trip or load tender requests.
                Either a collection of trip/booking tender data or a collection of load tender data
                is allowed, but not both.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripTenderData" type="cis:TripTenderDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                    A collection of trip/booking tender information.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadTenderData" type="cis:LoadTenderDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of load tender information.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventSourceEnumVal" type="cis:EventSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates the source of the event as originating from an application feed (i.e., UI or API) or a specific partner integration.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processTenderRejectType">
                <xsd:annotation>
                    <xsd:documentation>
                A collections of requests to reject a trip or load tender
                Either a collection of trip/booking tender data or a collection of load tender data
                is allowed, but not both.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripTenderData" type="cis:TripTenderDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                    A collection of trip/booking tender information.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadTenderData" type="cis:LoadTenderDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of load tender information.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventSourceEnumVal" type="cis:EventSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates the source of the event as originating from an application feed (i.e., UI or API) or a specific partner integration.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAutoTenderType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of requests to start/stop/resume carrier sequential tendering.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of load IDs. At least one load ID is required.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoTenderProcessModeEnumVal" type="cis:AutoTenderProcessModeEnumValType">
                        <xsd:annotation>
                            <xsd:documentation>
                    An enumerated value defining the type of carrier sequential tendering request:
                        ATPM_START  - start carrier sequential tendering.
                        ATPM_STOP   - stop carrier sequential tendering.
                        ATPM_RESUME - resume carrier sequential tendering.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processLoadRetrieveType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of requests to retrieve a load.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:ExternalXRefType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                 A collection of load IDs or load reference numbers.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IDsAreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  Indicates whether the supplied IDs are load IDs or load reference numbers. If you use reference numbers for identification, they must be unique across all loads. If a supplied reference number is attached to two or more loads, this will generate an error.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ComputeChargesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  Indicates whether to calculate a detailed charge breakdown for each load and for each load leg associated with each load.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberTypeCode" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The type of reference numbers used to identify the loads.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processLoadReturnToOpenType">
                <xsd:annotation>
                    <xsd:documentation>
      A collection of requests to return Load statuses from Planned or Tender Rejected to Open.
      </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadPlan" type="cis:LoadPlanType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
        A collection of load id and optional plan information.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processBookingReturnToOpenType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to return booking statuses from Planned or Tender Rejected to Open.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of system-generated booking IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemPlanID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The plan ID to attach the booking(s) to. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processLoadReturnToPlannedType">
                <xsd:annotation>
                    <xsd:documentation>
                        A collection of requests to return Load status from Tender Rejected to Planned.
                        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Operation header.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                A collection of load IDs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processBookingReturnToPlannedType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of requests to return booking statuses from Tender Rejected to Planned.
        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                A collection of system-generated booking IDs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processBuildStopType">
