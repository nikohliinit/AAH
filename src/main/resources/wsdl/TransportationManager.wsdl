            <xsd:element name="numberOfEntities">
                <xsd:complexType>
                    <xsd:annotation>
                        <xsd:documentation>
		Defines search criteria.
		</xsd:documentation>
                    </xsd:annotation>
                    <xsd:sequence>
                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
			Operation header.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="EntityType" type="cis:TMEntityEnumValType">
                            <xsd:annotation>
                                <xsd:documentation>
