                    <xsd:annotation>
                        <xsd:documentation>
		List of event codes for different statuses values.
		</xsd:documentation>
                    </xsd:annotation>
                    <xsd:sequence>
                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation> 
                                Indicates if the operation was successful. May contain a list of errors. 
                        </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ResponseHeader" type="cis:ResponseHeaderType">
