				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DockCommitmentType">
                <xsd:annotation>
                    <xsd:documentation>
            	The commitment (scheduling) information of the dock. Read-only.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDockCommitmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                An automatically generated system identifier for this dock commitment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDockID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The automatically generated dock system identifier.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommitmentStartDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The commitment starting date and time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommitmentEndDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The commitment ending date and time.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The system identifier of the load associated with the commitment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemStopID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The system identifier of the stop associated with the commitment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCodeViolationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicate whether the dock commitment resulting in commodity code violation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeViolationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicate whether the dock commitment resulting in equipment type violation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InboundOutboundViolationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicate whether the dock commitment resulting in inbound or outbound violation - inbound or outbound type mismatch between dock and stop.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LocationThroughputGroupCapacityViolationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicate whether the dock commitment resulting in location throughput group capacity violation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookedWhenCloseFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicate whether the dock commitment is booked when the dock is closed.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OverBookedCommitmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicate whether the time of dock commitment overlaps with other dock commitments from the same dock.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The carrier ID of the dock commitment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division ID of the dock commitment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The logistics group ID of the dock commitment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					An external identifying code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastEventReasonCode" type="cis:EventCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The last event reason code for the dock commitment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemOptimizationRequestID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated ID of the current optimization request for the dock commitment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockOnHoldFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the dock is on hold.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A memo associated with the dock commitment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrailerLoadingUnloadingStartedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time that the trailer started loading or unloading.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrailerLoadingUnloadingEndedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time that the trailer ended loading or unloading.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrailerLoadingUnloadingStartedReasonCode" type="cis:EventCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The reason code for the trailer loading unloading started event.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrailerLoadingUnloadingEndedReasonCode" type="cis:EventCodeType" minOccurs="0">
                        <xsd:annotation>
