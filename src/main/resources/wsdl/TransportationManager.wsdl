                                    This value will not be cleared when rating results for the load are cleared.
                                    Expressed in the time zone of the location. Read-only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastComputedDepartureDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                    The date and time that the load is scheduled to depart from the stop, as computed by the scheduling process.
                                    This value will not be cleared when rating results for the load are cleared.
                                    Expressed in the time zone of the location. Read-only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
