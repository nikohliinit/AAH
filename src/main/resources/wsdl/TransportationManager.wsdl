                            <xsd:documentation>
				The second of four time ranges that the entity closes on Fridays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FriBusinessHours3Open" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The third of four time ranges that the entity opens on Fridays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FriBusinessHours3Close" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The third of four time ranges that the entity closes on Fridays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FriBusinessHours4Open" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The fourth of four time ranges that the entity opens on Thursdays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FriBusinessHours4Close" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The fourth of four time ranges that the entity closes on Thursdays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SatBusinessHours1Open" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The first of four time ranges that the entity opens on Saturdays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SatBusinessHours1Close" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The first of four time ranges that the entity closes on Saturdays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SatBusinessHours2Open" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The second of four time ranges that the entity opens on Saturdays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SatBusinessHours2Close" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The second of four time ranges that the entity closes on Saturdays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SatBusinessHours3Open" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The third of four time ranges that the entity opens on Saturdays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SatBusinessHours3Close" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The third of four time ranges that the entity closes on Saturdays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SatBusinessHours4Open" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The fourth of four time ranges that the entity opens on Saturdays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SatBusinessHours4Close" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The fourth of four time ranges that the entity closes on Saturdays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SunBusinessHours1Open" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The first of four time ranges that the entity opens on Sundays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SunBusinessHours1Close" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The first of four time ranges that the entity closes on Sundays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SunBusinessHours2Open" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The second of four time ranges that the entity opens on Sundays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SunBusinessHours2Close" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The second of four time ranges that the entity closes on Sundays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SunBusinessHours3Open" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The third of four time ranges that the entity opens on Sundays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SunBusinessHours3Close" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The third of four time ranges that the entity closes on Sundays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SunBusinessHours4Open" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The fourth of four time ranges that the entity opens on Sundays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SunBusinessHours4Close" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The fourth of four time ranges that the entity closes on Sundays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreHolidaysFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of Holiday should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Holiday" type="cis:HolidayType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				Any holidays associated with the business hours.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="BusinessHoursRestrictedType">
                <xsd:annotation>
                    <xsd:documentation>
			The hours of operation for an entity.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was updated. This is a read-only field.
					This field is not used.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the entry. This is a read-only field.
					This field is not used.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreHolidaysFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of "holiday" should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Holiday" type="cis:HolidayType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				Any holidays associated with the business hours
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ChargeDetailType">
                <xsd:annotation>
                    <xsd:documentation>
			Describes all valid lanes and associated costs, and provides input for the required options.
			You can overwrite manual input units and service level charge amounts where applicable.
			(*) Units of measurement must be taken either from parent NonOperationalFreightType (ARRatingInformation structure for AR charge and APRatingInformation structure for AP charge) or from parent RateCriteriaType.
			The unit type for fields of NumberofUnitsType must be taken from corresponding MasterChargeType that has the same ChargeCode.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransactionID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the charge detail.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeCode" type="cis:ChargeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The code for the service, condition, or option charged.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeDetailFreightClassCode" type="cis:FreightClassCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight class of the charged entity.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatedAsFreightClassCode" type="cis:FreightClassCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The rated freight class.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeSequence" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The charge detail number in a sequence.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeLevelEnumVal" type="cis:ChargeLevelEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The service, condition, or option.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeLevelEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for chargeLevelEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeUnits" type="cis:NumberOfUnitsWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The charge units.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LookupUnits" type="cis:NumberOfUnitsWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The lookup units.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatingUnits" type="cis:NumberOfUnitsWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The number of units at which this charge is rated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateRange" type="cis:NumberofUnitsType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The rate range for calculating the charge.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatedAs" type="cis:RatePerUnitType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The rate at which this charge is rated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargedAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The charge amount including any discount or surcharge.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DiscountAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The discount or surcharge amount. If negative, it is a discount
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OptionApplyLevelEnumVal" type="cis:OptionsAppliedEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The option level applied to this charge.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OptionApplyLevelEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for optionApplyLevelEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ManualOverrideUnits" type="cis:NumberOfUnitsWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The manual override units for a charge.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ManualOverrideAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The manual override amount for a service.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The type of shipping point for the stop.
					If not specified and shippingLocationCode is specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for shippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the shipping point of the stop.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The equipment type code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatedAsEquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The code for Rated As Equipment Type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrePurchasedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the amounts are pre-purchased.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IsTaxFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the charge is a tax charge. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemContainerID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The container ID or container index. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalCurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The original currency. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalCurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for OriginalCurrencyCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalCurrencyExchangeRate" type="cis:ExchangeRateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The exchange rate for the original currency.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalCurrencyGrossAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The gross amount in the original currency (prior to applying surcharge or discount).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalCurrencyDiscountAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The surcharge/discount amount in original currency.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalCurrencyNetAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The net amount in original currency (after applying surcharge or discount).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated tariff ID. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByRatingUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user that created the charge detail (when charge detail was created based on a routing, rating and scheduling request). Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time the charge was created. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time the charge was updated. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The user that created the charge. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The user that last updated the charge. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalChargeCode" type="cis:ExternalChargeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The external charge code for this charge detail (applicable only when charge is retrieved from an external source which supports detailed charges).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NonOperationalFreightAR" type="cis:NonOperationalFreightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated Non Operational Freight (NOF) for A/R.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NonOperationalFreightAP" type="cis:NonOperationalFreightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated Non Operational Freight (NOF) for A/P.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ChargeOverrideType">
                <xsd:annotation>
                    <xsd:documentation>
			An override to a charge.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAPOptionEnumVal" type="cis:OptionsAppliedEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The option level applied to the charge for A/P..
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAPOptionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for applyAPOptionEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAPOptionOverrideEnumVal" type="cis:OverrideSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The source of the A/P charge override.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAPOptionOverrideEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for applyAPOptionOverrideEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAROptionEnumVal" type="cis:OptionsAppliedEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The option level applied to the charge for A/R.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAROptionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for applyAROptionEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAROptionOverrideEnumVal" type="cis:OverrideSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The source of the A/R charge override.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAROptionOverrideEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for applyAROptionOverrideEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ManualOverrideUnits" type="cis:NumberOfUnitsWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The number of override units for the charge.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ManualOverrideUnitsEnumVal" type="cis:OverrideSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The source of the manual units.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ManualOverrideUnitsEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for manualOverrideUnitsEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the override was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the override was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeCode" type="cis:ChargeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID code of the option or condition to override.
				Mandatory for a new ChargeOverride. Cannot be changed for an existing ChargeOverride.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created the override. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who last updated the override. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemStopID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the stop the ChargeOverride might belong to.
				Cannot be changed for an existing ChargeOverride.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the load the ChargeOverride might belong to.
					Used for Trip rating input only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the shipment leg the ChargeOverride might belong to. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated ID of the shipment the ChargeOverride might belong to. Read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeOverrideLocationEnumVal" type="cis:ChargeOverrideLocationEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Points to origin or destination for location level charge overrides on a shipment or shipment leg.
				Cannot be changed for an existing ChargeOverride.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeOverrideLocationEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for chargeOverrideLocationEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The type of shipping point. This field is read-only for shipments and shipment legs, used for loads and rate quotations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the shipping point. This field is read-only for shipments and shipment legs, used for loads and rate quotations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockSelectionConstraintAppliedLevelEnumVal" type="cis:DockSelectionConstraintAppliedLevelEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			    The dock selection constraint option applied level. 
			    This field is for shipments, shipment legs and loads when location is applicable. 
			    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockSelectionConstraintAppliedLevelEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			    Description for dockSelectionConstraintAppliedLevelEnumVal. Read-only. Available only through UI-oriented APIs.
			    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyDSCOptionOverrideEnumVal" type="cis:OverrideSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			    The source of the dock selection constraint override.
			    This field is for shipments, shipment legs and loads when location is applicable. 
			    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyDSCOptionOverrideEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			    Description for applyDSCOptionOverrideEnumVal. Read-only. Available only through UI-oriented APIs.
			    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="CityType">
                <xsd:annotation>
                    <xsd:documentation>
				Information about city.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CityStateKey" type="cis:CityStateKeyType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The postal data key.
					If it is not supplied in the input data, it will be generated.
					For user input, string length must not exceed 9 characters.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Country.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="State" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					State.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="City" type="cis:CityNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					City.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="CommodityExclusionType">
                <xsd:annotation>
                    <xsd:documentation>
                Define commodity exclusion between two commodities globally or at equipment type or equipment compartment level.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemExcludeCommodityID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated exclude commodity ID. Read only, except for commodity update.
                    Mandatory for commodity update of existing commodity exclusion.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The commodity code. Mandatory.
                    Read only (i.e. ignored) when processed as sub-entities firstCommodityExclusion of CommodityType.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExcludeCommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The commodity code of the exclude commodity. Mandatory.
                    Read only (i.e. ignored) when processed as update or delete sub-entities secondCommodityExclusion of CommodityType.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The equipment type ID. Optional. If exclusion is at the equipment type or equipment compartment level.
                    Read only when processed as sub-entities of equipment type or equipment compartment. 
                    Updatable when processed as sub-entities of commodity.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentCompartmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The equipment compartment identifier. Optional. If exclusion is at equipment compartment level.
                    Read only when processed as sub-entities of equipment type or equipment compartment. 
                    Updatable when processed as sub-entities of commodity.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the entry was created.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the entry was updated.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created the entry.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who updated the entry.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ContactType">
                <xsd:annotation>
                    <xsd:documentation>
				Contact information such as telephone and fax numbers.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="PrimaryTelephoneNumber" type="cis:TelephoneType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The phone number of the primary contact. Mandatory for a new Contact. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SecondaryTelephoneNumber" type="cis:TelephoneType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The phone number of the secondary contact.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FaxNumber" type="cis:FaxType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The fax number of the contact.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EmailAddress" type="cis:EmailType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The email address of the contact.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="URL" type="cis:URLType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The web URL of the contact.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ContactPersonType">
                <xsd:annotation>
                    <xsd:documentation>
				A contact person within an organization.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContactPersonRoleCode" type="cis:RoleDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The role of the contact.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContactPersonRoleCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for contactPersonRoleCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContactPersonName" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The name of the contact.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCode" type="cis:LanguageDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The language the contact uses.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for languageCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryTelephoneNumber" type="cis:TelephoneType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The phone number of the primary contact.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SecondaryTelephoneNumber" type="cis:TelephoneType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The phone number of the secondary contact.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FaxNumber" type="cis:FaxType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The fax number of the contact.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EmailAddress" type="cis:EmailType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The email address of the contact.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="URL" type="cis:URLType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The web URL of the contact.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryContactFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicate whether this contact is the primary contact.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Customer" type="cis:CustomerType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated customer.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Carrier" type="cis:CarrierType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffService" type="cis:TariffServiceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated tariff service.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Domicile" type="cis:DomicileType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated domiciles.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocation" type="cis:ShippingLocationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated shipping location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCarrierFreightAudit" type="cis:CustomerCarrierFreightAuditType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Associated carrier / customer cross-reference.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ContainerTypeType">
                <xsd:annotation>
                    <xsd:documentation>
				The type of container.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerTypeCode" type="cis:ContainerTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The container type code. This must be unique for a given entity.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerTypeGroupCode" type="cis:ComponentTypeGroupType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The container type group code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerTypeDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The container type description.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatingUnitEnumVal" type="cis:UnitEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				 How the container type should be rated. Acceptable values are UT_PIECES and UT_SKIDS. UT_SKIDS means that  the container type should be rated by pallets.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatingUnitEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for ratingUnitEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the object is active.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TareWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The tare weight for the container type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaxWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum weight for the container type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Length" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The length of the container type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Width" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The width of the container type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Height" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The height of the container type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Vol" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The volume of the container type. The default is length*width*height.  You may override that if required.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierPackageType" type="cis:CarrierPackageDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				 The carrier package type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierPackageTypeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for carrierPackageType. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode" type="cis:ExternalCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				 An external identifier for this container type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadConfigurationContainerType" type="cis:LoadConfigurationContainerDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				 The load configuration container type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadConfigurationContainerTypeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for LoadConfigurationContainerType. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time when the container type was created.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time when the container type was last updated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created this container type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who most recently updated this container type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				 A memo for the container type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerTypeGroup" type="cis:ContainerTypeGroupType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Container type group which container type belongs to.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ContainerTypeGroupType">
                <xsd:annotation>
                    <xsd:documentation>
					A group of container types.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerTypeGroupCode" type="cis:ComponentTypeGroupType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The container type group code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerTypeGroupDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The container type group description.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnitOfMeasure" type="cis:UnitOfMeasureType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The unit of measurement for the group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time when the container type group was created.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time when the container type group was last updated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created this container type group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who most recently updated this container type group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferencedByCustomerFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the container type group is referenced by at least one customer.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				 A memo for the container type group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreContainerTypesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of ContainerType (next) should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerType" type="cis:ContainerTypeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The container types included in the group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DestinationShippingLocationType">
                <xsd:annotation>
                    <xsd:documentation>
			The information about a Shipping Location used as a destination.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ShipToLocationTypeEnumVal" type="cis:ShipToPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The type of shipment destination point.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipToLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The code of the shipment destination point. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DomicileEquipmentType">
                <xsd:annotation>
                    <xsd:documentation>
				The equipment used at a domicile.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDomicileEquipmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated numeric Domicile Equipment ID. Read-only.
					Not applicable for adding a new Domicile Equipment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The domicile ID.
					Mandatory for a new DomicileEquipment unless it is included into a Domicile.
					Cannot be changed for an existing DomicileEquipment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The equipment type identifier. Mandatory for a new DomicileEquipment.
					Updatable. Cannot be cleared.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLoads" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The minimum number of loads.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumLoads" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum number of loads.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnforceConstraintsAsPercentageFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether minimumLoads and maximumLoads values are regarded as percentages rather than as absolute numbers.
				Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLoadPenalty" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The penalty paid for using fewer than the minimum number of loads.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumLoadPenalty" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The penalty paid for using more than the maximum number of loads.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumTravelDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum travel distance allowed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AvailableStartDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The earliest available start date and time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StartByDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time the equipment must start to be used.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReusableFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the equipment can be reused.
				The field is obsolete.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumDeadheadDistancePerLoad" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum unloaded distance between loads. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumDeadheadDistancePerLoadActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether any value exists for maximum unloaded distance between loads. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumReturnToOriginDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum return to origin distance. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumReturnToOriginDistanceActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether any value exists for maximum return to origin distance. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumInitialRepositioningDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum repositioning distance. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumInitialRepositioningDistanceActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether any value exists for maximum repositioning distance. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Domicile" type="cis:DomicileType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated domicile.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="EntitySelectionCriteriaType">
                <xsd:annotation>
                    <xsd:documentation>
				Record for Entity Selection Criteria
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemEntitySelectionCriteriaCode" type="cis:EntitySelectionCriteriaCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Unique ID of the entity selection criteria.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EntitySelectionCriteriaDescription" type="cis:EntitySelectionCriteriaDescriptionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Entity selection criteria description.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division ID of the Entity selection criteria.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StringIdentifierFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the identifier is string.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EntityTypeValue" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Entity type of the associated entity. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SqlCriteria" type="cis:SQLCriteriaType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					SQLCriteria.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FindEntitiesCriteria" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Criteria for find entities.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaxNumberOfEntities" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				the maximum number of entities that are supported by this criteria. If more are returned, none will be processed
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					the ID of the user who created this record
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				the ID of the user who last updated this record.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				the date and time this record was created
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				the date and time this record was last updated.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="EquipmentAvailabilityType">
                <xsd:annotation>
                    <xsd:documentation>
				Equipment availability controls.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ConstraintsActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether equipment availability constraints are active.
                                Mandatory for a new Equipment Availability.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLoads" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Minimum number of loads.
				Mandatory for a new Equipment Availability.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumLoads" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Maximum number of loads.
				Mandatory for a new Equipment Availability.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLoadPenaltyAmount" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The minimum load penalty amount.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumLoadPenaltyAmount" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum load penalty amount.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnforceConstraintsAsPercentageFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether minimumLoads and maximumLoads values are regarded as percentages rather than as absolute numbers.
				Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="EquipmentAvailabilityDateRangeType">
                <xsd:annotation>
                    <xsd:documentation>
				Equipment availability constraints for a date range.
                At least one element should be present in the structure for input.  
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Internal ID. Applicable only for UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The carrier ID. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTariffNumber" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated tariff ID. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The service ID. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StartDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The start date and time for the date range of equipment availability constraints.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EndDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The end date and time for the date range of equipment availability constraints.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ConstraintsActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether equipment availability constraints are active.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLoads" type="cis:NumberofLoadsType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Minimum number of loads or trips.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumLoads" type="cis:NumberofLoadsType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Maximum number of loads.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLoadPenaltyAmount" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The violation penalty amount for minimum loads or trips.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumLoadPenaltyAmount" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The violation penalty amount for maximum loads or trips.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnforceConstraintsAsPercentageFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Indicates whether MinimumLoads and MaximumLoads values are regarded as percentages rather than as absolute numbers.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyFEUFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether forty-feet equivalent unit factor should be applied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CEAGroupingTypeCode" type="cis:CEAGroupingDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The CEA Grouping Type.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CEAGroupingTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for CEAGroupingTypeCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BackupResourceFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether equipment availability constraints are marked for a backup resource.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResourceProjectTypeCode" type="cis:ResourceProjectIDDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Resource Project ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResourceProjectTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ResourceProjectTypeCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created this equipment availability constraints date range. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when this equipment availability constraints date range was created. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who most recently updated this equipment availability constraints date range. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when this equipment availability constraints date range was most recently updated. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ErrorType">
                <xsd:annotation>
                    <xsd:documentation>
				An error code.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Item" type="xsd:integer" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The item of the error.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Severity" type="cis:SeverityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The severity of the error.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Code" type="xsd:integer" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The error code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserMessage" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			User error message.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemMessage" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			The system error message.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="EventControlStatusReasonCodeType">
                <xsd:annotation>
                    <xsd:documentation>
				The detail information of the event reason code for an event control and status combination.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemEventControlStatusReasonCodeID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The system ID of this event reason code for the event control and status combination. Read-only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemEventControlStatusID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system ID of this event control and status combination. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventControl" type="cis:EventControlEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The enumerated event type. Mandatory. Cannot be changed for an existing entry.
                                If entries for multiple event controls from the same Event Group are included for the same API operation,
                                results might be unexpected due to background actions performed for the Event Group.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventControlStatus" type="cis:EventControlStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                    The enumerated event control status type. Mandatory. Cannot be changed for an existing entry.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventReasonCode" type="cis:EventCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                    The event reason code for this event control and status combination. Mandatory. Cannot be changed for an existing entry.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnableFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                    Indicates whether this event reason code is enabled. Read-only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserReasonCodeAllowedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                    Indicates whether user event reason code for this event status combination is allowed. Read-only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EmployeeUsage" type="cis:ReasonCodeUsageEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The enumerated event reason code usage type for employee. Mandatory for Create.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierUsage" type="cis:ReasonCodeUsageEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                    The enumerated event reason code usage type for carrier. Mandatory for Create.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerUsage" type="cis:ReasonCodeUsageEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                    The enumerated event reason code usage type for customer. Mandatory for Create.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncludeInPercentageConstraintsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether tendered resources should be counted for percentage based resource constraints after tender is canceled or rejected.
                    Applicable only to event types for Tender Cancel and Tender reject.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the entry was created.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the entry was updated.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created the entry.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who updated the entry.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ParentEventControlStatus" type="cis:EventControlStatusType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Parent event control status.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="EventInformationType">
                <xsd:annotation>
                    <xsd:documentation>
			Information about a change in the status of an load or shipment.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="EventCode" type="cis:EventCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The event code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MovementDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time of the load or shipment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventText" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Free form text in Events describing reason codes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ExternalCostType">
                <xsd:annotation>
                    <xsd:documentation>
				External cost (benchmark rate) for a ratable entity.
				The structure is read-only.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemExternalCostID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated External Cost ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated ID of the load associated with the external cost.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated ID of the trip associated with the external cost.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCostAmount" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The external cost amount.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCostTypeEnumVal" type="cis:ExternalCostEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The external cost type (market type).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCostTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ExternalCostTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The currency of the external cost.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for CurrencyCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCostDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the external cost was retrieved.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ExternalMappingType">
                <xsd:annotation>
                    <xsd:documentation>
				Defines external mappings to be used when integrating with other systems.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemExternalMappingID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system assigned ID for the external mapping.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalSourceEnumVal" type="cis:ExternalSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The external source for which this mapping is defined.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalSourceEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for externalSourceEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EntityTypeEnumVal" type="cis:EntityTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The entity type of the entity for which this mapping applies.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EntityTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for entityTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EntityColumn" type="cis:EntityColumnType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The column name from the source entity to be used for mapping.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EntityID" type="cis:EntityIDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The identifier of the entity for which this mapping applies.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SupplementalEntityID" type="cis:EntityIDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The supplemental identifier of the entity, used for domain table/value mappings.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FieldName" type="cis:FieldNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The external field for which this mapping applies.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FixedValue" type="cis:FixedValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The fixed value of this mapping.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the load.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who last updated this record.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time this record was last updated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time this record was created.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="GeographicAreaType">
                <xsd:annotation>
                    <xsd:documentation>
			The geographic area covered by a zone.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemGeographicAreaID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					System-generated Geographic Area ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The zone ID. Cannot be blank.
					Mandatory for a new Geographic Area unless it is a part of input data for a Zone.
					Cannot be modified for an existing Geographic Area.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FromZipCode" type="cis:PostalCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The lower limit of the zip/postal code range of the geographic area.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ToZipCode" type="cis:PostalCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The upper limit of the zip/postal code range of the geographic area.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RadialDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The size of the radius around an origin geographic area.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CityVsZipPrecisionCodeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the system will choose lanes based on the city over lanes based on the zip/postal code, when considering lanes for routing and rating.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="City" type="cis:CityNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The name of the city. *ALL means multiple cities, as defined by the other fields.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="State" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The state or province ID of the geographic area.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GeographicAreaPrecisionEnumVal" type="cis:GeographicAreaPrecisionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The precision of the geographic area.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GeographicAreaPrecisionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for geographicAreaPrecisionEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemUnitOfMeasureEnumVal" type="cis:SystemUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The measurement system for the geographic area.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for systemUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceUnitOfMeasureEnumVal" type="cis:DistanceUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The unit of measure of the distances for the geographic area.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for distanceUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A shipping location type (load-at, consignee, hub or distribution center).
					If shipping location code is unique for all shipping location types, this field can be optional
					even if shipping location code is specified. 
					Ignore, if shipping location is not specified.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for shippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A shipping location code. When specified, the Geo Area is associated with
					the shipping location. Either City, Zip/Postal Code and Distance or Shipping Location
					can be specified for a Geo Area, but not both.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Zone" type="cis:ZoneType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated zone.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The country ID for the zone.  Can not be blank. Mandatory and updatable..
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="GetBestZoneDataType">
                <xsd:annotation>
                    <xsd:documentation>
			Zone group and address info for retrieving the best zone.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ZoneGroupEnumVal" type="cis:ZoneGroupEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The zone group of the best zone. Mandatory
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="City" type="cis:CityNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The city name. Mandatory, when shippingLocationCode is not provided.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="State" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The state or province. Mandatory, when shippingLocationCode is not provided.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The country. Mandatory, when shippingLocationCode is not provided.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PostalCode" type="cis:PostalCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The zip or postal code.
				Postal or zip code is optional and will not be validated.
                                It is assumed that the address info is coming from a valid source.
                                Inconsistent postal or zip code may give unexpected result.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division ID. Optional.
					Currently not in use, reserved for future development.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location code. Allowed only when zoneGroupEnumVal is ZG_USER_DEFINED.
					Either city, state, countryCode and postalCode or shippingLocationCode and shippingLocationTypeEnumVal 
					should be provided, for getting the best zone, but not both.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location type. Optional, Ignore when shippingLocationCode is not provided.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="HolidayType">
                <xsd:annotation>
                    <xsd:documentation>
			An exception to the normal business hours of operation.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="HolidayDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date of the holiday. Mandatory for a new Holiday. Cannot be changed for an existing Holiday.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HolidayFromTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The start of the first time range of the holiday. Mandatory for a new Holiday. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HolidayToTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The end of the first time range of the holiday. Mandatory for a new Holiday. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HolidayFromTime2" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The start of the second time range of the holiday. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HolidayToTime2" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The end of the second time range of the holiday. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HolidayFromTime3" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The start of the third time range of the holiday. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HolidayToTime3" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The end of the third time range of the holiday. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HolidayFromTime4" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The start of the fourth time range of the holiday. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HolidayToTime4" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The end of the fourth time range of the holiday. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="IdentifyApplicableReferenceNumberQualifierType">
                <xsd:annotation>
                    <xsd:documentation>
			The input data for retrieving applicable reference number qualifiers.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ReferenceNumberEntityTypeEnumVal" type="cis:ReferenceNumberEntityTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Entity type of the reference number qualifiers. Support carrier and customer only. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberEntityID" type="cis:ReferenceNumberEntityIDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The ID code of a specific entity depends on referenceNumberEntityType.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberLevelEnumVal" type="cis:ReferenceNumberCategoryEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The reference number level (category). Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The division code of this reference number qualifier.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="JobDefinitionType">
                <xsd:annotation>
                    <xsd:documentation>
				Record for Job Definition
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemJobCode" type="cis:JobCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The name for this job definition.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="JobDescription" type="cis:JobDescriptionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The description for this job definition.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SchedulingTypeEnumVal" type="cis:SchedulingTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Specifies how queue entries for this job definition should be created - On Demand / Scheduled.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SchedulingTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for SchedulingTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="JobTypeEnumVal" type="cis:JobTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The type of this job definition.One of the support job types from the job type domain table.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="JobTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for JobTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division for this job definition.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Parameter1" type="cis:ParameterType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The first job parameter.Job parameters are interpreted differently based upon the job type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Parameter2" type="cis:ParameterType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The second job parameter. Job parameters are interpreted differently based upon the job type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Parameter3" type="cis:ParameterType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The third job parameter. Job parameters are interpreted differently based upon the job type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Parameter4" type="cis:ParameterType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The fourth job parameter. Job parameters are interpreted differently based upon the job type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Parameter5" type="cis:ParameterType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The fifth job parameter. Job parameters are interpreted differently based upon the job type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created this record
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who last updated this record.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time this record was created
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time this record was last updated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TemplateFileName" type="cis:TemplateFileNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
						Specifies a template file path and name. Used by job types which require a template.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OutputFileName" type="cis:OutputFileNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
						Specifies the output file path and name. Can include %i which will be replaced with the entity name for each entity processed.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SchedulingDetailID" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Refers to the scheduling details for the job definition.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Priority" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The priority of instances of this job definition, relative to other job instances.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Whether this job definition is active. Inactive job definitions will not be scheduled.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NextJobOnSuccess" type="cis:JobCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					If specified, identifies a job definition to be scheduled upon successful completion of an instance of this job.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NextJobOnFailure" type="cis:JobCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					If specified, identifies a job definition to be scheduled upon failure of an instance of this job.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertWatchGroupOnSuccess" type="cis:AlertWatchGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					If specified, identifies an alert watch group to be notified upon successful completion of an instance of this job.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertWatchGroupOnFailure" type="cis:AlertWatchGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					If specified, identifies an alert watch group to be notified upon failure of an instance of this job.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SchedulingDetail" type="cis:SchedulingDetailType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Scheduling Detail for the Job Definition.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="JobHistoryElementType">
                <xsd:annotation>
                    <xsd:documentation>
				Record for Job History Element.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemJobHistoryElementID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system assigned ID for the job history element.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="JobCode" type="cis:VarChar160" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The name of the job definition this queue entry is based on.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="JobTypeEnumVal" type="cis:JobTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The type of the job definition this element was processed by.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="JobTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for JobTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="JobServerInstanceID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			        The server id of the job server instance this element was processed by.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division for this job history element.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EntityID" type="cis:VarChar160" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The string or integer ID of the entity this job history element refers to.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StartedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time processing of this entity started.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CompletedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time processing of this entity completed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="QueueStatusEnumVal" type="cis:QueueStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The status of this history element; proc, failed, completed, completed with errors.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="QueueStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for queueStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ErrorMessage" type="cis:ErrorMessageType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The error message during processing this entity, if any.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemJobQueueID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					ID of the job queue entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="JobResult" type="cis:JobResultType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					the string storing the result after processing this entity.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="JobQueueType">
                <xsd:annotation>
                    <xsd:documentation>
				Record for Job Queue.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemJobQueueID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system assigned ID for the job queue entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StartedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time processing of this queue entry started; null if it has not been started yet.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time this record was created.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="JobCode" type="cis:JobCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The name of the job definition this queue entry is based on.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="JobTypeEnumVal" type="cis:JobTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The type of the job definition this queue entry is based on.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="JobTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for JobTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="JobServerInstanceID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The server id of the job server instance this queue entry was processed by, if any.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division ID for this job queue entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created this record.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastUpdatedByUserID" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who last updated this record.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastUpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time this record was last updated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TemplateFileName" type="cis:JobQueueFileNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					specifies a template file path and name; used by job types which require a template.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InputFileName" type="cis:JobQueueFileNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					specifies the input file path and name.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OutputFileName" type="cis:JobQueueFileNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					specifies the output file path and name; can include %i which will be replaced with the entity name for each entity processed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SchedulingDetailID" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The scheduling details of the job definition this queue entry is based on.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Priority" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The priority of this queue entry, relative to other queue entries.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ScheduledDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time this queue entry is scheduled to start.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CompletedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time processing of this queue entry completed; null if it has not been completed yet.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="QueueStatusEnumVal" type="cis:QueueStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The status of this queue entry; wait, proc, failed, completed, canceled, hold, completed with errors, abort. This is a read-only file.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="QueueStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for queueStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalNumberOfEntities" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of shipment legs with a committed carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfProcessedEntities" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of entities which have been processed by this queue entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfFailedEntities" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of entities which failed while processing by this queue entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MessageLogId" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Message Log details by this queue entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoggedMessage" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The logged message associated with the Job Queue entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedJobInstance" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Job queue id of the next job instance initiated by this job instance.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByJobInstance" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Job queue id of the previous job instance which initiated this job instance.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InputOverrideData" type="cis:AdditionalDataType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    id referencing additional data table which stores input entities for the job instance.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OutputOverrideData" type="cis:AdditionalDataType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    id referencing additional data table which stores successful and failed entities from the processing of this job instance.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InitiatedbyUIFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    indicates whether this job instance was initiated from the UI (Web UI or Transportation Smartbench).
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="JobResult" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                   the result (text) of this job instance.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="JobSelectionCriteriaType">
                <xsd:annotation>
                    <xsd:documentation>
				Record for Job Selection Criteria.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemJobSelectionCriteriaID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID for this job selection criteria.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemJobCode" type="cis:JobCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The job with which this selection criteria is associated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemEntitySelectionCriteriaCode" type="cis:EntitySelectionCriteriaCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The entity selection criteria definition.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="MemoType">
                <xsd:annotation>
                    <xsd:documentation>
				Additional information about an entity or item.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrintableMemo" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				This string can be on printed documentation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NonPrintableMemo" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				This string is for viewing only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="NoteType">
                <xsd:annotation>
                    <xsd:documentation>
                The user note.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Internal ID. Applicable only for UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemNoteID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    System-generated numeric ID of the note. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Subject" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The note subject.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Description" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The note description. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NoteTypeCode" type="cis:NoteTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The note type.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NoteTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for NoteTypeCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ImportanceEnumVal" type="cis:QueuePriorityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Importance level.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ImportanceEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ImportanceEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InternalOnlyFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the note is internal only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NoteEntityID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Numeric Entity ID of the associated entity. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NoteEntityEnumVal" type="cis:NoteEntityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Entity type of the associated entity. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NoteEntityEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for NoteEntityEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NoteEntityCode" type="cis:NoteEntityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The string Entity ID of the associated entity.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserGroupTypeEnumVal" type="cis:UserGroupTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    User group type of the associated entity. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserGroupTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for userGroupTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserGroupEntityCode" type="cis:UserGroupEntityIDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user group entity. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the note was created.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the note was updated.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created the note.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who updated the note.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TenderRequest" type="cis:TenderRequestType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Associated tender request.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Shipment" type="cis:ShipmentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Associated shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Load" type="cis:LoadType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Associated load.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SkeletonRoute" type="cis:SkeletonRouteType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Associated skeleton route.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Driver" type="cis:DriverType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Associated asset.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Asset" type="cis:AssetType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Associated asset.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBill" type="cis:FreightBillType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Associated Freight Bill.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="NoteMaintainDataType">
                <xsd:annotation>
                    <xsd:documentation>
                The user note data for input.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="NoteActionEnumVal" type="cis:ReferenceNumberActionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maintenance action type - add, update or delete. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user performing the operation. Optional for Create, ignored otherwise.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemNoteID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    System-generated numeric ID of the note. Ignored for Create, mandatory otherwise.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NoteEntityKey" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the entity which the note is associated with. Mandatory for Create, ignored otherwise.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NoteEntityEnumVal" type="cis:NoteEntityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Entity type of the associated entity. Mandatory for Create, ignored otherwise.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Subject" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The note subject.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Description" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The note description. Mandatory for Create. Cannot be blank.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NoteTypeCode" type="cis:NoteTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The note type.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ImportanceEnumVal" type="cis:QueuePriorityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Importance level.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InternalOnlyFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the note is internal only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="NamedResultType">
                <xsd:annotation>
                    <xsd:documentation>
				A result of an operation.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				An identifier.
				In LoadSrvc::SetAllToPlanned, this field contains the plan ID.	
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Description" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description or qualifier.
				In LoadSrvc::SetAllToPlanned, this field contains the load ID.	
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CompletedSuccessfullyFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Whether the operation has completed successfully.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="OriginShippingLocationType">
                <xsd:annotation>
                    <xsd:documentation>
			The information about a Shipping Location used as an origin.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ShipFromLocationTypeEnumVal" type="cis:ShipFromPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The type of shipment origin point.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipFromLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The code of the shipment origin point. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ParameterSetType">
                <xsd:annotation>
                    <xsd:documentation>
			The parameter set for server configuration.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SetName" type="cis:ParameterSetNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID or name of the parameter set. Mandatory for create, update and delete.
					SetName can only consist of charracters of "A" to "Z", "0" to "9" or "_".
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SetTypeName" type="cis:ParameterSetNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The name of server type available. Mandatory for create, ignore for update and delete.
					System defined value and the primary key of PARM_SET_TYP_T.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Version" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The version number of this parameter set. Read only.
				Version number increased by one each time the parameter set is updated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ParameterValue" type="cis:ParameterValueType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The parameter values for this parameter set.Create and update only. Ignore for delete.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ParameterValueType">
                <xsd:annotation>
                    <xsd:documentation>
			The parameter values of a parameter set instance for server configuration.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
					The character ^ is used as a separator for the compound key.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SetName" type="cis:ParameterSetNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID or name of the parameter set.
					SetName can only consist of charracters of "A" to "Z", "0" to "9" or "_".
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ParameterName" type="cis:ParameterSetNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The parameter name within a parameter set. 
					System defined parameter name of specific server type predefined in PARM_VAL_TYP_T.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ParameterValueString" type="cis:ParameterValueStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The value of this particular parameter.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DataTypeEnumVal" type="cis:ParameterDataTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The data type of the parameter values for this parameter set. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DataTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for DataTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DynamicFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicate whether the parameter will be read in dynamically by the server. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IsDefaultFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicate whether the parameter value is the same as the default value for this parameter. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="PayableCarrierOverrideType">
                <xsd:annotation>
                    <xsd:documentation>
				The information about a Payable Carrier Override.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffChargeCode" type="cis:ChargeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The tariff charge code. Cannot be changed for an existing Payable Carrier Override.
				                        Mandatory for a new Payable Carrier Override.
				                        Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the tariff charge. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PayableCarrierEnumVal" type="cis:PayableCarrierEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The payable carrier type.  Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PayableCarrierEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for payableCarrierEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The carrier code. Can be updated. Relevant only if payableCarrierEnumVal corresponds to Other Carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created this domicile. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time when the domicile was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who most recently updated this domicile. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time when the domicile was last updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ProofOfDeliveryType">
                <xsd:annotation>
                    <xsd:documentation>
				The information about a Proof of Delivery.  None of this information can be updated.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PODDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of this POD event. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PODDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The delivery date and time. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PODTotalWeight" type="cis:PODTotalWeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total weight delivered. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PODTotalPieces" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total number of pieces delivered. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PODTotalSkids" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total number of skids delivered. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PODSignedByName" type="cis:EmployeeNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The name or ID code of the employee signing for the delivery. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PODUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The user code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventReasonCode" type="cis:SECCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The reason code for the POD event. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventReasonDesc" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The event reason description for the status transition. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				An external identifying code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PODFlexibleQuantity1" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total number of Flexible Quantity 1 delivered. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PODFlexibleQuantity2" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total number of Flexible Quantity 2 delivered. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PODFlexibleQuantity3" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total number of Flexible Quantity 3 delivered. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PODFlexibleQuantity4" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total number of Flexible Quantity 4 delivered. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PODFlexibleQuantity5" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total number of Flexible Quantity 5 delivered. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ReferenceNumberType">
                <xsd:annotation>
                    <xsd:documentation>
				The number that an external entity such as a customer or carrier supplies to help identify its order. Mandatory. Not updatable.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemReferenceNumberID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The system generated ID for this reference number. Read only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberTypeCode" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A domain table value indicating the reference number qualifier type for the reference number. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for referenceNumberTypeCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The value of the reference number or code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Trip" type="cis:TripType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated trip.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Load" type="cis:LoadType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated load.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Shipment" type="cis:ShipmentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated shipment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentLeg" type="cis:ShipmentLegType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated shipment leg.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentLegContainer" type="cis:ShipmentLegContainerType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated shipment leg container.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentItem" type="cis:ShipmentItemType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated shipment item.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NonOperationalFreight" type="cis:NonOperationalFreightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated Non Operational Freight (NOF).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NonOperationalStop" type="cis:NonOperationalStopType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated Non Operational Freight (NOF) stop.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APVoucher" type="cis:APVoucherType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Associated A/P voucher.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ARVoucher" type="cis:ARVoucherType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Associated A/R voucher.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBill" type="cis:FreightBillType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated freight bill.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Container" type="cis:ContainerType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated container.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockCommitment" type="cis:DockCommitmentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Associated dock commitment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Stop" type="cis:StopType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Associated dock commitment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberQualifier" type="cis:ReferenceNumberQualifierType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Associated Reference Number Qualifier.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time that the Reference Number was created. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time that the Reference Number was updated. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ReferenceNumberCategoryType">
                <xsd:annotation>
                    <xsd:documentation>
				The reference number category.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
					The character ^ is used as a separator for the compound key.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemReferenceNumberQualifierID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated ID of the reference number qualifier.
					Ignored for input when the reference number category is included into a reference number qualifier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberCategoryEnumVal" type="cis:ReferenceNumberCategoryEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The reference number category type.
					Mandatory for input.
					Cannot be changed for an existing reference number category.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberCategoryEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ReferenceNumberCategoryEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MandatoryFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the reference number for this category is mandatory or not.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberRequiredByStatusEnumVal" type="cis:ReferenceNumberRequiredByStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The status of a load, if reached, the reference number is required.
					This applies only to reference number type PRO_ID reference number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberRequiredByStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ReferenceNumberRequiredByStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberQualifier" type="cis:ReferenceNumberQualifierType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Associated Reference Number Qualifier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ReferenceNumberQualifierType">
                <xsd:annotation>
                    <xsd:documentation>
				The reference number qualifier.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemReferenceNumberQualifierID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated ID of the reference number qualifier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberTypeCode" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A domain table value indicating the reference number type for the reference number.
					Mandatory for Create. Cannot be changed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EntityCode" type="cis:EntityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The entity code which this reference number qualifier is associated with.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ReferenceNumberType. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberFirstEntityTypeEnumVal" type="cis:ReferenceNumberFirstEntityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The first entity type of the reference number.
					Mandatory for Create. Cannot be changed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberFirstEntityTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ReferenceNumberFirstEntityTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberSecondEntityTypeEnumVal" type="cis:ReferenceNumberSecondEntityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The second entity type of the reference number.
					Only one type, Tariff, is available currently.
					This field is read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberSecondEntityTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ReferenceNumberSecondEntityTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberThirdEntityTypeEnumVal" type="cis:ReferenceNumberThirdEntityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The third entity type of the reference number.
					Only one type, Tariff Service, is available currently.
					This field is read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberThirdEntityTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ReferenceNumberThirdEntityTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the reference number qualifier is active or not.
					This field is read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemProvidedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the reference number qualifier is system provided or not.
					This field is read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CopyToAPFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the reference numbers will be copied from AR to AP.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The carrier code which this reference number qualifier is associated with.
					Ignored if the reference number qualifier cannot be associated with a carrier.
					Cannot be changed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The customer code which this reference number qualifier is associated with.
					Ignored if the reference number qualifier cannot be associated with a customer.
					Cannot be changed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTariffID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated tariff ID which this reference number qualifier is associated with.
					Allowed only for container tracking numbers with carrier defined.
					Cannot be changed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The service code which this reference number qualifier is associated with.
					Allowed only for container tracking numbers with carrier defined.
					Cannot be changed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberFormatEnumVal" type="cis:ReferenceNumberFormatEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The generation source for reference numbers.
					Mandatory for Create.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberFormatEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ReferenceNumberFormatEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoGenerateFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the reference numbers will be automatically generated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Length" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The length of the reference number.
					This field is read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberLiteral" type="cis:ReferenceNumberLiteralType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The literal string used to define the format of reference numbers.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnforceUniqueFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the reference number must be unique or not.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnforceUniqueWithinEntityFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the reference number must be unique only within the specific entity.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StartFreePosition" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The starting position of the free format characters in the literal for a fixed length reference number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EndFreePosition" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ending position of the free format characters in the literal for a fixed length reference number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CheckDigitTypeEnumVal" type="cis:CheckDigitTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The type of check digit to be generated for a reference number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CheckDigitTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for CheckDigitTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StartSequencePosition" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The starting position of the sequence to be inserted within the literal for reference numbers generated internally.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DuplicateEnabledFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the reference number will be duplicated when a shipment is duplicated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EmployeeAuthorizationEnumVal" type="cis:UserGroupFunctionAuthorizationEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The employee user group authorization level for accessing the reference number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EmployeeAuthorizationEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for EmployeeAuthorizationEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierAuthorizationEnumVal" type="cis:UserGroupFunctionAuthorizationEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The carrier user group authorization level for accessing the reference number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierAuthorizationEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for CarrierAuthorizationEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerAuthorizationEnumVal" type="cis:UserGroupFunctionAuthorizationEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The customer user group authorization level for accessing the reference number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerAuthorizationEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for CustomerAuthorizationEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SequenceCode" type="cis:SequenceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The sequence code of the sequence which will be used to generate the reference numbers internally.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RollOverFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the reference number can be rolled over when it reaches the end of the range.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumElapsedDays" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum number of elapsed days before reference number can be rolled over.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemOriginalReferenceNumberQualifierID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID code of the original reference number qualifier if the qualifier is a mirrored one.
					This field is read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemMirroredReferenceNumberQualifierID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID code of the mirrored reference number qualifier if the qualifier has been rolled over.
					This field is read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ArchiveDeletedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the deleted reference number will be archived.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division code of this reference number qualifier.
					Cannot be changed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberClassification" type="cis:ReferenceNumberClassificationDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The reference number classification of the reference number qualifier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberClassificationDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for referenceNumberClassification. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnorePrintedOnReportNamesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of PrintedOnReportName should be ignored.
					Mandatory for Create and Update if entries for PrintedOnReportName are present.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrintedOnReportName" type="cis:ReportNameType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The report name which the reference number may be printed on.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreReferenceNumberCategoriesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of ReferenceNumberCategory should be ignored.
					Mandatory for Create.
					Mandatory for Update if entries for ReferenceNumberCategory are present.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberCategory" type="cis:ReferenceNumberCategoryType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The reference number categories (levels) associated with this qualifier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ReferenceNumberUpdateDataType">
                <xsd:annotation>
                    <xsd:documentation>
				The data for maintaining reference numbers.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ReferenceNumberActionEnumVal" type="cis:ReferenceNumberActionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maintenance action type - add, update or delete. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberCategoryEnumVal" type="cis:ReferenceNumberCategoryEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The reference number category - the type of entity type which the reference numbers are associated with. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberEntityIdShipmentNumberFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					When true, indicates that the ReferenceNumberEntityKey contains Shipment Number when ReferenceNumberCategoryEnumVal is RNC_SHPM. Ignored otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberEntityKey" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the entity which the reference numbers are associated with. Mandatory for Create. Ignored otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberTypeCode" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A domain table value indicating the reference number qualifier type for the reference number. Mandatory for Create. Ignored otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The value of the reference number or code. Mandatory for Create and Update. Ignored otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemReferenceNumberID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system generated reference number ID. Mandatory for Update and Delete. Ignored for Create.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="SECInformationType">
                <xsd:annotation>
                    <xsd:documentation>
				The reason code (service exception code) for an event. 
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SECCode" type="cis:SECCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The service event code. Mandatory. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MovementDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time of the event. Mandatory. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="City" type="cis:CityNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The city of the event. Optional. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="State" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The state or province of the event. Optional. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The country of the event. Optional. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Appointment1FromDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The start date and time of the appointment at the origin.  Optional. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Appointment1ToDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The end date and time of the first appointment at the origin. Optional. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OverrideHoursForAppointment1Flag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the appointment at the origin overrides the location's hours of operation. Optional. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Appointment2FromDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The start date and time of the appointment at the destination. Optional. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Appointment2ToDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The end date and time of the appointment at the destination. Optional. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OverrideHoursForAppointment2Flag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the appointment at the destination overrides the location's hours of operation. Optional. Not updatable. 
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EstimatedFirstDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The estimated first date and time. Optional. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EstimatedSecondDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The estimated second date and time. Optional. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier code. Optional. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TenderAcceptedBy" type="cis:EmployeeNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The name of the employee accepting the tender. Optional. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorNumber" type="cis:TrailerNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The tractor number. Optional. Updatable only for load/stop confirmation.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrailerNumber" type="cis:TrailerNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The trailer number.Optional. Updatable only for load/stop confirmation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DriverCode" type="cis:DriverIdType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The asset code or name. Optional. Updatable only for load/stop confirmation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SealNumber" type="cis:SealNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The seal number.  Optional. Updatable only for load/stop confirmation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InGateDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					In-gate date and time. Applicable only for load/stop confirmation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InGateDateTimeActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether InGateDateTime is active. Applicable only for load/stop confirmation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TeamDriverFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether driver is a team driver. Optional. Updatable only for load/stop confirmation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SuspendedFunctionEnumVal" type="cis:SuspendFunctionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The suspended status. Optional. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadScheduleCompletedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether load scheduling is completed. Optional. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Latitude" type="cis:LatitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The latitude value. Optional. Not modifiable. Used only for processLoadUpdateProgress operation.
                    Will be ignored if longitude is not supplied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Longitude" type="cis:LongitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The longitude value. Optional. Not modifiable. Used only for processLoadUpdateProgress operation.
                    Will be ignored if latitude is not supplied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The current shipping location code. Optional. Not modifiable. Used only for processLoadUpdateProgress operation.
                    All of shippingLocationCode and shippingLocationTypeEnumVal,
                    or Latitude and longitude pair, 
                    or country and state and city are optional. But only one of them should be provided if applicable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The current shipping location type (load-at, consignee, hub or distribution center). 
                    Optional. Not modifiable. Used only for processLoadUpdateProgress operation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventText" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Free form text in Events describing reason codes.Optional. Not modifiable. Used only for processLoadUpdateProgress operation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="SchedulingDetailType">
                <xsd:annotation>
                    <xsd:documentation>
				Record for Scheduling Detail.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SchedulingDetailID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID for this scheduling detail.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RecurenceTypeEnumVal" type="cis:RecurenceTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The recurrence type for this scheduling detail,Daily, Monthly, Fixed Interval.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RecurenceTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for RecurenceTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FixedIntervalSourceTypeEnumVal" type="cis:FixedIntervalSourceTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					For fixed interval schedules, determines which date is used to calculate the next instance scheduled date, Scheduled date, Started date, Completed date.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FixedIntervalSourceTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for FixedIntervalSourceTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EffectiveDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The effective date for this scheduling detail.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExpirationDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The expiration date for this scheduling detail.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StartTimeOfTheDay" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The time of day to start the scheduled activity.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EndTimeOfTheDay" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The time of day to stop the scheduled activity. Active for Fixed Interval only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DayOfMonth" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Inactive.Specifies the day of month that a monthly recurrence should be scheduled. Interval to be used instead.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Interval" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Specifies the interval between scheduled activities. For Daily, interval is in number of days. For Monthly, interval specifies the day of month (if greater than 28, indicates last day of month).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessDaysID" type="cis:BusinessDaysCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Specifies the business days that the scheduling detail is active.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ShippingInformationType">
                <xsd:annotation>
                    <xsd:documentation>
					Information about a shipment.

					(*) Units of measurements may be loaded using the following rules.
					If parent is ShipmentType then from the shipment,
					currency code must be InputCurrencyCode in the case of parent shipment.
					If parent is RateQuotationType then from the rate quotation.
					If parent is ContainerType then from the shipment to which the container belongs to.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ScaledWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The scaled weight of the shipment.  Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Volume" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The volume of the shipment. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OrderValue" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total order value of the shipment. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeclaredValue" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total declared value of the shipment. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NominalWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The nominal weight of the shipment.
					Read-only unless used for processPlanShipments operation where it is mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TareWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The tare weight of the shipment.
					Read-only unless used for processPlanShipments where it is optional.
					Summarized mode is never used for input values.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Pieces" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total number of pieces in the shipment. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Skids" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total number of skids in the shipment. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LadenLength" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total laden length of the shipment. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FlexibleQuantity1" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total number of Flexible Quantity 1 in the shipment. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FlexibleQuantity2" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total number of Flexible Quantity 2 in the shipment. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FlexibleQuantity3" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total number of Flexible Quantity 3 in the shipment. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FlexibleQuantity4" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total number of Flexible Quantity 4 in the shipment. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FlexibleQuantity5" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total number of Flexible Quantity 5 in the shipment. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ShippingLocationZoneType">
                <xsd:annotation>
                    <xsd:documentation>
			Zone information associated with a shipping location.

			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The zone ID.  Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ZoneDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the zone.  Mandatory during create. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShortDescription" type="cis:ShortDescriptionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A short description of the zone. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="StateProvinceType">
                <xsd:annotation>
                    <xsd:documentation>
				Information about state/province.
				After states/provinces have been maintained,
				the web pages must be regenerated before these changes will be reflected
				in the combo boxes listing available states/provinces.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
					The character ^ is used as a separator for the compound key.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StateCode" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The state/province ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The country ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StateName" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The name of the state/province. 
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemProvidedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the state/province is maintained by the system.
					This field is read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="StopEventType">
                <xsd:annotation>
                    <xsd:documentation>
				The information about a stop event.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="EventCode" type="cis:EventCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The event code. Mandatory. Not modifiable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MovementDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The event date and time. Mandatory. Not modifiable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EstimatedDateTimeAtStop" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The estimated delivery date and time (ETA). Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="City" type="cis:CityNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The city of the event. Optional. Not modifiable. Used only for processSetStopETA operation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="State" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The state or province of the event. Optional. Not modifiable. Used only for processSetStopETA operation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The country of the event. Optional. Not modifiable. Used only for processSetStopETA operation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Latitude" type="cis:LatitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The latitude value. Optional. Not modifiable. Used only for processSetStopETA operation.
                    Will be ignored if longitude is not supplied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Longitude" type="cis:LongitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The longitude value. Optional. Not modifiable. Used only for processSetStopETA operation.
                    Will be ignored if latitude is not supplied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The current shipping location code. Optional. Not modifiable. Used only for processSetStopETA operation.
                    All of shippingLocationCode and shippingLocationTypeEnumVal,
                    or Latitude and longitude pair, 
                    or country and state and city are optional. But only one of them should be provided if applicable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The current shipping location type (load-at, consignee, hub or distribution center). 
                    Optional. Not modifiable. Used only for processSetStopETA operation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventText" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Free form text in Events describing reason codes.
					Optional. Not modifiable. Used only for processSetStopETA operation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="StopShippingLocationType">
                <xsd:annotation>
                    <xsd:documentation>
			The information about a Shipping Location used at a stop.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The type of the shipping location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The code of the shipping location. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="UnitOfMeasureType">
                <xsd:annotation>
                    <xsd:documentation>
			A collection of units of measurement.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemUnitOfMeasureEnumVal" type="cis:SystemUnitOfMeasureEnumValType">
                        <xsd:annotation>
                            <xsd:documentation>
				The system of measurement units for the entity. Mandatory. Updatable
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for systemUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightUnitOfMeasureEnumVal" type="cis:WeightUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The unit of measure for weight. Mandatory. Updatable
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for weightUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LengthUnitOfMeasureEnumVal" type="cis:LengthUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation> 
				The unit of measure for length. Mandatory. Updatable
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LengthUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for lengthUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceUnitOfMeasureEnumVal" type="cis:DistanceUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The unit of measure for distance. Mandatory. Updatable
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for distanceUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="UserSettingsConfigurationType">
                <xsd:annotation>
                    <xsd:documentation>
                define user configuration settings for the Smartbench and Transport Mobile User components.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Internal ID. Applicable only for UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemUserSettingsConfigurationID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    System-generated numeric ID of the note. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Optional. If populated, ID of the user to which this configuration entry belongs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PanelCode" type="cis:PanelCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Mandatory. Identifies the TMU panel (TMU defined values).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ModuleCode" type="cis:ModuleCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					System-applied. Always 'tmu'.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Panel" type="cis:PanelType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					TMU-defined Panel Type. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserGroupCode" type="cis:UserGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Optional. If populated, ID of the user group to which this configuration belongs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ViewState" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    TMU definition of the Panel.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="VariableLoadingUnloadingBuffersType">
                <xsd:annotation>
                    <xsd:documentation>
            			This table contains global percentages that can be used to increase the variable loading/unloading time when multiple items types are being handled at a stop.  		
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VariableLoadingUnloadingBuffersID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    An automatically generated system identifier for this type. Read only field.
                    Ignored for Create.
                    For operations other than Create, mandatory unless NumberOfItemTypes is specified.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfItemTypes" type="cis:ShipmentPriorityType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The minimum count of units for this buffer tier.
                    Mandatory for Create. Not editable.
                    For operations other than Create, mandatory unless VariableLoadingUnloadingBuffersID is specified
                    and should not be specified if VariableLoadingUnloadingBuffersID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NewNumberOfItemTypes" type="cis:ShipmentPriorityType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The new minimum count of units for this buffer tier for an existing entry (change operation only).
                    Not applicable for a new entry.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadingBufferPercentage" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The percentage by which loading time will be increased for stops where the number of item types being loaded satisfies the selection criteria.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnloadingBufferPercentage" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The percentage by which unloading time will be increased for stops where the number of item types being loaded satisfies the selection criteria.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the entry. Read-only.
					
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who last updated the entry. Read-only.

                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time that the entry was created. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time that the entry was last updated. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="AlertWatchGroupType">
                <xsd:annotation>
                    <xsd:documentation>
When an event occurs for an alert that matches the characteristics defined by the Alert Watch Group, an email to be sent to each email associated with the Alert Watch Group, 
as defined in the ALert Watch Group Recipients table.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertWatchGroupCode" type="cis:AlertWatchGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Alert Watch Group ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertWatchGroupDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Alert Watch Group description.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DisplayAlertSeverityEnumVal" type="cis:DisplayAlertSeverityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Alert status.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DisplayAlertSeverityEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for DisplayAlertSeverityEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertTypeCode" type="cis:AlertTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Alert Type ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The division ID of the Alert Watch Group. If you do not supply an input value for this field when creating this structure, then the value will be taken from the user's profile. To force this value to be blank, enter a single space in quotes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The logistics group of the Alert Watch Group. If you do not supply an input value for this field when creating this structure, then the value will be taken from the user's profile. To force this value to be blank, enter a single space in quotes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The default carrier ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The customer code. 
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location point type. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for ShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipping location code. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the Alert Watch Group was created. This is a read-only value.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the Alert Watch Group was updated. This is a read-only value.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who created the Alert Watch Group. This is a read-only value.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who updated the Alert Watch Group. This is a read-only value.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreRecipientsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the Recipient values should be ignored. May be present for add or change operation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Recipient" type="cis:AlertWatchGroupRecipientType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The recipients to be alerted.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="AlertWatchGroupRecipientType">
                <xsd:annotation>
                    <xsd:documentation>
The members of an Alert Watch Group that will recieve emails when a change in alert status or severity occurs for the specified alert. 
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertWatchGroupCode" type="cis:AlertWatchGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Alert Watch Group ID
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EmailAddress" type="cis:EmailType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The recipient's email address. 
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RoleCode" type="cis:RoleDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The recipient's role.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RoleCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for RoleCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the Alert Watch Group Recipient was created. This is a read-only value.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the Alert Watch Group Recipient was updated. This is a read-only value.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who created the Alert Watch Group Recipient. This is a read-only value.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who updated the Alert Watch Group Recipient. This is a read-only value.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AlertWatchGroup" type="cis:AlertWatchGroupType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Associated Alert Watch Group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="AutoAppliedOptionType">
                <xsd:annotation>
                    <xsd:documentation>
An option that is automatically selected for routing and rating when the entity it is attached to is selected. For all the elements listed here except Opt_Id, You can apply the option according to one of these levels: Rate, Route_Rate, and Do not apply.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoAppliedOptionCode" type="cis:ChargeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The option code to automatically apply for the associated entity. For a given entity, You cannot define two auto-applied options with the same code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAROptionShipFromEnumVal" type="cis:OptionsAppliedEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
You can apply the option when the entity for which the Auto-Applied Option is defined becomes a ShipFrom or ShipTo of a Shipment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAROptionShipFromEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Description for applyAROptionShipFromEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAPOptionShipFromEnumVal" type="cis:OptionsAppliedEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
You can apply the option when the entity for which the Auto-Applied Option is defined becomes a ShipFrom or ShipTo of a Load/ Shipment Leg.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAPOptionShipFromEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Description for applyAPOptionShipFromEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAROptionShipToEnumVal" type="cis:OptionsAppliedEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Currently disabled.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAPOptionShipToEnumVal" type="cis:OptionsAppliedEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Currently disabled.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAROptionHubInboundEnumVal" type="cis:OptionsAppliedEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Currently disabled.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAPOptionHubInboundEnumVal" type="cis:OptionsAppliedEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Currently disabled.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAROptionHubTransferEnumVal" type="cis:OptionsAppliedEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Currently disabled.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAPOptionHubTransferEnumVal" type="cis:OptionsAppliedEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Currently disabled.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAROptionHubOutboundEnumVal" type="cis:OptionsAppliedEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Currently disabled.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyAPOptionHubOutboundEnumVal" type="cis:OptionsAppliedEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Currently disabled.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the shipping location. Read-only. 
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipping location type. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for shippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocation" type="cis:ShippingLocationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated shipping location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="BookingRevisionRuleType">
                <xsd:annotation>
                    <xsd:documentation>
				A set of options defined to handle matching booking revisions.  
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemBookingRevisionRuleID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    An automatically generated booking revision rule system identifier. Ignored for Create.
                    Either this field or BookingRevisionRuleCode must be provided
                    to identify an existing entry.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionRuleCode" type="cis:BookingRevisionRuleCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the booking revision rule.
                    Mandatory for Create and when SystemBookingRevisionRuleID is not provided.
                    For an operation other than Create, can be used only to identify an active booking revision rule.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionRuleDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The description of the booking revision rule.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionActionEnumVal" type="cis:BookingRevisionActionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Action for booking revisions using this rule.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionActionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for BookingRevisionActionEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionRejectOptionEnumVal" type="cis:BookingRevisionRejectOptionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Reject option for booking revisions using this rule.
                    Defaults to Reject Tender and cannot be cleared if Booking Revision Action is Reject, otherwise not used.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionRejectOptionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for BookingRevisionRejectOptionEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyResourceConstraintsEnumVal" type="cis:BooleanEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether resource constraints will apply when Routing, Rating and Scheduling is executed for booking revisions using this rule.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyResourceConstraintsEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ApplyResourceConstraintsEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightVolumeConstraintsOverrideEnumVal" type="cis:BooleanEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether weight and volume constraints will be overridden when Routing, Rating and Scheduling is executed for booking revisions using this rule.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightVolumeConstraintsOverrideEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for WeightVolumeConstraintsOverrideEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaintainItineraryTimetableEntryOptionEnumVal" type="cis:UpdateItineraryTimetableEntryOptionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates if itinerary timetable entry used by the booking will be updated according to the proposed change on booking revision using this rule.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaintainItineraryTimetableEntryOptionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for MaintainItineraryTimetableEntryOptionEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentChangeEnumVal" type="cis:BooleanEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether this rule will be eligible for a booking revision if equipment type change is proposed.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentChangeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for EquipmentChangeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrioritySequence" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The priority sequence. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the booking revision rule is currently active. Read-only.
                    Set to True on Create.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IssueTenderUpdateAfterAcceptedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether tender update will be issued after booking revision is accepted. Defaults to true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RejectReasonCode" type="cis:EventCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The reason code applied when associated booking revision is rejected.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AcceptReasonCode" type="cis:EventCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The reason code applied when associated booking revision is accepted.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionRuleMatchingCriteriaEnumVal" type="cis:BookingRevisionRuleMatchingCriteriaEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the level of conditions a booking revision should satisfy to use this booking revision rule.
                    Mandatory for Create.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionRuleMatchingCriteriaEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for BookingRevisionRuleMatchingCriteriaEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The division ID of the booking revision rule.
                    Not applicable for Update.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DisableRRSOptionEnumVal" type="cis:DisableRRSOptionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates if routing, rating and scheduling will be disabled on the booking using this rule.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DisableRRSOptionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for DisableRRSOptionEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the booking revision rule was created. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the booking revision rule was last updated. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created the booking revision rule. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who last updated the booking revision rule. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionRuleDetail" type="cis:BookingRevisionRuleDetailType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Detail associated with this booking revision rule.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="BookingRevisionRuleDetailType">
                <xsd:annotation>
                    <xsd:documentation>
				The booking revision rule entry for a specific attribute.
                All booking revision rule details are re-created when the booking revision rule is updated.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionAttributeEnumVal" type="cis:BookingRevisionRuleAttributeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The booking revision attribute for this detail. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionAttributeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for BookingRevisionAttributeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OperatorEnumVal" type="cis:OperatorEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The comparison rule for the associated booking revision attribute.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OperatorEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for OperatorEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the shipping location for the booking revision attribute.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shipping location type for the booking revision attribute. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarlyDuration" type="cis:DurationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Duration allowed prior to current date/time.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TextValue" type="cis:VesselNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The text value for the booking revision attribute.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LateOperatorEnumVal" type="cis:OperatorEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The comparison rule for the associated booking revision attribute. Applies only to late duration.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LateOperatorEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for LateOperatorEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LateDuration" type="cis:DurationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Duration allowed after current date/time.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The carrier ID for the booking revision attribute.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the booking revision rule was created. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the booking revision rule was last updated. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created the booking revision rule. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who last updated the booking revision rule. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionRule" type="cis:BookingRevisionRuleType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Associated booking revision rule.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="BookingRevisionRuleStatusChangeInfoType">
                <xsd:annotation>
                    <xsd:documentation>
			    A collection of information for the booking revision rule status to change to.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemBookingRevisionRuleID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				    A system identifier of a booking revision rule.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the booking revision rule is active.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="CarrierType">
                <xsd:annotation>
                    <xsd:documentation>
A company that arranges shipping services for customers using one or more shippers.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID code of the carrier. Mandatory for a new Carrier. Cannot be changed for an existing Carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
A description of the carrier. Mandatory for a new Carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCode" type="cis:LanguageDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The language used by the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for languageCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierTypeCode" type="cis:CarrierDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The type of the shipping service that the carrier provides.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for carrierTypeCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SCACCode" type="cis:SCACDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The standard carrier alpha code assigned to the carrier by NMFTA. Mandatory for a new Carrier. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SCACCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for SCACCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierContractNumber" type="cis:ContractNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The contract number between the company and the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierContractDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date that the above contract was made.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CostCenterCode" type="cis:CostCenterDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The G/L cost center to be charged when transactions occur between the company and the carrier. Mandatory for a new Carrier. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CostCenterCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for costCenterCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierAccountNumber" type="cis:AccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The account number opened for the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APVendorNumber" type="cis:AccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The carrier's vendor number in the company's accounts payable system.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherGenerationLevelEnumVal" type="cis:APVoucherGenerationLevelEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The voucher generation level.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherGenerationLevelEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for voucherGenerationLevelEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillGroupLevelEnumVal" type="cis:FreightBillGroupLevelEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The freight bill group level.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillGroupLevelEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for freightBillGroupLevelEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillPaymentModeEnumVal" type="cis:FreightInvoicePaymentModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The freight bill payment mode.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillPaymentModeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for freightBillPaymentModeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The currency used by the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for currencyCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerTrackingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the boxes or pieces in a shipment can be tracked. If true, each component gets a separate tracking number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BarcodeTypeCode" type="cis:BarCodeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The bar code type used in bar code printing for the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BarcodeTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for barcodeTypeCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrintLabelFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether shipping labels are generated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrintBOLFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether bills of lading are generated. A carrier bill of lading lists the contents of an entire shipment itinerary. A shipment itinerary is the path that a shipment follows from its origin to its destination.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrintManifestFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether a manifest is printed each time that the carrier is assigned a shipment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrintFreightBillFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether a freight bill is generated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AuthorizeAppointmentsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the carrier is authorized to make an appointment with load-ats or consignees to pick up or deliver directly to them.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FaxEnabledFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the carrier has online fax communication capability.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PickupLeadTimeCode" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The type of pickup lead time. Always returned as 0.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierInsuranceExpiryDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date when the carrier's insurance expires. Mandatory for a new Carrier. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierInsuranceAmount" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The value of the carrier's insurance policy.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SingleTenderRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether a single tender is required for the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RoutingPrecisionEnumVal" type="cis:RoutePrecisionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates how shipments are routed for the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RoutingPrecisionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for routingPrecisionEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BOLFormatCode" type="cis:BOLFormatDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The format for the bill of lading (BOL).
					The field is read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BOLFormatCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for BOLFormatCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLabelFormatCode" type="cis:ShipLabelFormatDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The format for printing shipping labels.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLabelFormatCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for shippingLabelFormatCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ManifestFormatCode" type="cis:CarrierManifestFormatDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The format for printing manifests.
					The field is read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ManifestFormatCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for manifestFormatCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APVoucherFormatCode" type="cis:FreightBillFormatDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The format for printing the A/P vouchers. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APVoucherFormatCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for APVoucherFormatCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumVariancePercentPositive" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The maximum positive percentage difference allowed in match pay.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumVarianceAmountPositive" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The maximum positive dollar difference allowed in match pay.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumVariancePercentNegative" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The maximum negative percentage difference allowed in match pay.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumVarianceAmountNegative" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The maximum negative dollar difference allowed in match pay.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceGradeCode" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The grade for the service provided by the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinorityGroupCode" type="cis:MinorityGroupDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the carrier is owned by a visible minority, and by which minority.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinorityGroupCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for minorityGroupCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ManifestNumberControlFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether to use the carrier manifest number. May be present for add and change operations.
If present with a value of true, then the lastCarrierManifestNumber element is applied, otherwise it is ignored.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastCarrierManifestNumber" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Most recent Carrier Manifest Number used. Presence depends on the value of the manifestNumberControlFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APVoucherNumberControlFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether to use the carrier freight bill number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastCarrierFreightBillNumber" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Most recent Carrier Freight Bill Number used.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BOLNumberFormatMask" type="cis:BOLNumberFormatType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The BOL format code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BOLEntryRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates validation of the BOL number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffSelectionModeEnumVal" type="cis:TariffSelectionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The tariff selection control.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffSelectionModeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for tariffSelectionModeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RestrictedCarrierFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the carrier is restricted.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnrouteCommunication" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The enroute communications used by the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StatusVerificationEnumVal" type="cis:StatucVerificationEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The status verification control.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StatusVerificationEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for statusVerificationEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APTermsCode" type="cis:APTermsDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The A/P terms for the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APTermsCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for APTermsCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APVoucherCurrencyEnumVal" type="cis:APVoucherCurrencyEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The currency type of the A/P voucher payment. Mandatory for a new Carrier. Cannot be an empty element.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APVoucherCurrencyEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for APVoucherCurrencyEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RespondToTenderHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The maximum number of hours the carrier can take to respond to the tender offers.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NonLiveLoadUnloadFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether non-live loading and unloading is allowed for this carrier. Mandatory for a new Carrier. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EligibleForContinuousMovesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the carrier can use continuous moves.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EligibleForContinuousMovesWhenPlannedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the carrier can use loads in planned or tender-rejected status when creating continuous moves.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EligibleForContinuousMovesWhenTenderedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the carrier can use loads in tendered status when creating continuous moves.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EligibleForContinuousMovesWhenAcceptedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the carrier can use loads in tender accepted status when creating continuous moves.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EligibleForContinuousMovesWhenConfirmedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the carrier can use loads in confirmed or in-transit status when creating continuous moves.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EligibleForContinuousMovesWhenCompleteFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the carrier can use loads in completed status when creating continuous moves.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherGenerationLevelTripEnumVal" type="cis:TripVoucherGenerationLevelEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The voucher generation level for trips.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherGenerationLevelTripEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for voucherGenerationLevelTripEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightAuditDetailChargesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether detailed charges are required for freight audit for this carrier. The system assigns a default value of false to this field.
Cannot be changed for an existing Carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemUnitOfMeasureEnumVal" type="cis:SystemUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The unit of measure system of the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for systemUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightUnitOfMeasureEnumVal" type="cis:WeightUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The weight units of the carrier. Mandatory for a new Carrier. Cannot be an empty element.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for weightUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LengthUnitOfMeasureEnumVal" type="cis:LengthUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The length units of the carrier. Mandatory for a new Carrier. Cannot be an empty element.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LengthUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for lengthUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceUnitOfMeasureEnumVal" type="cis:DistanceUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The unit of measure for the distances.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for distanceUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InternalCarrierFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the carrier is internal.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SpotCarrierFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the carrier is a spot carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumAllowedLowestCostPercent" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The maximum percentage of the lowest cost allowed for the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripsEligibleForContinuationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether a trip is eligible for continuous moves
                        if this carrier is committed for this trip.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowNewShipmentsAfterTenderFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether shipment legs can be added to a load by Transportation Optimizer
                        after this load is tendered to this carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CorporateID1" type="cis:CorporateIdType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
A corporate identifier code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CorporateID2" type="cis:CorporateIdType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
A second corporate identifier code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PayToCarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The carrier that pays for the transportation services provided.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The division ID of the carrier. If you do not supply an input value for this field when creating this structure, then the value will be taken from the user's profile. To force this value to be blank, enter a single space in quotes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode1" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
An external identifying code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode2" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
A second external identifying code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierStatusEnumVal" type="cis:CarrierStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The status of the carrier. This is a read-only file.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for carrierStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumTenderLeadTime" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The minimum number of hours notice that the carrier needs in order to pick up a shipment or load. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MatchFreightBillCurrencyFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the currency for a matched freight bill must be the same as the payment currency for the A/P voucher.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EligibleForContinuousMovesWhenOpenFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether loads in OPEN operational status are eligible to be assigned to a trip/booking.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TenderedBookingsEligibleForContinuationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether bookings with status TENDERED or higher are eligible to have additional loads appended during optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberClassification" type="cis:ReferenceNumberClassificationDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The reference number classification of the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberClassificationDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for referenceNumberClassification. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the carrier was created. This is a read-only file.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the carrier was updated. This is a read-only file.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who created the carrier. This is a read-only file.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who updated the carrier. This is a read-only file.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Address" type="cis:AddressType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The address of the carrier. Mandatory for a new Carrier. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Contact" type="cis:ContactType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The contact information of the carrier. Mandatory for a new Carrier. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessHours" type="cis:BusinessHoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The business hours of the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
A memo associated with the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InsuranceNotes" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Insurance notes associated with the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentAvailability" type="cis:EquipmentAvailabilityType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The equipment availability constraints.
                The fields are not supposed to be used,
                input is accepted only in some cases for backward compatibility.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreContactsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the contents of contactPerson should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContactPerson" type="cis:ContactPersonType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
Contacts associated with the carrier. Presence depends on the value of ignoreContactsFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreCustomerCarrierFreightAuditFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the contents of customerCarrierFreightAudit should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCarrierFreightAudit" type="cis:CustomerCarrierFreightAuditType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
The customer and carrier relationship for freight audit. Presence depends on the value of ignoreCustomerCarrierFreightAuditFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneAvailabilityDetailEnumVal" type="cis:ContentDetailEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
For a query operation, indicates the level of detail to return.  Valid values are:
	DC_NONE : do not include lane availabilities,
	DC_IDS : include only lane availability IDs,
	DC_FULL : include full lane availability information.  This is the default.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreLaneAvailabilitiesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the LaneAvailability values should be ignored. LaneAvailability values may be accepted for the change operation only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneAvailability" type="cis:LaneAvailabilityType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
The lane availabilities for this carrier. Presence depends on the value of IgnoreLaneAvailabilitiesFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileCode" type="cis:ShippingLocationCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
The domicile IDs of the carrier. This is a read-only file.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreCarrierAccountNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the contents of carrierAccountNumber should be ignored. May be present for add and change operations.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierAccountNumbers" type="cis:CarrierAccountNumbersType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
The carrier account numbers which may be assigned based on Freight Term, Shipping Locations and Customer. Presence depends on the value of ignoreCarrierAccountNumbersFlag.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreMatchFreightBillCurrencyFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of MatchFreightBillCurrency should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MatchFreightBillCurrency" type="cis:MatchFreightBillCurrencyType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Currency that can be used by a carrier when this carrier sends freight bills that require match.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreEquipmentAvailabilityDateRangeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of EquipmentAvailabilityDateRange should be ignored. May be present for add and change operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentAvailabilityDateRange" type="cis:EquipmentAvailabilityDateRangeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Equipment availability constraints for a date range.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="CarrierAccountNumbersType">
                <xsd:annotation>
                    <xsd:documentation>
                        Carrier Account Number which may be assigned based on Freight Term, Shipping Location and Customer.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightTermsEnumVal" type="cis:FreightTermsType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The Freight Terms associated with this carrier account number. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightTermsEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for freightTermsEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The shipping location point code. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location point type. Optional.
					If not supplied for a new or re-created carrier account number,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for shippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The customer code associated with this carrier account number. Optional.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierAccountNumber" type="cis:CarrierAccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The carrier account number for this Carrier Shipping Location/Freight Term and/or Customer code. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DropoffPickupServiceType" type="cis:DropoffPickupServiceDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The Drop-off and/or Pick-up service code for this Carrier Shipping Location. Optional.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DropoffPickupServiceTypeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for dropoffPickupServiceType. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The date and time that the carrier account number was created. This is a read-only file.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The date and time that the carrier account was updated. This is a read-only file.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The ID of the user who created the carrier account number. This is a read-only file.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The ID of the user who updated the carrier account number. This is a read-only file.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Carrier" type="cis:CarrierType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="CarrierCrossReferenceType">
                <xsd:annotation>
                    <xsd:documentation>
			The carrier cross-reference.	
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SCACCode" type="cis:SCACDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The standard carrier alpha code assigned to the carrier by NMFTA. Mandatory. May not be empty.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			The carrier ID code. Optional.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="CarrierStatusChangeInfoType">
                <xsd:annotation>
                    <xsd:documentation>
			A collection of information for the carrier's status to change to.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="CarrierCode" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of Carrier codes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierStatusEnumVal" type="cis:CarrierStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The new status of the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="CommodityType">
                <xsd:annotation>
                    <xsd:documentation>
			Commodity type for a freight.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The commodity code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the commodity.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The external code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityPickSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The commodity pick sequence number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the commodity represent a hazardous material.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumCompartment" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The maximum number of compartments that this commodity can be assinged on a trailer.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SplitMethodEnumVal" type="cis:TrailerSplitMethodEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The trailer split method. Atomic unit to use when splitting this commodity across multiple compartments; 
                not applicable when maximum number of compartments is 1.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SplitMethodEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for splitMethodEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreCommodityExclusionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether the contents of firstCommodityExclusion and secondCommodityExclusion should be ignored.  
                Defaults to true if not specified. May be present for add and change operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RetainExistingCommodityExclusionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates that the existing Commodity Exclusion should be retained when adding new Commodity Exclusion or updating an existing one.Defaults to false if not specified. May be present for change operation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstCommodityExclusion" type="cis:CommodityExclusionType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Commodity Exclusions of this commodity link to CommodityCode of CommodityExclusionType.  Optional. Updatable.
                    Creation of commodity exclusion is allowed only in this collection.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SecondCommodityExclusion" type="cis:CommodityExclusionType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Commodity Exclusions of this commodity link to ExcludeCommodityCode of CommodityExclusionType.  Optional. Updatable.
                    Update is allowed only for equipment type and equipment compartment.
                    Creation of commodity exclusion not allowed in this collection.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TemperatureSensitiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates when the commodity is temperature sensitive; if set, temperature minimum or temperature maximum must be populated; when both are populated, a range is indicated and temperature maximum must be greater than temperature minimum.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ElevationSensitiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates when the commodity is elevation (altitude) sensitive; if set, elevation minimum or elevation maximum must be populated; when both are populated, a range is indicated and elevation maximum must be greater than elevation minimum.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousMaterialShipName1Qualifier" type="cis:SingleCharacterType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; value taken from government reference books.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousMaterialShipName2Qualifier" type="cis:SingleCharacterType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; value taken from government reference books.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousClassificationQualifier" type="cis:SingleCharacterType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; value taken from government reference books.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousCommodityEDIQualifier" type="cis:SingleCharacterType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration.		
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousFlashTemperature" type="cis:HazardTempType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; flashpoint temperature for a hazardous commodity; value taken from government reference books; stored in system temperature unit of measure.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousControlTemperature" type="cis:HazardTempType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; control temperature for a hazardous commodity; value taken from government reference books; stored in system temperature unit of measure.	
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousEmergencyTemperature" type="cis:HazardTempType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; emergency temperature for a hazardous commodity; value taken from government reference books; stored in system temperature unit of measure.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumTemperature" type="cis:TemperatureType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				When the commodity is marked as temperature sensitive, this value indicates the lowest ambient temperature before damage is expected to occur; no value indicates no minimum applies; non-blank values are stored in the system temperature unit of measure.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumTemperature" type="cis:TemperatureType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				When a commodity is marked as temperature sensitive, this value indicates the highest ambient temperature before damage is expected to occur; no value indicates no maximum; non-blank values are stored in the system temperature unit of measure.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumElevation" type="cis:ElevationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				When the commodity is marked as elevation sensitive, this value indicates the lowest elevation before damage is expected to occur; no value indicates no minimum applies; non-blank values are stored in the system elevation unit of measure.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumElevation" type="cis:ElevationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				When a commodity is marked as elevation sensitive, this value indicates the highest elevation before damage is expected to occur; no value indicates no maximum; non-blank values are stored in the system elevation unit of measure.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BOLHandlingCode1" type="cis:BOLHandlingType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; captures the code for relating special handling instructions to the carrier for how to handle the commodity; must be mapped to an AT5 segment; one of six.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BOLHandlingCode2" type="cis:BOLHandlingType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; captures the code for relating special handling instructions to the carrier for how to handle the commodity; must be mapped to an AT5 segment; two of six.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BOLHandlingCode3" type="cis:BOLHandlingType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; captures the code for relating special handling instructions to the carrier for how to handle the commodity; must be mapped to an AT5 segment; three of six.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BOLHandlingCode4" type="cis:BOLHandlingType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; captures the code for relating special handling instructions to the carrier for how to handle the commodity; must be mapped to an AT5 segment; four of six.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BOLHandlingCode5" type="cis:BOLHandlingType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; captures the code for relating special handling instructions to the carrier for how to handle the commodity; must be mapped to an AT5 segment; five of six.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BOLHandlingCode6" type="cis:BOLHandlingType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; captures the code for relating special handling instructions to the carrier for how to handle the commodity; must be mapped to an AT5 segment; six of six.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceHandlingCode1" type="cis:ServiceHandlingType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; captures the code for relating special handling instructions to the carrier for how to handle the commodity; must be mapped to an AT5 segment; one of six.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceHandlingCode2" type="cis:ServiceHandlingType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; captures the code for relating special handling instructions to the carrier for how to handle the commodity; must be mapped to an AT5 segment; two of six.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceHandlingCode3" type="cis:ServiceHandlingType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; captures the code for relating special handling instructions to the carrier for how to handle the commodity; must be mapped to an AT5 segment; three of six.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceHandlingCode4" type="cis:ServiceHandlingType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; captures the code for relating special handling instructions to the carrier for how to handle the commodity; must be mapped to an AT5 segment; four of six.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceHandlingCode5" type="cis:ServiceHandlingType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; captures the code for relating special handling instructions to the carrier for how to handle the commodity; must be mapped to an AT5 segment; five of six.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceHandlingCode6" type="cis:ServiceHandlingType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; captures the code for relating special handling instructions to the carrier for how to handle the commodity; must be mapped to an AT5 segment; six of six.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousPackingGroupCode" type="cis:HazardousPackingGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; value taken from government reference books.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousClassification" type="cis:HazardousClassificationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; value taken from government reference books.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousMaterialCode" type="cis:HazardousMaterialType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; value taken from government reference books.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousEmergencyContactPhone" type="cis:HazardousContactType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; hazardous matierials emergency contact telephone number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousUNNANumber" type="cis:HazardousUNNAType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; United Nations / North America number for a hazardous commodity; value taken from government reference books.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousEmergencyContactName" type="cis:HazardousEmergencyContactType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; hazardous matierials emergency contact name.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousLadingDescription" type="cis:HazardousLadingDescriptionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; value taken from government reference books.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousMaterialShipName1" type="cis:HazardousMaterialShipType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; value taken from government reference books.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousMaterialShipName2" type="cis:HazardousMaterialShipType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				For EDI integration; value taken from government reference books.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ConsigneeType">
                <xsd:annotation>
                    <xsd:documentation>
The final destination of a freight movement.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ConsigneeCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The consignee ID code. Mandatory for a new Consignee. Cannot be changed for an existing Consignee.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ConsigneeDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
A description of the consignee. Mandatory for a new Consignee. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCode" type="cis:LanguageDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The language used at the consignee.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for languageCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AppointmentRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether a carrier has to make an appointment to drop off shipments at the consignee.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumShipmentWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The maximum weight of a shipment that can be unloaded at the consignee.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumShipmentVolume" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The maximum volume of a shipment that can be unloaded at the consignee.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumEquipmentLength" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The maximum length of the equipment allowed at the consignee.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumEquipmentWidth" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The maximum width of the equipment allowed at the consignee.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumEquipmentHeight" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The maximum height of the equipment allowed at the consignee.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ConsigneeGroupCode" type="cis:ConsigneeGroupDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The consignee group of the consignee.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ConsigneeGroupCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for consigneeGroupCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StoreNumber" type="cis:StoreNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
A store number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLCategoryCode" type="cis:GLCategoryDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The G/L category.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLCategoryCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for GLCategoryCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FixedLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The fixed load or unload hours.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The maximum load or unload hours.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLeadTimeHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The minimum lead hours.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The minimum load or unload hours.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveLoadCodeEnumVal" type="cis:LiveLoadEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether live or non-live loading is allowed.
					This field is obsolete.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveLoadCodeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for LiveLoadCodeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveUnloadCodeEnumVal" type="cis:LiveLoadEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether inbound live or non-live unloading is allowed;
					if non-live, then it indicates whether there can be inbound non-live unloading
					during business hours or any time.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveUnloadCodeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LiveUnloadCodeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstStopFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether any shipment leg starting from this location must be the first stop for the load.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastStopFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether any shipment leg terminating at this location must be the last stop for the load.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SideDoorUnloadingRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether side door unloading is required at this location
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NearTailUnloadingRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether rear door unloading is required at this location
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationPickupSequenceNumber" type="cis:PickSequenceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The Shipping Location Shipment Pickup Sequence Number
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BoundaryRuleEnumVal" type="cis:BoundaryRuleEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The boundary rules.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BoundaryRuleEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for boundaryRuleEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CorporateID1" type="cis:CorporateIdType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
A corporate identifier code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CorporateID2" type="cis:CorporateIdType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
A second corporate identifier code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The logistics group of the consignee. If you do not supply an input value for this field when creating this structure, then the value will be taken from the user's profile. To force this value to be blank, enter a single space in quotes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The division of the consignee. If you do not supply an input value for this field when creating this structure, then the value will be taken from the user's profile. To force this value to be blank, enter a single space in quotes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PreferredCarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The default carrier ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PreferredServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The default service ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLRegionZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The G/L region zone.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The default INCO terms shipping location code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The default INCO terms shipping location type.
					For the Add operation or for the Change operation with INCO shipping location change,
					if INCOShippingLocationCode is specified but
					INCOShippingLocationTypeEnumVal is not specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for INCOShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode1" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
An external identifying code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode2" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
A second external identifying code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The primary shipping location code for this location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The primary shipping location type for this location. Optional. Updatable.
					For the Add operation or for the Change operation with primary shipping location change,
					if primaryShippingLocationCode is specified but
					primaryShippingLocationTypeEnumVal is not specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for primaryShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadUnloadTimeCalculationEnumVal" type="cis:FixedTimeModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Loading/unloading time calculation mode.
					The setting will determine how loading/unloading times from
					equipment type and location are handled in calculations.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadUnloadTimeCalculationEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LoadUnloadTimeCalculationEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ConsigneeStatusEnumVal" type="cis:ConsigneeStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The status of the consignee. This is a read-only file.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ConsigneeStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for consigneeStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoCreateNonLiveCommitmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether this location supports auto creation of non-live dock commitment.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WarehouseManagementSystemInstanceCode" type="cis:WarehouseManagementSystemInstanceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The WMS Instance ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationMaximumNumberShipmentSplit" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Maximum number of shipment splits for destination location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationSplitRulePrecisionEnumVal" type="cis:SplitRuleEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Split rule precision for desintaion location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationSplitRulePrecisionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Description for destinationSplitRulePrecisionEnumVal. Read-only. Available only through UI-oriented APIs.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationMinimumShipmentOverrideWindow" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Minimum shipment override window for destination location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PostDischargeActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether any value exists for EarliestPostDischargeStartHours and LatestPostDischargeStartHours.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestPostDischargeStartHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The smallest allowed interval between the time of carrier drop-off and the time when post-discharge starts.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestPostDischargeStartHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The largest allowed interval between the time of carrier drop-off and the time when post-discharge starts.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the consignee was created. This is a read-only file.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the consignee was updated. This is a read-only file.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who created the consignee. This is a read-only file.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who updated the consignee. This is a read-only file.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DTTEOverrideEnumVal" type="cis:DTTEOverrideEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether to convert or delete the distance override when updating the address of the consignee.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Address" type="cis:AddressType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The address of the consignee.  Mandatory for a new Consignee. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Contact" type="cis:ContactType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The contact information for the consignee.  Mandatory for a new Consignee. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessHours" type="cis:BusinessHoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The business hours of the consignee.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
A memo associated with the consignee.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Directions" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
directions to the location of the consignee.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreContactsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the contents of contactPerson should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContactPerson" type="cis:ContactPersonType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
contacts associated with the consignee. Presence depends on the value of ignoreContactsFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAutoAppliedOptionsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the contents of autoAppliedOption should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoAppliedOption" type="cis:AutoAppliedOptionType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
The auto-applied options for the consignee. Presence depends on the value of ignoreAutoAppliedOptionsFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreCustomerShippingLocationCrossReferenceFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the contents of customerShippingLocationCrossReference should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerShippingLocationCrossReference" type="cis:CustomerShippingLocationCrossReferenceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
The cross-reference relationship for a customer and shipping location. Presence depends on the value of ignoreCustomerShippingLocationCrossReferenceFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreVariableLoadUnloadTimeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the contents of variableLoadingUnloadingTime should be ignored.
May be present for add and change operations. If this element is not present or if its value is true, then no variableLoadingUnloadingTime should be present.
If the value of this element is false for an add operation, then the entity will be populated with any variableLoadingUnloadingTime elements in this document.
If the value of this element is false for a change operation, then all existing variableLoadingUnloadingTime members of this entity will be replaced with those in this document.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VariableLoadingUnloadingTime" type="cis:VariableLoadingUnloadingTimeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
Variable loading or unloading time factor. Presence depends on the value of ignoreVariableLoadUnloadTimeFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreDockFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the contents of dock should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Dock" type="cis:DockType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
Docks of this consignee. Presence depends on the value of ignoreDockFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreEquipmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the collection of equipment elements should be ignored.  May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Equipment" type="cis:ShippingLocationEquipmentType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
Supported equipment types for this consignee.  Contents will only be considered if the ignoreEquipmentFlag is false.  May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreShipmentSplitRuleFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the collection of shipment split rules should be ignored.  May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentSplitRule" type="cis:ShipmentSplitRuleType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Shipment split rules for this consignee.  Contents will only be considered if the ignoreShipmentSplitRuleFlag is false.  May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberTrailersAllowed" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Maximum number of trailers permitted at the location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberTrailersCanBeHandled" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Maximum number of trailers that can be handled at a time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumTotalTrailerLength" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Maximum total trailer(s) length permitted at the location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ContainerTypeCrossReferenceType">
                <xsd:annotation>
                    <xsd:documentation>
			A container type cross-reference.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ExternalCode" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The external code for this container.	Mandatory. May not be empty.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerTypeCode" type="cis:ComponentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The container type code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="CurrencyType">
                <xsd:annotation>
                    <xsd:documentation>
				An entry for a currency.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemCurrencyID" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A system-generated currency identifier.
					Either this field or CurrencyCode must be provided to identify an entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The currency code.
					Mandatory for creating a currency, for other operations it is ignored if SystemCurrencyID is supplied.
					Cannot be changed for an existing currency.
					Either this field or SystemCurrencyID must be provided to identify an entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A description of the currency. Mandatory for creating a currency. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the currency is active. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RoundingPrecision" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The decimal precision for a currency. Mandatory for creating a currency. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IsBaseFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the currency is the base currency. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EuroRate" type="cis:ExchangeRateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The euro exchange rate for a currency amalgamated under euro. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="CustomerType">
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The customer ID code. Mandatory for a new Customer. Cannot be changed for an existing Customer.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
A description of the customer. Mandatory for a new Customer. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCode" type="cis:LanguageDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The language the customer uses.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for languageCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CorporateCustomerFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the customer is a corporate customer.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultProfitCenterCode" type="cis:ProfitCenterDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The profit center to which the customer revenue is assigned.
                    Mandatory for a new Customer if the default value is not available in Global Settings. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultProfitCenterCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for DefaultProfitCenterCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerServiceRepresentativeCode" type="cis:CustomerServiceRepDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The service representative of the customer.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerServiceRepresentativeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for customerServiceRepresentativeCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The currency of the customer. The default value is from the Transportation Manager user who created the customer
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
