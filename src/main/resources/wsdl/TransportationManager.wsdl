            <xsd:element name="processLoadRate">
                <xsd:complexType>
                    <xsd:annotation>
                        <xsd:documentation>
            A collection of rate load requests.
            </xsd:documentation>
                    </xsd:annotation>
                    <xsd:sequence>
                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                Operation header.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="LoadRateData" type="cis:LoadRateDataType" minOccurs="0" maxOccurs="unbounded">
                            <xsd:annotation>
                                <xsd:documentation>
                        The data about each load to be rated.  At least one LoadRateData must be supplied.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="IDsAreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                 Indicates whether the supplied IDs are load IDs or load reference numbers. True (i.e. the ID's are reference numbers) by default. If you use reference numbers for identification, they must be unique across all loads. If a supplied reference number is attached to two or more loads, this will generate an error.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ReferenceNumberType" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                The type of reference numbers used to identify the loads.    Mandatory if IDsAreReferenceNumbersFlag (above) is set to true or absent.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="SkipRatingFlag" type="xsd:boolean" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                    If set to true, rating will not be performed
                    but updates (possibly including charge overrides) will be applied.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="KeepSpotRateFlag" type="xsd:boolean" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                    If set to true, existing spot rate will be preserved.
                    Ignored if SkipRatingFlag is true.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="SkipSavingResultsFlag" type="xsd:boolean" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                    Indicates display-only mode.
                    If set to true, no updates will be applied as a result of the operation.
                    In this case, the operation output will not reflect the current state of the load.
                    Not allowed if SkipRatingFlag is true.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="RateShopFlag" type="xsd:boolean" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                    Indicates whether load rate shop results should be returned.
                    Not allowed if more than one load is included in the request.
                    Ignored if SkipRatingFlag is true.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="IncludeEntriesWithInvalidSchedulingFlag" type="xsd:boolean" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                    If set to true, rate shop entries with invalid scheduling will be
                    included into the output.
                    Not allowed if SkipSavingResultsFlag is not true.
                    Ignored if RateShopFlag is false or SkipRatingFlag is true.
                    Ignored if scheduling is not active for the load,
                    in this case scheduling is not valid for all rate shop entries.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="IgnoreChargeOverridesFlag" type="xsd:boolean" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                Indicates whether charge overrides (below) should be ignored. True by default.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ChargeOverrides" type="cis:ChargeOverrideType" minOccurs="0" maxOccurs="unbounded">
                            <xsd:annotation>
                                <xsd:documentation>
                    The charge overrides for this load rate request. Optional.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ReturnRoutingMessageLogFlag" type="xsd:boolean" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                    Indicates whether diagnostic messages should be generated.
                    Not allowed if more than one load is included in the request.
                    Ignored if SkipRatingFlag is true.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="SupressDetailedResultsFlag" type="xsd:boolean" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                    Indicates whether or not to include detailed results in the response.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
