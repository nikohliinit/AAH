            <xsd:complexType name="processSetShipmentProofOfDeliveryType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of requests to set the Proof of Delivery information for existing shipment legs.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentUpdateProgressData" type="cis:ShipmentUpdateProgressDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of shipment update progress information.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentIDType" type="cis:ShipmentIdEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  An enumerated value defining how the shipment should be identified.
                  
                    SI_NULL - No shipments are retrieved.
                    
                    SI_ID - The shipments to be identified by their IDs.
                    
                    SI_NUM - The shipments to be identified by their shipment numbers.
                    
                    SI_RFRC - The shipments to be identified by their reference numbers.
                    
                    SI_RFRC_DIV - The shipments to be identified by their reference numbers and Division ID.
                    If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then a division can be omitted or, if specified, should match the division to which the user is restricted.
                    
                    SI_TRKG_NUM - The shipments to be identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.

                    SI_TRKG_NUM_DIV - The shipments to be identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.
                    If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then the division can be omitted or, if specified, it should match the division to which the user is restricted.

                    SI_LEG_ID - The shipment legs to be identified by their shipment leg IDs.
                    
                    SI_BOL_NUM_CARR - The shipment legs to be identified by their Carrier Codes and Bill Of Lading Numbers.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IDsAreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                 Indicates whether shipments should be identified by their reference numbers instead of their ID numbers.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberTypeCode" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                 The type of reference numbers used to identify the shipments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventSourceEnumVal" type="cis:EventSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates the source of the event as originating from an application feed (i.e., UI or API) or a specific partner integration.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
