    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastStopEarliestToDeliveryDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
    The earliest of 'delivery to' date/time of the shipments being unloaded at the last stop on the load; expressed in the time zone of the final delivery stop location
    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadPriorityCalculationMethodEnumVal" type="cis:LoadPriorityCalculationMethodEnumValType" minOccurs="0">
