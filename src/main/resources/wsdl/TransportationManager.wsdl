                            <xsd:documentation>
					Description for ARRelationshipEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeCode" type="cis:ChargeCodeType" minOccurs="0">
