                        <xsd:annotation>
                            <xsd:documentation>
			Source value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ValueTo" type="cis:CurrencyValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
