            <xsd:complexType name="TenderRequestType">
                <xsd:annotation>
                    <xsd:documentation>
				A collection of tender requests
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTenderRequestID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID code of the tender request.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TenderRequestStatusEnumVal" type="cis:TenderRequestStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The status of the tender request.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TenderRequestStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Description for tenderRequestStatusEnumVal. Read-only. Available only through UI-oriented APIs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TenderRequestStartedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The start date and time for the load this tender request is for.
                                For a trip level tender request, this is from the first load; 
                                expressed in the time zone of the first pickup stop.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TenderRequestEndDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The end date and time for the load this tender request is for.
                                For a trip level tender request, this is from the last load associated to 
                                the trip tender request; expressed in the time zone of the final delivery stop
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TenderResponseByDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The date and time that the tender response is required.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TenderUpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The date and time that the tender was updated.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TenderAcceptedBy" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The name of the employee who accepted the tender.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CompletedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicate whether this tender request consists of a complete trip or load.
                                For loads not on a trip, it is always true.
                                For load level tender requests of loads assigned to a trip, it is always false.
                                For trip level tender requests, it is true when the number 
                                of loads associated to this tender request is equal to the 
                                total number of loads assigned to the trip. Otherwise, it is false.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumScaledWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The maximum scaled weight of the tender request .
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumVolume" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The maximum volume of the tender request.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The total distance for this tender request.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfLoads" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The number of loads included in this tender request.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstShippingLocationAddressID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The address ID for the first freight pickup stop 
                                of the tendered load or trip.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstShippingPointTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The shipping location type for the first freight pickup stop 
                                of the tendered load or trip.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstShippingPointTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Description for firstShippingPointTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
