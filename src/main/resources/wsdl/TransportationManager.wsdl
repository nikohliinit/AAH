                            <xsd:documentation>
        The Load Priority Calculation Method.
    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadPriorityCalculationMethodEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
        Description for LoadPriorityCalculationMethodEnumVal. Read-only. Available only through UI-oriented APIs.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemUtilizationFactor" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The item utilization factor.
