				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateQuotationRoutingResultsPoint" type="cis:RateQuotationRoutingResultsPointType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The set of location points associated with the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeOverride" type="cis:ChargeOverrideType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The set of charge overrides associated with the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="RateQuotationContainerType">
                <xsd:annotation>
                    <xsd:documentation>
				Container information for a Rate Quotation request.

				The Summarized Entry Mode flag for the applicable Shipment Version will control whether
				weight, volume, order value, declared value and laden length for each occurrence of the container structure
				should be interpreted as being an extended value (Summarized Entry Mode is True) or a per-container value (False).
				When False, the value specified for the container must be extended by the Quantity to establish the extended value.
				The Shipment Version required to derive the value for Summarized Entry Mode flag is retrieved
				from the customer profile if CustomerCode is specified in RateCriteria or from Global Defaults otherwise.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ContainerTypeCode" type="cis:ComponentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The container type ID. Mandatory.
					Container type group ID required for unique identification of a container type is retrieved
					from the customer profile if CustomerCode is specified in RateCriteria or from Global Defaults otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Quantity" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of skids (a.k.a. pallets) or pieces in the container. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightByFreightClass" type="cis:WeightByFreightClassType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The weight by freight class information of the container. "*FAK" indicates Freight All Kinds. Mandatory.
					Currently, only one entry per container is allowed.
					Mode of input depends on Summarized Entry Mode flag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Volume" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The volume of the container.
					If volume is not specified and none of the dimensions (length, width, height) have been specified,
					volume will be derived from the volume for the container type identified by ContainerTypeCode.
					If volume is not specified and at least one of the dimensions have been specified,
					volume will be calculated from dimensions,
					some of the dimensions might be derived from the container type;
					in this case, when at least one of the dimension still has zero value,
					volume will be derived from the volume for the container type.
					Mode of input depends on Summarized Entry Mode flag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OrderValue" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total value of the container. Optional.
					Mode of input depends on Summarized Entry Mode flag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeclaredValue" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The declared value of the container. Optional.
					Mode of input depends on Summarized Entry Mode flag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Length" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The length of the container.
					If not supplied, the default value is retrieved from the container type identified by ContainerTypeCode.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Width" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The width of the container.
					If not supplied, the default value is retrieved from the container type identified by ContainerTypeCode.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Height" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The height of the container.
					If not supplied, the default value is retrieved from the container type identified by ContainerTypeCode.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LadenLength" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total laden length of the container. Optional.
					Mode of input depends on Summarized Entry Mode flag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FlexibleQuantity1" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of Flexible Quantity 1 in the container.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FlexibleQuantity2" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of Flexible Quantity 2 in the container.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FlexibleQuantity3" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of Flexible Quantity 3 in the container.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FlexibleQuantity4" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of Flexible Quantity 4 in the container.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FlexibleQuantity5" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of Flexible Quantity 5 in the container.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemContainerID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The container index. Optional. Cannot be blank.
					Used to reference container level charge details in the output.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentIndex" type="cis:LongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipment index. Optional. Cannot be blank.
					If NumberOfShipments in RateCriteria is specified,
					ShipmentIndex must be less than or equal to NumberOfShipments in RateCriteria,
					otherwise, recommended setting is 1.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="RateQuotationItineraryPointType">
                <xsd:annotation>
                    <xsd:documentation>
			The itinerary point for a rate quotation.
			All data are read-only.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The sequence number of the itinerary point for the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopTypeEnumVal" type="cis:StopEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The pick and drop type of the itinerary point.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for stopTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipping location type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for shippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipping location ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the shipping location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Address" type="cis:AddressType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The address of the location point.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateQuotation" type="cis:RateQuotationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated shipment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="RateQuotationLegType">
                <xsd:annotation>
                    <xsd:documentation>
			The rate quotation leg for a multi-leg rate quotation.
			All data are read-only.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LegSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The rate quotation leg sequence number for a rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APRatingInformation" type="cis:RatingInformationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A/P rating information.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RoutingResultsPoint" type="cis:RateQuotationRoutingResultsPointType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The set of location points associated with the rate quotation leg.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateQuotation" type="cis:RateQuotationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated shipment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="RateQuotationRoutingResultsPointType">
                <xsd:annotation>
                    <xsd:documentation>
			The routing results for a specific location point of a rate quotation or a rate quotation leg.
			All data are read-only.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The sequence number of the location point for the rate quotation or for the rate quotation leg.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopTypeEnumVal" type="cis:StopEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The pick and drop type of the location point.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for stopTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipping location type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for shippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipping location ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the shipping location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Address" type="cis:AddressType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The address of the location point.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LegSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The rate quotation leg sequence number.
				Always equals to 1 if this location point belongs directly to a rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceFromPreviousLocation" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The distance from the previous location to the current location for the rate quotation or for the rate quotation leg.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ArrivalDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The arrival date and time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DepartureDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The departure date and time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HoursFromPreviousLocation" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The transit time from the previous location to the current location for the rate quotation or for the rate quotation leg.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WaitingHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The wait time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadingHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The loading time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnloadingHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The unloading time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeekendHolidayBreakHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The weekend holiday break hours.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StartDateTimeWeekendHolidayBreak" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The start date and time for weekend holiday break.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EndDateTimeWeekendHolidayBreak" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The end date and time for weekend holiday break.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeekendHolidayBreakOrientationEnumVal" type="cis:WeekendHolidayBreakOrientationEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Weekend Holiday Break Orientation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeekendHolidayBreakOrientationEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for weekendHolidayBreakOrientationEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The primary shipping location code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The primary shipping location type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for primaryShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PreloadingPostDischargeStartDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when pre-loading or post-discharge started.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PreloadingPostDischargeEndDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when pre-loading or post-discharge completed.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateQuotation" type="cis:RateQuotationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated shipment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="RateQuotationUpdateDataType">
                <xsd:annotation>
                    <xsd:documentation>
			Information used to update a rate quotation.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemRateQuotationID" type="cis:KeyStringType">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateQuotationDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the rate quotation.
				If rateQuotationDescriptionRequiredFlag for the rate quotation is true, this element cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The logistics group ID of the rate quotation. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExpirationDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The expiration date of the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APSpotRateFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the A/P spot rate is applied to the rate quotation.
				A/P spot rate is not applicable if optimization was used as routing method.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APSpotRateAmount" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The A/P spot rate amount for the rate quotation.
				Ignored if A/P spot rate is not applied.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ARSpotRateFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the A/R Spot Rate is applied to the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ARSpotRateAmount" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The A/R spot rate amount for the rate quotation.
				Ignored if A/R spot rate is not applied.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A memo associated with the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ScheduleType">
                <xsd:annotation>
                    <xsd:documentation>
			A delivery schedule for shipping on a lane, and the times and stops for this schedule.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="DeliveryScheduleCode" type="cis:DeliveryScheduleCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The delivery schedule code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryCode" type="cis:ItineraryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The itinerary code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTimeTableCode" type="cis:ItineraryTimetableCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The itinerary timetable code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTimeTableEntryCode" type="cis:ItineraryTimetableEntryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The itinerary timetable entry code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopSchedule" type="cis:StopScheduleType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The stops and their associated times.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalElapsedTime" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total elapsed time in hours.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalWaitTime" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total departure time in hours.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeekendHolidayBreakHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The weekend holiday break hours.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultScheduleFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The best elapsed time for the schedules.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="StopScheduleType">
                <xsd:annotation>
                    <xsd:documentation>
			The schedule information of a stop for the freight being shipped.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="StopSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The sequence number of the stop in the stop list required by the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ArrivalDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The arrival date and time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DepartureDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The departure date and time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WaitingTime" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The wait time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadingTIme" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The load time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnloadingTime" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The unload time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeekendHolidayBreakHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The weekend holiday break hours.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StartDateTimeWeekendHolidayBreak" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The start date and time for weekend holiday break.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EndDateTimeWeekendHolidayBreak" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The end date and time for weekend holiday break.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeekendHolidayBreakOrientationEnumVal" type="cis:WeekendHolidayBreakOrientationEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The Weekend Holiday Break Orientation.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ValidLaneType">
                <xsd:annotation>
                    <xsd:documentation>
			A valid candidate lane for shipping the specified items.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="TariffCode" type="cis:TariffCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The tariff number of a valid lane.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MasterTariffCode" type="cis:TariffCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The master tariff number of a valid lane.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The service of a valid lane.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateCode" type="cis:RateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The rate code of a valid lane.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The equipment type code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorEquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The tractor equipment type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The tractor domicile.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileTrailerCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The trailer domicile.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceEngine" type="cis:ExternalEngineVersionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The external engine version (distance engine) code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeAmount" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The charge for the shipping.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeAmountInTariffCurrency" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The charge in the currency of the tariff.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The currency of the tariff.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRate" type="cis:ExchangeRateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The exchange rate of the tariff to the system currency.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier for the lane.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SchedulingValidFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether shipment information is available.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BestTotalHoursElapsedTime" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The hours of elapsed time for delivery.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceGradeCode" type="cis:ShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The grade for the service provided by the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Schedule" type="cis:ScheduleType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				schedule and stop information.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeDetail" type="cis:ChargeDetailType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The charge details for the lane.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LegSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The rate quotation leg sequence number for a rate quotation.
				Meaningful only when routing method is Optimization.
				In this case, rate shopping is disabled and only one lane is provided for each rate quotation leg.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipFromLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The type of the rate quotation leg origin shipping location.
				Meaningful only when routing method is Optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipFromLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the rate quotation leg origin shipping location.
				Meaningful only when routing method is Optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginCity" type="cis:CityNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The origin city of the rate quotation leg.
				Meaningful only when routing method is Optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginState" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The origin state or province of the rate quotation leg.
				Meaningful only when routing method is Optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginPostalCode" type="cis:PostalCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The origin zip or postal code of the rate quotation leg.
				Meaningful only when routing method is Optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginCountry" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The origin country of the rate quotation leg.
				Meaningful only when routing method is Optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginLatitude" type="cis:LatitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The origin latitude of the rate quotation leg.
				Meaningful only when routing method is Optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginLongitude" type="cis:LongitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The origin longitude of the rate quotation leg.
				Meaningful only when routing method is Optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipToLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The type of the rate quotation leg destination shipping location.
				Meaningful only when routing method is Optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipToLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the rate quotation leg destination shipping location.
				Meaningful only when routing method is Optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationCity" type="cis:CityNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The destination city of the rate quotation leg.
				Meaningful only when routing method is Optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationState" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The destination state or province of the rate quotation leg.
				Meaningful only when routing method is Optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationPostalCode" type="cis:PostalCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The destination zip or postal code of the rate quotation leg.
				Meaningful only when routing method is Optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationCountry" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The destination country of the rate quotation leg.
				Meaningful only when routing method is Optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationLatitude" type="cis:LatitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The destination latitude of the rate quotation leg.
				Meaningful only when routing method is Optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationLongitude" type="cis:LongitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The destination longitude of the rate quotation leg.
				Meaningful only when routing method is Optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightAuctionEligibilityEnumVal" type="cis:FreightAuctionEligibilityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Type of freight auction eligibility.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The tariff lane ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCost" type="cis:ExternalCostType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					An external cost entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="BookingFilterCriteriaType">
                <xsd:annotation>
                    <xsd:documentation>
			    Booking filtering criteria for Optimizer re-planning.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					List of Booking IDs. If specified, bookings will be filtered with the list of Booking IDs.
					Wild card character % is allowed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of Logistics Group Codes for bookings. If specified, bookings will be filtered with the list of Logistics Group Codes.
                    Wild card character % is allowed. Comma should not be entered here, it will be treated as field separator and may result in syntax error.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of Carrier Codes for bookings. If specified, bookings will be filtered with the list of Carrier Codes.
                    Wild card character % is allowed. Comma should not be entered here, it will be treated as field separator and may result in syntax error.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of Service Codes for bookings. If specified, bookings will be filtered with the list of Service Codes.
                    Wild card character % is allowed. Comma should not be entered here, it will be treated as field separator and may result in syntax error.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrentTripOperationalStatusEnumVal" type="cis:TripOperationalStatusEnumValType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of Operational Statuses for bookings. If specified, bookings will be filtered with the list of Operational Statuses.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrentTripFinancialStatusEnumVal" type="cis:TripFinancialStatusEnumValType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of Financial Statuses for bookings. If specified, bookings will be filtered with the list of Financial Statuses.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginCountry" type="cis:CountryCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of Origin Countries. If specified, bookings will be filtered with the list of Origin Countries.
                    Wild card character % is allowed. Comma should not be entered here, it will be treated as field separator and may result in syntax error.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginState" type="cis:StateCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of Origin States. If specified, bookings will be filtered with the list of Origin States.
                    Wild card character % is allowed. Comma should not be entered here, it will be treated as field separator and may result in syntax error.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginCity" type="cis:CityNameType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of Origin Cities. If specified, bookings will be filtered with the list of Origin Cities.
                    Wild card character % is allowed. Comma should not be entered here, it will be treated as field separator and may result in syntax error.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationCountry" type="cis:CountryCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of Destination Countries. If specified, bookings will be filtered with the list of Destination Countries.
                    Wild card character % is allowed. Comma should not be entered here, it will be treated as field separator and may result in syntax error.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationState" type="cis:StateCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of Destination States. If specified, bookings will be filtered with the list of Destination States.
                    Wild card character % is allowed. Comma should not be entered here, it will be treated as field separator and may result in syntax error.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationCity" type="cis:CityNameType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of Destination Cities. If specified, bookings will be filtered with the list of Destination Cities.
                    Wild card character % is allowed. Comma should not be entered here, it will be treated as field separator and may result in syntax error.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginShippingLocation" type="cis:StopShippingLocationType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					List of First Stop Shipping Locations.
					Not returned by UI-oriented APIs if the optimization request is created by Transportation Manager Web UI,
					please see OriginShippingLocationTypeEnumVal and OriginShippingLocationCode.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationShippingLocation" type="cis:StopShippingLocationType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					List of Last Stop Shipping Locations.
					Not returned by UI-oriented APIs if the optimization request is created by Transportation Manager Web UI,
					please see DestinationShippingLocationTypeEnumVal and DestinationShippingLocationCode.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					List of the First Stop Shipping Location types.
					Used only by UI-oriented APIs for optimization requests created by Transportation Manager Web UI.
					This field is ignored for creation of optimization requests,
					please use OriginShippingLocation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					List of the First Stop Shipping Location codes.
					Used only by UI-oriented APIs for optimization requests created by Transportation Manager Web UI.
					This field is ignored for creation of optimization requests,
					please use OriginShippingLocation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					List of the Last Stop Shipping Location types.
					Used only by UI-oriented APIs for optimization requests created by Transportation Manager Web UI.
					This field is ignored for creation of optimization requests,
					please use DestinationShippingLocation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					List of the Last Stop Shipping Location codes.
					Used only by UI-oriented APIs for optimization requests created by Transportation Manager Web UI.
					This field is ignored for creation of optimization requests,
					please use DestinationShippingLocation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Vessel" type="cis:VesselNameType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of Vessel Names for bookings. If specified, bookings will be filtered with the list of Vessel Names.
                    Wild card character % is allowed. Comma should not be entered here, it will be treated as field separator and may result in syntax error.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoyageNumber" type="cis:VoyageNumberType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of Voyage Numbers for bookings. If specified, bookings will be filtered with the list of Voyage Numbers.
                    Wild card character % is allowed. Comma should not be entered here, it will be treated as field separator and may result in syntax error.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DepartureShippingLocation" type="cis:StopShippingLocationType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of Vessel Departure Shipping Locations.
                    Not returned by UI-oriented APIs if the optimization request is created by Transportation Manager Web UI,
                    please see DepartureShippingLocationTypeEnumVal and DepartureShippingLocationCode.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ArrivalShippingLocation" type="cis:StopShippingLocationType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of Vessel Arrival Shipping Locations.
                    Not returned by UI-oriented APIs if the optimization request is created by Transportation Manager Web UI,
                    please see ArrivalShippingLocationTypeEnumVal and ArrivalShippingLocationCode.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DepartureShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of the Vessel Departure Shipping Location types.
                    Used only by UI-oriented APIs for optimization requests created by Transportation Manager Web UI.
                    This field is ignored for creation of optimization requests,
                    please use DepartureShippingLocation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DepartureShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of the Vessel Departure Shipping Location codes.
                    Used only by UI-oriented APIs for optimization requests created by Transportation Manager Web UI.
                    This field is ignored for creation of optimization requests,
                    please use DepartureShippingLocation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ArrivalShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of the Vessel Arrival Shipping Location types.
                    Used only by UI-oriented APIs for optimization requests created by Transportation Manager Web UI.
                    This field is ignored for creation of optimization requests,
                    please use ArrivalShippingLocation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ArrivalShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of the Vessel Arrival Shipping Location codes.
                    Used only by UI-oriented APIs for optimization requests created by Transportation Manager Web UI.
                    This field is ignored for creation of optimization requests,
                    please use ArrivalShippingLocation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResourceProjectTypeCode" type="cis:ResourceProjectIDDomainValueType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of Resource Project IDs. If specified, booking loads will be filtered with the list of Resource Project IDs.
                    Empty elements are ignored, please provide a double-quoted space (" ") for the default Resource Project ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="CompTrackingNumberType">
                <xsd:annotation>
                    <xsd:documentation>
			A container (formerly called component) tracking number override used in shipment confirmation.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ReferenceNumberTypeCode" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The reference number type identifying the container (formerly called component) to which the tracking number is applied. This must be "API".
				Required for all operations. If the value entered is not "API", it will still be treated as "API".
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The reference number identifying the container (formerly called component) to be applied.
				Required for all operations.
                                For container with quantity greater than one, the number of API container reference number can be one or greater than one.
                                For example, if the quantity of the container is three, then the API container reference numbers can be:
                                case 1: CON-REF1
                                case 2: CON-REF1 and CON-REF2
                                case 3: CON-REF1, CON-REF3 and CON-REF3
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrackingNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The overriding tracking number for the specified container (formerly called) component.
				Required for all operations.
                                Possible cases for the quantity field of the container greater than one, let say three, could be:
                                case 1: type API, reference number CON-REF1, tracking number CON-TRACK1
                                        type API, reference number CON-REF1, tracking number CON-TRACK2
                                        type API, reference number CON-REF1, tracking number CON-TRACK3
                                case 2: type API, reference number CON-REF1, tracking number CON-TRACK1
                                        type API, reference number CON-REF2, tracking number CON-TRACK2
                                        type API, reference number CON-REF2, tracking number CON-TRACK3
                                case 3: type API, reference number CON-REF1, tracking number CON-TRACK1
                                        type API, reference number CON-REF2, tracking number CON-TRACK2
                                        type API, reference number CON-REF3, tracking number CON-TRACK3
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ComponentReferenceNumberType">
                <xsd:annotation>
                    <xsd:documentation>
			A reference number of a Container (formerly called Component).
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Item" type="xsd:integer" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Always returned as zero.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberTypeCode" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
		A domain table value that indicates the reference number qualifier type for this reference number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for referenceNumberTypeCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The value of the reference number or code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ContainerType">
                <xsd:annotation>
                    <xsd:documentation>
			A single detail (Container or Item Summary) within a shipment which is used to store items. A container has attributes such as weight, length, width, height, and volume.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemContainerID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated shipment detail ID.
					This is a read-only field except for Update and Delete options
					of the container maintenance operation where it is mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerTypeCode" type="cis:ComponentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The container type.
                Ignored if shipment entry mode is Item Summary Level, otherwise mandatory for a new or recreated Container and cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Quantity" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The number of identical shipment details. Mandatory for a new Container. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Length" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The length of the shipment detail. If NULL, then the default value for a container is based on the component type that containerTypeCode specifies.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Width" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The width of the shipment detail. If NULL, then the default value for a container is based on the component type that containerTypeCode specifies.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Height" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The height of the shipment detail. If NULL, then the default value for a container is based on the component type that containerTypeCode specifies.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerShippingInformation" type="cis:ShippingInformationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipping information structure.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of this shipment detail.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StackCode" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The stacking mode ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StackFactor" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The stacking factor: the amount of weight that can be stacked on top of this shipment detail.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StackGroup" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The stacking group: indicates the relative durability of this shipment detail.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NestingDimensionEnumVal" type="cis:ControlDimensionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The container dimension along which the nesting occurs. if no value is assigned, then nesting is not allowed.
                    Currently not in use.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NestingDimensionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Description for NestingDimensionEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NestingValue" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The nesting value: the increase along the nesting dimension with each additional nested unit. if no value is assigned, then nesting is not allowed.
                    Currently not in use.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNestingSize" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum number of allowed nested units. If no value is assigned, then nesting is not allowed.
                    Currently not in use.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Occurence" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipment detail occurrence. Used as a factor when calculating the total scaled weight, volume, order value, and declared value for the shipment having this container. It is equal to 1 when the summarized entry mode is false, and equal to the container quantity when the summarized entry mode is true.
				This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadConfiguratorContainerTypeCode" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The load configuration container type. This is a read-only field.
                This element is not in use.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatingUnitEnumVal" type="cis:UnitEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The rating unit type. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatingUnitEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for RatingUnitEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumScaledWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum scaled weight. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentContainerNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipment container number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentContainerCrossReference" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The cross-reference of the shipment container.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerGLCategory" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The G/L category for items for this container. This is a read-only field.
                    Currently not in use.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InputSourceEnumVal" type="cis:TransactionSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The source of data input, such as API, EDI or through the GUI.
					This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InputSourceEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for InputSourceEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MarkedForLocationEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    A location to which the container is taken after the shipment is delivered.
                    Currently not in use.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MarkedForLocationEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Description for MarkedForLocationEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MarkedForLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID for the location to which the container is taken after the shipment is delivered.
                    Currently not in use.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DisplayColor" type="cis:DisplayColorType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    A display color for item summary.
                    Ignored if Shipment Entry Mode is not Item Summary Level.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DisplayName" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    A display name for item summary.
                    Ignored if Shipment Entry Mode is not Item Summary Level.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StackingRuleEnumVal" type="cis:StackingRuleEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The stacking rule.
                    Ignored if Load Configurator is not enabled in Global Defaults.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StackingRuleEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for StackingRuleEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierPackageType" type="cis:CarrierPackageDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The carrier packaging type.
                    Ignored if Shipment Entry Mode is not Item Summary Level.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierPackageTypeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for CarrierPackageType. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierPackageRegion" type="cis:CarrierPackageRegionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The carrier packaging region.
                    Ignored if Shipment Entry Mode is not Item Summary Level.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SplitMethodEnumVal" type="cis:SplitMethodEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The split method.
                    Ignored if Shipment Entry Mode is Item Detail Level or split method of the shipment is not Shipment Detail Level.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SplitMethodEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for SplitMethodEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadConfiguratorContainerTypeEnumVal" type="cis:LoadConfiguratorContainerTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Load Configurator container type.
                    Ignored if Load Configurator is not enabled in Global Defaults.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadConfiguratorContainerTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for LoadConfiguratorContainerTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemNumber" type="cis:ItemNumberCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Item Master ID.
                    Ignored if Shipment Entry Mode is not Item Summary Level, otherwise mandatory for a new or recreated shipment detail and cannot be blank.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemGroupCode" type="cis:ItemGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Item Group ID. This field is read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemPackageLevelIDCode" type="cis:ItemPackageLevelIDTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The item package level type ID.
                    Ignored if Shipment Entry Mode is not Item Summary Level.
                    System-defined values are '100' for 'Pallets', '200' for 'Layers' and '300' for 'Pieces'.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemPackageLevelIDCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ItemPackageLevelIDCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemDescription" type="cis:ItemDescriptionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The item description.
                    Ignored if Shipment Entry Mode is not Item Summary Level, otherwise cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfUnits" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The number of units.
                    Ignored if Shipment Entry Mode is not Item Summary Level.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Is3DLoadingRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether 3D loading is required.
                    Ignored if Load Configurator is not enabled in Global Defaults.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemType" type="cis:ItemDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The item type.
                    Ignored if Shipment Entry Mode is not Item Summary Level.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemTypeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Description for ItemType. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContentLevelTypeCode" type="cis:ItemPackageLevelIDTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The content level type.
                    Ignored if Shipment Entry Mode is not Item Summary Level.
                    System-defined values are '100' for 'Pallets', '200' for 'Layers' and '300' for 'Pieces'.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContentLevelTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ContentLevelTypeCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Priority" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Priority: the lower the number, the higher the priority.
                    Ignored if Shipment Entry Mode is not Item Summary Level.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemPackagingCommittedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether item packaging is committed.
                    Ignored if Shipment Entry Mode is not Item Summary Level.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginCountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The country of origin.
                    Ignored if Shipment Entry Mode is not Item Summary Level.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the Shipment
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTransportOrderID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the Associated Transport Order
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightByFreightClassCode" type="cis:FreightClassCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Freight Class Code
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightByFreightClassCount" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    count of number of Freight classes associated with the container
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreContainerOrientationsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of ContainerOrientation should be ignored.
					Used only for Update option of the container maintenance operation,
					otherwise assumed to be false regardless of the input.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerOrientationStr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The text representation of container orientation attached to the shipment detail.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerOrientation" type="cis:ContainerOrientationType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The container orientation objects attached to the shipment detail.
					Presence depends on the value of IgnoreContainerOrientationsFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreWeightByFreightClassFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of WeightByFreightClass should be ignored.
					Used only for Update option of the shipment detail maintenance operation,
					otherwise assumed to be false regardless of the input.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightByFreightClass" type="cis:WeightByFreightClassType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    The weight by freight classes associated with the shipment detail.
                    Presence depends on the value of IgnoreWeightByFreightClassFlag.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreShipmentItemsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of ShipmentItem should be ignored.
					Used only for Update option of the container maintenance operation,
					otherwise assumed to be false regardless of the input.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentItem" type="cis:ShipmentItemType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Shipment items associated with the container.
					Presence depends on the value of IgnoreShipmentItemsFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of ReferenceNumberStructure should be ignored.
                    May be present for create and update operations at shipment or shipment detail level.
                    For shipment level operations, when this value is true,
                    all existing reference numbers are removed.
                    For Update option of the shipment detail maintenance operation,
                    when the value is true, existing shipment detail reference numbers are preserved.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberStructure" type="cis:ComponentReferenceNumberType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Reference numbers associated with the shipment detail.
                    Presence depends on the value of IgnoreReferenceNumbersFlag.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransportOrderInfo" type="cis:TransportOrderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Transport Order associated with the shipment detail.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Shipment" type="cis:ShipmentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Shipment this shipment detail belongs to.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ContainerOrientationType">
                <xsd:annotation>
                    <xsd:documentation>
			The orientation of a container.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ContainerOrientationEnumVal" type="cis:ContainerOrientationEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The container orientation type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OrientationAllowedEnumVal" type="cis:ContainerOrientationAllowedEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				indicates whether the orientation is allowed, disallowed, or undefined.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Preference" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The container orientation preference.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ContainerPlanType">
                <xsd:annotation>
                    <xsd:documentation>
        Container information that is used in the shipment planning service.
        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ContainerTypeCode" type="cis:ComponentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The container type. Cannot be blank.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Quantity" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The number of identical containers. Mandatory for a new ContainerPlan. Cannot be blank.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerShippingInformation" type="cis:ShippingInformationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The container shipping information structure. Mandatory for a new ContainerPlan. Cannot be blank.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The commodity code. Mandatory for a new ContainerPlan unless the commodity can be retrieved from the provided ItemNumber. Cannot be blank.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PickupFromDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The start of the date and time range in which the container should be picked up.
            Mandatory for a new ContainerPlan. Cannot be blank.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PickupToDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The end of the date and time range in which the container should be picked up.
            Mandatory for a new ContainerPlan. Cannot be blank.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryFromDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The start of the date and time range in which the container should be delivered.
            Mandatory for a new ContainerPlan. Cannot be blank.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryToDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The end of the date and time range in which the container should be delivered.
            Mandatory for a new ContainerPlan. Cannot be blank.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The container ID. Mandatory for a new ContainerPlan. Cannot be blank.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentConsolidationClassCode" type="cis:ConsolidationClassType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The shipment consolidation class.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MergeInTransitConsolidationCode" type="cis:MitccIdType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The merge consolidation class code.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MergeInTransitConsolidationNum" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The merge consolidation sequence number.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Length" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The length of the container.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Width" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The width of the container.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Height" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The height of the container.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowSplitFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Indicates whether this container can be split.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StackHeight" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The stack height.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StackGroup" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The durability of the container's contents relative to the other containers.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StackFactor" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The amount of weight that can be stacked on top of this container.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreContainerOrientationsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Indicates whether the contents of containerOrientation can be ignored. May be present for add and change operations.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerOrientation" type="cis:ContainerOrientationType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
            The container orientation objects attached to the container. Presence depends on the value of IgnoreContainerOrientationsFlag.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NestingDimensionEnumVal" type="cis:ControlDimensionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The nesting container dimension: Height, Length or Width.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NestingValue" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Used with the nesting dimension to indicate how a container increases in size with each additional nested unit
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNestingSize" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The maximum number of units in a nested stack.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemNumber" type="cis:ItemNumberCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Item Master ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadConfiguratorContainerTypeEnumVal" type="cis:LoadConfiguratorContainerTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Load Configurator container type. If not supplied and ContainerTypeCode is not supplied, Box is assumed.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Priority" type="cis:ShipmentPriorityType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The priority.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="LoadFilterCriteriaType">
                <xsd:annotation>
                    <xsd:documentation>
			Load filtering criteria for Optimizer re-planning.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				List of Load IDs.  If specified, loads will be filtered with the list of load IDs.
                                Wild card character % is allowed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadTrackingNumber" type="cis:NameType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                List of Tracking Numbers of the load. Tracking Number is stored as the description of the load.
                                Wild card character % is allowed. Comma should not be entered here, it will treated as field separator and may result in syntax error.
                                If specified, loads will be filtered with the list of Tracking Numbers.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                List of Commodity Codes of the load. If specified, loads will be filtered with the list of Commodity Codes.
                                Wild card character % is allowed. Comma should not be entered here, it will treated as field separator and may result in syntax error.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                List of Logistics Group Codes of the load. If specified, loads will be filtered with the list of Logistics Group Codes.
                                Wild card character % is allowed. Comma should not be entered here, it will treated as field separator and may result in syntax error.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                List of Carrier Codes of the load. If specified, loads will be filtered with the list of Carrier Codes.
                                Wild card character % is allowed. Comma should not be entered here, it will treated as field separator and may result in syntax error.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrentLoadOperationalStatusEnumVal" type="cis:LoadOperationalStatusEnumValType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                List of Operational Statuses of the load. If specified, loads will be filtered with the list of Operational Statuses.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                List of Service Codes of the load. If specified, loads will be filtered with the list of Service Codes.
                                Wild card character % is allowed. Comma should not be entered here, it will treated as field separator and may result in syntax error.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                List of Equipment Type Codes of the load. If specified, loads will be filtered with the list of Equipment Type Codes.
                                Wild card character % is allowed. Comma should not be entered here, it will treated as field separator and may result in syntax error.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PlanningStatusEnumVal" type="cis:PlanningStatusEnumValType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                List of Planning Statuses of the load. If specified, loads will be filtered with the list of Planning Statuses.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginCountry" type="cis:CountryCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                List of Origin Countries. If specified, loads will be filtered with the list of Origin Countries.
                                Wild card character % is allowed. Comma should not be entered here, it will treated as field separator and may result in syntax error.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginState" type="cis:StateCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                List of Origin Cities. If specified, loads will be filtered with the list of Origin States.
                                Wild card character % is allowed. Comma should not be entered here, it will treated as field separator and may result in syntax error.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginCity" type="cis:CityNameType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                List of Origin Cities. If specified, loads will be filtered with the list of Origin Cities.
                                Wild card character % is allowed. Comma should not be entered here, it will treated as field separator and may result in syntax error.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationCountry" type="cis:CountryCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                List of Destination Countries. If specified, loads will be filtered with the list of Destination Countries.
                                Wild card character % is allowed. Comma should not be entered here, it will treated as field separator and may result in syntax error.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationState" type="cis:StateCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                List of Destination States. If specified, loads will be filtered with the list of Destination States.
                                Wild card character % is allowed. Comma should not be entered here, it will treated as field separator and may result in syntax error.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationCity" type="cis:CityNameType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                List of Destination Cities. If specified, loads will be filtered with the list of Destination Cities.
                                Wild card character % is allowed. Comma should not be entered here, it will treated as field separator and may result in syntax error.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginShippingLocation" type="cis:StopShippingLocationType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					List of First Stop Shipping Locations.
					Not returned by UI-oriented APIs if the optimization request is created by Transportation Manager Web UI,
					please see originShippingLocationTypeEnumVal and originShippingLocationCode.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationShippingLocation" type="cis:StopShippingLocationType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					List of Last Stop Shipping Locations.
					Not returned by UI-oriented APIs if the optimization request is created by Transportation Manager Web UI,
					please see destinationShippingLocationTypeEnumVal and destinationShippingLocationCode.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					List of the First Stop Shipping Location types.
					Used only by UI-oriented APIs for optimization requests created by Transportation Manager Web UI.
					This field is ignored for creation of optimization requests,
					please use originShippingLocation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					List of the First Stop Shipping Location codes.
					Used only by UI-oriented APIs for optimization requests created by Transportation Manager Web UI.
					This field is ignored for creation of optimization requests,
					please use originShippingLocation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					List of the Last Stop Shipping Location types.
					Used only by UI-oriented APIs for optimization requests created by Transportation Manager Web UI.
					This field is ignored for creation of optimization requests,
					please use destinationShippingLocation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					List of the Last Stop Shipping Location codes.
					Used only by UI-oriented APIs for optimization requests created by Transportation Manager Web UI.
					This field is ignored for creation of optimization requests,
					please use destinationShippingLocation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResourceProjectTypeCode" type="cis:ResourceProjectIDDomainValueType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of Resource Project IDs. If specified, loads will be filtered with the list of Resource Project IDs.
                    Empty elements are ignored, please provide a double-quoted space (" ") for the default Resource Project ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemSkeletonRouteID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    List of system-generated skeleton route IDs. If specified, loads will be filtered with the list of skeleton route IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="SelectionCriteriaType">
                <xsd:annotation>
                    <xsd:documentation>
			Select for Optimization Criteria For Shipment Legs.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemPlanID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The plan ID. Required for all operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				List of Shipment IDs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginCity" type="cis:CityNameType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				List of Origin Cities.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationCity" type="cis:CityNameType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				List of Destination Cities.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PickupFromDate" type="xsd:date" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The start of the date and time range in which the shipment should be picked up.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PickupToDate" type="xsd:date" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The end of the date and time range in which the shipment should be picked up.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryFromDate" type="xsd:date" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The start of the date and time range in which the shipment should be delivered.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryToDate" type="xsd:date" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The end of the date and time range in which the shipment should be delivered.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginShippingLocation" type="cis:OriginShippingLocationType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				List of Origin Shipping Locations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationShippingLocation" type="cis:DestinationShippingLocationType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				List of Destination Shipping Locations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ShipmentType">
                <xsd:annotation>
                    <xsd:documentation>
                The physical collection of components that moves between any two given locations.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Internal ID. Applicable only for UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                An automatically generated system shipment identifier. This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentNumber" type="cis:ShipmentNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shipment number.
                    Cannot be changed if used to identify the shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The customer ID. Mandatory for a new Shipment. Cannot be blank.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentEntryVersionCode" type="cis:OrderVersionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The shipment entry version ID. Cannot be changed for an existing Shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentEntryTypeCode" type="cis:OrderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The shipment entry version type ID. Cannot be changed for an existing Shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The logistics group ID. Cannot be changed for an existing Shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The division ID. Cannot be changed for an existing Shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTemplateCode" type="cis:JourneyTemplateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The journey template code. Cannot be changed for an existing Shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentInputSourceEnumVal" type="cis:InputSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The source from which the shipment was created. Cannot be changed for an existing Shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentInputSourceEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for shipmentInputSourceEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ProjectCode" type="cis:ProjectCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The project ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HoldFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether the shipment is on hold or is to be placed on hold later.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentEntryModeEnumVal" type="cis:TransportOrderModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The mode in which the shipment was created. Cannot be changed for an existing Shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentEntryModeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for shipmentEntryModeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ConsigneeGroupCode" type="cis:ConsigneeGroupDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The type of consignee group.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ConsigneeGroupCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for consigneeGroupCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PreferredAPCarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The default carrier ID. Cannot be changed for an existing Shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PreferredAPServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The default A/P service ID. Cannot be changed for an existing Shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The trailer equipment type. Cannot be changed for an existing Shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorEquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The tractor equipment type. Cannot be changed for an existing Shipment.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierServiceEquipmentRuleEnumVal" type="cis:CarrierServiceEquipmentRuleEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The carrier service equipment rule. It propagates the carrier, service and equipment type defined in the shipment structure to the first leg, last leg, or all legs of the itinerary. This rule only applies to a journey template, and does not apply if the shipment throughpoints are defined. The values are CSE_NULL, CSE_FIRSTLEG, CSE_LASTLEG, and CSE_ALLLEGS.
                Cannot be changed for an existing Shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ARServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The A/R service code.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SalesPersonCode" type="cis:SalesPersonCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The sales person responsible for the shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemPlanID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The plan ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentDescription" type="cis:ShipmentDescriptionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                A description of the shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightTermsEnumVal" type="cis:FreightTermsType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The freight terms.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightTermsEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for freightTermsEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BillToCustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The customer to whom the bill will be sent.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BillToCustomerName" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The customer name to whom the bill will be sent.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipDirectFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether the shipment is to be shipped directly.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UrgentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether the shipment is urgent.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentConsolidationClassCode" type="cis:ConsolidationClassType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The shipment consolidation class.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MergeInTransitConsolidationCode" type="cis:MitccIdType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The merge in transit consolidation class (Load MITCC).
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MergeInTransitConsolidationNum" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The merge in transit consolidation class (MITCC) sequence number.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                A memo associated with the shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipFromLocationTypeEnumVal" type="cis:ShipFromPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The type of shipment origin point.
                    If not supplied for Create,
                    one and only one origin location with the specified code should exist.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipFromLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for shipFromLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipFromLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The code of the shipment origin point.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipFromDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                A description of the shipment origin point.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipFromAddress" type="cis:AddressType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The address of the shipment origin point.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipFromAppointmentRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether an appointment is required at the shipment origin point.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipToLocationTypeEnumVal" type="cis:ShipToPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The type of shipment destination point.
                    If not supplied for Create,
                    one and only one destination location with the specified code should exist.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipToLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for shipToLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipToLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The shipment destination point code.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipToDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                A description of the shipment destination point.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipToAddress" type="cis:AddressType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The address of the shipment destination point.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipToAppointmentRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether an appointment is required for the shipment destination.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PickupFromDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The start of the date and time range in which the shipment should be picked up.
                Mandatory for a new Shipment. Cannot be blank.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PickupToDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The end of the date and time range in which the shipment should be picked up.
                Mandatory for a new Shipment. Cannot be blank.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryFromDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The start of the date and time range in which the shipment should be delivered.
                Mandatory for a new Shipment. Cannot be blank.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryToDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The end of the date and time range in which the shipment should be delivered.
                Mandatory for a new Shipment. Cannot be blank.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RecomputeDatesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether to re-calculate the pickup and delivery dates using the default dates.
                Cannot be changed for an existing Shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The commodity code.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ProfitCenterCode" type="cis:ProfitCenterDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The profit center type.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ProfitCenterCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for profitCenterCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerServiceRepresentativeCode" type="cis:CustomerServiceRepDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The customer service representative type.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerServiceRepresentativeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for customerServiceRepresentativeCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityPickSequenceRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether a pick sequence is required for the shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EligibleForInterDivisionTransferFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether a shipment is eligible for inter-division transfer.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EligibleForLogisticsGroupReassignmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether a shipment is eligible for logistics group re-assignment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BatchNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The batch number. The maximum value is 9999
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShiftSequence" type="cis:ShiftSequenceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shift sequence to be used for optimization.
                    Input value has to be zero if the database value should be nullified, value of zero is not allowed in the database.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceEngine" type="cis:ExternalEngineVersionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The external engine version (distance engine) code associated with the shipment. Read Only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID of the user who created the shipment. This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID of the user who updated the shipment. This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The date and time that the shipment was created. This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The date and time that the shipment was updated. This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The rating currency of the tariff used to rate the shipment. This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for currencyCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InputCurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The input currency type.
                    Cannot be changed for an existing Shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InputCurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for inputCurrencyCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRate" type="cis:ExchangeRateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The exchange rate for the rating currency of the tariff used to rate the shipment. This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrentShipmentOperationalStatusEnumVal" type="cis:ShipmentOperationalStatusValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The current operational status. This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrentShipmentOperationalStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for currentShipmentOperationalStatusEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrentShipmentFinancialStatusEnumVal" type="cis:ShipmentFinancialStatusValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The current financial status. This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrentShipmentFinancialStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for currentShipmentFinancialStatusEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnitOfMeasure" type="cis:UnitOfMeasureType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The structure of units of measurement used for input values.
                    Cannot be changed for an existing Shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffUnitOfMeasure" type="cis:UnitOfMeasureType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The units of measurement of the tariff used to rate the shipment. This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingInformation" type="cis:ShippingInformationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The shipping information structure. This is a read-only field.
                Values expressed in shipment input units of measure and currency.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOVersionEnumVal" type="cis:INCOVersionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The INCO terms version.
                    Cannot be changed for an existing Shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOVersionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for INCOVersionEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOTermsCode" type="cis:INCOTermsCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The INCO terms code.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BuyerSellerEnumVal" type="cis:INCOBuyerSellerEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                A description of the buyer and seller relationship.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BuyerSellerEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for buyerSellerEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The default INCO terms shipping location code.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The default INCO terms shipping location type.
                    For Create or for Update with INCO shipping location change,
                    if INCOShippingLocationCode is specified but
                    INCOShippingLocationTypeEnumVal is not specified,
                    one and only one shipping location with the specified code should exist.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for INCOShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncotermsCommittedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether the Incoterms shipping location is committed.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultIncoShippingLocationTypeEnumVal" type="cis:DefaultIncoShippingLocationTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Default Incoterms Shipping Location Type. Optional. Read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultIncoShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for defaultIncoShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrepaidSegOnlyFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether the segment is prepaid only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OrderValueRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The order value.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeclaredValueRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The declared value.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeferAPRatingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether the A/P rating is deferred.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeferARRatingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether the A/R rating is deferred.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RevenueFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether the shipment produces revenue.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumOrderValue" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The maximum order value. This is a read-only field.
                Expressed in shipment input currency.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum weight. This is a read-only field.
                    Expressed in shipment input units of measure.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumVolume" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum volume. This is a read-only field.
                    Expressed in shipment input units of measure.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IneligibleForManualDeleteFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether the shipment is ineligible for selective (manual) deletion.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UseOriginDefaultsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether the origin shipping location profile is refreshed. May be present for change operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UseDestinationDefaultsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether the destination shipping location profile is refreshed. May be present for change operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BaseLadenLength" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Laden length of the shipment. Expressed in base system units of measure.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BaseWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Weight of the shipment. Expressed in base system units of measure.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BaseVolume" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Volume of the shipment. Expressed in base system units of measure.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BaseOrderValue" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Order value of the shipment. Expressed in the system currency.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BaseDeclaredValue" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Declared value of the shipment. Expressed in the system currency.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemGroupCode" type="cis:ItemGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The item group code.
                    Cannot be changed for an existing Shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ComponentTypeGroupCode" type="cis:ComponentTypeGroupType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The container type group code.
                    Cannot be changed for an existing Shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransitModeEnumVal" type="cis:TransitModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The transit mode. The possible values are TSM_NULL, TSM_AIR, TSM_RAIL, TSM_ROAD, TSM_MARINE, TSM_PARCEL, TSM_TRUCKLOAD, TSM_LTL, TSM_INTERMODAL, TSM_USERDEFINED_1, TSM_USERDEFINED_2, TSM_USERDEFINED_3, TSM_USERDEFINED_4, TSM_USERDEFINED_5, TSM_USERDEFINED_6, TSM_USERDEFINED_7, TSM_USERDEFINED_8, TSM_USERDEFINED_9 and TSM_CLEAR.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransitModeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for transitModeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyARSpotRateFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether the A/R Spot Rate is applied to the shipment rating results. May be present for add and change operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ARSpotRateAmount" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The A/R Spot Rate amount. Presence depends on the value of applyARSpotRateFlag.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentLegReportDetailsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
