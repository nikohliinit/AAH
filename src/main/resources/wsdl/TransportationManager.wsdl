            </xsd:complexType>
            <xsd:complexType name="TariffChargeType">
                <xsd:annotation>
                    <xsd:documentation>
			A tariff charge.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The tariff ID. Cannot be changed for an existing Tariff Charge.
				Mandatory unless the data are used to create new tariff.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The tariff service code. Cannot be changed for an existing Tariff Charge.
				                         Mandatory for creation, modification or deletion of a Tariff Charge.
				                         Ignored when querying Tariff Charges.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffChargeCode" type="cis:ChargeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The tariff charge code. Cannot be changed for an existing Tariff Charge.
				                        Mandatory for creation, modification or deletion of a Tariff Charge.
				                        Ignored when querying Tariff Charges.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the tariff charge. Mandatory for a new Tariff Charge.
				Cannot be an empty element. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ConditionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the tariff charge is a condition (otherwise it's an option).
                                Cannot be changed for an existing Tariff Charge.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumUnitsForRateApplication" type="cis:NumberOfUnitsWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum number of units for rate application.
				Mandatory for a new Tariff Charge if it is not Based on Carrier.  Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumUnitsForRateApplication" type="cis:NumberOfUnitsWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The minimum number of units for rate application.
				Mandatory for a new Tariff Charge if it is not Based on Carrier. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumUnitsForSelection" type="cis:NumberOfUnitsWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum number of units for selection.
				Mandatory for a new Tariff Charge if it is not Based on Carrier.  Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumUnitsForSelection" type="cis:NumberOfUnitsWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The minimum number of units for selection.
				Mandatory for a new Tariff Charge if it is not Based on Carrier. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BaseChargeAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The base charge. Mandatory for a new Tariff Charge if it is not Based on Carrier. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyDiscountOrSurchargeToMinimumOrMaximumFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
