                        <xsd:annotation>
                            <xsd:documentation>
                                The customer name if applicable (all shipments from same customer). Applicable only for UI-oriented APIs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PickupArrivalDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                    The date and time that arrival for pickup was reported for the stop.
                                    This value could be based on an internal event or an update from the carrier. Expressed in the time zone of the location.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PickupDepartureDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                    The date and time that departure for pickup was reported for the stop.
                                    This value could be based on an internal event or an update from the carrier. Expressed in the time zone of the location..
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryArrivalDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                    The date and time that arrival for delivery was reported for the stop.
                                    This value could be based on an internal event or an update from the carrier. Expressed in the time zone of the location.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryDepartureDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                    The date and time that departure for delivery was reported for the stop.
                                    This value could be based on an internal event or an update from the carrier. Expressed in the time zone of the location.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
