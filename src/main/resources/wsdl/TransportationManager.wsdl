                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstShippingLocationCountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The country code for the first freight pickup stop 
                                of the tendered load or trip.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstShippingLocationState" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
