                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestInGateDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Latest in-gate date and time for all loads of the booking.
					For initial and post charge voucher associated with booking or load on boooking only. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the transaction was created.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the transaction was updated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created the transaction.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who updated the transaction.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The memo field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the contents of referenceNumberStructure should be ignored. May be present for add and change operations (currently not in use).
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberStructure" type="cis:ReferenceNumberType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                The reference numbers. Presence depends whether there is any reference number.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreVoucherChargesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the contents of voucherCharge should be ignored. May be present for add and change operations (currently not in use).
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherCharge" type="cis:VoucherChargeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                The voucher charges.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreVoucherHeldLogsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the contents of voucherHeldLog should be ignored. May be present for add and change operations (currently not in use).
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherHeldLog" type="cis:VoucherHeldLogType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                The voucher held logs. Presence depends whether there is any voucher held log.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Tariff" type="cis:TariffType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated tariff.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalFlexibleQuanity1" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total number of Flexible Quantity 1 in the load (maximum).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalFlexibleQuanity2" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total number of Flexible Quantity 2 in the load (maximum).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalFlexibleQuanity3" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total number of Flexible Quantity 3 in the load (maximum).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalFlexibleQuanity4" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total number of Flexible Quantity 4 in the load (maximum).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalFlexibleQuanity5" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total number of Flexible Quantity 5 in the load (maximum).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationFlexibleQuantity1" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The first of five flexible quantity fields reported as having been delivered.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationFlexibleQuantity2" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The second of five flexible quantity fields reported as having been delivered.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationFlexibleQuantity3" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The third of five flexible quantity fields reported as having been delivered.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationFlexibleQuantity4" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The forth of five flexible quantity fields reported as having been delivered.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationFlexibleQuantity5" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The fifth of five flexible quantity fields reported as having been delivered.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ARTransactionType">
                <xsd:annotation>
                    <xsd:documentation>
				General ledger accounts receivable (A/R) transactions.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTransactionID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID code of the transaction.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The customer name.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ARAccountNumber" type="cis:AccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The customer account number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerAccountNumber" type="cis:AccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The account number with the customer.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BillToCustomerName" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The bill-to customer name.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BillToARAccountNumber" type="cis:AccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The bill-to customer number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BillToCustomerAccountNumber" type="cis:AccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The bill-to account number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InvoiceNumber" type="cis:FreightBillNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The invoice number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InvoiceTypeCode" type="cis:InvoiceDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The invoice type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InvoiceTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for invoiceTypeCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InvoiceSourceEnumVal" type="cis:InvoiceSourceLevelEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The type of invoice source.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InvoiceSourceEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for invoiceSourceEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PaymentTermsCode" type="cis:ARTermsDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The payment term type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PaymentTermsCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for paymentTermsCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalInvoiceNumber" type="cis:FreightBillNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The original invoice number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalFreightChargesApproved" type="cis:SumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The sum of the approved invoice detail amounts.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalTaxChargesApproved" type="cis:SumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The sum of the approved invoice tax amounts.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalFreightChargesBilled" type="cis:SumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total non-tax invoice charges reported by the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalTaxChargesBilled" type="cis:SumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total invoice tax charges amounts reported by the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The currency type of the invoice charge.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for currencyCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRate" type="cis:ExchangeRateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The exchange rate at the time of invoice creation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ARTransactionStatusEnumVal" type="cis:ARStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The transaction status.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ARTransactionStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for ARTransactionStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PaymentDueDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The payment due date.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InvoiceDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The invoice date established by the logistics provider.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DateReceived" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date that the freight invoice was received.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the transaction was created.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the transaction was updated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created the transaction.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who updated the transaction.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ARTransactionVersionCode" type="cis:TransactionVersionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The A/R transaction version ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemFreightInvoiceID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight invoice ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalSystemFreightInvoiceID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The original freight invoice ID for post charges.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The customer ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BillToCustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The bill-to customer ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The division ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The logistics group ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FiscalYear" type="cis:BookingYearType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The accounting fiscal year.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AccountingPeriod" type="cis:AccountingPeriodType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The accounting period of the fiscal year.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransactionRunNumber" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the run that created the transaction.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                	A memo.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLTransaction" type="cis:GLTransactionType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of matching G/L transactions for this A/R transaction.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="FreightBillType">
                <xsd:annotation>
                    <xsd:documentation>
				A document issued by a carrier requesting payment for freight services.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill ID. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillNumber" type="cis:FreightBillNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill number. Mandatory for a new FreightBill. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillType" type="cis:FreightBillDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillTypeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for freightBillType. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillVersionCode" type="cis:FreightBillVersionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill version code. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The division ID. Cannot be changed for an existing FreightBill with matched vouchers.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The logistics group ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier ID. Cannot be changed for an existing FreightBill.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The customer ID. Cannot be changed for an existing FreightBill.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BillToCustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The Bill To customer code. Bill To Customer can be changed from one to another
                                 but not allowed to switch from with Bill To Customer to without, and vice versa.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillStatusEnumVal" type="cis:FreightBillStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The current status. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for freightBillStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MatchExistingVoucherFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the freight bill can be matched to an existing voucher. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InvoiceDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The invoice date.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PaymentDueDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The payment due date.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalSystemFreightInvoiceID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The invoice ID of the origin freight. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillAutoPaymentRunID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill auto payment run ID. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PaymentTermsCode" type="cis:APTermsDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The payment terms type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PaymentTermsCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for paymentTermsCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierAccountNumber" type="cis:CarrierAccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier account number. Cannot be changed for an existing FreightBill.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The currency type. Cannot be changed for an existing FreightBill with matched voucher.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for currencyCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRate" type="cis:ExchangeRateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The exchange rate. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FiscalYear" type="cis:BookingYearType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The fiscal year. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AccountingPeriod" type="cis:AccountingPeriodType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The accounting period. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierPaymentResponsibilityEnumVal" type="cis:FreightTermsType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier payment responsibility. Cannot be changed for an existing FreightBill with matched voucher.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierPaymentResponsibilityEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for carrierPaymentResponsibilityEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalAmount" type="cis:SumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total amount.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalTaxAmount" type="cis:SumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total tax amount.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalFreighBillDetailAmount" type="cis:SumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The sum of the freight bill detail total amounts. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalFreighBillDetailTaxAmount" type="cis:SumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The sum of the freight bill detail total tax amounts. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalApprovedFreighBillDetailAmount" type="cis:SumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The sum of the freight bill detail total approved amounts. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalApprovedFreighBillDetailTaxAmount" type="cis:SumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The sum of the approved freight bill detail total tax amounts. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalVoucherAmount" type="cis:SumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The sum of the voucher total amounts. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalVoucherTaxAmount" type="cis:SumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The sum of the voucher total tax amounts. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillSourceEnumVal" type="cis:FreightBillSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill source. Mandatory for create, read-only otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillSourceEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for freightBillSourceEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HoldFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the freight bill is on hold.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HeldFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the freight bill was on hold. Cannot be changed for an existing FreightBill.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ValidFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the freight bill is valid. Cannot be changed for an existing FreightBill.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReceivedDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The received date.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PaymentStatusType" type="cis:PaymentStatusDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The payment status.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PaymentStatusTypeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for paymentStatusType. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PaymentAmount" type="cis:SumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The amount paid.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PaymentDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The payment date.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ClearPaymentDateFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether payment date should be cleared or not.
					Input field and for update only. 
					When set to true, Input paymentDate will be ignored and persisted paymentDate will be cleared.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CheckNumber" type="cis:CheckNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Check Number for payment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaxOneDetailPerFreightBillFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the Freight Bill Header will consider One or More than One Freight Bill Details.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The user that created the freight bill. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The user that last updated the freight bill. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time the freight bill was created. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time the freight bill was updated. This is read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A memo for this freight bill.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the contents of referenceNumberStructure should be ignored. May be present for create and update operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberStructure" type="cis:ReferenceNumberType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The reference numbers. Presence depends on the value of ignoreReferenceNumbersFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreFreightBillDetailsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the contents of freightBillDetail should be ignored. May be present for create and update operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillDetail" type="cis:FreightBillDetailType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill details. Presence depends on the value of ignoreFreightBillDetailsFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HighestNoteImportanceEnumVal" type="cis:QueuePriorityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The highest note importance. Read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HighestNoteImportanceEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for HighestNoteImportanceEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Note" type="cis:NoteType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Existing notes for this Freight Bill.Read Only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NewNote" type="cis:NoteType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Notes to be added for this Freight Bill.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="FreightBillDetailType">
                <xsd:annotation>
                    <xsd:documentation>
				A specific entry on a freight bill.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillDetailID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill detail ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillDetailSequenceNumber" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill detail sequence number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillDetailStatusEnumVal" type="cis:FreightBillDetailStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The current status.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillDetailStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for freightBillDetailStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillNumber" type="cis:FreightBillNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherNumber" type="cis:VoucherNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The voucher number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MatchToVoucherNumber" type="cis:VoucherNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Optional input field. Voucher number provided will be used for 
                                freight bill detail matching when creating or updating freight bill detail. 
                                This field will be used only when multiple vouchers are found 
                                as matched candidates with the given UserReferenceNumber.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserReferenceNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The reference number supplied by the user.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InternalReferenceNumberTypeEnumVal" type="cis:APVoucherReferenceNumberEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The internal reference number type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InternalReferenceNumberTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for internalReferenceNumberTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InternalReferenceNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The internal reference number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillDetailSourceEnumVal" type="cis:FreightBillSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill detail source
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillDetailSourceEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for freightBillDetailSourceEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightAuditModeEnumVal" type="cis:FreightAuditModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight audit mode.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightAuditModeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for freightAuditModeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApprovedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The user that approved the freight bill detail.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total amount.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalTaxAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total tax amount.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApprovedTotalAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total approved amount.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApprovedTotalTaxAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total approved tax amount.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherPaymentAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The Voucher payment amount.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherTaxAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The Voucher payment tax amount.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VarianceAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The variance amount  that can be applied to the voucher.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VariancePercent" type="cis:PercentWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The variance percentage that can be applied to the voucher.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HighestProblematicCharge" type="cis:ChargeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The Charge ID which has the highest variance amount within the Freight Bill Detail Charges
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherHoldHeldFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				indicates whether Voucher is hold or held.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillDetailMatchFailureEnumVal" type="cis:FreightBillDetailMatchFailureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill detail match or audit failure reason.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillDetailMatchFailureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for freightBillDetailMatchFailureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreChargesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of "charge" should be ignored. May be present for create and update operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Charge" type="cis:FreightBillDetailChargeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill detail charges.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBill" type="cis:FreightBillType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated freight bill.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APVoucher" type="cis:APVoucherType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Associated A/P voucher.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="FreightBillDetailChargeType">
                <xsd:annotation>
                    <xsd:documentation>
				A specific charge in a freight bill detail.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillDetailChargeID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill detail charge ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillDetailID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill detail ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MasterChargeCode" type="cis:ChargeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The master charge code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightClassCode" type="cis:FreightClassCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight class code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The equipment type code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillDetailChargeStatusEnumVal" type="cis:FreightBillDetailChargeStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The current status code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillDetailChargeStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for freightBillDetailChargeStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargedUnits" type="cis:NumberofUnitsType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The charged units.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargedUnitRate" type="cis:RatePerUnitType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The charged unit rate.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExtendedAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The extended amount.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DiscountAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The discounted amount.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NetAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The net amount.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApprovedAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The approved amount.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherPaymentAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The Voucher payment amount.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeLevelEnumVal" type="cis:ChargeLevelEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The service, condition, or option.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeLevelEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for chargeLevelEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VariancePercent" type="cis:PercentWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The variance percentage that can be applied to the voucher.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VarianceAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The variance amount between the freight bill detail charge and voucher charge..
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The user that created the freight bill detail charge.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The user that last updated the freight bill detail charge.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time the freight bill detail charge was created.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time the freight bill detail charge was updated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipping location code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location type.
					If not specified and shippingLocationCode is specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for shippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillDetail" type="cis:FreightBillDetailType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated freight bill detail.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="FreightBillDetailChargeApprovedAmountType">
                <xsd:annotation>
                    <xsd:documentation>
				Freight bill detail charge approved amount.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="FreightBillDetailChargeID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill detail charge ID. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApprovedFreightBillDetailChargeAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The approved freight bill detail charge amount. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="FreightBillDetailConfirmDataType">
                <xsd:annotation>
                    <xsd:documentation>
				Freight bill detail confirm data.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="FreightBillDetailID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill detail ID. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApprovedFreightBillDetailAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The approved freight bill detail amount. This field will be ignored if the freight bill detail has charge details.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApprovedTaxAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The approved freight bill detail tax amount.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillDetailChargeApprovedAmount" type="cis:FreightBillDetailChargeApprovedAmountType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The approved amount details of freight bill detail charge. Mandatory if the freight bill detail has charge details. Ignores otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="FreightBillDetailMatchDataType">
                <xsd:annotation>
                    <xsd:documentation>
				Freight bill detail match data.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="FreightBillDetailID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill detail ID. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherNumber" type="cis:VoucherNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The voucher number. Optional. If provided, will try to match the specified voucher.
                                Otherwise, will try to find a matching voucher.
                                If mulitple matching ones are found, match will not complete, instead will return a list of matching voucher number.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="FreightBillPayStatusDataType">
                <xsd:annotation>
                    <xsd:documentation>
				Freight bill payment statuses.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemFreightBillID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill ID. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PaymentStatusEnumVal" type="cis:PaymentStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The payment status. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PaymentAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The amount paid.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PaymentDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The payment date.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ClearPaymentDateFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether payment date should be cleared or not.
					When set to true, Input paymentDate will be ignored and persisted paymentDate will be cleared.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CheckNumber" type="cis:CheckNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Check Number for payment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="GLTransactionType">
                <xsd:annotation>
                    <xsd:documentation>
				A general ledger transaction. An accrual transaction recognizes a current expense before a freight bill is received, and recognizes current revenue before an invoice is issued.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemGLTransactionID" type="cis:GLTransactionIDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the G/L transaction. This is the same field as GLTransactionID, but with prefix R or P for AR and AP transactions correspondingly.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLTransactionID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the G/L transaction.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLTransactionTypeEnumVal" type="cis:GLTransactionTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The type of G/L transaction (accrual, posting).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLTransactionTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for GLTransactionTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLClassificationEnumVal" type="cis:GLClassEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The G/L transaction classification (expense, liability, A/R, or A/P).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLClassificationEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for GLClassificationEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLTypeCode" type="cis:GLDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The G/L transaction type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for GLTypeCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLAccountNumber" type="cis:GLAccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The G/L account number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SourceOfGLAccountNumberEnumVal" type="cis:GLAccountSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The G/L account number source.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SourceOfGLAccountNumberEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for sourceOfGLAccountNumberEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreditOrDebitEnumVal" type="cis:CreditDebitEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The transaction type (credit or debit).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreditOrDebitEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for creditOrDebitEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CostCenterCode" type="cis:CostCenterDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The cost center.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CostCenterCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for costCenterCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ProfitCenterCode" type="cis:ProfitCenterDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The profit center.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ProfitCenterCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for profitCenterCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginLocationGLCategoryCode" type="cis:GLCategoryDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The G/L category of the origin shipping location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginLocationGLCategoryCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for originLocationGLCategoryCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationLocationGLCategoryCode" type="cis:GLCategoryDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The G/L category of the destination shipping location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationLocationGLCategoryCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for destinationLocationGLCategoryCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The customer name.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier name.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillNumber" type="cis:FreightBillNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill number (A/P only).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalFreightBillNumber" type="cis:FreightBillNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The original freight bill number if the transaction is a post charge (A/P only).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherReferenceNumberTypeEnumVal" type="cis:VoucherRefrenceNumberEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The type of reference number (A/R, A/P).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherReferenceNumberTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for voucherReferenceNumberTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The reference number for the charged entity.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherNumber" type="cis:VoucherNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The voucher from which the transaction charge is derived (A/R, A/P).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeDetailTypeEnumVal" type="cis:ChargeDetailEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The charge detail type (post charge, adjustment).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeDetailTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for chargeDetailTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransactionAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The transaction amount.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The currency type of the transaction.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for currencyCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRate" type="cis:ExchangeRateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The exchange rate of the base currency to the transaction currency.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BatchSequenceNumber" type="cis:LongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The batch sequence number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLTransactionStatusEnumVal" type="cis:GLStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The transaction status. Related field GLTransactionStatusDistinctAPAREnumVal has distinct AR and AP statuses, while this one combines similar statuses into one enumerated value.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLTransactionStatusDistinctAPAREnumVal" type="cis:GLStatusDistinctAPAREnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The transaction status.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLTransactionStatusDistinctAPAREnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for GLTransactionStatusDistinctAPAREnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FiscalYear" type="cis:BookingYearType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The accounting fiscal year for the transaction.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AccountingPeriod" type="cis:AccountingPeriodType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The accounting period within the fiscal year.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the transaction was created.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the transaction was updated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created the transaction.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who updated the transaction.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The division ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The logistics group ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The commodity code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier code. Returned as an empty string for A/R transactions
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The customer code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLOriginRegionZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The origin G/L region zone ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLDestinationRegionZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The destination G/L region zone ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentEntryTypeCode" type="cis:OrderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipment entry type ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipment ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentNumber" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The shipment Number.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AccrualsRunNumber" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The accrual run ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransactionRunNumber" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The transaction run ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InvoiceNumber" type="cis:FreightBillNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The invoice number (A/R only). Returned as an empty string for A/P transactions
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalInvoiceNumber" type="cis:FreightBillNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The original invoice number (A/R only). Returned as an empty string for A/P transactions.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemContainerID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The container ID.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegContainerID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipment leg container ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The load ID for the A/P type or A/R type of a carrier surcharge based customer. Returned as an empty string for A/R transactions.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipment leg ID for the A/P type or A/R type of a carrier surcharge based customer.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeCode" type="cis:ChargeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The charge code. Returned as an empty string if no charges are associated with the transaction
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The service code. Returned as an empty string if no charges are associated with the transaction, or if the associated charge has no load, shipment, or shipment leg as a rate owner.
				</xsd:documentation>
