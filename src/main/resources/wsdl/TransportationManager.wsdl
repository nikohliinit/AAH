                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processScheduleRunRequestHoldType">
                <xsd:annotation>
                    <xsd:documentation>
                        Put scheduled batch run requests on hold.
                        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
