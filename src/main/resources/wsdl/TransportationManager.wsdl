                        <xsd:annotation>
                            <xsd:documentation>
                    Indicate whether the Live and Non-Live Loading setting of the stop, the load and the dock has conflict.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockSelectionConstraintViolationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicate whether the dock selection constraints of the stop, the load and the dock has conflict.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockLoadingTypeViolationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicate whether the dock loading type of the stop, the load and the dock has conflict.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
