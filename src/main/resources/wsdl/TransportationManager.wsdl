                    Source tariff lane should be uniquely identified by its business key.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The service ID for the source tariff lane.
                    Part of the business key for the source tariff lane.
                    Source tariff lane should be uniquely identified by its business key.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The origin zone ID for the source tariff lane.
                    Part of the business key for the source tariff lane.
                    Source tariff lane should be uniquely identified by its business key.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The destination zone ID for the source tariff lane.
                    Part of the business key for the source tariff lane.
                    Source tariff lane should be uniquely identified by its business key.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginHubCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The origin hub ID for the source tariff lane.
                    Part of the business key for the source tariff lane.
                    Source tariff lane should be uniquely identified by its business key.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationHubCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The destination hub ID for the source tariff lane.
                    Part of the business key for the source tariff lane.
                    Source tariff lane should be uniquely identified by its business key.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The commodity ID for the source tariff lane.
                    Part of the business key for the source tariff lane.
                    Source tariff lane should be uniquely identified by its business key.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneTemplateCode" type="cis:LaneTemplateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The lane template ID for the source tariff lane.
                    Part of the business key for the source tariff lane.
                    Source tariff lane should be uniquely identified by its business key.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransferActionEnumVal" type="cis:TransferLaneActionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the source objects should be removed if applicable. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TargetTariffID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system generated numerical tariff ID of the target tariff. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TargetServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The target service ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransferLaneEnumVal" type="cis:TransferLaneLaneOptionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates how the source tariff lane is transferred. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransferRestrictionEnumVal" type="cis:TransferLaneLaneDependentsOptionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates how restriction of source tariff lane is transferred. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransferDockSelectionConstraintsEnumVal" type="cis:TransferLaneLaneDependentsOptionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates how dock selection constraints of source tariff lane are transferred. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransferLaneConstraintsEnumVal" type="cis:TransferLaneLaneDependentsOptionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates how lane constraints matching source tariff lane are transferred. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransferRatesEnumVal" type="cis:TransferLaneRateOptionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates how rates for source tariff lane are transferred. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransferSurchargesEnumVal" type="cis:TransferLaneRateDependentsOptionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates how rate surcharges/discounts for source tariff lane are transferred. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
