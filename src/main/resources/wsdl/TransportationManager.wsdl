                    Not allowed if any values are supplied for SystemLoadID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SkipLoadSuspensionFlag" type="xsd:boolean" minOccurs="0">
