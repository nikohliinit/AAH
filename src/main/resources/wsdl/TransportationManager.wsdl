            <xsd:complexType name="CurrencyUOMValueType">
                <xsd:annotation>
                    <xsd:documentation>
		Describes conversion of currency value from one currency to another.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="UomFrom" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Currency of source value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UomTo" type="cis:CurrencyDomainValueType" minOccurs="0">
