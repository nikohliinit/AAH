    <portType name="TransportationManagerPortType">
        <operation name="getUserProfile">
            <documentation>Returns profile of the current user.</documentation>
            <input message="cis:getUserProfile"/>
            <output message="cis:getUserProfileResponse"/>
            <fault name="CISFault" message="cis:OperationException"/>
        </operation>
        <operation name="findEntities">
            <documentation>Returns list of entities of one kind. Supports filtering, sorting and pagination. Allows define list of properties to return including child entities and child collections. For child collections allows define independent filtering, sorting and selection of retrieved properties.</documentation>
            <input message="cis:findEntities"/>
            <output message="cis:findEntitiesResponse"/>
            <fault name="CISFault" message="cis:OperationException"/>
        </operation>
        <operation name="findChildEntities">
            <documentation>Returns list of child entities of one kind for specified parent entity. Supports filtering, sorting and pagination. This API allows get list of child entities as getEntity does, but allows pagination as findEntities does.</documentation>
            <input message="cis:findChildEntities"/>
            <output message="cis:findChildEntitiesResponse"/>
            <fault name="CISFault" message="cis:OperationException"/>
        </operation>
        <operation name="getEntity">
            <documentation>Loads exactly one entity by ID. Allows define list of properties to retrieve. For collection of child entities allows define independent filtering, sorting and selection of retrieved properties.</documentation>
            <input message="cis:getEntity"/>
            <output message="cis:getEntityResponse"/>
            <fault name="CISFault" message="cis:OperationException"/>
        </operation>
        <operation name="numberOfEntities">
            <documentation>Returns number of entities of one kind. This API works with the same type of entities as findEntities API. Allows define filtering criteria.</documentation>
            <input message="cis:numberOfEntities"/>
            <output message="cis:numberOfEntitiesResponse"/>
            <fault name="CISFault" message="cis:OperationException"/>
        </operation>
        <operation name="getEnumValues">
            <documentation>Returns values of one or more enumerated types. For each enumerated value returns description and list of values that represent this enumerated value in different layers: CIS API representation, DB representation, and TM Web UI representation.</documentation>
            <input message="cis:getEnumValues"/>
            <output message="cis:getEnumValuesResponse"/>
            <fault name="CISFault" message="cis:OperationException"/>
        </operation>
        <operation name="getCountriesAndStates">
            <documentation>Returns Countries and States in these countries.</documentation>
            <input message="cis:getCountriesAndStates"/>
            <output message="cis:getCountriesAndStatesResponse"/>
            <fault name="CISFault" message="cis:OperationException"/>
        </operation>
        <operation name="getEventCodes">
            <documentation>Returns event codes.</documentation>
            <input message="cis:getEventCodes"/>
            <output message="cis:getEventCodesResponse"/>
            <fault name="CISFault" message="cis:OperationException"/>
        </operation>
        <operation name="convertUOM">
            <documentation>Converts values from one unit of measure to another.</documentation>
            <input message="cis:convertUOM"/>
            <output message="cis:convertUOMResponse"/>
            <fault name="CISFault" message="cis:OperationException"/>
        </operation>
        <operation name="getUIScreenOperationsSecurity">
            <documentation>Allows get permissions for the current user to the UI elements on the screen. External UI workflow tool may use this information to enable or to disable(remove) some of the UI controls and to define view vs. update modes for screen elements. One page may include multiple screen elements..</documentation>
            <input message="cis:getUIScreenOperationsSecurity"/>
            <output message="cis:getUIScreenOperationsSecurityResponse"/>
            <fault name="CISFault" message="cis:OperationException"/>
        </operation>
