                    </xsd:element>
                    <xsd:element name="LastShippingLocationAddressID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The address ID for the final freight pickup stop 
                                of the tendered load or trip.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastShippingPointTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The shipping location type for the final freight delivery stop 
                                of the tendered load or trip.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastShippingPointTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for lastShippingPointTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The shipping location code for the final freight delivery stop 
                                of the tendered load or trip.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastShippingLocationName" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The shipping location name for the final freight pickup stop 
                                of the tendered load or trip.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastShippingLocationCountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The country code for the final freight pickup stop 
                                of the tendered load or trip.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastShippingLocationState" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The state or province for the final freight pickup stop 
                                of the tendered load or trip.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastShippingLocationCity" type="cis:CityNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The city name for the final freight pickup stop 
                                of the tendered load or trip.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastShippingLocationPostalCode" type="cis:PostalCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The zip or postal code for the final freight pickup stop 
                                of the tendered load or trip.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RequestUpdatedReasonCode" type="cis:EventCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The reason code when this tender request was last updated.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RequestRespondReasonCode" type="cis:EventCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The accept or reject reason code when this tender request was last responded.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RequestRespondReasonCodeDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                            The description for RequestRespondReasonCode.
                        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The division ID of the tender request.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The logistics group ID of the tender request.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The commodity code of the tender request.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The carrier ID of the tender request.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The service ID of the tender request.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorEquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The tractor equipment type code of the tender request.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The trailer equipment type code of the tender request.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The tractor domicile code of the tender request.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileTrailerCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The trailer domicile code of the tender request.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VesselArrivalDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Scheduled vessel arrival date and time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VesselDepartureDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Scheduled vessel departure date and time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Vessel" type="cis:VesselNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Vessel name.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoyageNumber" type="cis:VoyageNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Voyage number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingServiceEnumVal" type="cis:BookingServiceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Type of booking service.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingServiceEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for BookingServiceEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DepartureShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The vessel departure shipping location ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DepartureShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The vessel departure shipping location type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DepartureShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for DepartureShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ArrivalShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The vessel arrival shipping location ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ArrivalShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The vessel arrival shipping location type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ArrivalShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ArrivalShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripEntityTypeEnumVal" type="cis:TripEntityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The trip type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripEntityTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for TripEntityTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedVessel" type="cis:VesselNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Related vessel.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedVoyageNumber" type="cis:VoyageNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Related voyage number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedDepartureDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The related departure date and time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedDepartureShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The related departure shipping location ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedDepartureShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The related departure shipping location type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedDepartureShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for RelatedDepartureShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated tariff ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionInProcessFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether booking revision is in process for this tender request.
                    Not applicable if the tender request is not associated with a booking.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AdvanceToAcceptedByBookingRevisionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether status was advanced to Tender Accepted by creation of a booking revision.
                    Not applicable if the tender request is not associated with a booking.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemBookingRevisionID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated booking revision ID.
                    Not applicable if the tender request is not associated with a booking.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The date and time that the tender request was created.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The date and time that the tender request was updated.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The ID of the user who created the tender request.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The ID of the user who updated the tender request.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The load ID this tender request is for; contains a value 
                                when the tender request is for one standalone load or 
                                one load on a trip; contains no value when the tender 
                                request is for a trip
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Load" type="cis:LoadType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Load the tender request is associated with.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The trip ID this tender request is for; contains a value 
                                when the tender request is for a trip with multiple 
                                loads (in which case the Load ID contains no value), 
                                or one load that is on a trip (in which case the 
                                Load ID also contains value)
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Trip" type="cis:TripType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Trip the tender request is associated with.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Note" type="cis:NoteType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Note associated with this tender request.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="VehicleSequenceType">
                <xsd:annotation>
                    <xsd:documentation>
                A Vehicle Sequence entry represents a possible Vehicle ID and Sequence combination from Domicile Vehicle Availabilities and Resources. Read only.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemVehicleSequenceID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The system-generated numeric ID of the vehicle sequence entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the entry is active.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The carrier ID of the entry.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The domicile ID of the entry.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentCategoryEnumVal" type="cis:EquipmentCategoryEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The equipment category.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentCategoryEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for EquipmentCategoryEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The equipment type ID of the entry.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VehicleCode" type="cis:VehicleCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The vehicle ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VehicleSequenceNumber" type="cis:ShortWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The sequence of the vehicle.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Carrier" type="cis:CarrierType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The carrier of the entry.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="FuelSurchargeContractType">
                <xsd:annotation>
                    <xsd:documentation>
				A fuel surcharge contract.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemFuelSurchargeContractID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated numerical Fuel Surcharge Contract ID.
					Cannot be changed for an existing Fuel Surcharge Contract.
					Mandatory for modification/deletion of a Fuel Surcharge Contract.
					Ignored for creation of a Fuel Surcharge Contract.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FuelSurchargeContractDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Fuel Surcharge Contract description.
					Mandatory for a new Fuel Surcharge Contract.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FuelSurchargeTypeCode" type="cis:FuelSurchargeTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Fuel Surcharge Type ID. Mandatory for creation of a Fuel Surcharge Contract.
					Cannot be blank.
					Cannot be changed for an existing Fuel Surcharge Contract.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RangeCode" type="cis:RangeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The range code.  Mandatory for creation of a Fuel Surcharge Contract.
					Cannot be blank.
					Cannot be changed for an existing Fuel Surcharge Contract.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the Fuel Surcharge Contract.
					This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who last updated the Fuel Surcharge Contract.
					This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time that the Fuel Surcharge Contract was created.
					This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time that the Fuel Surcharge Contract was last updated.
					This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreFuelSurchargeRateRangeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of fuelSurchargeRateRange should be ignored.
					If false during change, all existing fuelSurchargeRateRange members of this entity will be deleted and replaced with the contents of fuelSurchargeRateRange.
					May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FuelSurchargeRateRange" type="cis:FuelSurchargeRateRangeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The Fuel Surcharge Rate Ranges of the Fuel Surcharge Contract.
					The Fuel Surcharge Rate Ranges should match Range Breaks for the specified Range Code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreFuelSurchargeEquivalentTariffChargeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of fuelSurchargeEquivalentTariffCharge should be ignored.
					If false during change, the individual elements of fuelSurchargeEquivalentTariffCharge
					will be matched against the existing Fuel Surcharge Equivalent Tariff Charges
					by their system-generated numerical Fuel Surcharge Equivalent Tariff Charge IDs.
					The matched new entries will be updated, the unmatched new entries will be created, and
					the remaining existing Fuel Surcharge Equivalent Tariff Charges will be deleted.
					May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FuelSurchargeEquivalentTariffCharge" type="cis:FuelSurchargeEquivalentTariffChargeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The Fuel Surcharge Equivalent Tariff Charges of the Fuel Surcharge Contract.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FuelSurchargeType" type="cis:FuelSurchargeTypeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Associated Fuel Surcharge Type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="FuelSurchargeRateRangeType">
                <xsd:annotation>
                    <xsd:documentation>
				A rate range for a Fuel Surcharge Contract.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemFuelSurchargeRateRangeID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated numerical Fuel Surcharge Rate Range ID.
					This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemFuelSurchargeContractID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated numerical Fuel Surcharge Contract ID.
					This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RangeToUnits" type="cis:NumberofUnitsType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The upper limit for a Fuel Surcharge Rate Range. Mandatory.
					Cannot be changed for an existing Fuel Surcharge Rate Range.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeTypeEnumVal" type="cis:ChargeTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The charge type. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for chargeTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemRangeBreakID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated numerical Range Break ID.
					This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatePerUnit" type="cis:RatePerUnitType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The rate per unit. Mandatory for a new Fuel Surcharge Rate Range.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the entry. This is a read-only field.
