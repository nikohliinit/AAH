                        <xsd:annotation>
                            <xsd:documentation>
                                The loads attached to the trip.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Resource" type="cis:ResourceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    The resources associated with the trip and selected for the current route.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TripReSequenceDataType">
                <xsd:annotation>
                    <xsd:documentation>
				Information about loads to re-sequence on a trip.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the trip.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The IDs of all existing loads of the trip.
					The new sequence of loads on the trip corresponds to the sequence of Load IDs in the input.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TripTenderDataType">
                <xsd:annotation>
                    <xsd:documentation>
				The tender information for a trip or booking.
				CarrierCode and ServiceCode ensure that the caller is accepting or rejecting the correct tender information. That is,
				they ensure that the carrier and service have not changed since the caller retrieved the tender information.

				CurrentLoadOperationalStatusEnumVal is mandatory for tender reject and tender cancel operations to ensure that a tender
				is not accidentally rejected or cancelled after it has already been accepted by someone else.

				For fax and email notifications, you can override the default settings in CarrierNotification, with the following restrictions:

				*	If the load must be re-rated, the user override information supplied in CarrierNotification is disregarded, and the information for the
					new tariff service defaults is used instead.

				The remaining restrictions assume the Load has not been re-rated.

				*	If any of autofax or autoemail notifications are enabled, the caller may disable the notification using CarrierNotification field.
				*	If autofax or autoemail is enabled in global defaults level, but disabled for a given carrier and service combination, you
					can override this setting to enable the notification.
				*	Note that a fax number or email address must be available either from your overrides, or from the tariff service setup.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The trip or booking ID. Mandatory for all trip tender operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTenderRequestID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The tender request ID associated with the trip or booking. Read Only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the carrier for the trip or booking.
					Can always be set except for Tender Update operation where it is not updatable.
					Mandatory for Tender Accept, Tender Reject, and Tender Cancel.
					Optional for Tender.
					When it is not for tender, it is used for validation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the master service for the trip or booking.
					Not updatable for Tender Update operation, otherwise,
					can always be set and is always optional.
					When it is set and not for tender, it is used for validation only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorEquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The tractor equipment type. Can only be set during Tender. Not applicable for bookings.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tractor domicile code. Can only be set during Tender. Not applicable for bookings.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TenderAcceptedBy" type="cis:EmployeeNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The name of the employee who accepted the tender.
                    Can be set during Tender (optional unless AutoAcceptControlEnumVal is set to AUTOACCEPTCTRL_TRUE) and Tender Accept(mandatory).
                    For Tender Update, it will be used only when status is Tendered and AutoAcceptControlEnumVal is set to AUTOACCEPTCTRL_TRUE.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActualCarrierService" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The actual carrier and service for this tender, if using a virtual carrier such as NTE. Can only be set during Tender Accept and is optional then.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A memo for the trip. Can always be set and is always optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventInformation" type="cis:EventInformationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Reason Code information. Can only be set during Tender Reject, Tender Cancel or Tender Update and is optional then.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierNotification" type="cis:TenderNotificationDataType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The carrier notification information. Can only be set during Tender, Tender Cancel or Tender Update and is optional then.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RevisionToPreviouslyAcceptedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates if there was a revision to an accepted load tender. Can always be set and is always optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorNumber" type="cis:TrailerNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The tractor number. Can only be set during Tender, Tender Accept. Input only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorOwnerCarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The carrier that owns the tractor. Can only be set during Tender, Tender Accept. Input only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorLicenseNumber" type="cis:LicenseNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The tractor license number. Can only be set during Tender, Tender Accept. Input only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DriverCode" type="cis:DriverIdType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The ID of the asset. Can only be set during Tender, Tender Accept. Input only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DriverLicenseNumber" type="cis:LicenseNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The license number of the driver. Can only be set during Tender, Tender Accept. Input only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingReferenceNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The booking reference number. Applicable for bookings only. Applicable for initial tender only.
                    Mandatory when user input is required by Reference Number Qualifier setup.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of referenceNumberStructure (next) should be ignored.
					Applicable only for processTenderAccept operation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberStructure" type="cis:ReferenceNumberType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Reference numbers attached to the load. Optional.
					Applicable only for processTenderAccept operation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripLoadTenderData" type="cis:TripLoadTenderDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                The tender information for each load of the trip or booking.
                                For tender retrieval, only those loads with operational status greater than planned status will be included.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TripUpdateDataType">
                <xsd:annotation>
                    <xsd:documentation>
				Information about a trip or booking update.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the trip or booking.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The carrier code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The service code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorEquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tractor equipment type code. Optional.
                    Not applicable for bookings.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tractor domicile code associated with the trip. Optional.
                    Not applicable for bookings.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The commodity code. Optional.
                    Not applicable for bookings.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SchedulingActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether scheduling is active for the trip/booking (scheduling can be performed as part of a routing, rating and scheduling request).
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingInstructionDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Shipping instruction date and time. Not applicable for trips.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingInstructionDateTimeActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether ShippingInstructionDateTime is active.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyResourceConstraintsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether resource constraints such as equipment availability and lane constraints are applied. Optional.
                    Not applicable for bookings.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncludeInResourceUsageCountFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether associated resources will be included in resource usage counts. Optional.
                    Not applicable for bookings.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResourceProjectTypeCode" type="cis:ResourceProjectIDDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Resource Project ID.
                    Not applicable for bookings.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VesselDepartureDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Scheduled vessel departure date and time.
                    Not applicable for trips.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VesselArrivalDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Scheduled vessel arrival date and time.
                    Not applicable for trips.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerYardDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time by which consignments must be ready at the container yard for loading onto the vessel.
                    Not applicable for trips.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerYardDateTimeActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether ContainerYardDateTime is active.
                    Not applicable for trips.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Vessel" type="cis:VesselNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Vessel name.
                    Not applicable for trips.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoyageNumber" type="cis:VoyageNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Voyage number.
                    Not applicable for trips.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedVessel" type="cis:VesselNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Related vessel.
                    Not applicable for trips.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedVoyageNumber" type="cis:VoyageNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Related voyage number.
                    Not applicable for trips.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedDepartureDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The related departure date and time.
                    Not applicable for trips.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedDepartureDateTimeActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether RelatedDepartureDateTime is active.
                    Not applicable for trips.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedDepartureShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The related departure shipping location ID.
                    Not applicable for trips.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedDepartureShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The related departure shipping location type.
                    Not applicable for trips.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A memo associated with the Trip. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of referenceNumberStructure (next) should be ignored.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberStructure" type="cis:ReferenceNumberType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Reference numbers attached to the trip or booking.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VesselTrackingID1" type="cis:VarChar60" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Vessel tracking information 1.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VesselTrackingID2" type="cis:VarChar60" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Vessel tracking information 2.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalServiceType" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The service type of this itinerary from an external system.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionSchedulingOverriddenFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					This column will be true when a planner has decided execution mode scheduling is required to overcome one or more violations not allowed in planning/confirmation mode scheduling; applicable to trips/bookings not otherwise qualified for execution scheduling.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffRestrictionsOverriddenFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					This column will be true when restrictions associated with the applicable tariff service, tariff service/equipment or tariff lane have been overridden.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WebSchedulingRRSRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Web Scheduling RR and S Required.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalURL" type="cis:ExternalURLType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Used to store a URL to an external system, such as a visibility tracking URL.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalURL2" type="cis:ExternalURLType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Used to store a URL to an external system, such as a visibility tracking URL.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ChargeCriteriaType">
                <xsd:annotation>
                    <xsd:documentation>
			The details about potential charges of a rate calculation request.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="CustomerOrCarrierCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The customer or carrier code. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The A/R or A/P service. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The commodity code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadAtCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The load-at code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginHubCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The origin hub code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationHubCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The destination hub code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ConsigneeCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The consignee code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="FreightDetailType">
                <xsd:annotation>
                    <xsd:documentation>
			The item to be rated.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="WeightByFreightClass" type="cis:WeightByFreightClassType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight class of the item being rated. "*FAK" indicates Freight All Kinds. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Volume" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The volume of the shipment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OrderValue" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total value of the shipment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeclaredValue" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The declared value of the shipment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Pieces" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of pieces in the shipment.
					Either Pieces or Skids must have non-zero value if container type is not specified and EnableNewRateCalcFunctionFlag is true in Rate Criteria.
					Non-zero value is not allowed if container type is specified in Rate Criteria and EnableNewRateCalcFunctionFlag is true in Rate Criteria.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Skids" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of skids (a.k.a. pallets) in the shipment.
					Either Pieces or Skids must have non-zero value if container type is not specified and EnableNewRateCalcFunctionFlag is true in Rate Criteria.
					Non-zero value is not allowed if container type is specified in Rate Criteria and EnableNewRateCalcFunctionFlag is true in Rate Criteria.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Quantity" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of skids (a.k.a. pallets) or pieces in the shipment.
					Mandatory if container type is specified in Rate Criteria.
					Non-zero value is not allowed if container type is not specified in Rate Criteria.
					Ignored if EnableNewRateCalcFunctionFlag is false in Rate Criteria
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ScaledWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The scaled weight of the shipment.
				Non-zero value is not allowed if container type is specified in Rate Criteria.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LadenLength" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total laden length of the shipment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FlexibleQuantity1" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of Flexible Quantity 1 in the shipment.										
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FlexibleQuantity2" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of Flexible Quantity 2 in the shipment.										
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FlexibleQuantity3" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of Flexible Quantity 3 in the shipment.										
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FlexibleQuantity4" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of Flexible Quantity 4 in the shipment.										
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FlexibleQuantity5" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of Flexible Quantity 5 in the shipment.										
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="IntermediatePointType">
                <xsd:annotation>
                    <xsd:documentation>
			The intermediate location point for rate criteria used by rate quote request.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="StopTypeEnumVal" type="cis:StopEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The pick and drop type of the location point.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location type.
					If not specified and ShippingLocationCode is specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location ID.
					Mandatory if EnableNewRateCalcFunctionFlag is true and
					RoutingMethodEnumVal is not RUTNGMTD_RATING in RateCriteria.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="City" type="cis:CityNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The city for the location point. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="State" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The state or province for the location point. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PostalCode" type="cis:PostalCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The zip or postal code for the location point. Optional.
				If other address fields are present,
				this field is also mandatory if postal codes are required for the country.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Country" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The country for the location point. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Latitude" type="cis:LatitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The latitude for the location point. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Longitude" type="cis:LongitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The longitude for the location point. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="RateCriteriaType">
                <xsd:annotation>
                    <xsd:documentation>
The rate criteria describe what is being shipped and the constraints for selecting eligible lanes. Specify the origin and destination shipping points by doing one of the following actions: 1) provide a shipping location type and shipping location code, with the shipping address implied OR 2) explicitly provide an address.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ProcessARSideFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Indicates whether to find lanes for the A/R side rating (if True), or for the A/P side rating (if False). Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipFromLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The origin shipping point type.
					If not specified and ShipFromLocationCode is specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipFromLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The origin shipping location code.
					Mandatory if EnableNewRateCalcFunctionFlag is true and
					RoutingMethodEnumVal is not RUTNGMTD_RATING.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginCity" type="cis:CityNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The origin city for the routing. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginState" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The origin state or province for the routing. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginPostalCode" type="cis:PostalCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The origin zip or postal code. Optional.
				If other origin address fields are present,
				this field is also mandatory if postal codes are required for the country.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginCountry" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The origin country. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginLatitude" type="cis:LatitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The latitude of the origin's shipping point. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginLongitude" type="cis:LongitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The longitude of the origin's shipping point. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipToLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The destination shipping point type.
					If not specified and ShipToLocationCode is specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipToLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The destination shipping location code.
					Mandatory if EnableNewRateCalcFunctionFlag is true and
					RoutingMethodEnumVal is not RUTNGMTD_RATING.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationCity" type="cis:CityNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The destination city for the routing. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationState" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The destination state or province for the routing. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationPostalCode" type="cis:PostalCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The destination zip or postal code. Optional.
				If other destination address fields are present,
				this field is also mandatory if postal codes are required for the country.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationCountry" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The destination country. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationLatitude" type="cis:LatitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The latitude of the destination's shipping point. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationLongitude" type="cis:LongitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The longitude of the destination's shipping point. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The customer that the rating is for. This is a required field for A/R rating. It may not be relevant for A/P rating if, for example, there are multiple customers for the items being shipped.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					If specified, the best lane chosen will have this carrier.
					Relevant only for A/P rating.
					Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				If specified, the best lane chosen will provide this service. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				If specified, the best lane chosen will provide this equipment type.
				Relevant only for A/P rating.
				Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorEquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					If specified, the best lane chosen will provide this tractor equipment type.
					Relevant only for A/P rating.
					Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					If specified, the best lane chosen will provide this tractor domicile.
					Relevant only for A/P rating.
					Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileTrailerCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					If specified, the best lane chosen will provide this trailer domicile.
					Relevant only for A/P rating.
					Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MovementStartDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the freight movement starts.
					If specified, CumulativeDrivingTime and CumulativeBreakTime
					should be specified as well.
					Relevant only for A/P rating.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CumulativeDrivingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The cumulative driving time at the start of the freight movement.
					If specified, CumulativeBreakTime and MovementStartDateTime
					should be specified as well.
					Relevant only for A/P rating.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CumulativeBreakHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The cumulative break time at the start of the freight movement.
					If specified, CumulativeDrivingTime and MovementStartDateTime
					should be specified as well.
					Relevant only for A/P rating.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ProjectCode" type="cis:ProjectCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The project code. This is only relevant for A/R rating. Its use depends upon the customer settings. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ConsigneeGroupCode" type="cis:ConsigneeGroupDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The consignee group: only relevant for A/R rating. Its use depends upon the customer settings.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UseTariffHierarchyFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether to use the tariff hierarchy. It is only relevant for A/R rating.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The division for the rate quotation request. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				If specified, only lanes providing this commodity code are eligible for selection. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestDepartureTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					If EnableNewRateCalcFunctionFlag is true and RoutingMethodEnumVal is not RUTNGMTD_RATING,
					this is the earliest departure date/time for the rate quotation request and it is mandatory.
					Otherwise, if specified, rate shopping is done for the provided date; default value is the current date.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestDepartureTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					If EnableNewRateCalcFunctionFlag is true and RoutingMethodEnumVal is not RUTNGMTD_RATING,
					this is the latest departure date/time for the rate quotation request and it is mandatory.
					Otherwise, it is ignored.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestArrivalTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					If EnableNewRateCalcFunctionFlag is true and RoutingMethodEnumVal is not RUTNGMTD_RATING,
					this is the earliest arrival date/time for the rate quotation request and it is mandatory.
					Otherwise, it is ignored.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestArrivalTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					If EnableNewRateCalcFunctionFlag is true and RoutingMethodEnumVal is not RUTNGMTD_RATING,
					this is the latest arrival date/time for the rate quotation request and it is mandatory.
					Otherwise, it is ignored.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemUnitOfMeasureEnumVal" type="cis:SystemUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The unit of measure for the rate quotation request. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightUnitOfMeasureEnumVal" type="cis:WeightUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The weight unit of measure for the rate quotation request. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LengthUnitOfMeasureEnumVal" type="cis:LengthUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The length unit of measure for the rate quotation request. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightDetail" type="cis:FreightDetailType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Unit and freight class information describing the contents of the rate quotation request.
					Mandatory unless container level information is supplied for a rate quotation request,
					ignored if container level information is supplied for a rate quotation request.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeOverwrite" type="cis:ChargeDetailType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A set of charge details used for charge overwrites. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The currency code for the rate quotation request, corresponding to a domain table currency code, used to establish the currency of input monetary values. Mandatory.					
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfStops" type="cis:LongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The number of additional stops for the freight. Optional.
				Cannot be a positive number if an itinerary template or intermediate itinerary points are specified.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Distance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The distance that the freight is being shipped. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfShipments" type="cis:LongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The number of shipments for the freight. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnableNewRateCalcFunctionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates if Rate Quotation enhancement available in Transportation Manager Release 6.2.1 and beyond is activated.
				By default, the enhancement is not activated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UsePlanningTariffsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates if planning tariffs should be used.
					Cannot be set to true if ProcessARSideFlag is true or CarrierCode is not empty.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RoutingMethodEnumVal" type="cis:RoutingMethodEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The routing method for rate quotation.
				If EnableNewRateCalcFunctionFlag is false, this element is ignored and RUTNGMTD_RATING is used.
				If EnableNewRateCalcFunctionFlag is true, this element is mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierServiceEquipmentRuleEnumVal" type="cis:RateQuotationCarrierServiceEquipmentEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier service equipment rule. It propagates the carrier, service and equipment type to the first leg, last leg, or all legs of the rate quotation itinerary.
				If EnableNewRateCalcFunctionFlag is false or RoutingMethodEnumVal is not RUTNGMTD_OPTIMIZATION or ProcessARSideFlag is true,
				this element is ignored, otherwise it is mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerTypeCode" type="cis:ComponentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The container type ID. Optional.
					If EnableNewRateCalcFunctionFlag is false, this element is ignored.
					Ignored also if container level information is supplied for a rate quotation request.
					Container type group ID required for unique identification of a container type is retrieved
					from the customer profile if CustomerCode is specified or from Global Defaults otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTemplateCode" type="cis:JourneyTemplateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The itinerary template code. Optional.
				If EnableNewRateCalcFunctionFlag is false, this element is ignored.
				Cannot be specified if NumberOfStops is a positive number or intermediate itinerary points are specified.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OptimizerConstraintOverrideFile" type="cis:OptimizationConstraintOverrideDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The optimizer constraint override file, corresponding to a optimizer constraint override file domain value code. Optional.
				If EnableNewRateCalcFunctionFlag is false or RoutingMethodEnumVal is not RUTNGMTD_OPTIMIZATION or ProcessARSideFlag is true,
				this element is ignored.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultStopTypeEnumVal" type="cis:StopEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The stop type for intermediate points of the itinerary template.
				If EnableNewRateCalcFunctionFlag is false or ItineraryTemplateCode is empty or RoutingMethodEnumVal is RUTNGMTD_OPTIMIZATION, this element is ignored,
				otherwise it is mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipDirectFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the freight is to be shipped according to predefined itinerary as opposed to dynamic splitting.
				If EnableNewRateCalcFunctionFlag is false or RoutingMethodEnumVal is not RUTNGMTD_OPTIMIZATION or ProcessARSideFlag is true,
				this element is ignored.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IntermediatePoint" type="cis:IntermediatePointType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A set of intermediate location points for the freight. Optional.
				If EnableNewRateCalcFunctionFlag is false, this collection is ignored.
				Cannot be specified if NumberOfStops is a positive number or an itinerary template is specified.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationResidentialFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the destination is a residential address.
					If value is not defined and destination shipping location ID has been provided, value for destination shipping location will be used.
					Ignored if EnableNewRateCalcFunctionFlag is false.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreContainersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of RateQuotationContainer should be ignored. Optional.
					If not specified, the contents of RateQuotationContainer will be ignored.
					Ignored if EnableNewRateCalcFunctionFlag is false.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateQuotationContainer" type="cis:RateQuotationContainerType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Container level information associated with the request.
					Ignored if EnableNewRateCalcFunctionFlag is false.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyResourceConstraintsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether resource constraints such as equipment availability and lane constraints should be applied.
                    Ignored for A/R Rate Quotation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResourceProjectTypeCode" type="cis:ResourceProjectIDDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Resource Project ID.
                    Ignored for A/R Rate Quotation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SaveResultsAsRateQuotationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether to save the results of this request as a persistent rate quotation. Optional.
					If EnableNewRateCalcFunctionFlag is false, this element is ignored.
					Cannot be true when container level information is supplied for a rate quotation request.
					By default, the results are not saved.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateQuotationDescriptionRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the rate quotation description is required.
				If EnableNewRateCalcFunctionFlag is false or SaveResultsAsRateQuotationFlag is false,
				this element is ignored, otherwise it's mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateQuotationDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the rate quotation.
				If EnableNewRateCalcFunctionFlag is false or SaveResultsAsRateQuotationFlag is false,
				this element is ignored;
				otherwise, it's mandatory if rateQuotationDescriptionRequiredFlag is true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The logistics group ID of the rate quotation.
				If EnableNewRateCalcFunctionFlag is false or SaveResultsAsRateQuotationFlag is false,
				this element is ignored, otherwise it's mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExpirationDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The expiration date of the rate quotation.
				If EnableNewRateCalcFunctionFlag is false or SaveResultsAsRateQuotationFlag is false,
				this element is ignored, otherwise it's mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APSpotRateFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the A/P spot rate should be applied to the rate quotation.
				A/P spot rate is not applicable if optimization was used as routing method.
				If EnableNewRateCalcFunctionFlag is false or SaveResultsAsRateQuotationFlag is false or ProcessARSideFlag is true,
				this element is ignored.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APSpotRateAmount" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The A/P spot rate amount for the rate quotation.
				Ignored if A/P spot rate is not applied.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ARSpotRateFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the A/R Spot Rate should be applied to the rate quotation.
				If EnableNewRateCalcFunctionFlag is false or SaveResultsAsRateQuotationFlag is false or ProcessARSideFlag is false,
				this element is ignored.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ARSpotRateAmount" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The A/R spot rate amount for the rate quotation.
				Ignored if A/R spot rate is not applied.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="RateQuotationType">
                <xsd:annotation>
                    <xsd:documentation>
			An entity that reflects rate quotation results.
			All data are read-only.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemRateQuotationID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateQuotationDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateQuotationDescriptionRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the rate quotation description is required.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time when the rate quotation was created.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time when the rate quotation was updated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who updated the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The division ID of the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The logistics group ID of the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateCalculatorModeEnumVal" type="cis:RateCalculatorModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The mode used to create the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateCalculatorModeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for rateCalculatorModeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RoutingMethodEnumVal" type="cis:RoutingMethodEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The routing method used to create the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RoutingMethodEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for routingMethodEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The customer ID of the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the customer.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The commodity code of the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier ID of the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The A/P service code of the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ARServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The A/R service code of the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The equipment type of the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorEquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The tractor equipment type of the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The tractor domicile of the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileTrailerCode" type="cis:DomicileCodeType" minOccurs="0">
