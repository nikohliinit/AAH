                            <xsd:documentation>
                    Indicates whether the load schedule has valid itinerary.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfSoftConstraintViolations" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The number of soft constraint violations for this load; these will be identified either during optimization or routing/rating/scheduling.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TPSoftConstraintViolations" type="cis:TPSoftConstraintViolationsType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A TP Soft Constraint Violation.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VesselTrackingID1" type="cis:VarChar60" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Vessel tracking information 1.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VesselTrackingID2" type="cis:VarChar60" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
