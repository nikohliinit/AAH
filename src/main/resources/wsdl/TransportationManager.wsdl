                        <xsd:documentation>
                        A collection of update requests for schedule batch run.
                        </xsd:documentation>
                    </xsd:annotation>
                    <xsd:sequence>
                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                Operation header.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ScheduleRun" type="cis:ScheduleRunType" maxOccurs="unbounded">
