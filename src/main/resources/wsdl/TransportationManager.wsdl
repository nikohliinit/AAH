            A collection of delivery schedule requests.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryScheduleCode" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                A sequence of strings identifying the codes of delivery schedules to retrieve.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncludeItineraryFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Flag indicating if itineraries information should be included in Retrieve DeliverySchedule output
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncludeTimeTableFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Flag indicating if time tables information should be included in Retrieve DeliverySchedule output
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processUpdateDeliveryScheduleType">
