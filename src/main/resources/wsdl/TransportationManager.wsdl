                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDriverCodes" type="cis:DriverCodeStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    A list of comma separated System Driver IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HighestNoteImportanceEnumVal" type="cis:QueuePriorityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The highest note importance. Read only.
                </xsd:documentation>
                        </xsd:annotation>
