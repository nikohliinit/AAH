                    The booking merge in transit consolidation class.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentPriority" type="cis:ShipmentPriorityType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates the priority of the shipment; the lower the number the higher the priority.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DisplayStatusEnumVal" type="cis:ShipmentDisplayStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The display status. Read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DisplayStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for DisplayStatusEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatingValidFlag" type="xsd:boolean" minOccurs="0">
