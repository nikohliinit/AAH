				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumChargeAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The minimum charge. Mandatory for a new Tariff Charge if it is not Based on Carrier. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumChargeAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum charge. Mandatory for a new Tariff Charge if it is not Based on Carrier. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLTypeCode" type="cis:GLDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The G/L type. Optional. Updatable.
