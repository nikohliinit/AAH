            The split shipment number.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HoldReasonCode" type="cis:SECCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The reason code for holding the shipment.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberShipmentSplit" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Number of related split shipments. Read-only
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SurchargeBasedRatingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Indicates whether a carrier surcharge-based tariff is used for this shipment. Read-only.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ARConsolidationReferenceNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            A/R consolidation rating reference number; if consolidated rate used for shipment, this ID will be assigned to all shipments in the consolidated rating group. 
            Read-only.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ARVoucherRunExceptionID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the exception generated when a problem was encountered during A/R voucher generation most recently performed for this shipment.
                    Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowMixedLoadsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the shipments from the customer can be combined with shipments from other customers on a load. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ARServiceCommittedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Indicates whether the A/R service is committed. Read-only.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastRatedTariffID" type="cis:KeyStringType" minOccurs="0">
