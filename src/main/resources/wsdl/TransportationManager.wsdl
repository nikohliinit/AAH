        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SplitReviewEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Description for SplitReviewEnumVal. Read-only. Available only through UI-oriented APIs.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SplitShipmentNumber" type="cis:ShipmentNumberType" minOccurs="0">
