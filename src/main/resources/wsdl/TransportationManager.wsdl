                            <xsd:documentation>
                    Number of urgent shipment legs. Read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberHeldShipmentLeg" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Number of shipment legs held. Read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberDivertedShipmentLeg" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Number of diverted shipment legs. Read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
