                    <xsd:element name="UncommitFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
        Indicates whether hard and soft commits should be retained for the following load attributes: 
        carrier, service, tractor equipment type, trailer equipment type, tractor domicile and trailer domicile. 
        Must not be true if KeepSpotRateFlag is also true.
                </xsd:documentation>
