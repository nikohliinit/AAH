                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentConsolidationClassCode" type="cis:ConsolidationClassType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shipment consolidation class.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfDriverAssignments" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The number of asset assignments. Read-only.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionModeElapsedHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Execution mode elapsed hours.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionModeMaximumWaitHoursAtStop" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				execution mode maximum wait time at stop.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionModeTotalDrivingHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Execution mode total driving time.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionModeTotalLoadingHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Execution mode total loading time.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionModeTotalOffDutyHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Execution mode total off duty time.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionModeTotalOnDutyHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Execution mode total on duty time.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionModeTotalUnloadingHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Execution mode total unloading time for Trip.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionModeTotalWaitHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Execution mode total wait time for Load.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionModeWeekendHolidayBreakHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Execution mode weekend and holiday break hours.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the load was rated.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RouteDestinationZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The route destination zone ID.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RouteOriginZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The route origin zone ID.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionModeMaximumWaitHoursBetweenLoads" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            execution mode maximum wait time Between loads.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VesselTrackingID1" type="cis:VarChar60" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Vessel tracking information 1.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VesselTrackingID2" type="cis:VarChar60" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Vessel tracking information 2.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalServiceType" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The service type of this itinerary from an external system.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WebSchedulingRRSRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Web Scheduling RR and S Required.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalEquipmentTareWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The total tare weight for all equipments used by the load.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfSoftConstraintViolations" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The number of soft constraint violations for this trip; these will be identified either during optimization or routing/rating/scheduling.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TPSoftConstraintViolations" type="cis:TPSoftConstraintViolationsType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A TP Soft Constraint Violation.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionRRSBypassFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                indicates 'true' on any load attached to a booking that has been modified through the booking revisions workflows while bypassing routing, rating and scheduling; will be 'false' on any load attached to a booking that has been updated by routing, rating and scheduling results, either in or beyond booking revision workflows; not set in any other cases
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BaseTotalAdditionalChargesAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The total additional charge amount. Expressed in the system currency.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BaseTotalSystemCalculatedAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The total gross rated amount. Expressed in the system currency.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BaseTotalChargedAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The total freight charge amount for the trip or booking. Expressed in the system currency.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BaseTotalDiscountAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The total surcharge/discount amount. Expressed in the tariff rating currency. Expressed in the system currency.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionSchedulingOverriddenFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				This column will be true when a planner has decided execution mode scheduling is required to overcome one or more violations not allowed in planning/confirmation mode scheduling; applicable to trips/bookings not otherwise qualified for execution scheduling.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffRestrictionsOverriddenFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				This column will be true when restrictions associated with the applicable tariff service, tariff service/equipment or tariff lane have been overridden.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalURL" type="cis:ExternalURLType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Used to store a URL to an external system, such as a visibility tracking URL.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalURL2" type="cis:ExternalURLType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Used to store a URL to an external system, such as a visibility tracking URL.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLastOptimizerQueueID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The last optimizer queue ID of the trip.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TripCreateDataType">
                <xsd:annotation>
                    <xsd:documentation>
				Information about a created trip or booking.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The IDs of the existing loads to be included into the trip or booking.
					At least 2 loads are required for a trip and at least 1 load is required for a booking.
					The sequence of loads on the trip corresponds to the sequence of Load IDs in the input.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripEntityTypeEnumVal" type="cis:TripEntityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether a trip (by default) or a booking should be created.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The carrier code. Optional. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The service code. Optional. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorEquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The tractor equipment type code. Optional.
					Not applicable for bookings.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The tractor domicile code associated with the trip. Optional.
					Not applicable for bookings.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The commodity code. Optional. Cannot be blank.
					Not applicable for bookings.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A memo associated with the trip or booking. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of referenceNumberStructure (next) should be ignored.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberStructure" type="cis:ReferenceNumberType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Reference numbers attached to the trip or booking.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyResourceConstraintsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether resource constraints such as equipment availability and lane constraints are applied. Optional, defaults to true.
                    Not applicable for bookings.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncludeInResourceUsageCountFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether associated resources will be included in resource usage counts. Optional, defaults to true.
                    Not applicable for bookings.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResourceProjectTypeCode" type="cis:ResourceProjectIDDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Resource Project ID.
                    Not applicable for bookings.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TripLoadTenderDataType">
                <xsd:annotation>
                    <xsd:documentation>
				The tender information for load with trip level tender.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The load ID. Mandatory for all load tender operations.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadSequenceNumber" type="cis:ShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The sequence number of this load on its trip. Read-only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTenderRequestID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The tender request ID associated with the load. Read only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The trailer equipment type code. Read only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileTrailerCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The trailer domicile code. Read only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrentLoadOperationalStatusEnumVal" type="cis:LoadOperationalStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The current operational status of the load. Can only be set during Tender Reject or Tender Cancel for validation and is mandatory then.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrailerNumber" type="cis:TrailerNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The trailer number. Can always be set and is always optional. 
                                Ignored for Tender Reject and Cancel. Input only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrailerOwnerCarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The carrier that owns the trailer. Can always be set and is always optional. 
                                Ignored for Tender Reject and Cancel. Input only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrailerLicenseNumber" type="cis:LicenseNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The trailer license number. Can always be set and is always optional. 
                                Ignored for Tender Reject and Cancel. Input only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SealNumber" type="cis:SealNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The seal number. Can always be set and is always optional. 
                                Ignored for Tender Reject and Cancel. Input only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InGateDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					In-gate date and time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InGateDateTimeActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether InGateDateTime is active.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrackingNumber" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The tracking number. Always optional. Can be set for Tender Accept, ignored otherwise. Input only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TripRateDataType">
                <xsd:annotation>
                    <xsd:documentation>
        			The data necessary for rating a trip.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the trip to rate. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The carrier code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The service code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorEquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The tractor equipment type code. Optional.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The tractor domicile code. Optional.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyResourceConstraintsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether resource constraints such as equipment availability and lane constraints are applied. Optional.
                    Not applicable for bookings.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResourceProjectTypeCode" type="cis:ResourceProjectIDDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Resource Project ID.
                    Not applicable for bookings.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TripRateResultType">
                <xsd:annotation>
                    <xsd:documentation>
				A collection of continous moving loads or a booking.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID code of the trip.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FarPointLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The far point load ID.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripStartedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The date and time that the trip was started.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCommittedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the carrier is committed at the trip level.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCommittedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the service is committed at the trip level.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The rating currency of the tariff used to rate the trip.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemUnitOfMeasureEnumVal" type="cis:SystemUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The unit of measure system of the tariff used to rate the trip.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightUnitOfMeasureEnumVal" type="cis:WeightUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The weight units of the tariff used to rate the trip.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LengthUnitOfMeasureEnumVal" type="cis:LengthUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The length units of the tariff used to rate the trip.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceUnitOfMeasureEnumVal" type="cis:DistanceUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The distance units of measure of the tariff used to rate the trip.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRate" type="cis:ExchangeRateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The exchange rate for the rating currency of the tariff used to rate the trip.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatingValidFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether rating result of the trip is valid.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CostCenterCode" type="cis:CostCenterDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The cost center type.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DirectDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The direct distance. Expressed in base system units of measure.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OutOfRouteDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The out-of-route distance. Expressed in base system units of measure.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadedDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The loaded distance.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LongestUnloadedDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The longest unloaded distance. Expressed in base system units of measure.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnToOriginDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The return-to-origin distance. Expressed in base system units of measure.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total distance for this trip. Expressed in base system units of measure.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalUnloadedDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The total unloaded distance. Expressed in base system units of measure.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InTransitUnloadedDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The in-transit unloaded distance. Expressed in base system units of measure.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripScheduledDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The date and time that the trip was scheduled.
