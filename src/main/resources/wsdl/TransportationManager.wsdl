				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PickupToDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The end of the date and time range for pick-up.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryFromDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The start of the date and time range for delivery.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryToDateTime" type="xsd:dateTime" minOccurs="0">
