        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ClientID" type="cis:ClientIDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
        An ID that is copied from the Request to the Response.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApiSourceEnumVal" type="cis:ApiSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
          Indicates the source of the API as originating from an application feed (i.e., UI or API or Data Upload) or a specific partner integration.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="AppointmentType">
                <xsd:annotation>
                    <xsd:documentation>
			The physical collection of appointments - arranged meetings with shipment receiver.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AppointmentFromDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The start of the date and time range in which the appointment is planned to occur.
				    Mandatory for a new Appointment. Cannot be blank.
                    Cannot be changed for an appointment linked to a dock commitment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AppointmentToDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The end of the date and time range in which the appointment is planned to occur.
                    Mandatory for a new Appointment. Cannot be blank.
                    Cannot be changed for an appointment linked to a dock commitment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OverrideHoursForAppointmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether hours of operations are overriden for the appointment.
                    Cannot be changed for an appointment linked to a dock commitment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReschedulingRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether re-scheduling is required.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AppointmentStatusEnumVal" type="cis:AppointmentStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The appointment status. Mandatory for a new Appointment. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AppointmentStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for appointmentStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AppointmentNumber" type="cis:AppointmentNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The appointment number.
                    Cannot be changed for an appointment linked to a dock commitment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AppointmentWithName" type="cis:EmployeeNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The name of the person with whom the appointment arranged. This is a read-only field.
                    Cannot be changed for an appointment linked to a dock commitment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Contact" type="cis:ContactType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Contact details of the person with whom the appointment is arranged.
                    Cannot be changed for an appointment linked to a dock commitment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MovementDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time of the event.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventReasonCode" type="cis:EventCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The event reason code for this appointment operation. Optional.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventReasonDesc" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The event reason description for the status transition. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
