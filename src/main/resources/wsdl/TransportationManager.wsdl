                            <xsd:documentation>
                    The shipment consolidation class.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadGroupConsolidationClassCode" type="cis:ConsolidationClassType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The load group consolidation class.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
