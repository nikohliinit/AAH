                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryScheduleEntity" type="cis:DeliveryScheduleEntityType" maxOccurs="unbounded">
