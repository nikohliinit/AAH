                            <xsd:documentation>
                    The maintenance action type - add, update or delete. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ParameterSet" type="cis:ParameterSetType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of Parameter Sets to be maintained.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processBookingRevisionMaintainType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of Maintain Booking Revision requests.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionMaintainActionEnumVal" type="cis:ReferenceNumberActionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maintenance action type - add or update. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevision" type="cis:BookingRevisionType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of booking revisions to be maintained.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdateStatusFlag" type="cis:BooleanEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Whether the status of the booking should be updated if the booking revision is accepted. System maintained.
			  </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventSourceEnumVal" type="cis:EventSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates the source of the event as originating from an application feed (i.e., UI or API) or a specific partner integration.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processTriggerBookingRevisionActionType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of Trigger Booking Revision Action requests.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemBookingRevisionID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated booking revision IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CancelBookingRevisionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether Cancel Booking Revision should be executed.
                    This is one of the action flags for this operation.
                    One and only one of the actions flags must be set to true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReEvaluateBookingRevisionRuleFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether Re-Evaluate Booking Revision Rule should be executed.
                    This is one of the action flags for this operation.
                    One and only one of the actions flags must be set to true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnBookingRevisionToOpenFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether Return Booking Revision to Open should be executed.
                    This is one of the action flags for this operation.
                    One and only one of the actions flags must be set to true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ComputeEquipmentRevisionStatusFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether Compute Equipment Revision Status should be executed.
                    This is one of the action flags for this operation.
                    One and only one of the actions flags must be set to true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeChangeResolvedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether Compute Equipment Revision Status should be executed.
                    This is one of the action flags for this operation.
                    One and only one of the actions flags must be set to true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RejectBookingRevisionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether Reject Booking Revision should be executed.
                    This is one of the action flags for this operation.
                    One and only one of the actions flags must be set to true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AcceptBookingRevisionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether Accept Booking Revision should be executed.
                    This is one of the action flags for this operation.
                    One and only one of the actions flags must be set to true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowChangeToMatchedFromResolvedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether equipment revision status can be changed from Resolved to Matched.
                    Applicable only to Compute Equipment Revision Status.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OverrideOptionsOnActiveRuleFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether options derived from active booking revision rules should be overridden by user input.
                    If the value is true, booking revision rules are ignored, otherwise,
                    user input is ignored when active booking revision rule exists for the booking revision.
                    Applicable only to Accept Booking Revision and Reject Booking Revision.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionRejectOptionEnumVal" type="cis:BookingRevisionRejectOptionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Reject option.
                    Applicable only to Reject Booking Revision.
                    Ignored if OverrideOptionsOnActiveRuleFlag is not true
                    and active booking revision rule exists for the booking revision.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RejectReasonCode" type="cis:EventCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The reason code applied when a booking revision is rejected.
                    Applicable only to Reject Booking Revision.
                    Ignored if OverrideOptionsOnActiveRuleFlag is not true
                    and active booking revision rule exists for the booking revision.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IssueTenderUpdateFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether Tender Update should be performed if booking revision is accepted.
                    Applicable only to Accept Booking Revision.
                    Ignored if OverrideOptionsOnActiveRuleFlag is not true
                    and active booking revision rule exists for the booking revision.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TenderUpdateReasonCode" type="cis:EventCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The reason code applied when a booking revision is accepted and Tender Update is issued.
                    Applicable only to Accept Booking Revision.
                    Ignored if OverrideOptionsOnActiveRuleFlag is not true
                    and active booking revision rule exists for the booking revision.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyResourceConstraintsEnumVal" type="cis:BooleanEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates an override for Apply Resource Constraints flag on booking load(s).
                    Applicable only to Accept Booking Revision.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OverrideWeightVolumeConstraintsEnumVal" type="cis:BooleanEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates an override for weight and volume constraints on booking load(s).
                    Applicable only to Accept Booking Revision.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DisableRRSFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether routing, rating and scheduling should be disabled when booking revision is accepted.
                    Applicable only to Accept Booking Revision.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Note" type="cis:NoteType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Notes to be added for this booking revision.
                    Applicable only to Accept Booking Revision and Reject Booking Revision.
                    If notes are supplied, only one booking revision is allowed for this operation.
                    Notes can be retrieved not as a part of Booking Revision but as a part of the associated Tender Request.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdateStatusFlag" type="cis:BooleanEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Whether the status of the booking should be updated if the booking revision is accepted. System maintained.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processBookingRevisionResponseUpdateType">
                <xsd:annotation>
                    <xsd:documentation>
