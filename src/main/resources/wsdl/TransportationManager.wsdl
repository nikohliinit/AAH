			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="Filter" type="cis:FilterType" minOccurs="0" maxOccurs="unbounded">
                            <xsd:annotation>
                                <xsd:documentation>
			Filtering condition for entities to select.
			Designed to express simple constraints. When you need to express complex constraints then use Condition.
			Uses implicit AND for all child members.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="Condition" type="cis:NaryExprType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
			Filtering condition for entities to select.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="numberOfEntitiesResponse">
                <xsd:complexType>
                    <xsd:annotation>
                        <xsd:documentation>
		Number of entities, operational entities or financial entities in the database.
		</xsd:documentation>
                    </xsd:annotation>
                    <xsd:sequence>
                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation> 
                                Indicates if the operation was successful. May contain a list of errors. 
                        </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ResponseHeader" type="cis:ResponseHeaderType">
                            <xsd:annotation>
                                <xsd:documentation>
			Indicates if the operation was successful. May contain a list of errors.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="Size" type="xsd:integer" minOccurs="0">
