                            <xsd:documentation>
				Associated stop.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Dock" type="cis:DockType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated dock.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DockCommodityExclusionType">
                <xsd:annotation>
                    <xsd:documentation>
            The commodity exclusion information of the dock.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDockCommodityExclusionID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                An automatically generated system identifier for this commodity exclusion. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDockID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The automatically generated dock system identifier. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID of the commodity which will be excluded from the dock. Mandatory field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DockEquipmentTypeType">
                <xsd:annotation>
                    <xsd:documentation>
            The commodity exclusion information of the dock.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDockEquipmentTypeID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                An automatically generated system identifier for this equipment type. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDockID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The automatically generated dock system identifier. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID of the equipment type available for the dock. Mandatory field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Dock" type="cis:DockType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated dock.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DockLoadingTypeType">
                <xsd:annotation>
                    <xsd:documentation>
            			The excluded loading type information of the dock.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDockLoadingTypeID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				An automatically generated system identifier for this loading type. Read only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDockID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The automatically generated dock system identifier. Read only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadingTypeCode" type="cis:LoadingTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the loading type available for the dock. Mandatory field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Dock" type="cis:DockType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated dock.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DockSelectionOptionType">
                <xsd:annotation>
                    <xsd:documentation>
            	The dock selection option information of the dock.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Internal ID. Applicable only for UI-oriented APIs.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDockSelectionOptionID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    An automatically generated system identifier for this dock selection option. 
                    Ignored when DockSelectionOptionType is maintained as sub-entities under dock.
                    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDockID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The automatically generated dock system identifier. Mandatory field.
                    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeCode" type="cis:ChargeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the option charge which will be associated with the dock. Mandatory field.
                    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time that the dock selection option was created. Read only field.
                    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created the dock selection option. Read only field.
                    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time that the dock selection option was updated. Read only field.
                    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who updated the dock selection option. Read only field.
                    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DockStatusChangeInfoType">
                <xsd:annotation>
                    <xsd:documentation>
				A collection of information for the dock's status to change to.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemDockID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					System-generated dock ID.
					Either this field or DockCode, ShippingLocationCode and possibly ShippingLocationTypeEnumVal must be provided,
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockCode" type="cis:DockCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                	The ID of the dock for a particular shipping location.
                	Mandatory when SystemDockID is not provided.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A shipping location code.
					Mandatory if SystemDockID is not provided.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A shipping location type.
					If SystemDockID is not specified
					and ShippingLocationTypeEnumVal is not specified,
					one and only one shipping location with the specified ShippingLocationCode should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockStatusEnumVal" type="cis:DockStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The new status of the dock. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DomainValueEntryType">
                <xsd:annotation>
                    <xsd:documentation>
				An entry for a system domain value, for example, an entry for a language or a consignee group.
				Also, this structure can be used by processDomainValueEntryUpdate operation
				to update exchange rates with open effective and expiration dates for the default Exchange Rate Group.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
					The character ^ is used as a separator for the compound key.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomainTableCode" type="cis:DomainTableCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID code of the domain table of the domain value entry (eg. Language or ConsigneeGroup).
					For processDomainValueEntryUpdate operation, can be also Currency.
					Mandatory. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomainValueCode" type="cis:DomainValueCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID code of the domain value entry.
					For processDomainValueEntryUpdate operation, can be also a currency code.
					Mandatory. Cannot be changed for an existing domain value.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomainValueDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A description of the domain value. Updatable.
                    Mandatory for a new domain value.
					Ignored for exchange rate updates.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the domain value is active. Updatable.
					Ignored for exchange rate updates.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRate" type="cis:ExchangeRateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The exchange rate for a currency entry. Updatable.
					Default Exchange Rate Group and open effective and expiration dates are assumed.
					Ignored for domain value entries.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RoundingPrecision" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The decimal precision for a currency entry.
					Currently not in use.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumDecimalPrecision" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum decimal precision for a currency entry.
					Currently not in use.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					An external identifying code for a reference number type entry. Updatable.
					Ignored if the domain table is not ReferenceNumType.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OverrideFile" type="cis:OptimizerConstraintOverrideFileNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					An override file directory path for an optimizer constraint entry. Updatable.
					Ignored if the domain table is not OpmtCstrOvrd.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APIEnumeratedValue" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    API string for the corresponding enumerated value.
                    Not applicable if the domain value is not referred to by an API enumerated type.
                    Read-only. Available only for UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DomainValueEntryMaintainType">
                <xsd:annotation>
                    <xsd:documentation>
                An entry for a system domain value Maintain, used in processDomainTableMaintain API.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="DomainValueActionEnumVal" type="cis:ReferenceNumberActionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maintenance action type - add, update or delete. Mandatory when user provides the domain value for any operation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomainValueEntry" type="cis:DomainValueEntryType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Domain value information.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DomainTableMaintainType">
                <xsd:annotation>
                    <xsd:documentation>
                An entry for a system domain table maintain. used in processDomainTableMaintain API.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="DomainTableActionEnumVal" type="cis:ReferenceNumberActionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maintenance action type - add, update or delete. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomainTable" type="cis:DomainTableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Domain Table information.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DomainTableType">
                <xsd:annotation>
                    <xsd:documentation>
                An entry for a system domain tables.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Internal ID. Applicable only for UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTabID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    An automatically generated domain table identifier. This value is fixed for system defined domain tables.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomainTableCode" type="cis:DomainTableCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID code of the domain table. Mandatory for processDomainTableMaintain operation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomainTableDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    A description of the domain table. Updatable.
                    Mandatory for create and update for processDomainTableMaintain operation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaxCodeLength" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The length of the maximum code string.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaintainedBySystemFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether this is system maintained.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfEntries" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The number of entries this domain table has.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time that current domain table record was created. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time that current domain table record was updated. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created the domain table record. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who updated current domain table record. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomainValueEntry" type="cis:DomainValueEntryType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    domain value information for domain table. Only for UI oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomainValueEntryMaintain" type="cis:DomainValueEntryMaintainType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Domain value information for Domain Table. Will be used in processDomainTableMaintain API to add, update and delete entries.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DomicileType">
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The domicile ID code. Mandatory for a new Domicile. Cannot be changed for an existing Domicile.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileName" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The domicile name/description.
				Mandatory for a new Domicile. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the carrier that owns this domicile. Mandatory for a new Domicile. Cannot be changed for an existing Domicile.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The type of location associated with this domicile.
					If not specified and shippingLocationCode is specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for shippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The location associated with this domicile.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DispatchZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The dispatch zone code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnabledForOptimizationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether a domicile is enabled for optimization and routing.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created this domicile. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time when the domicile was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who most recently updated this domicile. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time when the domicile was last updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Address" type="cis:AddressType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The address of this domicile.
				If a shipping location is specified, the domicile's address is used as the shipping location's address.
				An override address can be specified as mandatory if no shipping location is specified.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessHours" type="cis:BusinessHoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The business hours of the domicile.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreContactsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the contents of contacts (next) should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Contacts" type="cis:ContactPersonType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The contacts associated with the domicile. Presence depends on the value of ignoreContactsFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreDomicileEquipmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether domicileEquipment (next) is processed. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileEquipment" type="cis:DomicileEquipmentType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The list of equipment for this domicile. Presence depends on the value of ignoreDomicileEquipmentFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VehicleAvailabilities" type="cis:DomicileVehicleAvailabilityType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Associated vehicle availability entries for domicile. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DomicileVehicleAvailabilityType">
                <xsd:annotation>
                    <xsd:documentation>
            The vehicle availability entry for a domicile. Used by Transportation Optimizer.
        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Internal ID. Applicable only for UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDomicileVehicleAvailabilityID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The Domicile Vehicle Availability ID. Read-only.
                Not applicable for adding a new Domicile Vehicle Availability.
                For other operations, should not be specified if
                DomicileCode, EquipmentCode and VehicleCode
                are used to identify a Domicile Vehicle Availability.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The domicile ID. Mandatory for a new Domicile Vehicle Availability.
                Cannot be changed for an existing Domicile Vehicle Availability.
                If a combination of DomicileCode, EquipmentCode and VehicleCode
                uniquely identifies a Domicile Vehicle Availability,
                this combination can be used instead of SystemDomicileVehicleAvailabilityID
                to retrieve an entry.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The equipment type ID. Mandatory for a new Domicile Vehicle Availability.
                If a combination of DomicileCode, EquipmentCode and VehicleCode
                uniquely identifies a Domicile Vehicle Availability,
                this combination can be used instead of SystemDomicileVehicleAvailabilityID
                to retrieve an entry.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VehicleCode" type="cis:VehicleCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The vehicle ID. Mandatory for a new Domicile Vehicle Availability.
                Cannot be changed for an existing Domicile Vehicle Availability.
                If a combination of DomicileCode, EquipmentCode and VehicleCode
                uniquely identifies a Domicile Vehicle Availability,
                this combination can be used instead of SystemDomicileVehicleAvailabilityID
                to retrieve an entry.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfVehicles" type="cis:UnsignedShortPositiveType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The number of vehicles.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AvailabilityStartDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The earliest available start date and time.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MustStartByDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The latest available start date and time.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MustEndByDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The date and time when usage of the vehicle must end.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumDurationHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum duration. When set to 0, stored as a null value.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UsePenaltyFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether penalty for violation will be used. Cannot be blank.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PenaltyForViolation" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The penalty paid for constraint violation.
                Not applicable if usePenaltyFlag is false.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReusableFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether the vehicle can be reused. Cannot be blank.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DelayHoursBetweenReuse" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The delay time between reuse.
                Not applicable if reusableFlag is false.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PenaltyPerHourOverTargetDuration" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The penalty paid per hour when target duration is exceeded.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TargetDurationHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The target duration. When set to 0, stored as a null value.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID of the user who created this Domicile Vehicle Availability.
                This is a read-only field.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The date and time when the Domicile Vehicle Availability was created.
                This is a read-only field.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID of the user who most recently updated this Domicile Vehicle Availability.
                This is a read-only field.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The date and time when the Domicile Vehicle Availability was last updated.
                This is a read-only field.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Domicile" type="cis:DomicileType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Associated domicile.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="AssetType">
                <xsd:annotation>
                    <xsd:documentation>
            An asset who handles the freight movement. Various constraints of a asset determine its eligibiliy of assignment
            to a load or trip
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Internal ID. Applicable only for UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemAssetCode" type="cis:AssetCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID code of the asset. Mandatory. Cannot be changed for an existing asset.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssetName" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The name of the asset. Mandatory for Create.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Contact" type="cis:ContactType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The contact information of the asset.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCode" type="cis:LanguageDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The language used by the asset. Mandatory for Create.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for languageCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExpirationDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date when the asset's insurance or license expires.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ClearExpirationDateFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether expiration date should be cleared or not.
                    Input field and for update only. 
                    When set to true, Input expirationDate will be ignored and persisted expirationDate will be cleared.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DepartmentOfTransportationIdentifier" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Department of Transportation Identifier.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PerformanceGrade" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The performance grade of the asset. Mandatory for create.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DriverLicenseNumber" type="cis:LicenseNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The driving license number of the driver asset.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssetPoolType" type="cis:AssetPoolTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The type of the asset pool.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssetPoolTypeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for assetPoolType. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CostCenterCode" type="cis:CostCenterDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The cost center used when generating A/P vouchers and G/L transactions based on activity for this asset.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CostCenterCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for costCenterCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityRestrictionCount" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The commodity restriction count of the asset. read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerRestrictionCount" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The customer restriction count of the asset. read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileRestrictionCount" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The domicile restriction count of the asset. read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentRestrictionCount" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The equipment type restriction count of the asset. read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LocationRestrictionCount" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shipping location restriction count of the asset. read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceRestrictionCount" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The service restriction count of the asset. read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HighestNoteImportanceEnumVal" type="cis:QueuePriorityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The highest note importance. Read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HighestNoteImportanceEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for highestNoteImportanceEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssetStatusEnumVal" type="cis:AssetStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    indicates whether the asset is currently active; inactive assets cannot be assigned or record activities
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssetStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for assetStatusEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorLicenseNumber" type="cis:LicenseNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    If a driver asset normally uses a specific tractor, this will refer to the license number for that tractor; optional; when a driver asset is assigned to a load, this value will be used to populate the tractor license number for the load if not already populated.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorNumber" type="cis:TrailerNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    If a driver asset normally uses a specific tractor, this will refer to the tractor number; optional; when a driver asset is assigned to a load, this value will be used to populate the tractor number for the load if not already populated.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorOwnerCarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    If the driver asset normally uses a specific tractor, this will refer to the carrier that owns the tractor; optional; when a driver asset is assigned to a load, this value will be used to populate the tractor owner for the load if not already populated
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Address" type="cis:AddressType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The address ID for this asset; mandatory when return type is 'immediate'.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessHours" type="cis:BusinessHoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The business hours ID which defines the working hours and out-of-servce schedule for an asset; to be eligible for assignment, an asset must be available for the entire duration of a movement. Read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the carrier to which this asset belongs; Mandatory for Create.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LinkedUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    TM login user ID associated with an asset; optional; when specified, this driver can directly login to TM as a carrier type user; supressed when asset type TM user code allowed is 'false'.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time this record was created. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time that the record was updated. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created the asset. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who updated the asset. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Note" type="cis:NoteType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    The notes of the asset. Read only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NewNote" type="cis:NoteType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    The new notes to be added for this asset. 
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAssetCommoditiesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of AssetCommodity should be ignored. May be present for add and change operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssetCommodity" type="cis:AssetCommodityType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Commodity restriction of this asset.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAssetCustomersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of AssetCustomer should be ignored. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssetCustomer" type="cis:AssetCustomerType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Customer restriction of this asset.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAssetDomicilesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of AssetDomicile should be ignored. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssetDomicile" type="cis:AssetDomicileType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Domicile restriction of this asset.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAssetEquipmentTypesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of AssetEquipment should be ignored. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssetEquipmentType" type="cis:AssetEquipmentTypeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Equipment Type restriction of this asset.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAssetShippingLocationsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of AsssetLocation should be ignored. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssetShippingLocation" type="cis:AssetShippingLocationType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Shipping Location restriction of this asset.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAssetServicesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of AssetService should be ignored. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssetService" type="cis:AssetServiceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Service restriction of this asset.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Carrier" type="cis:CarrierType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Associated carrier.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SharedAssetFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					when 'true', this asset may be used in assignments planned for another carrier; when 'false', may be used only in assignments planned for the asset carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumHoursBetweenUsage" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates the minimum duration that must elapse after the completion of an asset assignment before this asset may be used again; a violation is raised if this duration is not satisfied; may be used to model standard asset cleaning, inspection or other activity not associated with a movement.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssetReturnTypeEnumVal" type="cis:AssetReturnTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates how asset assignment end locations are set on assignments linked to a load/trip; immediate returns set asset assignment end locations to the load's domicile (if defined) or first stop location; other return types set asset assignment end location to the last load-stop.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssetReturnTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for assetReturnTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssetTypeCode" type="cis:AssetTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the asset Type to which this asset belongs; Mandatory for Create.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Optional. Identifies an asset as being of a specific equipment type; may be used to assist planners in assessing the appropriateness of an asset candidate for assignment by visual comparison to target load/trip properties; not used in assignment validations (i.e., will not result in an assignment violation)
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssetType" type="cis:AssetTypeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the type of asset; mandatory; some asset properties are supressed based on the asset type definition.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="AssetTypeType">
                <xsd:annotation>
                    <xsd:documentation>
            Asset Types define options controlling the visibility and handling of Assets in Transportatin Manager.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemAssetTypeCode" type="cis:AssetTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                   The user-assignable identifier for the asset type; must be unique
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssetTypeDesc" type="cis:AssetTypeDescType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                   the description of this asset type
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemProvidedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                   Indicates asset types provided by the system; system-provided entries cannot be deleted; defaults to 'false' for user-defined asset types
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  indicates if the asset type is active or inactive; assets cannot be created for inactive asset types; see Notes
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActivityAllowedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  indicates if asset activities are permitted against assets of this type
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContactInfoAllowedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  indicates if contact information is supported by assets of this type; when 'false', specific asset properties are supressed
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
