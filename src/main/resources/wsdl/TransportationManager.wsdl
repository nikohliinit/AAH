				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RunExceptionReasonEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
