                            <xsd:documentation>
            The gross amount for the shipment. Expressed in the tariff rating currency. Read-only.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SummarizedEntryModeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Indicates whether summarized entry mode is used for the shipment. Read-only.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalDistanceFromDefaultDistanceEngine" type="cis:DistanceType" minOccurs="0">
