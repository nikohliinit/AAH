                        <xsd:annotation>
                            <xsd:documentation>
The customer specific Invoice Cut Off Days for Invoice Run will override the one in the Invoice Version, if the Use Customer Invoice Cut Off Days flag in Invoice Version is true. Must be between -999 and 999.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ArConsolidationReferenceNumberQualifierId" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
A/R consolidation reference number qualifier. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DesiredGrossMarginPercent" type="cis:PercentWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The desired gross margin percentage. May be present for change operations. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowMixedTripsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the loads from the customer can be combined with loads from other customers on a trip. The default value is true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APVoucherPaymentCurrencyEnumVal" type="cis:VoucherCurrencyEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates which currency should be assigned as the payment currency for A/P vouchers created for this customer.
					Optional.
					Value VC_TFF_RATING_CNCY is not allowed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APVoucherPaymentCurrencyEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for APVoucherPaymentCurrencyEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerStatusEnumVal" type="cis:CustomerStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The status of the customer. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Description for customerStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberClassification" type="cis:ReferenceNumberClassificationDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The reference number classification of the customer.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberClassificationDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for referenceNumberClassification. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who created the customer. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who updated the customer. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the customer was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the customer was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Address" type="cis:AddressType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The customer address. Mandatory for a new Customer. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Contact" type="cis:ContactType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The contact information for the customer. Mandatory for a new Customer. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessHours" type="cis:BusinessHoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The business hours for the customer.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
A memo associated with the customer.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreContactsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the contents of contactPerson should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContactPerson" type="cis:ContactPersonType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
Contacts associated with the customer. Presence depends on the value of ignoreContactsFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAutoAppliedOptionsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Currently disabled.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoAppliedOption" type="cis:AutoAppliedOptionType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                Currently disabled.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreCustomerCarrierFreightAuditFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the contents of the customerCarrierFreightAudit should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCarrierFreightAudit" type="cis:CustomerCarrierFreightAuditType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
The customer/carrier freight audit relationship. Presence depends on the value of ignoreCustomerCarrierFreightAuditFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreCustomerShippingLocationCrossReferenceFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the contents of customerShippingLocationCrossReference should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerShippingLocationCrossReference" type="cis:CustomerShippingLocationCrossReferenceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
The cross-reference relationship for a customer and shipping location. Presence depends on the value of ignoreCustomerShippingLocationCrossReferenceFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="CustomerCarrierFreightAuditType">
                <xsd:annotation>
                    <xsd:documentation>
			    The carrier / customer cross-reference entry.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The customer code. Optional if you are creating or updating a customer
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Customer" type="cis:CustomerType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Customer this record referes to.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier code. Optional if you are creating or updating a carrier
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Carrier" type="cis:CarrierType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Carrier this record referes to.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowUnmatchedAuditEnumVal" type="cis:UnmatchedFreightBillAuthorizationEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The unmatched freight bill authorization level.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowUnmatchedAuditEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for allowUnmatchedAuditEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumVariancePercentPositive" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum positive percentage difference allowed in match pay. If you omit a value, then the value in the carrier structure is used.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumVarianceAmountPositive" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum positive dollar difference allowed in match pay. If you omit a value, then the value in the carrier structure is used.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumVariancePercentNegative" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum negative percentage difference allowed in match pay. If you omit a value, then the value in the carrier structure is used.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumVarianceAmountNegative" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum negative dollar difference allowed in match pay. If you omit a value, then the value in the carrier structure is used.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreContactsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of ContactPerson should be ignored. May be present for add and change operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContactPerson" type="cis:ContactPersonType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Contacts associated with the entry. Presence depends on the value of IgnoreContactsFlag.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="CustomerCrossReferenceType">
                <xsd:annotation>
                    <xsd:documentation>
				A customer cross-reference entity.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ExternalCode" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				An external ID code of the customer. Mandatory. May not be empty.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The customer ID code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerLocationCrossReference" type="cis:CustomerLocationCrossReferenceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of customer location cross-references. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerTypeCrossReference" type="cis:ContainerTypeCrossReferenceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of container cross-references. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="CustomerLocationCrossReferenceType">
                <xsd:annotation>
                    <xsd:documentation>
				A customer location cross-reference.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ExternalCode" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The external ID code of the customer.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipping location point code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipping location point type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="CustomerShippingLocationCrossReferenceType">
                <xsd:annotation>
                    <xsd:documentation>
				A customer shipping location cross-reference.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The customer code. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipping location code. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location point type. Optional. Updatable.
					If not supplied for a new or re-created customer shipping location cross-reference,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for shippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelationshipTypeEnumFlag" type="cis:CustomerLocationEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The relationship type between the customer and the shipping location. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DropoffPickupServiceType" type="cis:DropoffPickupServiceDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                 The Drop-off/Pick-up service type for this customer shipping location.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DropoffPickupServiceTypeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for dropoffPickupServiceType. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreExternalAliasesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether this cross-reference has an external ID list. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalAliasStructure" type="cis:ExternalAliasStructureType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A list of external IDs for this cross-reference. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Customer" type="cis:CustomerType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated customer.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocation" type="cis:ShippingLocationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated shipping location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="CustomerStatusChangeInfoType">
                <xsd:annotation>
                    <xsd:documentation>
			A collection of information for the Customer's status to change to.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="CustomerCode" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of customer codes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerStatusEnumVal" type="cis:CustomerStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The new status of the customer.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DefaultIncotermsShippingLocationType">
                <xsd:annotation>
                    <xsd:documentation>
                      	A number of attributes defined to match with the attributes from a shipment to determine the default Incoterm shipping location for the shipment.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDefaultIncotermsShippingLocationID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID code of the default Incoterms shipping location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the entry is active or not.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncoTermsCode" type="cis:INCOTermsCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Incoterms code. Mandatory. Not modifiable during update. 
					incoTermsCode, incoVersionEnumVal, divisionCode, customerCode, form the unique logical key.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncoVersionEnumVal" type="cis:INCOVersionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The version of these INCO terms. Possible values are INCO_VERSION_NULL, INCO_VERSION_1990, INCO_VERSION_2000 and INCO_VERSION_2010. Mandatory. Not modifiable during update. INCO terms are identified by the combination of IncoTermsCode, IncoVersionEnumVal, and DivisionCode.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncoVersionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for IncoVersionEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division code. Mandatory. Not modifiable during update.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The customer code. Mandatory. Not modifiable during update.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BuyerSellerEnumVal" type="cis:INCOBuyerSellerEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A description of the buyer and seller relationship.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BuyerSellerEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for BuyerSellerEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The origin shipping location code. Optional. Not modifiable during update.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginShippingLocationTypeEnumVal" type="cis:ShipFromPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The origin shipping location type (load-at, hub or distribution center).
					Optional. Not modifiable during update.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for originShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The destination shipping location code. Optional. Not modifiable during update.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationShippingLocationTypeEnumVal" type="cis:ShipToPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The destination shipping location type (hub or distribution center, consignee).
					Optional. Not modifiable during update.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for destinationShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultIncoShippingLocationTypeEnumVal" type="cis:DefaultIncoShippingLocationTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Default Incoterms Shipping Location Type. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultIncoShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for defaultIncoShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time that the default Incoterms shipping locations were created. Read only field.
                		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time that the default Incoterms shipping locations were updated. Read only field.
                		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created these default Incoterms shipping locations. Read only field.
                		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated these default Incoterms shipping locations. Read only field.
                		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DistanceTransitTimeType">
                <xsd:annotation>
                    <xsd:documentation>
			The Distance and Transit Time between two address points.
                        All are output fields.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Distance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The distance from point A to point B. Expressed in the default distance UOM for the application, as defined in the global settings
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransitTime" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The transit time from point A to point B.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceEngineVersionCode" type="cis:ExternalEngineVersionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The distance engine ID.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceTransitTimeBreakdownString" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The distance transit time breakdowns, if applicable. String contains multiple breakdowns.
					Format of this string for each breakdown is represented by 
					Distance in default distance UOM|Transit Time in hours|State Code|Country Code.
					For countries other than Mexico, Canada and USA, the state code will be empty.
					The difference beteen transitTime and the sum of the breakdown transit time caused by roudning will be adjusted
					in the last breakdown transit time.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrafficTransitOverrideBreakdownString" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
						the optional, comma-separated transit time traffic breakdown from location 1 to location 2 for the distance cache entry; each segment represents a fifteen minute start time interval starting at Sunday midnight and continuing for seven days; transit time is represented in minutes of driving time and does not account for breaks.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DistanceTransitTimeInputType">
                <xsd:annotation>
                    <xsd:documentation>
			The information about the Distance and Transit Time between two address points.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="DistanceTransitTimeOverride" type="cis:DistanceTransitTimeOverrideType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The data structure for CRUD of distance transit time override. It is also used here but 
                                not all the fields in this structure are needed for retrieving distance transit time.
                                Basically, what is needed are the address information of point A and point B and the
                                returning distance and time.
                                Unlike the operations for override, Shipping Location Code can be empty here if the address
                                information is provide.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GeoCodeOverridenAFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the latitude or longitude values have been manually overridden for location A.
                                If only shipping location code is provided, i.e. no address details, the address information
                                will come from the address of the shipping location and this flag will be ignored.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GeoCodeOverridenBFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the latitude or longitude values have been manually overridden for location B.
                                If only shipping location code is provided, i.e. no address details, the address information
                                will come from the address of the shipping location and this flag will be ignored.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncludeBreakdownFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether distance transit time breakdown should be included if applicalbe.
                                For non override retreival only. Ignore otherwise.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncludeTrafficBreakdownFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
						Indicates whether traffic breakdown should be included if applicable.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DistanceTransitTimeOverrideBreakdownType">
                <xsd:annotation>
                    <xsd:documentation>
				The information about the Distance and Transit Time Override Breakdown between two address points.
				Used also by processRetrieveDistanceTransitTime operation for output.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDistanceTransitTimeOverrideBreakdownID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					An automatically generated system identifier. Ignored for Create as well as processRetrieveDistanceTransitTime.
					Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDistanceTransitTimeOverrideID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system ID of the parent distance transit time override.
					Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BreakdownSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The sequence number of the breakdown in the breakdown list. Mandatory.
					Tne input sequence must match this value.
					The sequence number starts with zero. 
					So, the first entry in the list will be zero, the second one will be one and so on.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether distance and transit time override breakdown is from point A to B 					Ignored if distinct distances and transit times by direction are not supported by
					or from point B to A. False is from A to B and vice versa.
					Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StateCode" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The state which the breakdown belongs to.
					Mandatory for Mexico, Canada and USA. Empty otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The state which the breakdown belongs to.
					Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Distance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The distance breakdown for the specific state and / or country.
					Expressed in the default distance UOM for the application, as defined in the global settings.
					Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransitTime" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The transit time for the specific state and / or country.
					Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceTransitTimeOverride" type="cis:DistanceTransitTimeOverrideType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Distance Transit Time Override the Distance Transit Time Override Breakdown belongs to.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DistanceTransitTimeOverrideType">
                <xsd:annotation>
                    <xsd:documentation>
				The information about the Distance and Transit Time Override between two address points.
				Used also by processRetrieveDistanceTransitTime operation for input.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDistanceTransitTimeOverrideID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					An automatically generated system identifier. Ignored for Create as well as processRetrieveDistanceTransitTime.
					Mandatory for Retrieve, Update and Delete.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationATypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The type of the shipping location A.
					Used only for Create and processRetrieveDistanceTransitTime, ignored otherwise.
					If not supplied and ShippingLocationACode is supplied,
					one and only one shipping location with the code specified for location A should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationATypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ShippingLocationATypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationACode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the shipping location A. Mandatory for Create. Ignored for Retrieve, Update and Delete.
					For processRetrieveDistanceTransitTime, if not specified,
					distance / transit time overrides will not be considered for calculation.
					The address information of the shipping location will be used to create
					the distance / transit time override or calculate distance / transit time
					if address information is not provided (i.e.
					BlockLoc1, StreetLoc1, UnitLoc1, CityLoc1, StateLoc1, CountryCodeLoc1,
					PostalCodeLoc1, LatitudeLoc1 and LongitudeLoc1 are all empty).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BlockLoc1" type="cis:BlockNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The block (street) number of location A.
					Ignored if operation is not Create or processRetrieveDistanceTransitTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StreetLoc1" type="cis:StreetNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The street name of location A.
					Mandatory for Create or processRetrieveDistanceTransitTime if not using default address of shipping location.
					Ignored if operation is not Create or processRetrieveDistanceTransitTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnitLoc1" type="cis:UnitNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The unit number of location A.
					Ignored if operation is not Create or processRetrieveDistanceTransitTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CityLoc1" type="cis:CityNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The city name of location A.
					Mandatory for Create or processRetrieveDistanceTransitTime if not using default address of shipping location.
					Ignored otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StateLoc1" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The state or province of location A.
					Mandatory for Create or processRetrieveDistanceTransitTime if not using default address of shipping location.
					Ignored otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCodeLoc1" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The country of location A.
					Mandatory for Create or processRetrieveDistanceTransitTime if not using default address of shipping location.
					Ignored otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PostalCodeLoc1" type="cis:PostalCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The zip or postal code of location A.
					For Create or processRetrieveDistanceTransitTime, mandatory if postal codes are required for the country. Ignored otherwise.
					Ignored otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatitudeLoc1" type="cis:LatitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The latitude value of location A.
					Ignored if operation is not Create or processRetrieveDistanceTransitTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LongitudeLoc1" type="cis:LongitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The longitude value of location A.
					Ignored if operation is not Create or processRetrieveDistanceTransitTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GeoCodeOverrideAFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the latitude / longitude values have been manually overridden for location A.
					Read-only, ignored in the input for any operation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationBTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The type of the shipping location B.
					Used only for Create and processRetrieveDistanceTransitTime, ignored otherwise.
					If not supplied and ShippingLocationACode is supplied,
					one and only one shipping location with the code specified for location B should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationBTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ShippingLocationBTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationBCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the shipping location B. Mandatory for Create. Ignored for Retrieve, Update and Delete.
					For processRetrieveDistanceTransitTime, if not specified,
					distance / transit time overrides will not be considered for calculation.
					The address information of the shipping location will be used to create
					the distance / transit time override or calculate distance / transit time
					if address information is not provided (i.e.
					BlockLoc2, StreetLoc2, UnitLoc2, CityLoc2, StateLoc2, CountryCodeLoc2,
					PostalCodeLoc2, LatitudeLoc2 and LongitudeLoc2 are all empty).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BlockLoc2" type="cis:BlockNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The block (street) number of location B.
					Ignored if operation is not Create or processRetrieveDistanceTransitTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StreetLoc2" type="cis:StreetNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The street name of location B.
					Mandatory for Create or processRetrieveDistanceTransitTime if not using default address of shipping location.
					Ignored if operation is not Create or processRetrieveDistanceTransitTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnitLoc2" type="cis:UnitNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The unit number of location B.
					Ignored if operation is not Create or processRetrieveDistanceTransitTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CityLoc2" type="cis:CityNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The city name of location B.
					Mandatory for Create or processRetrieveDistanceTransitTime if not using default address of shipping location.
					Ignored otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StateLoc2" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The state or province of location B.
					Mandatory for Create or processRetrieveDistanceTransitTime if not using default address of shipping location.
					Ignored otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCodeLoc2" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The country of location B.
					Mandatory for Create or processRetrieveDistanceTransitTime if not using default address of shipping location.
					Ignored otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PostalCodeLoc2" type="cis:PostalCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The zip or postal code of location B.
					For Create or processRetrieveDistanceTransitTime, mandatory if postal codes are required for the country. Ignored otherwise.
					Ignored otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatitudeLoc2" type="cis:LatitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The latitude value of location B.
					Ignored if operation is not Create or processRetrieveDistanceTransitTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LongitudeLoc2" type="cis:LongitudeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The longitude value of location B.
					Ignored if operation is not Create or processRetrieveDistanceTransitTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GeoCodeOverrideBFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the latitude / longitude values have been manually overridden for location B.
					Read-only, ignored in the input for any operation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OverrideActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether distance and transit time override from point A to point B is active.
					Ignored if distinct distances and transit times by direction are not supported by
					global settings of the system; otherwise, mandatory for Create, can be omitted for Update
					to avoid change.
					Ignored for processRetrieveDistanceTransitTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Distance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The distance from point A to point B.
					Expressed in the default distance UOM for the application, as defined in the global settings.
					If defined, must be greater than zero.
					Ignored if this direction is not active for the distance and transit time override;
					otherwise, mandatory for Create, can be omitted for Update to keep the existing value.
					This direction is always active when distinct distances and transit times by direction are not supported by
					global settings of the system.
					If distanceTransitOverrideBreakdown is provided, this field will be ignored.
					Ignored for processRetrieveDistanceTransitTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransitTime" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The transit time from point A to point B.
					If defined, must be greater than zero.
					Ignored if this direction is not active for the distance and transit time override;
					otherwise, mandatory for Create, can be omitted for Update to keep the existing value.
					This direction is always active when distinct distances and transit times by direction are not supported by
					global settings of the system.
					If distanceTransitOverrideBreakdown is provided, this field will be ignored.
					Ignored for processRetrieveDistanceTransitTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnOverrideActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether distance and transit time override from point B to point A is active.
					Ignored if distinct distances and transit times by direction are not supported by
					global settings of the system; otherwise, mandatory for Create, can be omitted for Update
					to avoid change.
					Ignored for processRetrieveDistanceTransitTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The distance from point B to point A.
					Expressed in the default distance UOM for the application, as defined in the global settings.
					If defined, must be greater than zero.
					Ignored if this direction is not active for the distance and transit time override;
					otherwise, mandatory for Create, can be omitted for Update to keep the existing value.
					This direction is never active when distinct distances and transit times by direction are not supported by
					global settings of the system.
					If returnDistanceTransitOverrideBreakdown is provided, this field will be ignored.
					Ignored for processRetrieveDistanceTransitTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnTransitTime" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The transit time from point B to point A.
					If defined, must be greater than zero.
					Ignored if this direction is not active for the distance and transit time override;
					otherwise, mandatory for Create, can be omitted for Update to keep the existing value.
					This direction is never active when distinct distances and transit times by direction are not supported by
					global settings of the system.
					If returnDistanceTransitOverrideBreakdown is provided, this field will be ignored.
					Ignored for processRetrieveDistanceTransitTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceEngineCode" type="cis:ExternalEngineCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Read only field. The distance engine vendor ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceEngineVersionCode" type="cis:ExternalEngineVersionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The distance engine version ID. If not specified, default distance engine is assumed.
					Ignored if operation is not Create or processRetrieveDistanceTransitTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division ID. Mandatory for Create. Ignored for Retrieve, Update and Delete.
					For processRetrieveDistanceTransitTime, if not specified,
					distance / transit time overrides will not be considered for calculation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTariffNumber" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated tariff ID.
					SystemTariffNumber and TariffServiceCode must be both supplied or both be null.
					Ignored for Retrieve, Update and Delete.
					For processRetrieveDistanceTransitTime, if not specified,
					distance / transit time overrides specific for this tariff / service will not be considered for calculation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The tariff service ID.
					SystemTariffNumber and TariffServiceCode must be both supplied or both be null.
					Ignored for Retrieve, Update and Delete.
					For processRetrieveDistanceTransitTime, if not specified,
					distance / transit time overrides specific for this tariff / service will not be considered for calculation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					the optional trailer type for the distance cache entry; applicable when equipment-specific distance is required; an empty value is used when equipment-specific distance is not requested.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfTrailers" type="cis:NumberOfTrailerType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					the optional number of trailers for the distance cache entry; applicable when equipment-specific distance is required; an empty value is matched when equipment-specific distance is not requested.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousLevelTypeEnumVal" type="cis:HazardousLevelEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					the optional hazardous level for the distance cache entry; applicable when commodity-specific distance is required; values are zero (any), one (non-hazardous) and two (hazardous).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HazardousLevelTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for hazardousLevelTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreTrafficBreakdownFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					This indicates whether the contents of traffic transit times should be processed by the operation or ignored. Defaults to true if not specified. This is present for addEntity and changeEntity operations. If user wants to clear the traffic breakdowns, include IgnoreTrafficBreakdownFlag as false in changeEntity operation without specifying TrafficTransitOverrideBreakdownType tag then entire traffic breakdown data will be cleared.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceTransitOverrideBreakdown" type="cis:DistanceTransitTimeOverrideBreakdownType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The distance transit time override breakdown for location 1 to 2, if available (RET_YN='F' in the breakdown record).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceTransitOverrideBreakdownString" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The distance transit time override breakdowns coded in a string for location 1 to 2, if available.
					String contains multiple breakdowns.
					Format of this string for each breakdown is represented by
					Distance|Transit Time in minutes|State Code|Country Code.
					For countries other than Mexico, Canada and USA, the state code will be empty.
					Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnDistanceTransitOverrideBreakdown" type="cis:DistanceTransitTimeOverrideBreakdownType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The distance transit time override breakdown for location 2 to 1, if available (RET_YN='T' in the breakdown record).
					If returnOverrideActiveFlag is not true or system is not directional, will be ignored when used as input.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnDistanceTransitOverrideBreakdownString" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The distance transit time override breakdown coded in a string for location 2 to 1, if available.
					String contains multiple breakdowns.
					Format of this string for each breakdown is represented by
					Distance|Transit Time in minutes|State Code|Country Code.
					For countries other than Mexico, Canada and USA, the state code will be empty.
					Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrafficTransitOverrideBreakdown" type="cis:TrafficTransitOverrideBreakdownType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The distance transit time override breakdown for location 1 to 2, if available (RET_YN='F' in the breakdown record).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrafficTransitOverrideBreakdownString" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					the optional, comma-separated transit time traffic breakdown from location 1 to location 2 for the distance cache entry; each segment represents a fifteen minute start time interval starting at Sunday midnight and continuing for seven days; transit time is represented in minutes of driving time and does not account for breaks.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnTrafficTransitOverrideBreakdown" type="cis:TrafficTransitOverrideBreakdownType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The distance transit time override breakdown for location 2 to 1, if available (RET_YN='T' in the breakdown record).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnTrafficTransitOverrideBreakdownString" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					the optional, comma-separated transit time traffic breakdown from location 2 to location 1 for the distance cache entry; each segment represents a fifteen minute start time interval starting at Sunday midnight and continuing for seven days; transit time is represented in minutes of driving time and does not account for breaks.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the entry. Read only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the entry. Read only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was created. Read only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was updated. Read only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DistributionCenterType">
                <xsd:annotation>
                    <xsd:documentation>
				A physical location where merchandise is stored, shipped, and received.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistributionCenterCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The distribution center ID code. Mandatory for a new Distribution Center. Cannot be changed for an existing Distribution Center.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistributionCenterDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the distribution center. Mandatory for a new Distribution Center. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCode" type="cis:LanguageDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The language used at the distribution center.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for languageCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The currency used at the distribution center.
					The field is obsolete.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for currencyCode. Read-only. Available only through UI-oriented APIs.
					The field is obsolete.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemUnitOfMeasureEnumVal" type="cis:SystemUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The unit of measure system used at the distribution center.
					The field is obsolete.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for systemUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
					The field is obsolete.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightUnitOfMeasureEnumVal" type="cis:WeightUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The weight units used at the distribution center.
					The field is obsolete.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for weightUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
					The field is obsolete.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LengthUnitOfMeasureEnumVal" type="cis:LengthUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The length units used at the distribution center.
					The field is obsolete.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LengthUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for lengthUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
					The field is obsolete.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceUnitOfMeasureEnumVal" type="cis:DistanceUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The distance units used at the distribution center.
					The field is obsolete.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for distanceUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
					The field is obsolete.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AppointmentRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether a carrier has to make an appointment to pick up or drop off shipments at the distribution center.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumShipmentWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum weight of a shipment that can be loaded or unloaded at the distribution center.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumShipmentVolume" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum volume of a shipment that can be loaded or unloaded at the distribution center.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumEquipmentLength" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum length of the equipment allowed at the distribution center.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumEquipmentWidth" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum width of the equipment allowed at the distribution center.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumEquipmentHeight" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum height of the equipment allowed at the distribution center.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FixedLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The fixed load or unload hours.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			The maximum load or unload hours.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLeadTimeHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The minimum lead hours.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The minimum loading or unloading hours.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveLoadCodeEnumVal" type="cis:LiveLoadEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether outbound live or non-live loading is allowed;
					if non-live, then it indicates whether there can be outbound non-live loading
					during business hours or any time.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveLoadCodeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LiveLoadCodeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveUnloadCodeEnumVal" type="cis:LiveLoadEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether inbound live or non-live unloading is allowed;
					if non-live, then it indicates whether there can be inbound non-live unloading
					during business hours or any time.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveUnloadCodeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LiveUnloadCodeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstStopFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether any shipment leg starting from this location must be the first stop for the load.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastStopFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                indicates whether any shipment leg terminating at this location must be the last stop for the load.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SideDoorUnloadingRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether side door unloading is required at this location
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NearTailUnloadingRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether rear door unloading is required at this location
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OrderGroupingEnabledFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicate whether order grouping is enabled for this shipping location
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationPickupSequenceNumber" type="cis:PickSequenceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The Shipping Location Shipment Pickup Sequence Number
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BoundaryRuleEnumVal" type="cis:BoundaryRuleEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The boundary rules.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BoundaryRuleEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for boundaryRuleEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLCategoryCode" type="cis:GLCategoryDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The G/L category.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLCategoryCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for GLCategoryCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CorporateID1" type="cis:CorporateIdType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A corporate identifier code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CorporateID2" type="cis:CorporateIdType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A second corporate identifier code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The division ID of the distribution center. If you do not supply an input value for this field when creating this structure, then the value will be taken from the user's profile. To force this value to be blank, enter a single space in quotes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The logistics group ID code. If you do not supply an input value for this field when creating this structure, then the value will be taken from the user's profile. To force this value to be blank, enter a single space in quotes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLRegionZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The predefined G/L region zone. if you do not supply a value, then the zone is derived from the distribution center's address.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The default INCO terms shipping location code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The default INCO terms shipping location type.
					For the Add operation or for the Change operation with INCO shipping location change,
					if INCOShippingLocationCode is specified but
					INCOShippingLocationTypeEnumVal is not specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for INCOShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncotermsShippingLocationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the distribution center can be used as Incoterms shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode1" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				An external identifying code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode2" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A second external identifying code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RespondToTenderHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The maximum number of hours for the distribution center to respond to the tender offers.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The primary shipping location code for this location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The primary shipping location type for this location. Optional. Updatable.
					For the Add operation or for the Change operation with primary shipping location change,
					if primaryShippingLocationCode is specified but
					primaryShippingLocationTypeEnumVal is not specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for primaryShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadUnloadTimeCalculationEnumVal" type="cis:FixedTimeModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Loading/unloading time calculation mode.
					The setting will determine how loading/unloading times from
					equipment type and location are handled in calculations.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadUnloadTimeCalculationEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LoadUnloadTimeCalculationEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssumeTrailerSwapFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether trailer swap is assumed.
					The setting will influence the loading/unloading time calculations and
					whether empty trailers can be picked or dropped.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowEmptyLoadFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether a load is allowed to drop all freight at this location before any picks when this location is not the final delivery stop.
                    Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistributionCenterStatusEnumVal" type="cis:DCStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The status of the distribution center. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistributionCenterStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for distributionCenterStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ManageTrailerAlertsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether this location supports trailer alerts management.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoCreateNonLiveCommitmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether this location supports auto creation of non-live dock commitment.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WarehouseManagementSystemInstanceCode" type="cis:WarehouseManagementSystemInstanceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The WMS Instance ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginMaximumNumberShipmentSplit" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Maximum number of shipment splits for origin location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginSplitRulePrecisionEnumVal" type="cis:SplitRuleEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Split rule precision for desintaion location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginSplitRulePrecisionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Description for originSplitRulePrecisionEnumVal. Read-only. Available only through UI-oriented APIs.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginMinimumShipmentOverrideWindow" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Minimum shipment override window for origin location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationMaximumNumberShipmentSplit" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Maximum number of shipment splits for destination location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationSplitRulePrecisionEnumVal" type="cis:SplitRuleEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Split rule precision for desintaion location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationSplitRulePrecisionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Description for destinationSplitRulePrecisionEnumVal. Read-only. Available only through UI-oriented APIs.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationMinimumShipmentOverrideWindow" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Minimum shipment override window for destination location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PreloadingActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether any value exists for EarliestPreLoadingEndHours and LatestPreLoadingEndHours.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestPreloadingEndHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The largest allowed interval between the time when pre-loading is complete and the time of carrier pick-up.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestPreloadingEndHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The smallest allowed interval between the time when pre-loading is complete and the time of carrier pick-up.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PostDischargeActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether any value exists for EarliestPostDischargeStartHours and LatestPostDischargeStartHours.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestPostDischargeStartHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The smallest allowed interval between the time of carrier drop-off and the time when post-discharge starts.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestPostDischargeStartHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The largest allowed interval between the time of carrier drop-off and the time when post-discharge starts.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the distribution center was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the distribution center was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created the distribution center. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who updated the distribution center. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DTTEOverrideEnumVal" type="cis:DTTEOverrideEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether to convert or delete the distance override when updating the distribution center's address.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Address" type="cis:AddressType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The address of the distribution center. Mandatory for a new Distribution Center. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Contact" type="cis:ContactType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The contact information for the distribution center. Mandatory for a new Distribution Center. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessHours" type="cis:BusinessHoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The business hours for the distribution center.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A memo associated with the distribution center.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreContactsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the contents of contactPerson should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContactPerson" type="cis:ContactPersonType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				Contacts associated with the distribution center. Presence depends on the value of ignoreContactsFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAutoAppliedOptionsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the contents of autoAppliedOption should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoAppliedOption" type="cis:AutoAppliedOptionType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
The auto-applied options for the distribution center. Presence depends on the value of ignoreAutoAppliedOptionsFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreCustomerShippingLocationCrossReferenceFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the contents of customerShippingLocationCrossReference should be ignored.
				May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerShippingLocationCrossReference" type="cis:CustomerShippingLocationCrossReferenceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The cross-reference relationship for a customer and shipping location.
				Presence depends on the value of ignoreCustomerShippingLocationCrossReferenceFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreVariableLoadUnloadTimeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the contents of variableLoadingUnloadingTime should be ignored.
May be present for add and change operations.  If this element is not present or if its value is true, then no variableLoadingUnloadingTime should be present.
If the value of this element is false for a create operation, then the entity will be populated with any variableLoadingUnloadingTime elements in this document.
If the value of this element is false for an update operation, then all existing variableLoadingUnloadingTime members of this entity will be replaced with those in this document.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VariableLoadingUnloadingTime" type="cis:VariableLoadingUnloadingTimeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
Variable loading or unloading time factor. Presence depends on the value of the ignoreVariableLoadUnloadTimeFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreDockFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the contents of dock should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Dock" type="cis:DockType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
Docks of this Distribution Center. Presence depends on the value of ignoreDockFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreEquipmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Indicates whether the collection of equipment elements should be ignored.  May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Equipment" type="cis:ShippingLocationEquipmentType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
Supported equipment types for this distribution center.  Contents will only be considered if the ignoreEquipmentFlag is false.  May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreShipmentSplitRuleFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the collection of shipment split rules should be ignored.  May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentSplitRule" type="cis:ShipmentSplitRuleType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Shipment split rules for this distribution center.  Contents will only be considered if the ignoreShipmentSplitRuleFlag is false.  May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberTrailersAllowed" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Maximum number of trailers permitted at the location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberTrailersCanBeHandled" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Maximum number of trailers that can be handled at a time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumTotalTrailerLength" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Maximum total trailer(s) length permitted at the location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DistributionCenterStatusChangeInfoType">
                <xsd:annotation>
                    <xsd:documentation>
			A collection of information for the distribution center's status to change to.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="DistributionCenterCode" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of distribution center codes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistributionCenterStatusEnumVal" type="cis:DCStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The new status of the distribution center.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DockType">
                <xsd:annotation>
                    <xsd:documentation>
            A dock is for loading and unloading goods, it must associate with a shipping location.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDockID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                An automatically generated dock system identifier. Either this field or dockCode, shippingLocationTypeEnumVal and shippingLocationCode must be provided,
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockCode" type="cis:DockCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID of the dock for a particular shipping location. Mandatory for Create or Update or when systemDockID is not provided.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The description of the dock. Mandatory for Create or Update.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockTypeEnumVal" type="cis:DockTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The type of the dock. Mandatory for Create or Update.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for dockTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID code of the shipping location. Mandatory if systemDockID is not provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                	The shipping location type for the dock.
                	If systemDockID is not provided and
                	shippingLocationTypeEnumVal is not provided,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FixedLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The fixed load or unload hours.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The maximum load or unload hours.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The minimum load or unload hours.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessHours" type="cis:BusinessHoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The business hours for the dock.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Length" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The length of the dock.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockCommitmentEligibleStartEnumVal" type="cis:DockCommitmentEligibleStartEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The dock commitment eligible start times.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockCommitmentEligibleStartEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for DockCommitmentEligibleStartEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumDockCommitmentLeadHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum lead time for editing dock commitment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockCommitmentCutoffTimeActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether DockCommitmentNextBusinessDayCutoffTime is active.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockCommitmentNextBusinessDayCutoffTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Cut off time for next business day for editing dock commitments.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockStatusEnumVal" type="cis:DockStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The status of the dock. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for DockStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Priority" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Dock Priority. Updatable. Cannot be an empty element.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnabledForOptimizationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the dock is enabled for optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockCommitmentMaximumDaysStartDateChangeToEarlier" type="cis:ThreeDigitIntegerType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Maximum number of days for dock commitment start date change to an earlier date.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockCommitmentMaximumDaysStartDateChangeToLater" type="cis:ThreeDigitIntegerType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Maximum number of days for dock commitment start date change to a later date.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InboundOutboundEnvironmentEnumVal" type="cis:DockInboundOutboundEnvironmentEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The inbound and outbound environment of the dock.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InboundOutboundEnvironmentEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for InboundOutboundEnvironmentEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityExclusionDefinedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the dock has any commodity exclusion defined. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockSelectionOptionDefinedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the dock has any option defined for dock selection. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockSlotIdentifier" type="cis:DockSlotIdentifierType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The dock slot identifier.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeDefinedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the dock has any equipment type defined. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadingTypeDefinedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the dock has any excluded loading type defined. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockActivityEnumVal" type="cis:DockActivityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The activity type of the dock.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockActivityEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for DockActivityEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PreloadingActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether any value exists for EarliestPreLoadingEndHours and LatestPreLoadingEndHours.
                    Not applicable for Consignees.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestPreloadingEndHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The largest allowed interval between the time when pre-loading is complete and the time of carrier pick-up.
                    Not applicable for Consignees.
               </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestPreloadingEndHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The smallest allowed interval between the time when pre-loading is complete and the time of carrier pick-up.
                    Not applicable for Consignees.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PostDischargeActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether any value exists for EarliestPostDischargeStartHours and LatestPostDischargeStartHours.
                    Not applicable for Load-Ats.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestPostDischargeStartHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The smallest allowed interval between the time of carrier drop-off and the time when post-discharge starts.
                    Not applicable for Load-Ats.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestPostDischargeStartHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The largest allowed interval between the time of carrier drop-off and the time when post-discharge starts.
                    Not applicable for Load-Ats.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The date and time that the dock was created. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The date and time that the dock was updated. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID of the user who created the dock. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID of the user who updated the dock. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreVariableLoadUnloadTimeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                	Indicates whether the contents of VariableLoadingUnloadingTime should be ignored. May be present for add and change operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
