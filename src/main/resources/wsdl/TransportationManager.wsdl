                            <xsd:documentation>
                Indicates the priority of the load; value is computed based on priorities of the shipment legs assigned to the load 
                and the calculation method defined in the global settings; the lower the number the higher the priority
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstStopLatestFromPickupDateTime" type="xsd:dateTime" minOccurs="0">
