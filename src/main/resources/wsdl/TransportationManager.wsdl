                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation> 
                                Indicates if the operation was successful. May contain a list of errors. 
                        </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ResponseHeader" type="cis:ResponseHeaderType">
                            <xsd:annotation>
                                <xsd:documentation>
			Indicates if the operation was successful. May contain a list of errors.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="Page" type="cis:PageClauseType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
			Support for paging in UI. If you want to page through multiple 
			pages then this member must be sent in the next request.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="Entity" type="cis:UIEntityType" minOccurs="0" maxOccurs="unbounded">
                            <xsd:annotation>
                                <xsd:documentation>
			A collection of entities.
			</xsd:documentation>
                            </xsd:annotation>
