                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of shipment appointment details.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processStopAppointmentType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of requests to process Stop Appointment.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopAppointment" type="cis:StopAppointmentType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of stop appointment details.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processStopAppointmentEventType">
                <xsd:annotation>
                    <xsd:documentation>
                        A collection of requests to create Stop Appointment Event.
                        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopAppointmentEvent" type="cis:StopAppointmentEventType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                  A collection of create stop appointment event details.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAttachToPlanType">
                <xsd:annotation>
                    <xsd:documentation>
            Attaches shipment legs to the specified plan. If the list is empty, then all shipment legs in process status will be attached to the plan.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemPlanID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The plan ID to which the shipment legs can attach.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                 A sequence of shipment leg ID strings to attach to the plan.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The user ID. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processTriggerLoadEventType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of requests to process Trigger Load Event.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of load IDs.  May only be used when IDsAreReferenceNumbersFlag has the value false.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumber" type="cis:ExternalXRefType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                 A collection of Reference Numbers.  May only be used when IDsAreReferenceNumbersFlag has the value true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IDsAreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                 Indicates whether the supplied IDs are load IDs or load reference numbers.  If you use reference numbers for identification, they must be unique across all loads.  If a supplied reference number is attached to two or more loads, an error will be returned.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberTypeCode" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The type of reference numbers used to identify the loads.  Mandatory if IDsAreReferenceNumbersFlag (above) is set to true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadEventType" type="cis:LoadEventEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  An enumerated value defining different load event.
                  Field is mandatory.
                  Valid values are : LOEV_NULL, LOEV_GENMOVMENT and LOEV_UNSUSPEND
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SEC" type="cis:SECInformationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  A reason code for a specific event.
                  Field is mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processTenderCancelType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of requests to cancel a trip/booking or load tender.
                Either a collection of trip/booking tender data or a collection of load tender data
                is allowed, but not both.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripTenderData" type="cis:TripTenderDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                    A collection of trip/booking tender information.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadTenderData" type="cis:LoadTenderDataType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of load tender information.
                  Field is madatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventSourceEnumVal" type="cis:EventSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates the source of the event as originating from an application feed (i.e., UI or API) or a specific partner integration.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processRetrieveLoadByDescType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of requests to retrieve load by a specified description.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadDescription" type="cis:NameType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of load descriptions.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processRetrieveLoadByDateType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of requests to retrieve load that meet the specified range of dates.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RetrieveLoadDateType" type="cis:RetrieveLoadDateEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  An enumerated value defining different load date.
                  Field is mandatory.
                  Valid values are : RLD_START, RLD_END, RLD_SCHED
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StartDate" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  The start date of the specified range, if this date is omitted,
                  the system will uses the earliest date in the database.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EndDate" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  The end date of the specified range, if this date is omitted,
                  the system will uses the current date in the database.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processRetrieveDistanceTransitTimeType">
                <xsd:annotation>
                    <xsd:documentation>
                        A collection of requests to retrieve distance transit time between two locations.
                        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Operation header.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceTransitTimeInput" type="cis:DistanceTransitTimeInputType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                  A collection of location pairs information.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="queryTariffEntityType">
                <xsd:annotation>
                    <xsd:documentation>
                   A collection of tariff entity query requests.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffEntity" type="cis:TariffEntityType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                   A collection of entities for Tariff Setup.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="addTariffEntityType">
                <xsd:annotation>
                    <xsd:documentation>
                   A collection of tariff entity creation requests.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffEntity" type="cis:TariffEntityType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                   A collection of entities for Tariff Setup.
                   For this request, may not contain different types of tariff entities.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="changeTariffEntityType">
                <xsd:annotation>
                    <xsd:documentation>
                   A collection of tariff entity change requests.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffEntity" type="cis:TariffEntityType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                   A collection of entities for Tariff Setup.
                   For this request, may not contain different types of tariff entities.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="deleteTariffEntityType">
                <xsd:annotation>
                    <xsd:documentation>
                   A collection of tariff entity deletion requests.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffEntity" type="cis:TariffEntityType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                   A collection of entities for Tariff Setup.
                   For this request, may not contain different types of tariff entities.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processTariffRateType">
                <xsd:annotation>
                    <xsd:documentation>
                A collection of tariff rate processing requests.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Rate" type="cis:RateType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of individual tariff rates.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="queryTariffType">
                <xsd:annotation>
                    <xsd:documentation>
                   A collection of tariff query requests.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                 A collection of tariff IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnServicesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                 If this flag is set to true, the tariff services will be included in the output data.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnRateCodesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                 If this flag is set to true, the rate codes will be included in the output data.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnLanesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                 If this flag is set to true, the lanes will be included in the output data.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnSurchargesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                 If this flag is set to true, the surcharges of all kinds will be included in the output data.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="addTariffType">
                <xsd:annotation>
                    <xsd:documentation>
                   A collection of tariff creation requests.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Tariff" type="cis:TariffType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                   A collection of tariffs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="changeTariffType">
                <xsd:annotation>
                    <xsd:documentation>
                   A collection of tariff change requests.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Tariff" type="cis:TariffType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                   A collection of tariffs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="deleteTariffType">
                <xsd:annotation>
                    <xsd:documentation>
                   A collection of tariff deletion requests.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                 A collection of tariff IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processTariffSetStatusType">
                <xsd:annotation>
                    <xsd:documentation>
                Puts on hold or activates existing tariff(s).
                If the tariff is not completed yet (eg. doesn't have any lanes), the Activate operation will set the status to Incomplete.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of system-generated tariff IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffStatusEnumVal" type="cis:TariffStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tariff status to set. Allowed values are TFFST_ACTIVE and TFFST_ON_HOLD.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processSetShipmentLegToPlannedType">
                <xsd:annotation>
                    <xsd:documentation>    A request to advance a collection of Open Shipment Legs to Planned status and remove them from their associated plan(s).
    These Shipment Legs will be destined for Manifest Load(s), rather than Built Load(s).</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>    A collection of Shipment Leg IDs.  The Shipment Legs they represent will be advanced to Planned status.</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processShipmentRemoveType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of requests to remove the shipment from their loads.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentKeyInfo" type="cis:ShipmentKeyInfoType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of shipment IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processSetEntityStatusType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of entity status change requests.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HubStatusChangeInfo" type="cis:HubStatusChangeInfoType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                A collection of changes to be made to the hub status.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistributionCenterStatusChangeInfo" type="cis:DistributionCenterStatusChangeInfoType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                A collection of changes to be made to the distribution center status.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerStatusChangeInfo" type="cis:CustomerStatusChangeInfoType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                A collection of changes to be made to the customer status.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierStatusChangeInfo" type="cis:CarrierStatusChangeInfoType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                A collection of changes to be made to the carrier status.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationStatusChangeInfo" type="cis:ShippingLocationStatusChangeInfoType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of changes to be made to the shipping location status.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockStatusChangeInfo" type="cis:DockStatusChangeInfoType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of changes to be made to the dock status.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserStatusChangeInfo" type="cis:UserStatusChangeInfoType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of changes to be made to the user status.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionRuleStatusChangeInfo" type="cis:BookingRevisionRuleStatusChangeInfoType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of changes to be made to the booking revision rule status.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DriverStatusChangeInfo" type="cis:DriverStatusChangeInfoType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
        A collection of changes to be made to the driver status.
    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processSetShipmentToProcessedType">
                <xsd:annotation>
                    <xsd:documentation>
                   A request to advance the status of a collection of shipments to "processed".
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Shipment" type="cis:ShipmentType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                   A collection of shipments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentIDType" type="cis:ShipmentIdEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  An enumerated value defining how the shipment should be identified.
                  
                    SI_NULL - Equivalent to omitting this field which will be defaulted to SI_NUM.
                    
                    SI_ID - The shipments are identified by their IDs.
                    
                    SI_NUM - The shipments are identified by their shipment numbers.
                    
                    SI_RFRC - The shipments are identified by their reference numbers.
                    
                    SI_RFRC_DIV - The shipments are identified by their reference numbers and Division ID.
                    If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then a division can be omitted or, if specified, should match the division to which the user is restricted.
                    
                    SI_TRKG_NUM - The shipments are identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.

                    SI_TRKG_NUM_DIV - The shipments are identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.
                    If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then the division can be omitted or, if specified, it should match the division to which the user is restricted.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SearchReferenceNumberType" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                 The type of reference number to search.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processShipmentLegReturnFromPlannedType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of requests to return the shipment legs from Planned status to Processed.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of shipment leg IDs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SECInformation" type="cis:SECInformationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Reason Code information. Note that only SECCode and movementDateTime are used at this time.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processAssignShipmentLegToNewLoadType">
                <xsd:annotation>
                    <xsd:documentation>
            A  request to assign  the given shipment leg(s) to  new loads. If no shipment legs are specified, all shipment legs attached to the given plan are added to  new loads.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of shipment leg IDs to be attached to new loads.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PlanID" type="cis:KeyStringType">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the plan from which to select the shipment legs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processSetAllToPlannedType">
                <xsd:annotation>
                    <xsd:documentation>
            A  request to advance the status of all loads in a list of plans from Open to Planned and remove them from their plans.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PlanID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of plans.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processTriggerShipmentLegEventType">
                <xsd:annotation>
                    <xsd:documentation>
            A  request to trigger shipment leg events. The supporting events are release and return of a shipment, and stopping the suspension of shipment legs.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShipmentLegID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A collection of shipment legs to apply event (next) to.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Event" type="cis:ShipmentLegEventEnumValType">
                        <xsd:annotation>
                            <xsd:documentation>
                  The event triggered for the shipment legs specified above. The possible values are:
                    SLEV_UNSUSPEND, SLEV_RELEASE, SLEV_RETURN.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SecInfo" type="cis:SECInformationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  The SEC information for the event.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processDisableAssignToTripType">
                <xsd:annotation>
                    <xsd:documentation>
                   A collection of  requests to render each specified load ineligible to be assigned to a trip.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EligibleForContinuationOverrideStatusEnumVal" type="cis:NonLivePickUpDropOffOverrideStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates that the continuation eligibility flag for the trip/booking has been overridden and
                    whether the override is unconditional or conditional on carrier being unchanged. Optional.
                    By default, the override is conditional on carrier being unchanged.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                   A sequence of Load IDs. This operation will try to stop each load from being able to be assigned to a trip. If any of the loads cannot be stopped, none are. That is, the operation succeeds for all of the loads in the list, or for none of them.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processDisableTripContinuationType">
                <xsd:annotation>
                    <xsd:documentation>
                   A collection of  requests to render each specified trip ineligible to continue.
                </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EligibleForContinuationOverrideStatusEnumVal" type="cis:NonLivePickUpDropOffOverrideStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates that the continuation eligibility flag for the trip/booking has been overridden and
                    whether the override is unconditional or conditional on carrier being unchanged. Optional.
                    By default, the override is conditional on carrier being unchanged.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                  A sequence of trip IDs. This operation will try to stop each trip from continuing. If any of the trips cannot be stopped, none are. That is, the operation succeeds for all of the trips in the list, or for none of them.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
