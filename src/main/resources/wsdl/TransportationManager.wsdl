                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether associated resources will be included in resource usage counts.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstTenderIssuedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the load has been tendered at least once.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResourceProjectTypeCode" type="cis:ResourceProjectIDDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Resource Project ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResourceProjectTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ResourceProjectTypeCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
