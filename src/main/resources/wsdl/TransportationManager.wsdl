                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Location" type="cis:SkeletonLocationType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A skeleton location.
                    Ignored if IgnoreSkeletonLocationFlag is not set to false.
                    For Create New, skeleton locations should be supplied, at least two skeleton locations are required.
                    For Create Version, skeleton locations are processed using skeleton location IDs from the source skeleton route version;
                    in this case, skeleton location IDs can be omitted for all skeleton locations in order to re-create all skeleton locations from the input.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the entry was created. This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
