					Description for taxTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ARRelationshipEnumVal" type="cis:ARRelationshipEnumValType" minOccurs="0">
