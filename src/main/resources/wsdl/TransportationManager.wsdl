            Indicates whether post-confirmation updates are allowed for a shipment. Read-only.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateShopReasonCode" type="cis:RateOverrideReasonDomainValueType" minOccurs="0">
