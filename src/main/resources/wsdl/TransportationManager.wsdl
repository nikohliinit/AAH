				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DriverCheckOutReasonCode" type="cis:EventCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The reason code for the driver checked out event.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NonLivePickUpDropOffFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the pick-up or drop-off of the associated load is non-live.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NonLivePickUpDropOffOverrideStatusEnumVal" type="cis:NonLivePickUpDropOffOverrideStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicate that the default setting for the live vs. non-live flag has been overridden and
					whether the override should  survive a change in route or location. Attribute replicated from load.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NonLivePickUpDropOffOverrideStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for nonLivePickUpDropOffOverrideStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InitialCommitmentStartDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The commitment initial start date and time. Cannot be changed after creation of dock commitment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StartDateChangeToEarlierViolationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicate whether the difference between actual start date (changed to an earlier date) and initial start date exceeds the limit for the dock.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StartDateChangeToLaterViolationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicate whether the difference between actual start date (changed to a later date) and initial start date exceeds the limit for the dock.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AcknowledgedCommitmentStartDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The commitment start date and time acknowledged for alert generation. An alert will not be created for start date equal to acknowledged start date.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
