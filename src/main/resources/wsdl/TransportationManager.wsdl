            <xsd:complexType name="processSelectForOptimizationType">
                <xsd:annotation>
                    <xsd:documentation>
            Select Shipment Legs for Optimization.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Operation header.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Criteria" type="cis:SelectionCriteriaType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  The selection criteria for Shipment Legs
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RequestDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  The date and time when the optimization is scheduled to be performed.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BuildTripsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    You can use this flag to include eligible loads not attached to trips in the optimization request
                    if it is sent to Transportation Optimizer.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OnlyLoadsCompatibleWithSelectedShipmentsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates that loads not attached to trips will not be selected by Optimizer if
                    they are not compatible with the collection of
                    shipments associated with the optimization request.
                    You can use this flag only if buildTripsFlag is true.
                    Currently not in use.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoOptimizeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  You can use this flag to send a request to Transportation Optimizer immediately.
                  If True, then the optimization request is sent to Transportation Optimizer.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StrategyFile" type="cis:StrategyFileType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                  The overrided optimizer strategy file path.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncludeEligibleTripsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    You can use this flag to include eligible trips in the optimization request
                    if it is sent to Transportation Optimizer.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OnlyTripsCompatibleWithSelectedShipmentsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates that trips will not be selected by Optimizer if
                    they are not compatible with the collection of
                    shipments associated with the optimization request.
                    You can use this flag only if IncludeEligibleTripsFlag is true.
                    Currently not in use.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadFilterCriteria" type="cis:LoadFilterCriteriaType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The load filtering criteria which is used in optimization to filter loads that otherwise meet basic re-planning eligibility requirements. It will be used only when the buildTripsFlag is true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripFilterCriteria" type="cis:TripFilterCriteriaType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The trip filtering criteria which are used in optimization to filter trips that otherwise meet basic re-planning eligibility requirements.
                    It will be used only when the IncludeEligibleTripsFlag is true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OptimizerInstanceGroupCode" type="cis:OptimizerInstanceGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Optimizer Instance Group ID for optimization.
                    Ignored if active Optimizer Instance Groups do not exist.
                    Mandatory if active Optimizer Instance Groups exist and
                    default Optimizer Instance Group is not defined.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The user ID. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncludeEligibleBookingsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    You can use this flag to include eligible bookings in the optimization request
                    if it is sent to Transportation Optimizer.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OnlyBookingsCompatibleWithSelectedShipmentsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates that bookings will not be selected by Optimizer if
                    they are not compatible with the collection of
                    shipments associated with the optimization request.
                    You can use this flag only if IncludeEligibleBookingsFlag is true.
                    Currently not in use.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingFilterCriteria" type="cis:BookingFilterCriteriaType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The booking filtering criteria which are used in optimization to filter bookings that otherwise meet basic re-planning eligibility requirements.
                    It will be used only when the IncludeEligibleBookingsFlag is true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResourceProjectTypeCode" type="cis:ResourceProjectIDDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Resource Project ID. Will be used only if it is sent to Transportation Optimizer (i.e. autoOptimizeFlag is true). Ignore otherwise.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OptimizationRequestTypeCode" type="cis:OptimizationRequestTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The optimization request type. Will be used only if it is sent to Transportation Optimizer (i.e. autoOptimizeFlag is true). Ignore otherwise.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OptimizerConstraintsGroupCode" type="cis:OptimizerConstraintsGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Defines the Optimizer Constraints Group, a list of Constraint Override Files, to be used by an Evaluation Request.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EvaluationRequestFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether this optimization request is an Evaluation Request; an evaluation request is used to compare the results of running the same optimization with different Constraints.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="processSendToOptimizerType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of optimization requests.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
