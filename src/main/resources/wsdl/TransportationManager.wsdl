                            <xsd:documentation>
            Total distance between the origin and destination locations for this shipment, computed using the default distance engine for the applicable countries. 
            Expressed in the system distance unit of measure. Read-only.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalDistanceFromTariffDistanceEngine" type="cis:DistanceType" minOccurs="0">
