			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="WeightDistanceUOMValueType">
                <xsd:annotation>
                    <xsd:documentation>
		Describes conversion of weight distance value from one UOM to another.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="UomFrom" type="cis:WeightDistanceUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			UOM of source value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UomTo" type="cis:WeightDistanceUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			UOM of target value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ValueFrom" type="cis:WeightDistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Source value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ValueTo" type="cis:WeightDistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Target value.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="UOMValueType">
                <xsd:annotation>
                    <xsd:documentation>
		Describes conversion from one unit of measure to another for a value.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Weight" type="cis:WeightUOMValueType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
			Conversion for weight.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Length" type="cis:LengthUOMValueType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
			Conversion for length.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Volume" type="cis:VolumeUOMValueType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
			Conversion for volume.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Distance" type="cis:DistanceUOMValueType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
			Conversion for distance.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Currency" type="cis:CurrencyUOMValueType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
			Conversion for currency.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightDistance" type="cis:WeightDistanceUOMValueType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
			Conversion for weight distance.
			</xsd:documentation>
                        </xsd:annotation>
