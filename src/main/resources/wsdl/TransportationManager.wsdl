					Mandatory for a new Fuel Surcharge Contract.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                	The currency code. Cannot be blank.
                	Can be updated only if no Fuel Surcharge Prices and no Fuel Surcharge Contracts exist for this Fuel Surcharge Type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for currencyCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Division that the Fuel Surcharge Type is restricted to.
					Cannot be blank. Conditionally updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the Fuel Surcharge Type.
					This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who last updated the Fuel Surcharge Type.
					This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time that the Fuel Surcharge Type was created.
					This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time that the Fuel Surcharge Type was last updated.
					This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
