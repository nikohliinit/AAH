                            <xsd:documentation>
                    The ID of the user who created the driver customer restiction. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who updated the driver customer restiction. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Driver" type="cis:DriverType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Associated driver.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Customer" type="cis:CustomerType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Associated customer.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DriverDomicileType">
                <xsd:annotation>
                    <xsd:documentation>
                Domicile restriction of a driver.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Internal ID. Applicable only for UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDriverDomicileID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    An automatically generated system ID of this driver domicile restriction. Ignored for create; mandatory otherwise.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDriverCode" type="cis:DriverCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID code of the driver. Mandatory for create.
                </xsd:documentation>
