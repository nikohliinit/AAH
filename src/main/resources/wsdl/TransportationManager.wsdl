                            <xsd:documentation>
                An external cost entry.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadScheduleEntry" type="cis:LoadScheduleEntryType" minOccurs="0" maxOccurs="unbounded">
