                        <xsd:annotation>
                            <xsd:documentation>
            The system shipment ID if the load has only one shipment. Read only.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Shipment" type="cis:ShipmentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Shipment associated with the load if the load has only one single shipment.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
