                            <xsd:documentation>
                    The unit of measure for the volume.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VolumeUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for VolumeUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Contact" type="cis:ContactType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The contact information.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryRoutingSelectionMethodEnumVal" type="cis:RoutingSelectionMethodEnumValType" minOccurs="0">
