            <xsd:complexType name="EquipmentCommodityExclusionType">
                <xsd:annotation>
                    <xsd:documentation>
            Defines commodity exclusion/inclusion for an equipment type.  Multiple entries may be applied to a single equipment type.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentCommodityExclusionID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                An automatically generated system identifier. Read only. 
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The equipment type Code. Read only. Value for create and update based on parent entity.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID of the commodity which will be excluded or included from the equipment. Mandatory field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentCompartmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The equipment compartment identifier. Optional. Read only. Value for create and update based on parent entity.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncludeExcludeRestrictionEnumVal" type="cis:IncludeExcludeRestrictionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicate the commodity is for exclude or include restriction.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncludeExcludeRestrictionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for includeExcludeRestrictionEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The date and time that the entry was created. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID of the user who created the entry. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The date and time that the entry was updated. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID of the user who updated the entry. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="EquipmentAssociationType">
                <xsd:annotation>
                    <xsd:documentation>
            	Defines valid tractor/trailer associations for an equipment type.
            	Multiple entries may be applied to a single equipment type.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentAssociationID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                	An automatically generated system identifier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorEquipmentTypeCode" type="cis:EquipmentTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                	The tractor equipment type code.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrailerEquipmentTypeCode" type="cis:EquipmentTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                	The trailer equipment type code.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RestrictedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the equipment association is restricted.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time that the record was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time that the record was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the record. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the record. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="EquipmentAxleType">
                <xsd:annotation>
                    <xsd:documentation>
				Information related to an axle of an equipment type.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemEquipmentAxleID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated Equipment Axle ID. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The equipment type ID. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AxleSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The sequence number of the axle. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadPointLocation" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The location of the axle.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadPointTareWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tare weight on the axle.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadPointMaxLoadWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum load weight on the axle.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AxleSpringFactor" type="cis:UnitDivideFactorType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The spring factor of the axle.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created this equipment axle. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when this equipment axle was created. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who most recently updated this equipment axle. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when this equipment axle was most recently updated. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="EquipmentCapacityDegradationType">
                <xsd:annotation>
                    <xsd:documentation>
				Equipment type capacity reduction related to multiple drop stops, items and/or loading types on a load.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemEquipmentCapacityDegradationID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated Equipment Capacity Degradation ID. Read-only.
                    Ignored for Create.
                    For operations other than Create, mandatory unless full business key is specified.
                    The business key consists of EquipmentTypeCode, FromShippingLocationTypeEnumVal, FromShippingLocationCode,
                    ToShippingLocationTypeEnumVal, ToShippingLocationCode, MinimumNumberOfDropStops, MaximumNumberOfDropStops, MinimumNumberOfItems,
                    MaximumNumberOfItems, MinimumNumberOfLoadingTypes and MaximumNumberOfLoadingTypes.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The equipment type ID.
                    Mandatory for Create. Not editable.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemEquipmentCapacityDegradationID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FromShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shipping location type for the start location.
                    Mandatory for Create if FromShippingLocationCode is provided and the shipping location cannot be uniquely identified by FromShippingLocationCode.
                    Not editable.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemEquipmentCapacityDegradationID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FromShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for FromShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FromShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shipping location ID for the start location.
                    Mandatory for Create if FromShippingLocationTypeEnumVal is provided.
                    Not editable.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemEquipmentCapacityDegradationID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ToShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shipping location type for the end location.
                    Mandatory for Create if ToShippingLocationCode is provided and the shipping location cannot be uniquely identified by ToShippingLocationCode.
                    Not editable.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemEquipmentCapacityDegradationID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ToShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ToShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ToShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shipping location ID for the end location.
                    Mandatory for Create if ToShippingLocationTypeEnumVal is provided.
                    Not editable.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemEquipmentCapacityDegradationID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the equipment capacity degradation is currently active.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumNumberOfDropStops" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The minimum number of drop stops.
                    Cannot be changed for an existing equipment capacity degradation, NewMinimumNumberOfDropStops should be used for this purpose.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemEquipmentCapacityDegradationID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NewMinimumNumberOfDropStops" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The new minimum number of drop stops for an existing equipment capacity degradation (change operation only).
                    Not applicable for a new equipment capacity degradation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberOfDropStops" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum number of drop stops.
                    Cannot be changed for an existing equipment capacity degradation, NewMaximumNumberOfDropStops should be used for this purpose.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemEquipmentCapacityDegradationID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NewMaximumNumberOfDropStops" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The new maximum number of drop stops for an existing equipment capacity degradation (change operation only).
                    Not applicable for a new equipment capacity degradation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumNumberOfItems" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The minimum number of items.
                    Cannot be changed for an existing equipment capacity degradation, NewMinimumNumberOfItems should be used for this purpose.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemEquipmentCapacityDegradationID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NewMinimumNumberOfItems" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The new minimum number of items for an existing equipment capacity degradation (change operation only).
                    Not applicable for a new equipment capacity degradation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberOfItems" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum number of items.
                    Cannot be changed for an existing equipment capacity degradation, NewMaximumNumberOfItems should be used for this purpose.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemEquipmentCapacityDegradationID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NewMaximumNumberOfItems" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The new maximum number of items for an existing equipment capacity degradation (change operation only).
                    Not applicable for a new equipment capacity degradation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumNumberOfLoadingTypes" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The minimum number of loading types.
                    Cannot be changed for an existing equipment capacity degradation, NewMinimumNumberOfLoadingTypes should be used for this purpose.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemEquipmentCapacityDegradationID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NewMinimumNumberOfLoadingTypes" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The new minimum number of loading types for an existing equipment capacity degradation (change operation only).
                    Not applicable for a new equipment capacity degradation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberOfLoadingTypes" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum number of loading types.
                    Cannot be changed for an existing equipment capacity degradation, NewMaximumNumberOfLoadingTypes should be used for this purpose.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemEquipmentCapacityDegradationID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NewMaximumNumberOfLoadingTypes" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The new maximum number of loading types for an existing equipment capacity degradation (change operation only).
                    Not applicable for a new equipment capacity degradation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentCapacityDegradationEnumVal" type="cis:EquipmentCapacityDegradationEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The equipment capacity degradation type. Mandatory for Create.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentCapacityDegradationEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for EquipmentCapacityDegradationEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumUtilizationPercent" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum utilization percentage.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created this equipment capacity degradation. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when this equipment capacity degradation was created. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who most recently updated this equipment capacity degradation. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when this equipment capacity degradation was most recently updated. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="EquipmentCompartmentType">
                <xsd:annotation>
                    <xsd:documentation>
			    The equipment compartment of an equipment.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemEquipmentCompartmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated Equipment Compartment ID. 
                    Mandatory for update. Omitted for create. 
                    When the ignoreEquipmentCompartmentFlag is false in EquipmentTypeType during equipment type update,
                    any EquipmentCompartmentType not included in the collection will be deleted.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The equipment type ID. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CompartmentPosition" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The compartment position within an equipment type. Unique within an equipment type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowStaggeringFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the compartment can be staggered. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentCompartmentDividerEnumVal" type="cis:EquipmentCompartmentDividerEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The compartment divider type. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentCompartmentDividerEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for equipmentCompartmentDividerEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FlexibleFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the compartment is flexible. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadConfiguratorEnumVal" type="cis:LoadConfiguratorEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The load configuration type. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadConfiguratorEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for loadConfiguratorEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadingSequence" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The loading sequence of this compartment. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumCommodity" type="cis:QuantityType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum number of commodities for this compartment. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumPieces" type="cis:QuantityType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum number of pieces for this compartment. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumPallets" type="cis:QuantityType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum number of pallets for this compartment. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumVolume" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum volume for this compartment. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum weight for this compartment. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumUnits" type="cis:QuantityType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum units for this compartment. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BaseHeight" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum weight for this compartment. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UsableHeight" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Usable height of this compartment. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UsableLength" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Usable length of this compartment. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UsableWidth" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Usable width of this compartment. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreEquipmentCommodityExclusionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of EquipmentCommodityExclusion should be ignored.  Defaults to true if not specified. May be present for add and change operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RetainExistingCommodityExclusionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Indicates that the existing Commodity Exclusion should be retained when adding new Commodity Exclusion or updating an existing one.Defaults to false if not specified. May be present for change operation. 
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentCommodityExclusion" type="cis:EquipmentCommodityExclusionType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Equipment Commodity Exclusion of this equipment compartment.  Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreCommodityExclusionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of CommodityExclusion should be ignored.  Defaults to true if not specified. May be present for add and change operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityExclusion" type="cis:CommodityExclusionType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    The commodity exclusion for this equipment compartment. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The date and time that the Equipment Compartment was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time that the Equipment Compartment was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created the Equipment Compartment. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who updated the Equipment Compartment. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="EquipmentTypeType">
                <xsd:annotation>
                    <xsd:documentation>
			The type of equipment used to move the load.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The equipment type Code. This is a required field. It is not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the equipment type. This is a required field.  It is updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Length" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The equipment type length. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Width" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The equipment type width. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Height" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The equipment type height. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnitTareWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The equipment type tare weight.  Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UsableLength" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The usable length of the equipment type.  Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UsableWidth" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The usable width of the equiment type.  Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UsableHeight" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The usable height of the equipment type.   Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumLoadWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum load weight of the equipment type.  Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadPoint1Location" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The location of the first axle. Currently not in use, moved to Equipment Axle.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadPoint1TareWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tare weight on the first axle. Currently not in use, moved to Equipment Axle.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadPoint1MaxLoadWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum load weight on the first axle. Currently not in use, moved to Equipment Axle.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadPoint2Location" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The location of the second axle. Currently not in use, moved to Equipment Axle.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadPoint2TareWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tare weight on the second axle. Currently not in use, moved to Equipment Axle.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadPoint2MaxLoadWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum load weight on the second axle. Currently not in use, moved to Equipment Axle.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FixedLoadingUnloadingHoursActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether FixedLoadingUnloadingHours is active.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FixedLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The fixed load or unload hours allowed. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumMaximumLoadingUnloadingHoursActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether MaximumLoadingUnloadingHours and MinimumLoadingUnloadingHours are active.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum load or unload hours allowed. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum load or unload hours allowed. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode1" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The external code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SideDoorFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether the equipment has side door or not. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SideDoorLocation" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The linear measurement or postion of the side door on the equipment. Non-zero if SideDoorFlag is true. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NearTailLocation" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The imaginary boundary in the trailer that can be considered near the tail for rear door unloading. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DriverControlEnumVal" type="cis:DriverControlEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The driver control.
					Not applicable to trailer equipment types.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DriverControlEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for DriverControlEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentCategoryEnumVal" type="cis:EquipmentCategoryEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The equipment category.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentCategoryEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for EquipmentCategoryEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FEUFactor" type="cis:UnitDivideFactorType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The FEU (Forty Foot Equivalent Unit) factor. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastRollHeightClearance" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The clearance required for cylinders that are loaded as rolls at the end of the equipment. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastStackHeightClearance" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The clearance required for cylinders that are loaded as stacks at the end of the equipment. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StackLoadingOnRightFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether cylinders should start loading on the right side of the equipment. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadConfiguratorEquipmentTypeEnumVal" type="cis:LoadConfiguratorEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether this equipment type is used for full loading or pallet building.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadConfiguratorEquipmentTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for LoadConfiguratorEquipmentTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the Equipment Type was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the Equipment Type was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created the Equipment Type. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who updated the Equipment Type. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnitOfMeasure" type="cis:UnitOfMeasureType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The unit of measurement for the equipment type.
					The field is obsolete.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreVariableLoadUnloadTimeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of VariableLoadingUnloadingTime should be ignored.  Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VariableLoadingUnloadingTime" type="cis:VariableLoadingUnloadingTimeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				Variable loading or unloading time factor.  Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreEquipmentCommodityExclusionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                	Indicates whether the contents of EquipmentCommodityExclusion should be ignored.  Defaults to true if not specified. May be present for add and change operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RetainExistingCommodityExclusionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Indicates that the existing Commodity Exclusion should be retained when adding new Commodity Exclusion or updating an existing one.Defaults to false if not specified. May be present for change operation. 
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RetainExistingEquipmentCompartmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Indicates that the existing Compartments should be retained, when adding new Compartments or updating an existing Compartment at Equipment level. Defaults to false if not specified. May be present for change operation.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentCommodityExclusion" type="cis:EquipmentCommodityExclusionType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                Equipment Commodity Exclusion.  Optional. Updatable. 
                This collection only includes equipment commodity exclusion/restriction at the equipment type level.
                Exclusion/Restrictions at the equipment compartment level are not included here.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreEquipmentAssociation" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                	Indicates whether the contents of EquipmentAssociation should be ignored.  Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentAssociation" type="cis:EquipmentAssociationType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The equipment association representing an associated trailer equipment type.
					Applicable only to tractor equipment types.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreEquipmentAxleFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of EquipmentAxle should be ignored.  Defaults to true if not specified. May be present for add and change operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentAxle" type="cis:EquipmentAxleType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    The equipment axle.
                    Sequence of equipment axles is determined by order of input data.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreCommodityExclusionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of CommodityExclusion should be ignored.  Defaults to true if not specified. May be present for add and change operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityExclusion" type="cis:CommodityExclusionType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    The commodity exclusion for this equipment type. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreEquipmentCompartmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of EquipmentCompartment should be ignored.  Defaults to true if not specified. May be present for add and change operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentCompartment" type="cis:EquipmentCompartmentType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    The equipment compartment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="EquipmentTypeCrossReferenceType">
                <xsd:annotation>
                    <xsd:documentation>
				An equipment type cross-reference.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ExternalCode" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The external ID code. Mandatory.  May not be empty.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The equipment type code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="EventReasonType">
                <xsd:annotation>
                    <xsd:documentation>
				An event reason associated with events that occur in Transportation Manager.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventReasonCode" type="cis:EventCodeType">
                        <xsd:annotation>
                            <xsd:documentation>
					The event reason code. Mandatory. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A description of the Event Reason.
					Mandatory for a new Event Reason. Cannot be blank. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the Event Reason is active or not.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode1" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					An external identifying code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode2" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A second external identifying code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemProvidedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the Event Reason is system provided or not. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the Event Reason. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the Event Reason. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time that the Event Reason was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time that the Event Reason was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ExchangeRateDataType">
                <xsd:annotation>
                    <xsd:documentation>
				An exchange rate data entry for a combination of currency, exchange rate group and date range.
				By default, open date range is assumed.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemCurrencyID" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A system-generated currency identifier.
					Either this field or CurrencyCode must be provided for an entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The currency code.
					Either this field or SystemCurrencyID must be provided to for an entry.
					Ignored if SystemCurrencyID is supplied.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRateGroupCode" type="cis:ExchangeRateGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The exchange rate group ID. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRate" type="cis:ExchangeRateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The exchange rate. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EffectiveDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The effective date.
					If not specified, open effective date is assumed such that the exchange rate will apply to any date before and on the expiration date.
					Cannot be an empty element.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExpirationDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The expiration date.
					If not specified, open expiration date is assumed such that the exchange rate will apply to any date on and after the effective date.
					Cannot be an empty element.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ExchangeRateEntryType">
                <xsd:annotation>
                    <xsd:documentation>
				An exchange rate entry for a combination of currency, exchange rate group and date range.
				By default, open date range is assumed.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemExchangeRateID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A system-generated exchange rate identifier.
					Either this field or a combination of SystemCurrencyID or CurrencyCode,
					ExchangeRateGroupCode, EffectiveDate and ExpirationDate must be provided to identify an entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemCurrencyID" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A system-generated currency identifier.
					Either SystemExchangeRateID or a combination of this field or CurrencyCode,
					ExchangeRateGroupCode, EffectiveDate and ExpirationDate must be provided to identify an entry.
					This field or CurrencyCode must be provided to create a new exchange rate entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The currency code.
					Either SystemExchangeRateID or a combination of SystemCurrencyID or this field,
					ExchangeRateGroupCode, EffectiveDate and ExpirationDate must be provided to identify an entry.
					SystemCurrencyID or this field must be provided to create a new exchange rate entry.
					Ignored if SystemCurrencyID is supplied.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRateGroupCode" type="cis:ExchangeRateGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The exchange rate group ID.
					Either SystemExchangeRateID or a combination of SystemCurrencyID or CurrencyCode,
					this field, EffectiveDate and ExpirationDate must be provided to identify an entry.
					Cannot be updated for an existing exchange rate entry.
					Mandatory for a new exchange rate entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRate" type="cis:ExchangeRateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The exchange rate. Updatable.
					Mandatory for a new exchange rate entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EffectiveDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The effective date.
					If not specified, open effective date is assumed such that the exchange rate will apply to any date before and on the expiration date.
					Either SystemExchangeRateID or a combination of SystemCurrencyID or CurrencyCode,
					ExchangeRateGroupCode, this field and ExpirationDate must be provided to identify an entry.
					Cannot be changed for an existing exchange rate entry, NewEffectiveDate should be used for this purpose.
					Cannot be an empty element.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NewEffectiveDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The new effective date for an existing exchange rate entry (change operation only). Optional.
					Cannot be an empty element.
					Not applicable for a new exchange rate entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NewEffectiveDateActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the effective date should be changed to the value provided as NewEffectiveDate
					or left unchanged if effective date exists and NewEffectiveDate is not provided.
					If false and effective date exists, effective date will be cleared such that the exchange rate will apply to any date before and on the expiration date.
					Not applicable for a new exchange rate entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExpirationDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The expiration date.
					If not specified, open expiration date is assumed such that the exchange rate will apply to any date on and after the effective date.
					Either SystemExchangeRateID or a combination of SystemCurrencyID or CurrencyCode,
					ExchangeRateGroupCode, EffectiveDate and this field must be provided to identify an entry.
					Cannot be changed for an existing exchange rate entry, NewExpirationDate should be used for this purpose.
					Cannot be an empty element.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NewExpirationDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The new expiration date for an existing exchange rate entry (change operation only). Optional.
					Cannot be an empty element.
					Not applicable for a new exchange rate entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NewExpirationDateActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the expiration date should be changed to the value provided as NewExpirationDate
					or left unchanged if expiration date exists and NewExpirationDate is not provided.
					If false and expiration date exists, expiration date will be cleared such that the exchange rate will apply to any date on and after the effective date.
					Not applicable for a new exchange rate entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the exchange rate entry was created. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the exchange rate entry was updated. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the exchange rate entry. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the exchange rate entry. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ExchangeRateGroupType">
                <xsd:annotation>
                    <xsd:documentation>
				An exchange rate group used as a source for exchange rate information.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRateGroupCode" type="cis:ExchangeRateGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The exchange rate group ID. Mandatory. Cannot be changed for an existing exchange rate group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRateGroupDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A description of the exchange rate group. Mandatory for creating an exchange rate group. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the exchange rate group is active. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IsDefaultFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the exchange rate group is the default exchange rate group. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the exchange rate group was created. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the exchange rate group was updated. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the exchange rate group. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the exchange rate group. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A memo associated with the exchange rate group.  Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ExternalAliasStructureType">
                <xsd:annotation>
                    <xsd:documentation>
			An external alias that a customer can use for a shipping location.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID code of the external alias. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalLocationDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the external location. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalLocationUsageFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether a customer uses the external ID as a default. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerShippingLocationCrossReference" type="cis:CustomerShippingLocationCrossReferenceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated cross-reference relationship for a customer and shipping location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="GLAccountDesignationType">
                <xsd:annotation>
                    <xsd:documentation>
				Record of a G/L Account Designation.
                                Some of the input fields here are conditional mandatory or ignored depending on
                                how the global settings are defined.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemGLAccountDesignationID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated ID for the G/L Account Designation record. Ignored for create. Mandatory otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLClassificationEnumVal" type="cis:GLClassEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The G/L Classification. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLClassificationEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Description for GLClassificationEnumVal. Read-only. Available only through UI-oriented APIs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLTypeCode" type="cis:GLDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The G/L Type. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Description for GLTypeCode. Read-only. Available only through UI-oriented APIs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ProfitCenterCode" type="cis:ProfitCenterDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                        The profit center to which the customer revenue is assigned. 
                                        Mandatory for G/L classification GLC_AR_ACCRUED_REVENUE, GLC_AR_ACCRUED_ASSET,
                                        GLC_AR_REVENUE and GLC_AR_ASSET.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ProfitCenterCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Description for profitCenterCode. Read-only. Available only through UI-oriented APIs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CostCenterCode" type="cis:CostCenterDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                        The cost center to which the carrier expense is assigned. 
                                        Mandatory for G/L classification GLC_AP_ACCRUED_EXPS_RVNU_SHPM,
                                        GLC_AP_ACCRUED_LBTY_RVNU_SHPM, GLC_AP_EXPS_RVNU_SHPM,
                                        GLC_AP_LBTY_RVNU_SHPM, GLC_AP_ACCRUED_EXPS_NON_RVNU_SHPM,
                                        GLC_AP_ACCRUED_LBTY_NON_RVNU_SHPM, GLC_AP_EXPS_NON_RVNU_SHPM and
                                        GLC_AP_LBTY_NON_RVNU_SHPM.
                                        The field will be Read only when G/L classification is for AR and 
                                        the Revenue By Cost Center flag of Global Defaults is off
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CostCenterCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Description for costCenterCode. Read-only. Available only through UI-oriented APIs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginLocationGLCategoryCode" type="cis:GLCategoryDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                        The G/L category of the origin location. 
                                        Conditional mandatory or read only depending on global setting.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginLocationGLCategoryCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Description for originLocationGLCategoryCode. Read-only. Available only through UI-oriented APIs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationLocationGLCategoryCode" type="cis:GLCategoryDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                        The G/L category of the destination location.
                                        Conditional mandatory or read only depending on global setting.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationLocationGLCategoryCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Description for destinationLocationGLCategoryCode. Read-only. Available only through UI-oriented APIs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLAccountNumber" type="cis:GLAccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The G/L account number. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                        The date and time when the record was created. Read only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                        The date and time when the record was updated. Read only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division ID. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                        The logistics group ID.
                                        Conditional mandatory or read only depending on global setting.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginGLRegionZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                        The original shipping location GL region zone ID.
                                        Conditional mandatory or read only depending on global setting.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationGLRegionZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                        The destination shipping location GL region zone ID.
                                        Conditional mandatory or read only depending on global setting.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                        The commodity ID.
                                        Conditional mandatory or read only depending on global setting.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created this record. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                        The ID of the user who updated this record. Read only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="HubType">
                <xsd:annotation>
                    <xsd:documentation>
			A center for load consolidation or deconsolidation, also called a cross-dock or pool-point. Consolidation is the combining of several shipments into a single load or multiple loads. Deconsolidation is the separation of shipments that are grouped together in a load for delivery to their final destinations.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HubCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A unique hub code. Mandatory. Not modifiable during update.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HubDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the hub. Mandatory for create. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCode" type="cis:LanguageDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The language used at the hub. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for languageCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AppointmentRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether a carrier has to make an appointment to pick up or drop off shipments at the hub. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumShipmentWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum weight of a shipment that can pass through the hub. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumShipmentVolume" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum volume of a shipment that can pass through the hub. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumEquipmentLength" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum length of the equipment allowed at this hub. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumEquipmentWidth" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum width of the equipment allowed at this hub. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumEquipmentHeight" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum height of the equipment allowed at this hub. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowDropOffEnumVal" type="cis:DropEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The degree to which drop-offs of shipments at the hub are allowed. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowDropOffEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for allowDropOffEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowPickUpEnumVal" type="cis:PickEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The degree to which pickups of shipments at the hub are allowed. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowPickUpEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for allowPickUpEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowDeconsolidationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the hub allows deconsolidation. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumDeconsolidationWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The field is obsolete.
				The minimum deconsolidation weight allowed for the hub. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumConsolidationWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The field is obsolete.
				The minimum consolidation weight allowed for the hub. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumDropWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The minimum drop-off weight allowed for the hub. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LargestFreeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The field is obsolete.
				Indicates whether the carrier who owns the hub does not charge for the largest drop. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnableAlertsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The field is obsolete.
				Indicates whether the delivery alert process is active. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FixedLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The fixed load or unload hours. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum load or unload hours. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLeadTimeHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The minimum lead time hours. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The minimum load or unload hours. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveLoadCodeEnumVal" type="cis:LiveLoadEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether outbound live or non-live loading is allowed;
					if non-live, then it indicates whether there can be outbound non-live loading
					during business hours or any time.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveLoadCodeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LiveLoadCodeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveUnloadCodeEnumVal" type="cis:LiveLoadEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether inbound live or non-live unloading is allowed;
					if non-live, then it indicates whether there can be inbound non-live unloading
					during business hours or any time.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveUnloadCodeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LiveUnloadCodeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstStopFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether any shipment leg starting from this location must be the first stop for the load. Mandatory for create. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastStopFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether any shipment leg terminating at this location must be the last stop for the load. Mandatory for create. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SideDoorUnloadingRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether side door unloading is required at this location
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NearTailUnloadingRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicates whether rear door unloading is required at this location
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OrderGroupingEnabledFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicate whether order grouping is enabled for this shipping location
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationPickupSequenceNumber" type="cis:PickSequenceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The Shipping Location Shipment Pickup Sequence Number
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BoundaryRuleEnumVal" type="cis:BoundaryRuleEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The boundary rules. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BoundaryRuleEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for boundaryRuleEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FullServiceHubFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the hub provides full service. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLCategoryCode" type="cis:GLCategoryDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The G/L category type. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLCategoryCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for GLCategoryCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CorporateID1" type="cis:CorporateIdType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A corporate identifier code. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CorporateID2" type="cis:CorporateIdType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A second corporate identifier code. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The logistics group of the hub. If you do not supply an input value for this field when creating this structure, then the value will be taken from the user's profile. To force this value to be blank, enter a single space in quotes. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The division ID of the hub. If you do not supply an input value for this field when creating this structure, then the value will be taken from the user's profile to force this value to be blank, enter a single space in quotes. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HubTransferServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The charge associated with the hub transfer. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HubOwnerCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier that owns the hub. Mandatory for create. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HubExclusiveRegionGroupCode" type="cis:ZoneGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The group ID of the hub's excluded region. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLRegionZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The G/L region zone ID. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The default INCO terms shipping location code. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The default INCO terms shipping location type. Optional. Updatable.
					For the Add operation or for the Change operation with INCO shipping location change,
					if INCOShippingLocationCode is specified but
					INCOShippingLocationTypeEnumVal is not specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for INCOShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncotermsShippingLocationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the hub can be used as Incoterms shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode1" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				An external identifying code. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode2" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A second external identifying code. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RespondToTenderHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The maximum number of hours for the hub to respond to the tender offers.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The primary shipping location code for this location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The primary shipping location type for this location. Optional. Updatable.
					For the Add operation or for the Change operation with primary shipping location change,
					if primaryShippingLocationCode is specified but
					primaryShippingLocationTypeEnumVal is not specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for primaryShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumOptimizationWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum optimization weight.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumOptimizationWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum optimization weight.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumOptimizationVolume" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum optimization volume.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumOptimizationVolume" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum optimization volume.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumOptimizationPieces" type="cis:QuantityNullableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum optimization number of pieces.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumOptimizationPieces" type="cis:QuantityNullableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum optimization number of pieces.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumOptimizationPallets" type="cis:QuantityNullableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum optimization number of pallets.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumOptimizationPallets" type="cis:QuantityNullableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum optimization number of pallets.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumOptimizationInboundLoads" type="cis:QuantityNullableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum optimization number of inbound loads.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumOptimizationInboundLoads" type="cis:QuantityNullableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum optimization number of inbound loads.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumOptimizationOutboundLoads" type="cis:QuantityNullableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum optimization number of outbound loads.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumOptimizationOutboundLoads" type="cis:QuantityNullableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum optimization number of outbound loads.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PenaltyForMinimumViolation" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The penalty for violation of a minimum constraint.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PenaltyForMaximumViolation" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The penalty for violation of a maximum constraint.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumShipmentHoldHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum number of hours to hold the shipment at a hub.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumCrossDockHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum number of hours to hold the shipment at a hub.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadUnloadTimeCalculationEnumVal" type="cis:FixedTimeModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Loading/unloading time calculation mode.
					The setting will determine how loading/unloading times from
					equipment type and location are handled in calculations.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadUnloadTimeCalculationEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LoadUnloadTimeCalculationEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssumeTrailerSwapFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether trailer swap is assumed.
					The setting will influence the loading/unloading time calculations and
					whether empty trailers can be picked or dropped.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowEmptyLoadFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether a load is allowed to drop all freight at this location before any picks when this location is not the final delivery stop.
                    Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HubStatusEnumVal" type="cis:HubStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The status of the hub. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HubStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for hubStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ManageTrailerAlertsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether this location supports trailer alerts management.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoCreateNonLiveCommitmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether this location supports auto creation of non-live dock commitment.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WarehouseManagementSystemInstanceCode" type="cis:WarehouseManagementSystemInstanceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The WMS Instance ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginMaximumNumberShipmentSplit" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Maximum number of shipment splits for origin location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginSplitRulePrecisionEnumVal" type="cis:SplitRuleEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Split rule precision for desintaion location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginSplitRulePrecisionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Description for originSplitRulePrecisionEnumVal. Read-only. Available only through UI-oriented APIs.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginMinimumShipmentOverrideWindow" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Minimum shipment override window for origin location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationMaximumNumberShipmentSplit" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Maximum number of shipment splits for destination location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationSplitRulePrecisionEnumVal" type="cis:SplitRuleEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Split rule precision for desintaion location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationSplitRulePrecisionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Description for destinationSplitRulePrecisionEnumVal. Read-only. Available only through UI-oriented APIs.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationMinimumShipmentOverrideWindow" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Minimum shipment override window for destination location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PreloadingActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether any value exists for EarliestPreLoadingEndHours and LatestPreLoadingEndHours.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestPreloadingEndHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The largest allowed interval between the time when pre-loading is complete and the time of carrier pick-up.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestPreloadingEndHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The smallest allowed interval between the time when pre-loading is complete and the time of carrier pick-up.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PostDischargeActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether any value exists for EarliestPostDischargeStartHours and LatestPostDischargeStartHours.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestPostDischargeStartHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The smallest allowed interval between the time of carrier drop-off and the time when post-discharge starts.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestPostDischargeStartHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The largest allowed interval between the time of carrier drop-off and the time when post-discharge starts.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the hub was created. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the hub was updated. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created the hub. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who updated the hub. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DTTEOverrideEnumVal" type="cis:DTTEOverrideEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether to convert or delete the distance override when updating the hub's address. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Address" type="cis:AddressType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The address of the hub. Mandatory for create. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Contact" type="cis:ContactType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The contact information for the hub. Mandatory for create. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessHours" type="cis:BusinessHoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The business hours for the hub. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A memo associated with the hub. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransferOnlyFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether a hub is a transfer only hub. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreContactsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of ContactPerson should be ignored.
					If false during change, all existing ContactPerson members of this entity will be deleted and replaced with the contents of ContactPerson.
					Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContactPerson" type="cis:ContactPersonType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				Contacts associated with the hub. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAutoAppliedOptionsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of the autoAppliedOption should be ignored.
					If false during change, all existingAutoAppliedOption members of this entity will be deleted and replaced with the contents of AutoAppliedOption.
					Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoAppliedOption" type="cis:AutoAppliedOptionType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The auto-applied options for the hub. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreCustomerShippingLocationCrossReferenceFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of CustomerShippingLocationCrossReference should be ignored.
					If false during change, all existing CustomerShippingLocationCrossReference members of this entity will be deleted and replaced with the contents of CustomerShippingLocationCrossReference.
					Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerShippingLocationCrossReference" type="cis:CustomerShippingLocationCrossReferenceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The cross-reference relationship for a customer and shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreVariableLoadUnloadTimeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of VariableLoadingUnloadingTime should be ignored.
					If false during change, all existing VaraibleLoadingUnloadingTime members of this entity will be deleted and replaced with the contents of VariableLoadingUnloadingtTime.
					Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VariableLoadingUnloadingTime" type="cis:VariableLoadingUnloadingTimeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
Variable loading or unloading time factor. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreDockFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of Dock should be ignored.
					If false during change, all existing Dock members of this entity will be deleted and replaced with the contents of Dock.
					Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Dock" type="cis:DockType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
Docks of this Hub. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreEquipmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the collection of equipment elements should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Equipment" type="cis:ShippingLocationEquipmentType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
Supported equipment types for this hub.  Contents will only be considered if the ignoreEquipmentFlag is false.  May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreShipmentSplitRuleFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the collection of shipment split rules should be ignored.  May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentSplitRule" type="cis:ShipmentSplitRuleType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Shipment split rules for this hub.  Contents will only be considered if the ignoreShipmentSplitRuleFlag is false.  May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberTrailersAllowed" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Maximum number of trailers permitted at the location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberTrailersCanBeHandled" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Maximum number of trailers that can be handled at a time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumTotalTrailerLength" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Maximum total trailer(s) length permitted at the location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="HubStatusChangeInfoType">
                <xsd:annotation>
                    <xsd:documentation>
			A collection of information for the Hub's status to change to.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="HubCode" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of Hub codes. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HubStatusEnumVal" type="cis:HubStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The new status of the hub. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="INCOTermsType">
                <xsd:annotation>
                    <xsd:documentation>
                      INCO terms are a set of standard international freight terms defined by the International Chamber of Commerce. They bring consistency to the description of freight movements, and help eliminate uncertainty regarding which party is responsible for paying the cost of the freight movement, particularly for international shipments.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncoTermsCode" type="cis:INCOTermsCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The INCO terms code. Mandatory. Not modifiable during update.  INCO terms are identified by the combination of IncoTermsCode, IncoVersionEnumVal, and DivisionCode.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncoTermsDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A description of the INCO terms. Mandatory for create. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncoVersionEnumVal" type="cis:INCOVersionEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The version of these INCO terms. Possible values are INCO_VERSION_NULL, INCO_VERSION_1990, INCO_VERSION_2000 and INCO_VERSION_2010. Mandatory. Not modifiable during update. INCO terms are identified by the combination of IncoTermsCode, IncoVersionEnumVal, and DivisionCode.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncoVersionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for IncoVersionEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division code. Mandatory. Not modifiable during update. INCO terms are identified by the combination of IncoTermsCode, IncoVersionEnumVal, and DivisionCode.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncoShippingLocationEnumVal" type="cis:INCOShippingLocationEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The INCO terms Shipping Location Source. Possible values are INCO_NULL, INCO_ORIGIN and INCO_DESTINATION. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncoShippingLocationEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for incoShippingLocationEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultIncoShippingLocationTypeEnumVal" type="cis:DefaultIncoShippingLocationTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Default Incoterms Shipping Location Type. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultIncoShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for defaultIncoShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time that the INCO terms were created. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time that the INCO terms were updated. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created these INCO terms. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated these INCO terms. Read only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ItemGroupType">
                <xsd:annotation>
                    <xsd:documentation>
			Representation for a collection of Item Masters for a customer.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemGroupCode" type="cis:ItemGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The Item Group ID. Cannot be changed for an existing Item Group.  Mandatory for all operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemGroupDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the Item Group. Mandatory for create. Can always be changed during update. The value cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NMFCRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether NMFC is required for Item Masters of this Item Group. Cannot be changed if Item Masters already exist for this Item Group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HarmonizedTariffRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether Harmonized Tariff is required for Item Masters of this Item Group. Cannot be changed if Item Masters already exist for this Item Group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnitOfMeasure" type="cis:UnitOfMeasureType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The unit of measurement structure. Cannot be changed if Item Masters already exist for this Item Group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the Item Group was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the Item Group was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who created the Item Group. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who updated the Item Group. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferencedByCustomerFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether this Item Group is referenced by a customer. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
A memo associated with the Item Group.  Optional. Can always be updated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreItemMastersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of ItemMaster should be ignored. This flag is not used for an existing Item Group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemMaster" type="cis:ItemMasterType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
Item Masters associated with the Item Group.  Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ItemLoadingFactorType">
                <xsd:annotation>
                    <xsd:documentation>
                Item loading factor defines the minimum and maximum quantity, distance and transit time for a load having matched combination of 
                Item Package Level, Equipment Type, Origin (if defined) and Destination (if defined) for a given loading type.
                If there are more than one matched, the one with the highest priority will be applicable.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemItemLoadingFactorID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated item loading factor ID. Read-only.
                    Ignored for Create.
                    For operations other than Create, mandatory unless full business key is specified.
                    The business key consists of ItemType, LoadingTypeCode, EquipmentTypeCode, OriginZoneCode, DestinationZoneCode, ItemNumber and ItemGroup.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemType" type="cis:ItemDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The item type used for this item loading factor.
                    Not editable.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemItemLoadingFactorID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemTypeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ItemType. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadingTypeCode" type="cis:LoadingTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Loading type ID. Mandatory for Create.
                    Not editable.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemItemLoadingFactorID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The equipment type ID. Mandatory for Create.
                    Not editable.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemItemLoadingFactorID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The origin zone ID.
                    Not editable.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemItemLoadingFactorID is provided.
                    If the element is used to identify an item loading factor with empty origin zone ID, quoted space is expected.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The destination zone ID.
                    Not editable.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemItemLoadingFactorID is provided.
                    If the element is used to identify an item loading factor with empty destination zone ID, quoted space is expected.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemNumber" type="cis:ItemNumberCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Item Master ID.
                    Not editable.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemItemLoadingFactorID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemGroupCode" type="cis:ItemGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Item Group ID.
                    Not editable.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemItemLoadingFactorID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemPackageLevelIDCode" type="cis:ItemPackageLevelIDTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The item package level type ID. Mandatory on Create.
                    System-defined values are '100' for 'Pallets', '200' for 'Layers' and '300' for 'Pieces'.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemPackageLevelIDCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ItemPackageLevelIDCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemLoadingFactorStatusEnumVal" type="cis:ItemLoadingFactorStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The item loading factor status.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemLoadingFactorStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ItemLoadingFactorStatusEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Priority" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Priority: the lower the number, the higher the priority.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumQuantity" type="cis:QuantityType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum quantity.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumTransitTime" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum transit time.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum distance.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumTransitTime" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The minimum transit time.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The minimum distance.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created this equipment capacity degradation. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when this equipment capacity degradation was created. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who most recently updated this equipment capacity degradation. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when this equipment capacity degradation was most recently updated. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ItemMasterType">
                <xsd:annotation>
                    <xsd:documentation>
			A template for creation of Shipment Items.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Internal ID. Applicable only for UI-oriented APIs.
                    The character ^ is used as a separator for the compound key.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemNumber" type="cis:ItemNumberCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The Item Master ID. Cannot be changed for an existing Item Master. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemGroupCode" type="cis:ItemGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The Item Group ID. Cannot be changed for an existing Item Master. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemDescription" type="cis:ItemDescriptionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the Item Master. Mandatory for a new Item Master. The value cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemType" type="cis:ItemDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The item type used for this Item Master. Must be a valid domain table value if specified. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemTypeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for ItemType. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NominalWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The nominal weight. Mandatory for a new Item Master. Cannot be negative. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StatusEnumVal" type="cis:ItemMasterStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The status of the Item Master. Cannot be an empty element. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for statusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SerialLotControlEnumVal" type="cis:SerialLotControlEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The enumerated serial lot control number. Cannot be an empty element. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SerialLotControlEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for serialLotControlEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NMFCCode" type="cis:NMFCCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The NMFC code.
If NMFC is not required at the Item Group level, the value must be blank if this element is specified.
If NMFC is required at the Item Group level, this element is mandatory for a new Item Master, the value cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HarmonizedTariffCode" type="cis:HarmonizedTariffCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The harmonized tariff code.
If harmonized tariff is required at the Item Group level, this element is mandatory for a new Item Master; the value cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightClassCode" type="cis:FreightClassCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight class code. The value cannot be empty. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginCountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The origin country code. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The commodity code. The value cannot be empty. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Is3DLoadingRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether 3D loading is required.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Priority" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Priority of this item master: the lower the number, the higher the priority.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemPackageLevelIDForPalletsCode" type="cis:ItemPackageLevelIDTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The item package level type ID 1.
                    System-defined values are '100' for 'Pallets', '200' for 'Layers' and '300' for 'Pieces'.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemPackageLevelIDForPalletsCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ItemPackageLevelIDForPalletsCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemPackageLevelIDForLayersCode" type="cis:ItemPackageLevelIDTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The item package level type ID 2.
                    System-defined values are '100' for 'Pallets', '200' for 'Layers' and '300' for 'Pieces'.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemPackageLevelIDForLayersCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ItemPackageLevelIDForLayersCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemPackageLevelIDForPiecesCode" type="cis:ItemPackageLevelIDTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The item package level type ID 3.
                    System-defined values are '100' for 'Pallets', '200' for 'Layers' and '300' for 'Pieces'.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemPackageLevelIDForPiecesCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ItemPackageLevelIDForPiecesCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultItemPackageLevelIDCode" type="cis:ItemPackageLevelIDTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The default item package level type ID.
                    System-defined values are '100' for 'Pallets', '200' for 'Layers' and '300' for 'Pieces'.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultItemPackageLevelIDCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for DefaultItemPackageLevelIDCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
A memo associated with the Item Master. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the Item Master was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the Item Master was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who created the Item Master. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who updated the Item Master. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemGroup" type="cis:ItemGroupType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated item group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ItemPackageLevelType">
                <xsd:annotation>
                    <xsd:documentation>
                Item Package Level is used to to define product dimensions and will be used as appropriate to pack shipments into loading spaces of an equipment type.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemItemPackageLevelID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated item package level ID. Read-only.
                    Ignored for Create.
                    For operations other than Create, mandatory unless full business key is specified.
                    The business key consists of ItemPackageLevelIDCode, ItemNumber and ItemGroup.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemPackageLevelIDCode" type="cis:ItemPackageLevelIDTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The item package level type ID.
                    Not editable.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemItemPackageLevelID is provided.
                    System-defined values are '100' for 'Pallets', '200' for 'Layers' and '300' for 'Pieces'.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemPackageLevelIDCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ItemPackageLevelIDCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemNumber" type="cis:ItemNumberCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Item Master ID.
                    Not editable.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemItemPackageLevelID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemGroupCode" type="cis:ItemGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Item Group ID.
                    Not editable.
                    Included into the business key.
                    For operations other than Create, should not be specified if SystemItemPackageLevelID is provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DisplayName" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    A description of the item package level.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the item package level is active.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatingUnitsForContainerEnumVal" type="cis:RatingUnitsForContainerEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The rating units.
                    Mandatory for Create.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatingUnitsForContainerEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for RatingUnitsForContainerEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContentLevelTypeCode" type="cis:ItemPackageLevelIDTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The content level.
                    Mandatory for Create.
                    System-defined values are '100' for 'Pallets', '200' for 'Layers' and '300' for 'Pieces'.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContentLevelTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ContentLevelTypeCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfUnits" type="cis:QuantityExType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The number of units.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Weight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The weight.
                    Mandatory for Create.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Volume" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The volume.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Length" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The length.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Width" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The width.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Height" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The height.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LadenLength" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The laden length.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StackingRuleEnumVal" type="cis:StackingRuleEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The stacking rule.
                    Ignored if Load Configurator is not enabled in Global Defaults.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StackingRuleEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for StackingRuleEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StackHeight" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The stack height.
                    Ignored if Load Configurator is not enabled in Global Defaults.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StackFactor" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The stacking factor. Indicates the amount of weight that can be stacked on top.
                    Ignored if Load Configurator is not enabled in Global Defaults.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StackGroup" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The stacking group. Indicates the relative durability.
                    Ignored if Load Configurator is not enabled in Global Defaults.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadConfiguratorContainerTypeEnumVal" type="cis:LoadConfiguratorContainerTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Load Configurator container type.
                    Ignored if Load Configurator is not enabled in Global Defaults.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadConfiguratorContainerTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for LoadConfiguratorContainerTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierPackageType" type="cis:CarrierPackageDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The carrier packaging type.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierPackageTypeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for CarrierPackageType. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierPackageRegion" type="cis:CarrierPackageRegionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The carrier packaging region.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    An external ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created this equipment capacity degradation. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when this equipment capacity degradation was created. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who most recently updated this equipment capacity degradation. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when this equipment capacity degradation was most recently updated. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreContainerOrientationsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of ContainerOrientation should be ignored.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerOrientation" type="cis:ContainerOrientationType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    The container orientation objects.
                    Not applicable if Load Configurator is not enabled in Global Defaults.
                    Otherwise, presence depends on the value of IgnoreContainerOrientationsFlag.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemGroup" type="cis:ItemGroupType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Associated item group.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ItineraryTemplateType">
                <xsd:annotation>
                    <xsd:documentation>
				An itinerary template used to specify a standard path that multiple shipments follow from origin to destination.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTemplateCode" type="cis:JourneyTemplateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The itinerary template code. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTemplateDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The description of the itinerary template. Mandatory for a new itinerary template. Cannot be blank.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EffectiveDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The effective date. Cannot be an empty element.
                    If not specified for Create, current date is used.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExpirationDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The expiration date. Cannot be an empty element.
                    Should not be specified if ExpirationDateActiveFlag is not true.
                    Mandatory if ExpirationDateActiveFlag is true and the value did not previously exist.
                    For Create, set to current date plus one year if not specified and not explicitly suppressed by setting ExpirationDateActiveFlag to false.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExpirationDateActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether any value exists for ExpirationDate.
                    Must be true if a value is specified for ExpirationDate.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The customer ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The logistics group ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the itinerary template. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the itinerary template. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the itinerary template was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the itinerary template was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreItineraryTemplateThroughPointsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of ItineraryTemplateThroughPoint should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTemplateThroughPoint" type="cis:ItineraryTemplateThroughPointType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The location points of the itinerary template.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ItineraryTemplateThroughPointType">
                <xsd:annotation>
                    <xsd:documentation>
				The location point of an itinerary template.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingThroughPointEnumVal" type="cis:ShipThruPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The intermediate point type (Hub or DC). Cannot be blank.
					If not supplied,
					one and only one intermediate location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingThroughPointEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for ShippingThroughPointEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingThroughPointLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID code of the point. Mandatory. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ThroughPointSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The position of the through point within the sequence of through points of the itinerary template. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTemplate" type="cis:ItineraryTemplateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Associated itinerary template.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="LaneAvailabilityType">
                <xsd:annotation>
                    <xsd:documentation>
				The restrictions on the number of loads allowed on certain lanes for specific pieces of a carrier's equipment.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLaneAvailabilityID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The Lane Availability ID. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier ID code. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneConstraintActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the lane is active. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTariffNumber" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The tariff ID. Optional. Not modifiable during update.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The service code. Optional. Not modifiable during update.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The origin identifier if the origin is a zone. You must use just one of originZoneCode or laneOriginHubCode, or orginShippingLocation.   Optional. Not modifiable during update.
				This field is used for create only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneOriginHubCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The origin identifier if the origin is hub. You must use just one of originZoneCode, laneOriginHubCode, or orginShippingLocation.   Optional. Not modifiable during update.
				This one is kept for backward compatibility. Hub origin can now be specified using originShippingLocationCode and originShippingLocationType.
				This field is used for create only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The origin identifier if the origin is shipping location. You must use just one of originZoneCode, laneOriginHubCode, or orginShippingLocation. Optional. 
				This field is used for create only, ignored otherwise.
				Not persisted in Lane Availability table.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location type (load-at, hub or distribution center but not consignee).
					Part of the origin identifier if the origin is shipping location. Ignore, if originShippingLocationCode is empty. Optional.
					This field is used for create only, ignored otherwise.
					Not persisted in Lane Availability table.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginShippingLocationControlEnumVal" type="cis:ShippingLocationControlEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Control how the originShippingLocationCode will be used when originShippingLocationCode is specified. Optional.
					This field is used for create only, ignored otherwise. 
					Not persisted in Lane Availability table.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The destination identifier if the origin is a zone. You must use either destinationZoneCode or laneDestinationHubCode, but not both.   Optional. Not modifiable during update.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneDestinationHubCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The destination identifier if the origin is a hub. You must use either destinationZoneCode or laneDestinationHubCode, but not both.   Optional. Not modifiable during update.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The destination identifier if the destination is shipping location. You must use just one of destinationZoneCode, laneDestinationHubCode, or destinationShippingLocation. Optional.
				This field is used for create only, ignored otherwise. 
				Not persisted in Lane Availability table.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location type (consignee, hub or distribution center but not load-at).
					Part of the destination identifier if the destination is shipping location. Ignored, if destinationShippingLocationCode is empty. Optional.
					This field is used for create only, ignored otherwise. 
					Not persisted in Lane Availability table.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationShippingLocationControlEnumVal" type="cis:ShippingLocationControlEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Control how the destinationShippingLocationCode will be used when destinationShippingLocationCode is specified. Optional.
					This field is used for create only, ignored otherwise. 
					Not persisted in Lane Availability table.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLoadsPerLane" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The minimum number of loads per lane. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumLoadsPerLane" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum number of loads per lane. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnforceConstraintsAsPercentageFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether minimumLoadsPerLane and maximumLoadsPerLane values are regarded as percentages rather than as absolute numbers.
				Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneStartDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The start date and time. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneEndDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The end date and time. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CEAGroupingTypeCode" type="cis:CEAGroupingDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The CEA Grouping Type. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CEAGroupingTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for CEAGroupingTypeCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyFEUFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether forty-feet equivalent unit factor should be applied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BackupResourceFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the entry is marked for a backup resource.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BucketTypeEnumVal" type="cis:BucketTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The bucket type.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BucketTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for BucketTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The equipment type ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The commodity ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResourceProjectTypeCode" type="cis:ResourceProjectIDDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Resource Project ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResourceProjectTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ResourceProjectTypeCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created this lane availability. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that this lane availability was created. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who most recently updated this lane availability. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that this lane availability was most recently updated. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Carrier" type="cis:CarrierType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="LoadAtType">
                <xsd:annotation>
                    <xsd:documentation>
				A location where freight is picked up that is neither a hub nor a distribution center. If a transport order references a load-at, then it is the origin point for the freight movement.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadAtCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID code of the load-at.  Mandatory. Not modifiable during update.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadAtDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the load-at. Mandatory during create. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCode" type="cis:LanguageDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The language used at the load-at. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for languageCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AppointmentRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether a carrier has to make an appointment to pick up shipments at the load-at. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumShipmentWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum weight of a shipment that can be loaded at the load-at. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumShipmentVolume" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum volume of a shipment that can be loaded at the load-at. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumEquipmentLength" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum length of equipment that can be loaded at the load-at. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumEquipmentWidth" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum width of equipment allowed at the load-at.  Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumEquipmentHeight" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum height of the equipment allowed at the load-at.  Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StoreNumber" type="cis:StoreNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A store number.  Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLCategoryCode" type="cis:GLCategoryDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The G/L category.  Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLCategoryCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for GLCategoryCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FixedLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The fixed load or unload hours. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum load or unload hours. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLeadTimeHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The minimum lead hours. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The minimum load or unload hours. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveLoadCodeEnumVal" type="cis:LiveLoadEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether outbound live or non-live loading is allowed;
					if non-live, then it indicates whether there can be outbound non-live loading
					during business hours or any time.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveLoadCodeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LiveLoadCodeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstStopFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether any shipment leg starting from this location must be the first stop for the load. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastStopFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether any shipment leg terminating at this location must be the last stop for the load. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OrderGroupingEnabledFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicate whether order grouping is enabled for this shipping location
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BoundaryRuleEnumVal" type="cis:BoundaryRuleEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The boundary rules. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BoundaryRuleEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for boundaryRuleEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CorporateID1" type="cis:CorporateIdType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A corporate identifier code. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CorporateID2" type="cis:CorporateIdType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A second corporate identifier code. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The logistics group of the load-at. If you do not supply an input value for this field when creating this structure, then the value will be taken from the user's profile. To force this value to be blank, enter a single space in quotes. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The division ID of the load-at. If you do not supply an input value for this field when creating this structure, then the value will be taken from the user's profile. To force this value to be blank, enter a single space in quotes. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PreferredCarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The default carrier ID. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PreferredServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The default service ID. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLRegionZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The predefined G/L region zone for the load-at. If you do not supply a value, then the zone is derived from the load-at address. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The predefined INCO terms shipping location code for the load-at. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The default INCO terms shipping location type. Optional. Updatable.
					For the Add operation or for the Change operation with INCO shipping location change,
					if INCOShippingLocationCode is specified but
					INCOShippingLocationTypeEnumVal is not specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for INCOShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode1" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				An external identifying code. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode2" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A second external identifying code. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RespondToTenderHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The maximum number of hours for the load-at to respond to the tender offers.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The primary shipping location code for this location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The primary shipping location type for this location. Optional. Updatable.
					For the Add operation or for the Change operation with primary shipping location change,
					if primaryShippingLocationCode is specified but
					primaryShippingLocationTypeEnumVal is not specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for primaryShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadUnloadTimeCalculationEnumVal" type="cis:FixedTimeModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Loading/unloading time calculation mode.
					The setting will determine how loading/unloading times from
					equipment type and location are handled in calculations.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadUnloadTimeCalculationEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LoadUnloadTimeCalculationEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadAtStatusEnumVal" type="cis:LoadAtStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The status of the load-at. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadAtStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for loadAtStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ManageTrailerAlertsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether this location supports trailer alerts management.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoCreateNonLiveCommitmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether this location supports auto creation of non-live dock commitment.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WarehouseManagementSystemInstanceCode" type="cis:WarehouseManagementSystemInstanceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The WMS Instance ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginMaximumNumberShipmentSplit" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Maximum number of shipment splits for origin location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginSplitRulePrecisionEnumVal" type="cis:SplitRuleEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Split rule precision for desintaion location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginSplitRulePrecisionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Description for originSplitRulePrecisionEnumVal. Read-only. Available only through UI-oriented APIs.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginMinimumShipmentOverrideWindow" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Minimum shipment override window for origin location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PreloadingActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether any value exists for EarliestPreLoadingEndHours and LatestPreLoadingEndHours.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestPreloadingEndHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The largest allowed interval between the time when pre-loading is complete and the time of carrier pick-up.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestPreloadingEndHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The smallest allowed interval between the time when pre-loading is complete and the time of carrier pick-up.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the load-at was created. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the load-at was updated. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created the load-at. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who updated the load-at. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DTTEOverrideEnumVal" type="cis:DTTEOverrideEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether to convert or delete the distance override when updating the load-at's address. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Address" type="cis:AddressType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The address of the load-at. Mandatory during create. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Contact" type="cis:ContactType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The contact information for the load-at. Mandatory during create. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessHours" type="cis:BusinessHoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The business hours for the load-at. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A memo associated with the load-at. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Directions" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Directions to the location of the load-at. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreContactsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of ContactPerson should be ignored.
					If false during change, all existing ContactPerson members of this entity will be deleted and replaced with the contents of ContactPerson.
					Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContactPerson" type="cis:ContactPersonType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				Contacts associated with the load-at. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAutoAppliedOptionsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of autoAppliedOption should be ignored.
					If false during change, all existing AutoAppliedOption members of this entity will be deleted and replaced with the contents of AutoAppliedOption.
					Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoAppliedOption" type="cis:AutoAppliedOptionType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The auto-applied options for the load-at. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreCustomerShippingLocationCrossReferenceFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of customerShippingLocationCrossReference should be ignored.
					If false during change, all existing CustomerShippingLocationCrossReference members of this entity will be deleted and replaced with the contents of CustomerShippingLocationCrossReference.
					Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerShippingLocationCrossReference" type="cis:CustomerShippingLocationCrossReferenceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The cross-reference relationship for a customer and shipping location.  Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreVariableLoadUnloadTimeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of VariableLoadingUnloadingTime should be ignored.
					If false during change, all existing VariableLoadUnloadTime members of this entity will be deleted and replaced with the contents of VriableLoadUnloadTime.
					Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VariableLoadingUnloadingTime" type="cis:VariableLoadingUnloadingTimeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
Variable loading or unloading time factor. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreDockFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of dock should be ignored.
					If false during change, all existing Dock members of this entity will be deleted and replaced with the contents of Dock.
					Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Dock" type="cis:DockType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
Docks of this LoadAt. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreEquipmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the collection of equipment elements should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Equipment" type="cis:ShippingLocationEquipmentType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
Supported equipment types for this load-at.  Contents will only be considered if the ignoreEquipmentFlag is false.  May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreShipmentSplitRuleFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the collection of shipment split rules should be ignored.  May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentSplitRule" type="cis:ShipmentSplitRuleType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Shipment split rules for this load-at.  Contents will only be considered if the ignoreShipmentSplitRuleFlag is false.  May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberTrailersAllowed" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Maximum number of trailers permitted at the location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberTrailersCanBeHandled" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Maximum number of trailers that can be handled at a time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumTotalTrailerLength" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Maximum total trailer(s) length permitted at the location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="LoadingTypeType">
                <xsd:annotation>
                    <xsd:documentation>
			    The loading type.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadingTypeCode" type="cis:LoadingTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Loading type ID. Mandatory. Cannot be changed for an existing loading type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadingTypeDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    A description of the loading type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemProvidedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the loading type is system-provided. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the loading type is active.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="LocationThroughputGroupType">
                <xsd:annotation>
                    <xsd:documentation>
				Location throughput groups are used to manage various constraints at a shipping location.  
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLocationThroughputGroupID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					An automatically generated location throughput group system identifier. Ignored for create.
					Either this field or LocationThroughputGroupCode, ShippingLocationTypeEnumVal and ShippingLocationCode must be provided
					to identify an existing entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LocationThroughputGroupCode" type="cis:LocationThroughputGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the location throughput group for a particular shipping location. 
					Mandatory for Create and when SystemLocationThroughputGroupID is not provided.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LocationThroughputGroupDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The description of the location throughput group. Mandatory for Create.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LocationThroughputGroupUnitTypeEnumVal" type="cis:LocationThroughputGroupUnitTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The location throughput group unit type. Mandatory for Create.
					The unit type used to track demand vs. capacity for the location throughput group: loads, weight, volume, pieces, pallets.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LocationThroughputGroupUnitTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LocationThroughputGroupUnitTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID code of the shipping location. Mandatory for create and if SystemLocationThroughputGroupID is not provided.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location type for the location throughput group.
					If SystemLocationThroughputGroupID is not provided and
					ShippingLocationTypeEnumVal is not provided,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the location throughput group is currently active or not.
					Set to True on Create if not specified.
					Inactive location throughput groups will not constrain optimization.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnitDivideFactorVal" type="cis:UnitDivideFactorType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A unit divide factor to get from actual shipment/load values to capacity.
					For example, if capacity is defined in terms of weight and unit divide is 100, a capacity of 10,000,000 pounds a day (around 250 trailers) would be 100,000.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActivityTypeEnumVal" type="cis:DockTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                			The activity type of the location throughput group; inbound only, outbound only, both inbound and outbound.
                			Mandatory for Create.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActivityTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ActivityTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LocationThroughputGroupLevelEnumVal" type="cis:LocationThroughputGroupLevelEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                			The location throughput group level, indicates whether tracking of demand vs. capacity will be managed at shipping location or dock level for the location throughput group. 
                			Mandatory for Create.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LocationThroughputGroupLevelEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LocationThroughputGroupLevelEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LocationThroughputGroupCapacityIntervalEnumVal" type="cis:LocationThroughputGroupCapacityIntervalEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                			The location throughput group capacity interval, indicates whether capacity for the location throughput group will be available per hour or per day; 
                			for example, if the capacity interval is 6 loads and interval is hourly, the defined capacity will be available for each hour between the start time and end time for each date within the date range or on each occurrence of the day of the week within the date range.
                			Mandatory for Create.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LocationThroughputGroupCapacityIntervalEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for locationThroughputGroupCapacityIntervalEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LocationThroughputGroupUnitOfMeasureType" type="cis:LocationThroughputGroupUnitOfMeasureTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                			The location throughput group unit of measure type. 
                			In cases where the unit divide factor is used to adjust the unit type that is used to compare demand with capacity, 
                			this value can be used to illustrate the conversion that will be used e.g. if capacity is expressed in hundredweight, 
                			the UOM might be "CWT".
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LocationThroughputGroupUnitOfMeasureTypeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LocationThroughputGroupUnitOfMeasureType. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LocationThroughputGroupType" type="cis:LocationThroughputGroupTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                			The location throughput group type. 
                			An optional user-assignable category for the location throughput group, 
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LocationThroughputGroupTypeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LocationThroughputGroupType. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DateBasedCapacityRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether capacity that is defined for a day of the week will be formally recognized as capacity during optimization; 
					if true, optimizer will only recognize date specific capacity.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnforceFullPageDateTimeConstraintsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether capacity for this location throughput group can be maintained using the screens that will allow users to concurrently manage capacity for multiple groups for a location; 
					if so, additional validation will be performed to restrict values assigned to capacity date and time ranges; 
					if not eligible, location throughput group will not be eligible to be accessed using these screens.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultPenaltyAmount" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Default Penalty Amount when Target Violated.
					Default penalty amount will be used when defining capacity for the location throughput group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InternalActivityInclusionEnumVal" type="cis:LocationThroughputGroupInternalActivityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the types of internal activities to be counted for this location throughput group.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InternalActivityInclusionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for InternalActivityInclusionEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			                The date and time that the location throughput group was created. Read only field.
		                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                			The date and time that the location throughput group was updated. Read only field.
                		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                			The ID of the user who created the location throughput group. Read only field.
                		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                			The ID of the user who updated the location throughput group. Read only field.
                		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreLocationThroughputGroupDockFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                			Indicates whether the contents of LocationThroughputGroupDock should be ignored. May be present for add and change operations.
                		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LocationThroughputGroupDock" type="cis:LocationThroughputGroupDockType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                			The dock associated with this location throughput group.
                		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocation" type="cis:ShippingLocationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Associated shipping location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="LocationThroughputGroupDockType">
                <xsd:annotation>
                    <xsd:documentation>
				Location throughput groups and dock association. Update not applicable.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLocationThroughputGroupDockID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					An automatically generated location throughput group dock system identifier. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLocationThroughputGroupID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The location throughput group system identifier.  Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDockID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The dock system identifier. If not specified,
					DockCode, ShippingLocationCode and possibly ShippingLocationTypeEnumVal are required to identify the dock.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockCode" type="cis:DockCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the dock.
					If SystemDockID is not specified,
					used together with the shipping location of the location throughput group
					to identify the dock.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID code of the shipping location for the location throughput group. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location type for the location throughput group. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			                The date and time that the location throughput group was created. Read only field.
		                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                			The ID of the user who created the location throughput group. Read only field.
                		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocation" type="cis:ShippingLocationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Associated shipping location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="LocationThroughputGroupCapacityType">
                <xsd:annotation>
                    <xsd:documentation>
				Capacity information entry of the location throughput group.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLocationThroughputGroupCapacityID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					An automatically generated location throughput group capacity system identifier. Ignored for create; mandatory otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLocationThroughputGroupID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The location throughput group system identifier.
                    Mandatory for Create unless LocationThroughputGroupCode, ShippingLocationCode and possibly ShippingLocationTypeEnumVal
                    are used to identify the location throughput group.
                    Otherwise, ignored for input.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LocationThroughputGroupCode" type="cis:LocationThroughputGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the location throughput group for a particular shipping location.
                    Mandatory for Create if SystemLocationThroughputGroupID is not supplied, otherwise ignored for input.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the shipping location of the location throughput group.
                    Mandatory for Create if SystemLocationThroughputGroupID is not supplied, otherwise ignored for input.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shipping location type for the location throughput group.
                    The input value can be used only for Create.
                    If SystemLocationThroughputGroupID is not provided,
                    ShippingLocationTypeEnumVal is not provided and
                    ShippingLocationCode is provided,
                    one and only one shipping location with the specified ShippingLocationCode should exist.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StartDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The start date for this location throughput group capacity entity; mandatory for create; 
					dates and day of week could both be specified; 
					if the Enforce Full Page Date/Time Constraints flag for the location throughput group is True and Day of Week is not specified, 
					the start date and end date must be equal.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EndDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The end date for the location throughput group capacity entity; mandatory for create;
					dates and day of week could both be specified;
					if the Enforce Full Page Date/Time Constraints flag for the location throughput group is True and Day of Week is not specified,
					the start date and end date must be equal .
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OpenTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The open time for the location throughput group capacity entity; mandatory for create; 
					applicable for each business day in the range of start and end dates and/or for each 
					occurrence of the designated day of the week within the range of start and end dates.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CloseTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The close time for the location throughput group capacity entity; mandatory for create;
					applicable for each business day in the range of start and end dates and/or for each 
					occurrence of the designated day of the week within the range of start and end dates.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DayOfWeekEnumVal" type="cis:DayOfWeekEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates for which day of week the definition is applicable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DayOfWeekEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for DayOfWeekEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TimeBucketHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A numerical representation of the location throughput group capacity interval, expressed in hours; 
					will be 1 when hourly and 24 for daily. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumQuantity" type="cis:QuantityType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Maximum quantity allowed per hour or per day for each date between the start and end time in the defined 
					date range and/or on each occurrence of the applicable day of the week within the range of start and end dates; 
					quantity is expressed in relation to the unit type defined for the corresponding location throughput group entity 
					which could be loads, weight, volume, pieces or pallets; demand will be adjusted by the unit divide factor 
					(also from the location throughput group entity) before it is compared to this value.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TargetQuantity" type="cis:QuantityType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Target quantity allowed per hour or per day for each date between the start and end time in the defined 
					date range and/or on each occurrence of the applicable day of the week within the range of start and end dates; 
					quantity is expressed in relation to the unit type defined for the corresponding location throughput group entity 
					which could be loads, weight, volume, pieces or pallets; demand will be adjusted by the unit divide factor 
					(also from the location throughput group entity) before it is compared to this value; 
					when target quantity is exceeded, the target penalty amount will be incurred for each capacity unit in excess of the target.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PenaltyAmount" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The target quantity violation penalty amount; expressed in base system currency; 
					will be applied for each adjusted unit in excess of the target quantity.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			                The date and time that the location throughput group capacity was created. Read only field.
		                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                			The ID of the user who created the location throughput group capacity. Read only field.
                		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                			The date and time that the location throughput group capacity was updated. Read only field.
                		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                			The ID of the user who updated the location throughput group capacity. Read only field.
                		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocation" type="cis:ShippingLocationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Shipping location associated with the location throughput group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="MasterServiceType">
                <xsd:annotation>
                    <xsd:documentation>
			Master Service represents the mode or method of transportation used by carriers.
			It is used to set up Tariff Services.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The service code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the service.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode1" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The external code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode2" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The external code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLTypeCode" type="cis:GLDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The general ledger type code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for GLTypeCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransitModeEnumVal" type="cis:TransitModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The transit mode.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransitModeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for transitModeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the master service was created. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the master service was updated. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created the master service. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who updated the master service. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="MatchFreightBillCurrencyType">
                <xsd:annotation>
                    <xsd:documentation>
				This table defines the currencies that can be used by a carrier when this carrier sends freight bills that require match.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemMatchFreightBillCurrencyID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					An automatically generated system identifier. Read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The carrier ID. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The currency allowed for matching freight bills sent by this carrier. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for CurrencyCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="NMFCType">
                <xsd:annotation>
                    <xsd:documentation>
				The information about a National Motor-carriers Freight Classification (NMFC).
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NMFCCode" type="cis:NMFCCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The NMFC ID code. Mandatory for a new NMFC. Cannot be changed for an existing NMFC.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NMFCName" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The NMFC name/description.
				Mandatory for a new NMFC. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightClassCode" type="cis:FreightClassCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight class code. Mandatory for a new NMFC. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferencedByItemMasterFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the NMFC is referenced by an Item Master. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A memo associated with the NMFC.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created this NMFC. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time when the NMFC was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who most recently updated this NMFC. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time when the NMFC was last updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="PostalDataEntryType">
                <xsd:annotation>
                    <xsd:documentation>
				An entry of the postal data provided by a third-party supplier.
				Due to system resource restrictions,
				only limited number of entries can be processed within one request.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemPostalEntryID" type="cis:SystemPlanIDStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					System-generated ID for a postal data entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The country ID. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="State" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The state ID. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="City" type="cis:CityNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The city. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CityStateKey" type="cis:CityStateKeyType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The postal data key.
					If it is not supplied in the input data, it will be generated.
					For user input, string length must not exceed 9 characters.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PostalCode" type="cis:PostalCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The zip or postal code. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Street" type="cis:StreetNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The street name.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DirectionCode" type="cis:DirectionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					If present, has one string or two concatenated strings representing street directions.
					Each string can have the values E, O, N, NE, NO, NW, S, SE, SO, SW, W.
					If the first string has only one character and the second string is present,
					a space is added such that the second string always starts at
					the third (1-based) character.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OddEvenIndicator" type="cis:SingleCharacterType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					If present, indicates whether the record refers
					to odd block numbers (the value is O),
					to even block numbers (the value is E),
					or to both kinds of block numbers (the value is B).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AddressIndicator" type="cis:SingleCharacterType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					An internal indicator.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FromBlockNumber" type="cis:BlockNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The starting block number for a range.
					Must be present if the ending block number is present.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ToBlockNumber" type="cis:BlockNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ending block number for a range.
					Must be present if the starting block number is present.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FromUnitNumber" type="cis:UnitNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The starting unit number for a range.
					Must be present if the ending unit number is present.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ToUnitNumber" type="cis:UnitNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ending unit number for a range.
					Must be present if the starting unit number is present.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="queryTMEntityIDDataType">
                <xsd:annotation>
                    <xsd:documentation>
				A retrieved Transportation Manager entity ID.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="CarrierCrossReference" type="cis:CarrierCrossReferenceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A list of carrier cross-references..
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCrossReference" type="cis:ServiceCrossReferenceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A list of service cross-references.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCrossReference" type="cis:EquipmentTypeCrossReferenceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A list of equipment type cross-references.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCrossReference" type="cis:CustomerCrossReferenceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A list of customer cross-references.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberTypeCrossReference" type="cis:ReferenceNumberTypeCrossReferenceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A list of reference number type cross-references.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ReferenceNumberTypeCrossReferenceType">
                <xsd:annotation>
                    <xsd:documentation>
			A reference number type cross-reference.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ExternalCode" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The external code. Mandatory. May not be empty.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberTypeCode" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The reference number type code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ServiceCrossReferenceType">
                <xsd:annotation>
                    <xsd:documentation>
			A service cross-reference.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ExternalCode" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The external code. Mandatory. May not be empty.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The service code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ShipmentSplitRuleType">
                <xsd:annotation>
                    <xsd:documentation>
				Shipment split rule for shipping location.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID code of the shipping location. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location type for the shipment split rule. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for shippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentAttributeEnumVal" type="cis:LoadUnitEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Shipment attribute of this split rule. Manadatory.
					LUT_UNITS and LUT_QUANTITY are not valid here.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentAttributeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for shipmentAttributeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the shipment split rule is for origin or destination. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PercentageFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the shipment split rule is by percentage.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumSplitSize" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Minimum size allows for shipment split.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			                The date and time that the shipment split rule was created. Read only field.
		                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                			The date and time that the shipment split rule was updated. Read only field.
                		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                			The ID of the user who created the shipment split rule. Read only field.
                		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                			The ID of the user who updated the shipment split rule. Read only field.
                		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocation" type="cis:ShippingLocationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Associated shipping location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ShippingLocationEquipmentType">
                <xsd:annotation>
                    <xsd:documentation>
			A supported Equipment Type for a Shipping Location.
			If this collection is populated for a location, then only Equipment Types
			in the collection may be used at the location.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The equipment type code.  Cannot be changed for an existing ShippingLocationEquipment.
				Mandatory for creation, and to identify a ShippingLocationEquipment for modification or deletion.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RestrictedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the Equipment Type is restricted.  If true, then the
				equipment type may be used at a location only if it is committed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocation" type="cis:ShippingLocationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated shipping location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ShippingLocationStatusChangeInfoType">
                <xsd:annotation>
                    <xsd:documentation>
				A collection of information for the shipping location's status to change to.
				Only hubs and distribution centers are allowed for this operation.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemShippingLocationID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system generated numerical Shipping Location ID.
					Mandatory if shippingLocationCode is not provided.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A shipping location type.
					If systemShippingLocationID is not specified
					and shippingLocationTypeEnumVal is not specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A shipping location code.
					Mandatory if systemShippingLocationID is not specified.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationStatusEnumVal" type="cis:ShippingLocationStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The new status of the shipping location. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ShippingLocationType">
                <xsd:annotation>
                    <xsd:documentation>
				A shipping location.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemShippingLocationID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system generated numerical Shipping Location ID.
					Cannot be changed for an existing Shipping Location.
					Mandatory for modification/deletion of a Shipping Location if
					shippingLocationCode is not provided.
					Ignored for creation of Shipping Location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A shipping location type (load-at, consignee, hub or distribution center).
					Mandatory for a new Shipping Location.
					Cannot be changed for an existing Shipping Location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for shippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A shipping location code. Mandatory for a new Shipping Location.
					Cannot be changed for an existing Shipping Location.
					Mandatory for modification/deletion if systemShippingLocationID is not provided.
					For modification/deletion, if systemShippingLocationID is not specified
					and shippingLocationTypeEnumVal is not specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A description of the shipping location. Mandatory for create. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCode" type="cis:LanguageDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The language used at the shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for languageCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AppointmentRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether a carrier has to make an appointment to pick up or drop off shipments at the shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumShipmentWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum weight of a shipment that can pass through the shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumShipmentVolume" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum volume of a shipment that can pass through the shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumEquipmentLength" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum length of the equipment allowed at this shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumEquipmentWidth" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum width of the equipment allowed at this shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumEquipmentHeight" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum height of the equipment allowed at this shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ConsigneeGroupCode" type="cis:ConsigneeGroupDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The consignee group of the shipping location.
					Applicable only to consignees.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ConsigneeGroupCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for consigneeGroupCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StoreNumber" type="cis:StoreNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A store number.
					Applicable only to load-ats and consignees.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowDropOffEnumVal" type="cis:DropEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The degree to which drop-offs of shipments at the shipping location are allowed. Optional. Updatable.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowDropOffEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for allowDropOffEnumVal. Read-only. Available only through UI-oriented APIs.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowPickUpEnumVal" type="cis:PickEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The degree to which pick-ups of shipments at the shipping location are allowed. Optional. Updatable.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowPickUpEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for allowPickUpEnumVal. Read-only. Available only through UI-oriented APIs.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowDeconsolidationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the shipping location allows deconsolidation. Optional. Updatable.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumDropWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum drop-off weight allowed for the shipping location. Optional. Updatable.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FixedLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The fixed load or unload hours. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum load or unload hours. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLeadTimeHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum lead time hours. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumLoadingUnloadingHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum load or unload hours. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveLoadCodeEnumVal" type="cis:LiveLoadEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether outbound live or non-live loading is allowed;
					if non-live, then it indicates whether there can be outbound non-live loading
					during business hours or any time.
					Not applicable for consignees.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveLoadCodeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LiveLoadCodeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveUnloadCodeEnumVal" type="cis:LiveLoadEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether inbound live or non-live unloading is allowed;
					if non-live, then it indicates whether there can be inbound non-live unloading
					during business hours or any time.
					Not applicable for load-ats.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiveUnloadCodeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LiveUnloadCodeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstStopFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether any shipment leg starting from this location must be the first stop for the load.
					Optional. Updatable.
					Not applicable for consignees.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastStopFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether any shipment leg terminating at this location must be the last stop for the load.
					Optional. Updatable.
					Not applicable for load-ats.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SideDoorUnloadingRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether side door unloading is required at this location.
					Not applicable for load-ats.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NearTailUnloadingRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether rear door unloading is required at this location.
					Not applicable for load-ats.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OrderGroupingEnabledFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicate whether order grouping is enabled for this shipping location.
					Not applicable for consignees.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationPickupSequenceNumber" type="cis:PickSequenceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Shipping Location Shipment Pickup Sequence Number.
					Not applicable for load-Ats.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BoundaryRuleEnumVal" type="cis:BoundaryRuleEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The boundary rules. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BoundaryRuleEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for boundaryRuleEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FullServiceHubFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the shipping location provides full service. Optional. Updatable.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLCategoryCode" type="cis:GLCategoryDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The G/L category type. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLCategoryCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for GLCategoryCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CorporateID1" type="cis:CorporateIdType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A corporate identifier code. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CorporateID2" type="cis:CorporateIdType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A second corporate identifier code. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The logistics group of the shipping location.
					If you do not supply an input value for this field when creating this structure,
					then the value will be taken from the user's profile.
					To force this value to be blank, enter a single space in quotes.
					Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division ID of the shipping location.
					If you do not supply an input value for this field when creating this structure,
					then the value will be taken from the user's profile.
					To force this value to be blank, enter a single space in quotes.
					Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					For hubs, the service associated with the hub transfer.
					For load-ats and consignees, the default service.
					Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					For hubs, the carrier that owns the hub, mandatory for Create.
					For load-ats and consignees, the default carrier, optional.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLRegionZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The G/L region zone ID. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The default INCO terms shipping location code. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The default INCO terms shipping location type. Optional. Updatable.
					For the Add operation or for the Change operation with INCO shipping location change,
					if INCOShippingLocationCode is specified but
					INCOShippingLocationTypeEnumVal is not specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="INCOShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for INCOShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncotermsShippingLocationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the hub can be used as Incoterms shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode1" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					An external identifying code. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode2" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A second external identifying code. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RespondToTenderHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum number of hours for the shipping location to respond to the tender offers.
					Not applicable for consignees.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The primary shipping location code for this location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The primary shipping location type for this location. Optional. Updatable.
					For the Add operation or for the Change operation with primary shipping location change,
					if primaryShippingLocationCode is specified but
					primaryShippingLocationTypeEnumVal is not specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for primaryShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumOptimizationWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum optimization weight.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumOptimizationWeight" type="cis:WeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum optimization weight.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumOptimizationVolume" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum optimization volume.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumOptimizationVolume" type="cis:VolumeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum optimization volume.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumOptimizationPieces" type="cis:QuantityNullableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum optimization number of pieces.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumOptimizationPieces" type="cis:QuantityNullableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum optimization number of pieces.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumOptimizationPallets" type="cis:QuantityNullableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum optimization number of pallets.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumOptimizationPallets" type="cis:QuantityNullableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum optimization number of pallets.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumOptimizationInboundLoads" type="cis:QuantityNullableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum optimization number of inbound loads.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumOptimizationInboundLoads" type="cis:QuantityNullableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum optimization number of inbound loads.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumOptimizationOutboundLoads" type="cis:QuantityNullableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum optimization number of outbound loads.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumOptimizationOutboundLoads" type="cis:QuantityNullableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum optimization number of outbound loads.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PenaltyForMinimumViolation" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The penalty for violation of a minimum constraint.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PenaltyForMaximumViolation" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The penalty for violation of a maximum constraint.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumShipmentHoldHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum number of hours to hold the shipment at a hub.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumCrossDockHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The minimum number of hours to hold the shipment at a hub.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadUnloadTimeCalculationEnumVal" type="cis:FixedTimeModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Loading/unloading time calculation mode.
					The setting will determine how loading/unloading times from
					equipment type and location are handled in calculations.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadUnloadTimeCalculationEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LoadUnloadTimeCalculationEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssumeTrailerSwapFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether trailer swap is assumed.
					The setting will influence the loading/unloading time calculations and
					whether empty trailers can be picked or dropped.
					Applicable only for hubs and distribution centers.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowEmptyLoadFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether a load is allowed to drop all freight at this location before any picks when this location is not the final delivery stop.
                    Applicable only for hubs and distribution centers.
                    Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationStatusEnumVal" type="cis:ShippingLocationStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The status of the shipping location. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for shippingLocationStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ManageTrailerAlertsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether this location supports trailer alerts management.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoCreateNonLiveCommitmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether this location supports auto creation of non-live dock commitment.
					Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockCounter" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Dock counter. Read-only. Available only through UI-oriented APIs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WarehouseManagementSystemInstanceCode" type="cis:WarehouseManagementSystemInstanceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The WMS Instance ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginMaximumNumberShipmentSplit" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Maximum number of shipment splits for origin location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginSplitRulePrecisionEnumVal" type="cis:SplitRuleEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Split rule precision for desintaion location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginSplitRulePrecisionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Description for originSplitRulePrecisionEnumVal. Read-only. Available only through UI-oriented APIs.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginMinimumShipmentOverrideWindow" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Minimum shipment override window for origin location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationMaximumNumberShipmentSplit" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Maximum number of shipment splits for destination location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationSplitRulePrecisionEnumVal" type="cis:SplitRuleEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Split rule precision for desintaion location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationSplitRulePrecisionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Description for destinationSplitRulePrecisionEnumVal. Read-only. Available only through UI-oriented APIs.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationMinimumShipmentOverrideWindow" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Minimum shipment override window for destination location. Updatable.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PreloadingActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether any value exists for EarliestPreLoadingEndHours and LatestPreLoadingEndHours.
                    Not applicable for Consignees.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestPreloadingEndHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The largest allowed interval between the time when pre-loading is complete and the time of carrier pick-up.
                    Not applicable for Consignees.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestPreloadingEndHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The smallest allowed interval between the time when pre-loading is complete and the time of carrier pick-up.
                    Not applicable for Consignees.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PostDischargeActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether any value exists for EarliestPostDischargeStartHours and LatestPostDischargeStartHours.
                    Not applicable for Load-Ats.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestPostDischargeStartHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The smallest allowed interval between the time of carrier drop-off and the time when post-discharge starts.
                    Not applicable for Load-Ats.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestPostDischargeStartHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The largest allowed interval between the time of carrier drop-off and the time when post-discharge starts.
                    Not applicable for Load-Ats.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TimeZoneOffset" type="cis:TimezoneOffsetType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The number of hours offset due to time zone differences. Read-only. Available only through UI-oriented APIs
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the shipping location was created. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the shipping was updated. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the shipping location. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the shipping location. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DTTEOverrideEnumVal" type="cis:DTTEOverrideEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether to convert or delete the distance override when updating the shipping location's address.Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Address" type="cis:AddressType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The address of the shipping location. Mandatory for Create. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Contact" type="cis:ContactType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The contact information for the shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessHours" type="cis:BusinessHoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The business hours for the shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A memo associated with the shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Directions" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Directions to the shipping location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransferOnlyFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the location is a transfer only hub. Optional. Updatable.
					Applicable only for hubs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreContactsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of ContactPerson should be ignored.
					If false during change, all existing ContactPerson members of this entity will be deleted and replaced with the contents of ContactPerson.
					Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContactPerson" type="cis:ContactPersonType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Contacts associated with the shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAutoAppliedOptionsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of the autoAppliedOption should be ignored.
					If false during change, all existing AutoAppliedOption members of this entity will be deleted and replaced with the contents of AutoAppliedOption.
					Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoAppliedOption" type="cis:AutoAppliedOptionType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The auto-applied options for the shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreCustomerShippingLocationCrossReferenceFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of CustomerShippingLocationCrossReference should be ignored.
					If false during change, all existing CustomerShippingLocationCrossReference members of this entity will be deleted and replaced with the contents of CustomerShippingLocationCrossReference.
					Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerShippingLocationCrossReference" type="cis:CustomerShippingLocationCrossReferenceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The cross-reference relationship for a customer and shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreVariableLoadUnloadTimeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of VariableLoadingUnloadingTime should be ignored.
					If false during change, all existing VariableLoadingUnloadingTime members of this entity will be deleted and replaced with the contents of VariableLoadingUnloadingTime.
					Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VariableLoadingUnloadingTime" type="cis:VariableLoadingUnloadingTimeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Variable loading or unloading time factor. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreDockFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of Dock should be ignored.
					If false during change, all existing Dock members of this entity will be deleted and replaced with the contents of Dock.
					Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Dock" type="cis:DockType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Docks of this shipping location. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreEquipmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of Equipment should be ignored.
					If false during change, all existing Equipment members of this entity will be deleted and replaced with the contents of Equipment.
					Defaults to true if not specified. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Equipment" type="cis:ShippingLocationEquipmentType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Supported equipment types for this shipping location.
					Contents will only be considered if the ignoreEquipmentFlag is false.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreCreateZoneFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of CreateZone should be ignored.
					Defaults to true if not specified. 
					May be present for add and change operations only. Ignore, otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreateZone" type="cis:ShippingLocationZoneType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Zone to be created for this shipping location.
					Contents will only be considered if the ignoreCreateZoneFlag is false.
					May be present for add and change operations only. Ignore, otherwise.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreAssociatedZoneFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of AssociatedZone should be ignored.
					Read only and applicable for retrieval only.
					Must be true or omiited for create or update.
                    Not applicable for Ui-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssociatedZone" type="cis:ShippingLocationZoneType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Zone associated with this shipping location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreShipmentSplitRuleFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the collection of shipment split rules should be ignored.  May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentSplitRule" type="cis:ShipmentSplitRuleType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					Shipment split rules for this shipping location.  Contents will only be considered if the ignoreShipmentSplitRuleFlag is false.  May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberTrailersAllowed" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Maximum number of trailers permitted at the location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberTrailersCanBeHandled" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Maximum number of trailers that can be handled at a time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumTotalTrailerLength" type="cis:DimensionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Maximum total trailer(s) length permitted at the location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="SkeletonLocationType">
                <xsd:annotation>
                    <xsd:documentation>
			    A pre-defined stop for a skeleton route.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemSkeletonLocationID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated numeric ID of the skeleton location.
                    If the value is not supplied, new skeleton location is created.
                    For Create Skeleton Route Version, IDs of existing skeleton locations
                    for the source version are used to identify new skeleton locations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemSkeletonRouteID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated numeric ID of the skeleton route. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SkeletonLocationSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The position of the skeleton location within the sequence of skeleton locations of the skeleton route.
                    Mandatory for a new skeleton location.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shipping location type.
                    If not specified and ShippingLocationCode is specified,
                    one and only one shipping location with the specified ID should exist.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shipping location ID. Mandatory for a new skeleton location.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationName" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    A description of the shipping location. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationAddress" type="cis:AddressType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The address of the shipping location. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The commodity ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopTypeEnumVal" type="cis:StopEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The stop type.
                    Mandatory for a new skeleton location.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for StopTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopDurationHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The estimated variable stop duration.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestServiceTimeActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether EarliestServiceTime and EarliestElapsedDays are active.
                    Should be set to true when EarliestServiceTime and EarliestElapsedDays are supplied for a new Skeleton Location
                    or changed for an existing Skeleton Location or a source version of a Skeleton Location.
                    Should be set to false to clear EarliestServiceTime and EarliestElapsedDays.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestServiceTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the earliest time of day to service this location.
                    Mandatory if EarliestElapsedDays is supplied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestElapsedDays" type="cis:SkeletonLocationDaysType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the number of days added to scheduled date/time of a skeleton load to mark when service at a skeleton stop may begin.
                    Mandatory if EarliestServiceTime is supplied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestServiceTimeActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether LatestServiceTime and LatestElapsedDays are active.
                    Should be set to true when LatestServiceTime and LatestElapsedDays are supplied for a new Skeleton Location
                    or changed for an existing Skeleton Location or a source version of a Skeleton Location.
                    Should be set to false to clear LatestServiceTime and LatestElapsedDays.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestServiceTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the latest time of day to service this location.
                    Mandatory if LatestElapsedDays is supplied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestElapsedDays" type="cis:SkeletonLocationDaysType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the number of days added to scheduled date/time of a skeleton load to mark when service at a skeleton stop must end.
                    Mandatory if LatestServiceTime is supplied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MustStartByTimeActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether MustStartByTime and MustElapsedDays are active.
                    Should be set to true when MustStartByTime and MustElapsedDays are supplied for a new Skeleton Location
                    or changed for an existing Skeleton Location or a source version of a Skeleton Location.
                    Should be set to false to clear MustStartByTime and LatestElapsedDays.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MustStartByTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the time of day cutoff for when service at this location must start.
                    Mandatory if MustElapsedDays is supplied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MustElapsedDays" type="cis:SkeletonLocationDaysType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the number of days added to scheduled date/time of a skeleton load to mark the cutoff for when service at a skeleton stop must start.
                    Mandatory if MustStartByTime is supplied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopsBeforeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates if a stop can be inserted before this location is serviced.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopsBeforeCount" type="cis:SkeletonRouteCountType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Maximum number of stops allowed to be inserted before this location.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopsAfterFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates if a stop can be inserted after this location is serviced.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopsAfterCount" type="cis:SkeletonRouteCountType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Maximum number of stops allowed to be inserted after this location.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Maximum distance for stop insertion. Expressed in base system units of measure.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the entry was created. This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the entry was updated. This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created the entry. This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who updated the entry. This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SkeletonRoute" type="cis:SkeletonRouteType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Associated skeleton route.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="SkeletonRouteType">
                <xsd:annotation>
                    <xsd:documentation>
                Pre-defined sequence of truckload stops.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Internal ID. Applicable only for UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemSkeletonRouteID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated numeric ID of the skeleton route.
                    Ignored for Create, otherwise mandatory unless SkeletonRouteCode
                    is used to access the latest version.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SkeletonRouteCode" type="cis:SkeletonRouteCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The skeleton route ID.
                    Mandatory for Create: if there is no skeleton route with this SkeletonRouteCode,
                    new skeleton route is created (Create New), otherwise, new version of an existing skeleton route
                    is created (Create Version).
                    For other operations, ignored if SystemSkeletonRouteID is supplied,
                    otherwise, used to access the latest version of the skeleton route.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SkeletonRouteDescription" type="cis:NameType" minOccurs="0">
