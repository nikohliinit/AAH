                    The country ID of the user. Mandatory for Create. Updatable.
                    If UseCountryLanguageForDefaultsFlag is true or omitted,
                    the input value will be assigned to the user as default value for other entities.
                    If UseCountryLanguageForLocaleFlag is true or omitted and LanguageCode is supplied as well,
                    the input value will be used to configure user locale.
                    The output value is the value assigned to the user as default value for other entities.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UseCountryLanguageForDefaultsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Input only.
                    Indicates whether values supplied for LanguageCode and CountryCode are to be assigned to the user as values used for subsequent defaulting.
                    True by default.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UseCountryLanguageForLocaleFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Input only.
                    Indicates whether values supplied for LanguageCode and CountryCode are to be used to configure user locale.
                    True by default.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The default shipping location code of the user. Optional. Updatable.
					The field is currently not in use.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The default shipping location type of the user. Optional. Updatable.
					The field is currently not in use.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for shippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RestrictedAccessFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Control whether the user is restricted from accessing certain view. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OneScreenFreightBillEntryFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Control whether the user is using single or multiple screens for freight bill entry (applies to desktop only). Read-only.
					This field is obsolete.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerServiceRepresentativeCode" type="cis:CustomerServiceRepDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The default customer service representative type. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerServiceRepresentativeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for customerServiceRepresentativeCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The default currency type. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for currencyCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Contact" type="cis:ContactType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The contact info of the user. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemUnitOfMeasureEnumVal" type="cis:SystemUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The unit of measure system used by the user. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for systemUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightUnitOfMeasureEnumVal" type="cis:WeightUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The weight units used by the user. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for weightUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LengthUnitOfMeasureEnumVal" type="cis:LengthUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The length units used by the user. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LengthUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for lengthUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceUnitOfMeasureEnumVal" type="cis:DistanceUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The unit of measure for the distances. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for distanceUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VolumeUnitOfMeasureEnumVal" type="cis:VolumeUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The unit of measure for the volume. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VolumeUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for VolumeUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightDistanceUnitOfMeasureEnumVal" type="cis:WeightDistanceUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The unit of measure for the weight distance. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightDistanceUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for weightDistanceUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemPlanID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Plan ID. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SendEmailForApprovalChainAlertsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                	Indicates whether email should be sent for approval chain alerts.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowListChartCustomizationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                	Indicates whether the user is allowed to customize lists and charts.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowSearchFromListsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                	Indicates whether the user can search from lists.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowExportDataFromListsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                	Indicates whether the user can export data from lists.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DisplayDateOrDateTimeFormatFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether date or date/time formats should be displayed for the user.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DisplayListNameFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether list name should be displayed on customization screens for the user.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DisplayTitleWithMessageFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether solution and page title should appear on UI screens even when an error message is being presented.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MonetaryInformationControlEnumVal" type="cis:AuthorityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Level of access to displayed monetary values. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MonetaryInformationControlEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for MonetaryInformationControlEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserStatusEnumVal" type="cis:UserStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The user status. The field is read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for UserStatusEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PasswordChangeDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when password was last changed for the user. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastLoginDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time of the last login for the user. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PasswordChangeExemptFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the user is exempt from password change requirement. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLVoucherReversalEnumVal" type="cis:GLVoucherReversalEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The authorization level for reversing A/P voucher with accured charges, i.e. G/L transaction already created.
                    GLVR_ACCRUED means user is allowed to reverse A/P voucher with accured charges; otherwise not allowed.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLVoucherReversalEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for GLVoucherReversalEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadGroupConsolidationClassCode" type="cis:ConsolidationClassType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The load group consolidation class. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLocaleSupportEntry" type="cis:SystemLocaleSupportType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    System locale information for the user. Available only via UI-oriented API.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserAlternatePropertiesAccessEnumVal" type="cis:UserAlternatePropertiesAccessEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Level of update permissions the user has to its own alternate user properties. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserAlternatePropertiesAccessEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for UserAlternatePropertiesAccessEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AccountLockDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the user profile status was set to locked; null if user profile status is not locked.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InvalidPasswordCount" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Stores the number of consecutive invalid password entries during login or change password operations; used by the system to determine if the user account should be locked; reset to zero upon successful login of change password operations, or when the user account lockout period expires (configured in global settings)
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ElevationUnitOfMeasureEnumVal" type="cis:ElevationUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The elevation unit of measure for this user; elevations will be presented to the user in this unit of measure (excluding pages where transactions are created).
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ElevationUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for elevationUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TemperatureUnitOfMeasureEnumVal" type="cis:TemperatureUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The temperature unit of measure for this user; temperatures will be presented to the user in this unit of measure (excluding pages where transactions are created)
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TemperatureUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for temperatureUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumVoucherApprovalAmount" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum amout that can be approved for a voucher by the user.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="UserGroupType">
                <xsd:annotation>
                    <xsd:documentation>
            Grouping of the users.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Internal ID. Applicable only for UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserGroupCode" type="cis:UserGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID code of the user group. Mandatory field. Not updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserGroupDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The description of the user group. Mandatory for create. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserGroupTypeEnumVal" type="cis:UserGroupTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The type of the user group, e.g. Employee, Carrier, Customer and Trading Partner. Mandatory for create. Cannot change once created.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserGroupTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Description for userGroupTypeEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID code of the carrier which the user group is associated with, when the user group type is carrier. Mandatory for create if user group type is carrier. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID code of the customer which the user group is associated with, when the user group type is customer. Mandatory for create if user group type is customer. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowShipmentEntryFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Control whether the user group is allowed to perform shipment entry (obsolete field).
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MarketingProfileFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Controls whether users of this user group are allowed to view untendered loads. Optional. Updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowListCustomizationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the user group can edit the Web List Customization
                    This field is obsolete.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnableForDivisionRestrictedUsersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the user group is enabled for division-restricted users. Optional.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RestrictedLocationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Indicate whether the user group has restricted shipping locations. Optional. Read Only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The division ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaintainDockCommitmentWithViolationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether dock commitments with violations are allowed to be maintained.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockCommitmentDateTimeAccessEnumVal" type="cis:DockCommitmentDateTimeAccessEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The dock commitment date/time access.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockCommitmentDateTimeAccessEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for DockCommitmentDateTimeAccessEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaintainUnassociatedDockCommitmentsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether dock commitments not associated with a load stop are allowed to be maintained.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnforceDockCommitmentLeadTimeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether minimum lead time should be enforced for editing dock commitments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnforceDockCommitmentCutOffTimeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether cut off time for next business day should be enforced for dock commitments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnforceDockCommitmentMaximumStartDateChangeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether maximum number of days for start date change should be enforced for dock commitments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnforceLiveNonLiveViolationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether Live Non-Live violation should be enforced for dock commitments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnforceDockSelectionConstraintViolationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether Dock Selection Constraint violation should be enforced for dock commitments.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChangeShipmentHorizonFromRateShopEnumVal" type="cis:ShipmentHorizonOverrideAuthorizationEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    User group authorization level for shipment pickup and delivery horizon changes from Rate Shop.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChangeShipmentHorizonFromRateShopEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ChangeShipmentHorizonFromRateShopEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaintainItineraryTimetableEntryToleranceEarly" type="cis:DurationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tolerance level in days for earlier dates, applied when Itinerary Timetable Entries are selected to be maintained for Booking Revisions.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaintainItineraryTimetableEntryToleranceLate" type="cis:DurationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tolerance level in days for later dates, applied when Itinerary Timetable Entries are selected to be maintained for Booking Revisions.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EligibleMaintainDriverAssignmentViolationsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether user group is eligible to maintain asset assignment with violations. 
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberOfEligibleLoadsActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether any value exists for MaximumNumberOfEligibleLoads.
                    Should be true if a value is supplied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberOfEligibleLoads" type="cis:OptimizationMaximumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum number of eligible loads for optimization.
                    Set to null if MaximumNumberOfEligibleLoadsActiveFlag is false.
                    Mandatory if MaximumNumberOfEligibleLoadsActiveFlag is true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberOfEligibleTripsActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether any value exists for MaximumNumberOfEligibleTrips.
                    Should be true if a value is supplied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberOfEligibleTrips" type="cis:OptimizationMaximumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum number of eligible trips for optimization.
                    Set to null if MaximumNumberOfEligibleTripsActiveFlag is false.
                    Mandatory if MaximumNumberOfEligibleTripsActiveFlag is true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberOfEligibleBookingsActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether any value exists for MaximumNumberOfEligibleBookings.
                    Should be true if a value is supplied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumNumberOfEligibleBookings" type="cis:OptimizationMaximumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum number of eligible bookings for optimization.
                    Set to null if maximumNumberOfEligibleBookingsActiveFlag is false.
                    Mandatory if maximumNumberOfEligibleBookingsActiveFlag is true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreUserGroupLocationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of userGroupLocation should be ignored. May be present for add and change operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserGroupLocation" type="cis:UserGroupLocationType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Shipping locations the user group is restricted to.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowRateShopAccessForSuspensionsAtLoadStatusEnumVal" type="cis:LoadOperationalStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    indicates the minimum load operational status at which rate shop access is permitted when the selection involves a suspended load if rate shop is invoked and this field indicates a load operational status that is later in the status workflow than a suspended load, access to rate shop will be denied the value set here is used as the default value when creating a new user group.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowRateShopAccessForSuspensionsAtLoadStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for allowRateShopAccessForSuspensionsAtLoadStatusEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowRateShopAutoUnsuspendAtLoadStatusEnumVal" type="cis:LoadOperationalStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the minimum load operational status at which submitting a rate shop selection will perform auto-unsuspend behaviors setting as blank (0) indicates auto-unsuspend should never occur when set to any other value, auto-unsuspend will be performed only suspended loads that are at or above the indicated load operational status the value set here is used as the default setting when creating a new user group.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowRateShopAutoUnsuspendAtLoadStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for allowRateShopAutoUnsuspendAtLoadStatusEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowRateShopAutoUnsuspendedforManualSuspensionsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether loads in operational statuses qualifying for auto-unsuspend behavior in rate shop extends to manually suspended loads; when false, a manually suspended load will never be auto-unsuspended by rate shop even if the load operational status qualifies. 
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumVoucherApprovalAmount" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum amount that can be approved for a voucher by the user group.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APIRestrictionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Control whether the user group is allowed to perform API operation for selected API.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="UserGroupLocationType">
                <xsd:annotation>
                    <xsd:documentation>
            Grouping of the users.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
					The character ^ is used as a separator for the compound key.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserGroupCode" type="cis:UserGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID code of the user group. Mandatory field. Not updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The type of the shipping location. Not updatable.
					If not specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for shippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The ID code of the shipping location. Mandatory. Not updatable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserGroup" type="cis:UserGroupType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Associated user group.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="UserStatusChangeInfoType">
                <xsd:annotation>
                    <xsd:documentation>
			    A collection of information for the user status to change to.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="UserCode" type="cis:UserCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				    A collection of user codes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserStatusEnumVal" type="cis:UserStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The new status of the user.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="VariableLoadingUnloadingTimeType">
                <xsd:annotation>
                    <xsd:documentation>
Defines a variable loading or unloading time factor.  Multiple entries may be applied to a single entity based on Load Unit Type.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VariableLoadingUnloadingTimeCode" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
An automatically generated system identifier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VariableTimeCategoryEnumVal" type="cis:VariableTimeCategoryEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Defines whether the variable time factor is for loading or unloading time. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VariableTimeCategoryEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for variableTimeCategoryEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VariableLoadingUnitTypeEnumVal" type="cis:LoadUnitExEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shipment attribute that this variable time factor is based on. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VariableLoadingUnitTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for VariableLoadingUnitTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnitDivideFactorVal" type="cis:UnitDivideFactorType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
Factor to scale a unit expression by.  For example, a unit divide factor of 100 applied to a variable time factor of 5 scales the variable time factor to .05 (perhaps to express the variable time factor in terms of hundred weight, rather than raw weight). Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VariableTimeFactorVal" type="cis:PreciseHoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The variable time factor defined by this entry. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadingTypeCode" type="cis:LoadingTypeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The loading type of this record. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemType" type="cis:ItemDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The item type used for this record. Optional. Updatable.				    				    
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItemTypeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Description for ItemType. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the shipment was created. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the shipment was last updated. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who created the shipment. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who last updated the shipment. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocation" type="cis:ShippingLocationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated shipping location.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadingType" type="cis:LoadingTypeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Associated Loading Type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ZoneType">
                <xsd:annotation>
                    <xsd:documentation>
			A geographic area that represents the origin or destination point of a shipment. Examples include a country, a state, a city, and a zip code range.

			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The zone ID.  Can not be blank. Can not be modified during update. Mandatory for all operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ZoneDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the zone.  Mandatory during create. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShortDescription" type="cis:ShortDescriptionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A short description of the zone. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The country ID for the zone.  Can not be blank. Mandatory and updatable..
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="State" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The state or province ID for the zone. *ALL means any state or province in the country of this zone. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLRegionZoneGroupCode" type="cis:ZoneGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The G/L region zone group of the zone. Optional. Updatable. Allowed value for this is GL1.
				To force this value to be blank, enter a single space in double quotes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TaxRegionZoneGroupCode" type="cis:ZoneGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The tax region zone group of the zone. Optional. Updatable.
				To force this value to be blank, enter a single space in double quotes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessHourZoneGroupCode" type="cis:ZoneGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The business hour zone group of the zone. Optional. Updatable.
					To force this value to be blank, enter a single space in double quotes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TimeZoneOffset" type="cis:TimezoneOffsetType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The number of hours offset from the default business hours due to time zone differences. Usually calculated based on the address of the object the business hours are attached to. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DaylightSavingsOffset" type="cis:DaylightOffsetType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The number of hours offset for this location due to daylight savings time. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IsTimeZoneFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether zone is a time zone. Optional.  Can not be modified during update.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IsDayLightSavingZoneFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether zone is a daylight saving zone. Optional. Can not be modified during update.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division ID.
					Not applicable for time zones, daylight savings zones, G/L region zones, tax zones or business hour zones.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessHours" type="cis:BusinessHoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The business hours for the zone. Optional. Updatable.
				    Applicable only if the zone is a Business Hour Zone.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreGeographicAreaFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of GeographicArea should be ignored.
					Cannot be true for a new Zone.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GeographicArea" type="cis:GeographicAreaType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The details of the geographic area of the zone.  Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="PalletVolumeFactorType">
                <xsd:annotation>
                    <xsd:documentation>
			It is used to estimate the number of pallets required to transport a consolidation of order lines. Pallet factors can specify origin location, destination location and commodity keys.
        </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Internal ID. Applicable only for UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PalletVolumeFactorID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The internally-assigned unique identifier for the pallet volume factor.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipFromLocationTypeEnumVal" type="cis:ShipFromPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The origin location type which the pallet volume factor applies to; optional.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipFromLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for shipFromLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipFromLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The origin location code which the pallet volume factor applies to; optional.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipToLocationTypeEnumVal" type="cis:ShipToPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The destination location type which the pallet volume factor applies to; optional.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipToLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for shipToLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipToLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The destination location code which the pallet volume factor applies to; optional.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The commodity code which the pallet volume factor applies to; optional.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Factor" type="cis:FactorType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The factor to apply to the volume to arrive at the estimated number of pallets.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created this pallet volume factor.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who updated this pallet volume factor.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The date and time that the  pallet volume factor was created(in system time zone).
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that this pallet volume factor was last updated (in system time zone).
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="BusinessDaysType">
                <xsd:annotation>
                    <xsd:documentation>
            The BusinessDays structure represents Business Days
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessDaysID" type="cis:BusinessDaysCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Business days code. Mandatory for a new BusinessDays. Cannot be changed for an existing BusinessDays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessDaysDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Business days description. Mandatory for a new BusinessDays. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessDaysMondayFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Indicates whether Monday is a business day. Mandatory for a new BusinessDays. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessDaysTuesdayFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Indicates whether Tuesday is a business day. Mandatory for a new BusinessDays. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessDaysWednesdayFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Indicates whether Wednesday is a business day. Mandatory for a new BusinessDays. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessDaysThursdayFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Indicates whether Thursday is a business day. Mandatory for a new BusinessDays. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessDaysFridayFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Indicates whether Friday is a business day. Mandatory for a new BusinessDays. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessDaysSaturdayFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Indicates whether Saturday is a business day. Mandatory for a new BusinessDays. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessDaysSundayFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Indicates whether Sunday is a business day. Mandatory for a new BusinessDays. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DayWeekPntTimeTableType">
                <xsd:annotation>
                    <xsd:documentation>
            The DayWeekPntTimeTable structure represents a Timetable
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
					The character ^ is used as a separator for the compound key.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryScheduleCode" type="cis:DeliveryScheduleCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The delivery schedule code.
					Mandatory for a new DayWeekPntTimeTable. Cannot be changed for an existing DayWeekPntTimeTable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTimeTableCode" type="cis:ItineraryTimetableCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The itinerary time table code.
					Mandatory for a new DayWeekPntTimeTable. Cannot be changed for an existing DayWeekPntTimeTable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTimeTableEntryCode" type="cis:ItineraryTimetableEntryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The itinerary time table entry code.
                    Should match the itinerary time table entry code of the itinerary time table entry if supplied for a new DayWeekPntTimeTable.
                    Cannot be changed for an existing DayWeekPntTimeTable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryPointSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Number of itinerary point in the itinerary.
					Mandatory for a new DayWeekPntTimeTable. Cannot be changed for an existing DayWeekPntTimeTable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestArrivalDateTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Earliest date and time of arrival. Mandatory for every point except the first.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestArrivalDateTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Latest date and time of arrival. Mandatory for every point except the first.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestDepartureDateTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Earliest date and time of departure. Mandatory for every point except the last.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestDepartureDateTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Latest date and time of departure. Mandatory for every point except the last.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ArrivalWeek" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Number of weeks in transit.
					Must be zero for first point, otherwise cannot be less than one.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ArrivalDayOfWeek" type="cis:DayOfWeekEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Arrival day of week. Mandatory for every point except the first.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DepartureDayOfWeek" type="cis:DayOfWeekEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Arrival day of week. Mandatory for every point except the last.
   				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumTransitHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Minimum transit hours. Cannot be negative. Optional.
   				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumDwellHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Minimum dwell hours. Cannot be negative. Optional.
   				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DepartureWeek" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Number of weeks before departure. 
					Must be zero for first and last point, otherwise cannot be less than one.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliverySchedule" type="cis:DeliveryScheduleType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated delivery schedule.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItnrTimeTableEntry" type="cis:ItnrTimeTableEntryType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated timetable entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DeliveryScheduleType">
                <xsd:annotation>
                    <xsd:documentation>
            The DeliverySchedule structure represents a Delivery Schedule
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryScheduleCode" type="cis:DeliveryScheduleCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			        The delivery schedule code. Mandatory for a new DeliverySchedule. Cannot be changed for an existing DeliverySchedule.
				    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryScheduleDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Delivery schedule Description. Mandatory for a new DeliverySchedule. Cannot be blank.
				    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryScheduleLocationTypeEnumVal" type="cis:DeliveryScheduleLocationBasisEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Default location type. Mandatory for a new DeliverySchedule. Cannot be an empty element.
				    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryScheduleLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for deliveryScheduleLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryScheduleDateBasisEnumVal" type="cis:DeliveryScheduleDateBasisEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Default date basis of delivery schedule. Mandatory for a new delivery schedule.
				    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryScheduleDateBasisEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for DeliveryScheduleDateBasisEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnforceGeoHierarchyFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Flag that if set is enforcing geographical hierarchy for the delivery schedule.
					Mandatory for a new DeliverySchedule. Cannot be blank.
				    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopMustMatchItineraryFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					When flag is enabled, an itinerary must have all points as Shipping Location instead of Zones, and
					the point location and point sequence must be identical to the Load stops and stop sequence.
					Also when flag is enabled, Default location type DeliveryScheduleLocationTypeEnumVal cannot be defined as Zone.
					Cannot be true when AllowMultipleItinerariesFlag is true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowMultipleItinerariesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether linking of multiple delivery schedule itineraries is allowed to identify a path from origin to destination.
					Cannot be true when StopMustMatchItineraryFlag is true.
					Cannot be changed if Delivery Schedule already has Itineraries.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultTransitModeEnumVal" type="cis:TransitModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The default transit mode for the delivery schedule.
					When AllowMultipleItinerariesFlag is true, mandatory for Create and cannot be cleared on Update.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultTransitModeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for DefaultTransitModeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The Carrier Code from an external system integrated to for source data.
				    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The ID of the create user. This is a read-only field.
				    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The ID of the user who performed the most recent update. This is a read-only field.
				    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessHours" type="cis:BusinessHoursRestrictedType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                        The business hours (holiday exceptions) of the delivery schedule.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A memo associated with the delivery schedule.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessDays" type="cis:BusinessDaysType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The BusinessDays structure represents Business Days.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreItinerariesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the supplied itineraries should be ignored. May be present for add and change operations.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Itineraries" type="cis:ItineraryType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The collection of components that moves between any two given locations. Presence depends on the value of ignoreItinerariesFlag.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreItnrTimeTableFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the supplied itinerary timetables should be ignored. May be present for add and change operations.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItnrTimeTables" type="cis:ItnrTimeTableType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The collection of itinerary time tables. Presence depends on the value of ignoreItnrTimeTableFlag.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FixedPntTimeTables" type="cis:FixedPntTimeTableType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The collection of FixedPntTimeTable structures.
					Accessibe only via UI-orineted APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ElapsedPntTimeTables" type="cis:ElapsedPntTimeTableType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The collection of elapsed point time tables.
					Accessibe only via UI-orineted APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="DeliveryScheduleEntityType">
                <xsd:annotation>
                    <xsd:documentation>
				A sequence of entity structures of the type of entity to be deleted, retrieved, or updated.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Itinerary" type="cis:ItineraryType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The physical collection of components that moves between any two given locations. The system creates shipments from a single transport order.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItnrTimeTable" type="cis:ItnrTimeTableType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					A list of itinerary timetables.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItnrLanePerformance" type="cis:ItnrLanePerformanceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					A list of itinerary lane performance.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItnrTimeTableEntry" type="cis:ItnrTimeTableEntryType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					A list of timetable entries.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ElapsedPntTimeTableType">
                <xsd:annotation>
                    <xsd:documentation>
				A timetable point based on elapsed business days.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
					The character ^ is used as a separator for the compound key.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryScheduleCode" type="cis:DeliveryScheduleCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The delivery schedule code.
					Mandatory for a new ElapsedPntTimeTable. Cannot be changed for an existing ElapsedPntTimeTable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTimeTableCode" type="cis:ItineraryTimetableCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The itinerary time table code.
					Mandatory for a new ElapsedPntTimeTable. Cannot be changed for an existing ElapsedPntTimeTable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTimeTableEntryCode" type="cis:ItineraryTimetableEntryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The itinerary time table entry code.
                    Should match the itinerary time table entry code of the itinerary time table entry if supplied for a new ElapsedPntTimeTable.
                    Cannot be changed for an existing ElapsedPntTimeTable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryToPointSequentialNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Sequential number of itinerary destination point.
					Mandatory for a new ElapsedPntTimeTable. Cannot be changed for an existing ElapsedPntTimeTable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestArrivalDateTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Earliest date and time of arrival. Mandatory for every point except the first.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestArrivalDateTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Latest date and time of arrival. Mandatory for every point except the first.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestDepartureDateTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Earliest date and time of departure. Mandatory for every point except the last.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestDepartureDateTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Latest date and time of departure. Mandatory for every point except the last.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ElapsedDays" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Number of elapsed business days in transit. Mandatory for a new ElapsedPntTimeTable. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumTransitHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Minimum transit hours. Cannot be negative. Optional.
   				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumDwellHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Minimum dwell hours. Cannot be negative. Optional.
   				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DepartureElapsedDays" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Number of elapsed business days before departure. 
					Mandatory for a new ElapsedPntTimeTable. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliverySchedule" type="cis:DeliveryScheduleType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated delivery schedule.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItnrTimeTableEntry" type="cis:ItnrTimeTableEntryType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated timetable entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="FixedPntTimeTableType">
                <xsd:annotation>
                    <xsd:documentation>
                           The FixedPntTimeTable structure represents a Timetable
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
					The character ^ is used as a separator for the compound key.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryScheduleCode" type="cis:DeliveryScheduleCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The delivery schedule code.
					Mandatory for a new FixedPntTimeTable. Cannot be changed for an existing FixedPntTimeTable.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTimeTableCode" type="cis:ItineraryTimetableCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The itinerary time table code.
					Mandatory for a new FixedPntTimeTable. Cannot be changed for an existing FixedPntTimeTable.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTimeTableEntryCode" type="cis:ItineraryTimetableEntryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The itinerary time table entry code.
                    Should match the itinerary time table entry code of the itinerary time table entry if supplied for a new FixedPntTimeTable.
                    Cannot be changed for an existing FixedPntTimeTable.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryPointSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Number of itinerary point in the itinerary
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestArrivalDateTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Earliest date and time of arrival. Mandatory for every point except the first.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestArrivalDateTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Latest date and time of arrival. Mandatory for every point except the first.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EarliestDepartureDateTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Earliest date and time of departure. Mandatory for every point except the last.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LatestDepartureDateTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Latest date and time of departure. Mandatory for every point except the last.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ArrivalDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Arrival date. Mandatory for every point except the first.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DepartureDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Detarture date. Mandatory for every point except the last.
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumTransitHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Minimum transit hours. Cannot be negative. Optional.
   				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumDwellHours" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Minimum dwell hours. Cannot be negative. Optional.
   				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliverySchedule" type="cis:DeliveryScheduleType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated delivery schedule.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItnrTimeTableEntry" type="cis:ItnrTimeTableEntryType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated timetable entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ItineraryType">
                <xsd:annotation>
                    <xsd:documentation>
				The physical collection of components that moves between any two given locations. The system creates shipments from a single transport order.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
					The character ^ is used as a separator for the compound key.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryScheduleCode" type="cis:DeliveryScheduleCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The delivery schedule code. Mandatory for a new Itinerary. Cannot be changed for an existing Itinerary.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryCode" type="cis:ItineraryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The itinerary code. Mandatory for a new Itinerary. Cannot be changed for an existing Itinerary.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Itinerary Description. Mandatory for a new Itinerary. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryStatusEnumVal" type="cis:ItineraryStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Itinerary status (active/inactive).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for itineraryStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryItineraryFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the itinerary is a primary itinerary.
					Cannot be false if AllowMultipleItinerariesFlag is false for the Delivery Schedule.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItinerarySchedulingMethodEnumVal" type="cis:ItinerarySchedulingMethodEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Scheduling method for the itinerary.
					Cannot be set to Distance Engine if PrimaryItineraryFlag is true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItinerarySchedulingMethodEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for ItinerarySchedulingMethodEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransitModeEnumVal" type="cis:TransitModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Transit mode for the itinerary.
					Not editable if PrimaryItineraryFlag is true, otherwise, cannot be cleared.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransitModeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for TransitModeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TeamDriverEnumVal" type="cis:BooleanEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether team drivers are used for loads handled using this itinerary.
					Not applicable if ItinerarySchedulingMethodEnumVal is Timetable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TeamDriverEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for TeamDriverEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeekendHolidaySchedulingEnumVal" type="cis:WeekendHolidaySchedulingEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The weekend / holiday scheduling control.
					Not applicable if ItinerarySchedulingMethodEnumVal is Timetable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeekendHolidaySchedulingEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for WeekendHolidaySchedulingEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceEngine" type="cis:ExternalEngineVersionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Distance Engine this itinerary will be associated with. To force this value to be blank, enter a single space (" ").
					Not applicable if itinerary scheduling method is not Distance Engine.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalServiceType" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The service type of this itinerary from an external system.
				    </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the create user. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who performed the most recent update. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTimeTableCode" type="cis:ItineraryTimetableCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The itinerary time table code. Cannot be changed for an existing Itinerary.
					Cannot be specified if ItinerarySchedulingMethodEnumVal is Distance Engine.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTimeTableDeliveryScheduleCode" type="cis:DeliveryScheduleCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Code of delivery schedule for itinerary time table. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessHours" type="cis:BusinessHoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The business hours of the itinerary.
					Not applicable if ItinerarySchedulingMethodEnumVal is not Distance Engine.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreItineraryPointsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the supplied itinerary points should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryPointList" type="cis:ItineraryPointType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					A collection of Itinerary Points. Presence depends on the value of ignoreItineraryPointsFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreLanePerformancesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the supplied list of lane performances should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanePerformance" type="cis:ItnrLanePerformanceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The lane performances associated with this itinerary. Presence depends on the value of ignoreLanePerformancesFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliverySchedule" type="cis:DeliveryScheduleType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated delivery schedule.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ItineraryPointType">
                <xsd:annotation>
                    <xsd:documentation>
			The ItineraryPoint structure represents an Itinerary Point
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryPointID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Itinerary point id. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryPointDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Itinerary Point Description. Mandatory for a new ItineraryPoint. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryPointSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Number of itinerary point in the itinerary. Mandatory for a new ItineraryPoint. Cannot be changed for an existing ItineraryPoint.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ItineraryPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Type of shipping location. Mandatory for a new ItineraryPoint. Cannot be an empty element.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for shippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryScheduleCode" type="cis:DeliveryScheduleCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The delivery schedule code. Mandatory for a new ItineraryPoint. Cannot be changed for an existing ItineraryPoint.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryCode" type="cis:ItineraryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The itinerary code. Mandatory for a new ItineraryPoint. Cannot be changed for an existing ItineraryPoint.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryPointZoneLocationCode" type="cis:ItineraryPointZoneLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Itinerary point's shipping location or zone code. Mandatory for a new ItineraryPoint. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliverySchedule" type="cis:DeliveryScheduleType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated delivery schedule.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Itinerary" type="cis:ItineraryType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated itinerary.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ItnrLanePerformanceType">
                <xsd:annotation>
                    <xsd:documentation>
				An itinerary lane performance.
				The corresponding database table is not currently active.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
					The character ^ is used as a separator for the compound key.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTariffNumber" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system generated tariff number.
					Mandatory for a new ItnrLanePerformance. Cannot be changed for an existing ItnrLanePerformance.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The tariff service. Mandatory for a new ItnrLanePerformance. Cannot be changed for an existing ItnrLanePerformance.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryFromPointSequentialNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The sequential number of the From point in the itinerary.
					Mandatory for a new ItnrLanePerformance. Cannot be changed for an existing ItnrLanePerformance.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItnrFromShippingLocationTypeEnumVal" type="cis:ItineraryPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The From point type: shipping location or zone.
					Mandatory for a new ItnrLanePerformance. Cannot be changed for an existing ItnrLanePerformance.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItnrFromShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for itnrFromShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryFromPointZoneLocationCode" type="cis:ItineraryPointZoneLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The code of the From itinerary zone or shipping location.
					Mandatory for a new ItnrLanePerformance. Cannot be changed for an existing ItnrLanePerformance.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryToPointSequentialNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The sequential number of the To point in the itinerary.
					Mandatory for a new ItnrLanePerformance. Cannot be changed for an existing ItnrLanePerformance.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItnrToShippingLocationTypeEnumVal" type="cis:ItineraryPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The To point type: shipping location or zone.
					Mandatory for a new ItnrLanePerformance. Cannot be changed for an existing ItnrLanePerformance.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItnrToShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for itnrToShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryToPointZoneLocationCode" type="cis:ItineraryPointZoneLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The code of the To itinerary zone or shipping location.
					Mandatory for a new ItnrLanePerformance. Cannot be changed for an existing ItnrLanePerformance.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryScheduleCode" type="cis:DeliveryScheduleCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The associated delivery schedule code.
					Mandatory for a new ItnrLanePerformance. Cannot be changed for an existing ItnrLanePerformance.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryCode" type="cis:ItineraryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The associated itinerary code.
					Mandatory for a new ItnrLanePerformance. Cannot be changed for an existing ItnrLanePerformance.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Performance" type="cis:PerformanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The performance data. Mandatory for a new ItnrLanePerformance. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ItnrTimeTableType">
                <xsd:annotation>
                    <xsd:documentation>
				An itinerary timetable.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
					The character ^ is used as a separator for the compound key.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryScheduleCode" type="cis:DeliveryScheduleCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The delivery schedule code. Mandatory for a new ItnrTimeTable. Cannot be changed for an existing ItnrTimeTable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTimeTableCode" type="cis:ItineraryTimetableCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The itinerary time table code. Mandatory for a new ItnrTimeTable. Cannot be changed for an existing ItnrTimeTable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTimeTableDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Tescription of the itinerary timetable. Mandatory for a new ItnrTimeTable. Cannot be blank.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfItnrPoints" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of itinerary points.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created this delivery schedule. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who last updated this delivery schedule. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreTimeTableEntries" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of the following sequence should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TimeTableEntries" type="cis:ItnrTimeTableEntryType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The timetable entries of this timetable. Presence depends on the value of ignoreTimeTableEntries.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliverySchedule" type="cis:DeliveryScheduleType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated delivery schedule.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ItnrTimeTableEntryType">
                <xsd:annotation>
                    <xsd:documentation>
				A timetable entry.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
					The character ^ is used as a separator for the compound key.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryScheduleCode" type="cis:DeliveryScheduleCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The delivery schedule code.
					Mandatory for a new ItnrTimeTableEntry. Cannot be changed for an existing ItnrTimeTableEntry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTimeTableCode" type="cis:ItineraryTimetableCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The itinerary time table code.
					Mandatory for a new ItnrTimeTableEntry. Cannot be changed for an existing ItnrTimeTableEntry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItineraryTimeTableEntryCode" type="cis:ItineraryTimetableEntryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The itinerary timetable entry code.
                    If not supplied for a new ItnrTimeTableEntry, TimeTableEntryDescription should be unique for the itinerary timetable.
                    Cannot be changed for an existing ItnrTimeTableEntry.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TimeTableEntryDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    A description of the timetable entry. Mandatory for a new ItnrTimeTableEntry. Cannot be blank.
                    Cannot be used by non-UI-oriented API to identify an existing timetable entry, ExistingTimeTableEntryDescription should be used instead.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExistingTimeTableEntryDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    A description used by non-UI-oriented API to identify an existing timetable entry.
                    Ignored if ItineraryTimeTableEntryCode is provided.
                    Ignored for a new ItnrTimeTableEntry.
                    Ignored by UI-oriented APIs.
                    Cannot be blank.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TimeTableEntryDateBasis" type="cis:DeliveryScheduleDateBasisEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The timetable entry date basis. Mandatory for a new ItnrTimeTableEntry. Cannot be an empty element.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Vessel" type="cis:VesselNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Vessel name for the timetable entry.					
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoyageNumber" type="cis:VoyageNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Voyage number for the timetable entry.					
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerYardDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The container yard date and time.					
					Should not be specified if ContainerYardDateTimeActiveFlag is not true.
					Mandatory if ContainerYardDateTimeActiveFlag is true and the value did not previously exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerYardDateTimeActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether any value exists for ContainerYardDateTime.
					Must be true if a value is specified for ContainerYardDateTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedVessel" type="cis:VesselNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Name of the related vessel such as feeder vessel.					
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedVoyageNumber" type="cis:VoyageNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Number of the related voyage such as feeder voyage.					
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedDepartureDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The related departure date and time such as departure date and time from the mother vessel port.					
					Should not be specified if RelatedDepartureDateTimeActiveFlag is not true.
					Mandatory if RelatedDepartureDateTimeActiveFlag is true and the value did not previously exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedDepartureDateTimeActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether any value exists for RelatedDepartureDateTime.
					Must be true if a value is specified for RelatedDepartureDateTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedDepartureShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The related departure shipping location ID such as the departure port for the mother vessel.					
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedDepartureShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The related departure shipping location type.					
					Cannot be specified if RelatedDepartureShippingLocationCode is not available.
					If RelatedDepartureShippingLocationCode is specified but
					RelatedDepartureShippingLocationTypeEnumVal is not specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RelatedDepartureShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for RelatedDepartureShippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExcludeFromOptimizationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the entry will be excluded from optimization.
                    The field will be used in a future release.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalSourceID" type="cis:VarChar140" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					External Source ID from which the time information was sourced.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VesselTrackingID1" type="cis:VarChar60" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Vessel tracking information 1.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VesselTrackingID2" type="cis:VarChar60" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Vessel tracking information 2.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    ActiveFlag indicates whether the  time table is active or not. Defaults to true. 
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the entry was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreFixedPointEntries" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of the following sequence should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FixedPntTimeTableEntry" type="cis:FixedPntTimeTableType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The fixed date-based timetables of this timetable entry.
					Presence depends on the value of ignoreFixedPointEntries. The list should have at least two entries. Cannot be changed for an existing ItnrTimeTableEntry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreDayWeekEntries" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of the following sequence should be ignored. This is a read-only field. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DayWeekPointTimeTableEntry" type="cis:DayWeekPntTimeTableType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The day of the week timetables of this timetable entry.
					Presence depends on the value of ignoreDayWeekEntries. The list should have at least two entries. Cannot be changed for an existing ItnrTimeTableEntry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreElapsedEntries" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of the following sequence should be ignored. This is a read-only field. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ElapsedDaysPointTimeTableEntry" type="cis:ElapsedPntTimeTableType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The elapsed business days timetables of this timetable entry.
					Presence depends on the value of ignoreElapsedEntries. The list should have at least two entries. Cannot be changed for an existing ItnrTimeTableEntry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliverySchedule" type="cis:DeliveryScheduleType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated delivery schedule.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ItnrTimeTable" type="cis:ItnrTimeTableType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated itinerary timetable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingInstructionsDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping instructions date and time.					
					The latest date/time by which shipping instructions must be sent to the carrier; applicable if the load is using sailing schedule
					(expressed in the time zone of the vessel departure location).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingInstructionsDateTimeActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether any value exists for ShippingInstructionsDateTime.
					Must be true if a value is specified for ShippingInstructionsDateTime.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="PerformanceType">
                <xsd:annotation>
                    <xsd:documentation>
			The Performance structure represents data about Line Performance
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="UserDefinedServiceGrade" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			  	    Number defined by user characterizing lane performance
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemGeneratedServiceGrade" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
	 			    Number generated by system characterizing lane performance
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserGradingEnumVal" type="cis:UserDefinedServiceGradeHandlingEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Number defined by user characterizing lane performance
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserGradingEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for userGradingEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfTransactions" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    Number of transactions
					</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="APInitialVoucherUpdateDataType">
                <xsd:annotation>
                    <xsd:documentation>
				Accounts Payable (AP) initial vouchers. Structure used to update AP initial voucher only.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemVoucherID" type="cis:VoucherNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The ID uniquely identifies the voucher. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherType" type="cis:VoucherTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The voucher type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierAccountNumber" type="cis:CarrierAccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The carrier account number.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A memo field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the contents of referenceNumberStructure should be ignored.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberStructure" type="cis:ReferenceNumberType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                The reference numbers. Presence depends whether there is any reference number.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreVoucherChargesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the contents of voucherCharge should be ignored.
                                To Delete an Adjustment, set this to False and omit the adjustment from the charge structure below.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherCharge" type="cis:VoucherChargeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                The voucher charges. 
                                Cannot included initial charges computed by rating, charges beyond accrued status or has been used as the basis for an AR charge.
                                All other charges must be included or they will be deleted.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="APMiscVoucherCreateDataType">
                <xsd:annotation>
                    <xsd:documentation>
				Accounts Payable (AP) miscellaneous vouchers. Structure used for AP miscellaneous voucher creation only.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="VoucherType" type="cis:VoucherTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The voucher type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EffectiveDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The effective date. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The division ID. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The logistics group ID. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTariffNumber" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The tariff ID on the voucher. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherReferenceNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The value of the voucher reference number or code. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierAccountNumber" type="cis:CarrierAccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The carrier account number.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The carrier ID. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The customer ID. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CostCenterCode" type="cis:CostCenterDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The cost center type. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ProfitCenterCode" type="cis:ProfitCenterDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The profit center type. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginShippingLocationTypeEnumVal" type="cis:ShipFromPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The location type of the origin.
					If not specified and originShippingLocationCode is specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The location ID of the origin.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationShippingLocationTypeEnumVal" type="cis:ShipToPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The location type of the destination.
					If not specified and destinationShippingLocationCode is specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The location ID of the destination.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The service code. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentNumber" type="cis:ShipmentNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The shipment number, for AP miscellaneous voucher referring to a particular shipment only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The commodity code.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentEntryTypeCode" type="cis:OrderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The shipment entry type ID. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The memo field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the contents of referenceNumberStructure should be ignored.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberStructure" type="cis:ReferenceNumberType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                The reference numbers. Presence depends whether there is any reference number.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreVoucherChargesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the contents of voucherCharge should be ignored.
                                Must be false because at least one charge details is needed to create a post charge voucher.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherCharge" type="cis:VoucherChargeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                The voucher charges. Must have at least one charge details.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="APMiscVoucherUpdateDataType">
                <xsd:annotation>
                    <xsd:documentation>
				Accounts Payable (AP) miscellaneous vouchers. Structure used for update AP miscellaneous voucher only.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemVoucherID" type="cis:VoucherNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID uniquely identifies the voucher. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherType" type="cis:VoucherTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The voucher type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EffectiveDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The effective date. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherReferenceNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The value of the voucher reference number or code. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierAccountNumber" type="cis:CarrierAccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The carrier account number.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CostCenterCode" type="cis:CostCenterDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The cost center type. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ProfitCenterCode" type="cis:ProfitCenterDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The profit center type. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginShippingLocationTypeEnumVal" type="cis:ShipFromPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The location type of the origin.
					If not specified for an origin location change and originShippingLocationCode is specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The location ID of the origin.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationShippingLocationTypeEnumVal" type="cis:ShipToPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The location type of the destination.
					If not specified for a destination location change and destinationShippingLocationCode is specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The location ID of the destination.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentNumber" type="cis:ShipmentNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The shipment number, for AP miscellaneous voucher referring to a particular shipment only.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The commodity code.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentEntryTypeCode" type="cis:OrderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The shipment entry type ID. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The memo field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the contents of referenceNumberStructure should be ignored.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberStructure" type="cis:ReferenceNumberType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                The reference numbers. Presence depends whether there is any reference number.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreVoucherChargesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the contents of voucherCharge should be ignored.
                                To Delete an Adjustment, set this to False and omit the adjustment from the charge structure below.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherCharge" type="cis:VoucherChargeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                The voucher charges.
                                Cannot include charges beyond accrued status or has been used as the basis for an AR charge.
                                All other charges must be included or they will be deleted.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="APPostChargeVoucherCreateDataType">
                <xsd:annotation>
                    <xsd:documentation>
				Accounts Payable (AP) post charge vouchers. Structure used to create AP post charge voucher only.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="VoucherType" type="cis:VoucherTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The voucher type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EffectiveDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The effective date. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierAccountNumber" type="cis:CarrierAccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The carrier account number.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The carrier ID. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InitialVoucherID" type="cis:VoucherNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The ID uniquely identifies the initial voucher for a post charge voucher.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A memo field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the contents of referenceNumberStructure should be ignored.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberStructure" type="cis:ReferenceNumberType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                The reference numbers. Presence depends whether there is any reference number.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreVoucherChargesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the contents of voucherCharge should be ignored.
                                Must be false because at least one charge details is needed to create a post charge voucher.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherCharge" type="cis:VoucherChargeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                The voucher charges. Must have at least one charge details.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="APPostChargeVoucherUpdateDataType">
                <xsd:annotation>
                    <xsd:documentation>
				Accounts Payable (AP) post charge vouchers. Structure used to update AP post charge voucher only.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemVoucherID" type="cis:VoucherNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The ID uniquely identifies the voucher. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherType" type="cis:VoucherTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The voucher type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EffectiveDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The effective date. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierAccountNumber" type="cis:CarrierAccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The carrier account number.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A memo field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the contents of referenceNumberStructure should be ignored.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberStructure" type="cis:ReferenceNumberType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                The reference numbers. Presence depends whether there is any reference number.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreVoucherChargesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the contents of voucherCharge should be ignored.
                                To Delete an Adjustment, set this to False and omit the adjustment from the charge structure below.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherCharge" type="cis:VoucherChargeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                                The voucher charges. 
                                Cannot included initial charges computed by rating, charges beyond accrued status or has been used as the basis for an AR charge.
                                All other charges must be included or they will be deleted.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="APTransactionType">
                <xsd:annotation>
                    <xsd:documentation>
				General ledger accounts payable (A/P) transactions.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTransactionID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID code of the transaction.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier name.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APVendorNumber" type="cis:AccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier vendor number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierAccountNumber" type="cis:AccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier account number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PayToCarrierName" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The Pay To carrier name.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PayToAPVendorNumber" type="cis:AccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The Pay To vendor number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PayToCarrierAccountNumber" type="cis:AccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The Pay To account number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillNumber" type="cis:FreightBillNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill number.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillTypeCode" type="cis:FreightBillDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for freightBillTypeCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillSourceEnumVal" type="cis:FreightBillSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill source type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillSourceEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for freightBillSourceEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalFreightBillNumber" type="cis:FreightBillNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The original freight bill number for post charges.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalFreightChargesApproved" type="cis:SumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The sum of the approved freight bill detail amounts.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalTaxChargesApproved" type="cis:SumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The sum of the approved freight bill tax amounts.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalFreightChargesBilled" type="cis:SumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total non-tax freight bill charges reported by the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalTaxChargesBilled" type="cis:SumType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total freight bill tax charges reported by the carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PaymentTermsCode" type="cis:APTermsDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The type of payment terms.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PaymentTermsCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for paymentTermsCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The currency type of the freight bill charge.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for currencyCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRate" type="cis:ExchangeRateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The exchange rate during freight bill generation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APTransactionStatusEnumVal" type="cis:APStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The transaction status.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APTransactionStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for APTransactionStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PaymentDueDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The due date of the payment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InvoiceDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date quoted by the carrier on the invoice or freight bill form.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DateReceived" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date the freight bill was received.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the transaction was created.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The date and time that the transaction was updated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who created the transaction.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the user who updated the transaction.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APTransactionVersionCode" type="cis:TransactionVersionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The A/P transaction version ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemFreightBillID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginalSystemFreightBillID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The original freight bill ID for post charges.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PayToCarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The Pay To carrier ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The division ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The logistics group ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightBillBatchControlID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight bill batch control ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FiscalYear" type="cis:BookingYearType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The accounting fiscal year.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AccountingPeriod" type="cis:AccountingPeriodType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The accounting period of the fiscal year.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TransactionRunNumber" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The transaction run ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A freight bill memo field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLTransaction" type="cis:GLTransactionType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of matching G/L transactions for this A/P transaction.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="APVoucherType">
                <xsd:annotation>
                    <xsd:documentation>
				Accounts Payable (AP) vouchers. Structure used for retrieval only.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ClassID" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                        Internal class ID to identify the type of voucher. Applicable only for UI-oriented APIs.
                                        3407 - Initial AP Voucher, 3408 - Post Charge AP Voucher, 3409 - Misc. AP Voucher
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemVoucherID" type="cis:VoucherNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID uniquely identifies the voucher. Mandatory except for voucher creation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalVoucherPaymentAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total voucher amount in payment currency.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalTaxAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The total tax amount in payment currency.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherType" type="cis:VoucherTypeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The voucher type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VoucherTypeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for voucherType. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EffectiveDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The effective date.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The currency type of the payment amount.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for currencyCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRate" type="cis:ExchangeRateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The exchange rate of the payment amount.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HoldFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the voucher is on hold.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="HeldFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the voucher was held for some conditions.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatingCurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The currency type of the rating amount.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatingCurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for ratingCurrencyCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatingExchangeRate" type="cis:ExchangeRateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The exchange rate of the rating amount.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalVoucherRatingAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The total voucher amount in rating currency.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The division ID.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The logistics group ID.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrentStatusEnumVal" type="cis:APVoucherStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The current AP Voucher status.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrentStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for currentStatusEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTariffNumber" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The tariff ID on the voucher.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemNonOperationalFreightID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The non operational freight ID if the AP voucher is associated with a Non Operational Freight.
