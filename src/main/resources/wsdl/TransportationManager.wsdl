                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowRateShopAutoUnsuspendAtLoadStatusEnumVal" type="cis:LoadOperationalStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the minimum load operational status at which submitting a rate shop selection will perform auto-unsuspend behaviors setting as blank (0) indicates auto-unsuspend should never occur when set to any other value, auto-unsuspend will be performed only suspended loads that are at or above the indicated load operational status the value set here is used as the default setting when creating a new user group.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowRateShopAutoUnsuspendAtLoadStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for allowRateShopAutoUnsuspendAtLoadStatusEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowRateShopAutoUnsuspendedforManualSuspensionsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether loads in operational statuses qualifying for auto-unsuspend behavior in rate shop extends to manually suspended loads when false, a manually suspended load will never be auto-unsuspended by rate shop even if the load operational status qualifies. 
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BkgRviDrayLdHandlingEnumVal" type="cis:BkgRviDryLdHandlTypEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Used to control how dray loads should be handled when a booking revision is accepted with Disable RRS if it is Mark for Rescheduling, dray loads are not updated except to flag them as requiring re-scheduling  if it is Apply Adjustments Conditionally, dray loads are adjusted only as needed to ensure they do not reflect a timing that is too late for port departure (origin drays) or too early for port arrival (destination drays) if it is "Always Apply Adjustments" (default), dray loads will be adjusted according to location and time duration changes applied to the associated booking
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BkgRviDrayLdHandlingEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for SchedulingModeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinPasswordLength" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The minimum character length required for a valid password.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PasswordChangeFrequency" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Specifies a time period (in minutes) that must elapse between user account password changes a blank value indicates this policy does not apply.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinNumbersInPassword" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the minimum number of numeric characters required in a valid password zero indicates no minimum this characteristic is enforced by change/update password operations when Allow Numbers in Password is true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinSpecialCharsInPassword" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the minimum number of special characters required in a valid password zero indicates no minimum this characteristic is enforced by change/update password operations when Allow Special Characters in Password is true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinUppercaseLettersInPassword" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the minimum number of uppercase characters required in a valid password zero (0) indicates no minimum this characteristic is enforced by change/update password operations when Allow Uppercase Letters in Password is true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinLowercaseLettersInPassword" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the minimum number of lowercase characters required in a valid password zero (0) indicates no minimum this characteristic is enforced by change/update password operations when Allow Lowercase Letters in Password is true.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaxInvalidPasswordAttempts" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum number of consecutive login or change password operations that will be allowed using an invalid password before the user account is locked a successful login or change password operation will reset the counter, as will administrator action to unlock this user's account or reset password zero in this field indicates this feature is not applied.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UserAccountLockDuration" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Specifies a time period (stored in minutes) to measure how long a user account will remain locked once Maximum Invalid Password Attempts is reached this policy is enforced by login and change password operations not enforced when Maximum Invalid Password Attempts is zero user accounts will automatically unlock when this duration has elapsed.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PasswordHistoryCount" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates the number of old passwords the system will retain and enforce during change/reset password operations new passwords may not match any of these old passwords zero indicates no prior passwords are checked.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowNumbersInPassword" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether or not number are permitted in a user password enforced by change/reset password operations when enabled, Minimum Numbers in Password is also enforced. 
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowSpecialCharactersInPassword" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether or not special characters are permitted in a user password enforced by change/reset password operations when enabled, Minimum Special Characters in Password and Password Special Characters are also enforced. 
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowUppercaseLettersInPassword" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether or not uppercase characters are permitted in a user password enforced by change/reset password operations when enabled, Minimum Uppercase Letters in Password is also enforced. 
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowLowercaseLettersinPassword" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether or not lowercase characters are permitted in a user password enforced by change/reset password operations when enabled, Minimum Lowercase Letters in Password is also enforced. 
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PasswordSpecialCharacters" type="cis:PasswordSpecialCharType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Specifies all the special characters that are allowed in a valid password enforced by change/reset password operations when Allow Special Characters in Password is true characters specified in this field that technically classify as alpha or numeric will not be counted as special characters.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ElevationUnitOfMeasureEnumVal" type="cis:ElevationUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The elevation unit of measure for this user; elevations will be presented to the user in this unit of measure (excluding pages where transactions are created).
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ElevationUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for elevationUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TemperatureUnitOfMeasureEnumVal" type="cis:TemperatureUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The temperature unit of measure for this user; temperatures will be presented to the user in this unit of measure (excluding pages where transactions are created)
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TemperatureUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for temperatureUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="KeepTenderWhenLastPlanningShipmentRemovedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether load-level tender and scheduling information (including status) should be cleared or reverted on tendered or tender accepted loads when the last attached shipment flagged as a planning shipment is removed; when 'True', operational status, tariff/service/equipment/domicile, related commit flags, load first/last location and start/end dates are retained; empty stops are retained; when 'False', this information is cleared, empty stops are removed and the operational status reverts to Open.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PalletRoundingRules" type="cis:SkidRoundingRuleType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					defines a list of estimated pallet rounding rules: minPallet,roundingFactor,minPallet2,roundingFactor2;... Each rule specifies the minimum estimated pallet value to which it applies and a rounding factor. If the fractional portion of the estimated pallet amount is above the rounding factor, the pallet amount will be rounded up, otherwise it will be rounded down. e.g. "0,.0,3,.1,5,.2".
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumVoucherApprovalAmount" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum amout that can be approved for a voucher by any user.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FinancialsPrepaidCollectControlEnumVal" type="cis:FinancialsPrepaidCollectControlEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Controls how Prepaid and Collect are intepreted in the financial workflow within the system.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncludeEquipmentTypeInDistanceCallsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					include equipment type in distance calls directs whether specified equipment type and number of trailers (always '1' for TM) is passed as a factor in TM-initiated distance and transit time calls; TP-initiated calls are managed by a separate setting.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncludeCommodityInDistanceCallsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					include commodity in distance calls directs whether the hazardous indication of shipped commodities is passed as a factor in TM-initiated distance and transit time calls; if any shipped commodity is marked as hazardous, the hazardous indication will be passed; TP-initiated calls are managed by a separate setting.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceTtmLookupControlEnumVal" type="cis:DistanceTtmLookupControlEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					this value controls how distance transit time override (dtto) entries are determined by the TM distance engine for a given origin and destination pair when an exact match does not exist; when tariff/service is selected, the cached dtto entry having an exact match on these elements will be applied before precise matches on commodity/equipment type where the tariff/service is not specified; conversely, when commodity/equipment type is selected, the cached dtto entry having an exact match on these elements will be applied before precise matches on tariff/service where commodity/equipment type is not specified; this control only influences the lookup behavior in cached dtto entries; lookups in the distance provider cache will always apply exact match criteria.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceTtmLookupControlEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for distanceTtmLookupControlEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionDisableRRSRecommendationModeEnumVal" type="cis:BookingRevisionDisableRRSRecommendationModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Used to control how 'rescheduling recommended' flag should be handled while accepting booking revision with Disable RRS; considering the requirements for other shipment legs associated with the shipment leg(s) for the transaction being scheduled (load, booking); if violation exists on the entity being rated and the entity's rescheduling recommended is false, based on the web type defined,  the dependent load, trip or booking, the 'rescheduling recommended' flag will be turned to true; possible web types are : 'none' - no web processing; 'basic web'- only the direct dependencies of the load, trip, or booking being rated; 'forward only basic web' - only the future direct dependencies of the load, trip, or booking being rated; 'full web' - all dependencies of the load, trip or booking being rated, recursively; 'forward only full web' -  all the future dependencies of the load, trip or booking being rated, recursively.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingRevisionDisableRRSRecommendationModeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for bookingRevisionDisableRRSRecommendationModeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionModeSchedulingViolationRecommendationModeEnumVal" type="cis:ExecutionModeSchedulingViolationRecommendationModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Used to control how 'rescheduling recommended' flag should be handled during scheduling with violation; considering the requirements for other shipment legs associated with the shipment leg(s) for the transaction being scheduled (load, trip/booking); if violation exists on the entity being rated and the entity's rescheduling recommended is false, based on the web type defined,  the dependent load, trip or booking, the 'rescheduling recommended' flag will be turned to true; possible web types are : 'none' - no web processing; 'basic web'- only the direct dependencies of the load, trip, or booking being rated; 'forward only basic web' - only the future direct dependencies of the load, trip, or booking being rated; 'full web' - all dependencies of the load, trip or booking being rated, recursively; 'forward only full web' -  all the future dependencies of the load, trip or booking being rated, recursively.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionModeSchedulingViolationRecommendationModeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for executionModeSchedulingViolationRecommendationModeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RRSSchedulingFailureRecommendationModeEnumVal" type="cis:RRSSchedulingFailureRecommendationModeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Used to control how 'rescheduling recommended' flag should be handled during scheduling, considering the requirements for other shipment legs associated with the shipment leg(s) for the transaction being scheduled (load, trip/booking); if scheduling fails on the entity being rated and the entity's rescheduling recommended is false, based on the web type defined,  the dependent load, trip or booking, the 'rescheduling recommended' flag will be turned to true; possible web types are : 'none' - no web processing; 'basic web'- only the direct dependencies of the load, trip, or booking being rated; 'forward only basic web' - only the future direct dependencies of the load, trip, or booking being rated; 'full web' - all dependencies of the load, trip or booking being rated, recursively; 'forward only full web' -  all the future dependencies of the load, trip or booking being rated, recursively.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RRSSchedulingFailureRecommendationModeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for rRSSchedulingFailureRecommendationModeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateShopRemoveResourceConstraintsbyDefaultFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the remove commitment constraints option in rate shop Uis should be set or unset when the initial request is executed.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowTripOverrideToLoadHardCommitFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Allow trip overrides when load has hard commits.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowTripLoadTenderfromLoadListsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Allow Trip Load Tender from Load Lists to control Load Level Tendering when on a Trip.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EnforceStatusEligibilityforTripContinuationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Enforce Status Eligibility for Trip Continuation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="OptimizerInstanceGroupType">
                <xsd:annotation>
                    <xsd:documentation>
				An Optimizer Instance Group.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OptimizerInstanceGroupCode" type="cis:OptimizerInstanceGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Optimizer Instance Group ID.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OptimizerInstanceGroupDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Optimizer Instance Group description.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the Optimizer Instance Group is active.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IsDefaultOptimizerInstanceGroupFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the Optimizer Instance Group will be considered as the default.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the Optimizer Instance Group was created.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the Optimizer Instance Group was last updated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created this Optimizer Instance Group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who most recently updated this Optimizer Instance Group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="OptimizerConstraintsGroupType">
                <xsd:annotation>
                    <xsd:documentation>
				An Optimizer Constraints Group.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OptimizerConstraintsGroupCode" type="cis:OptimizerConstraintsGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The optimizer constraints group code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OptimizerConstraintsGroupDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The description for this optimizer constraints group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time this optimizer constraints group was created.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time this optimizer constraints group was last updated.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created this optimizer constraints group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who last updated this optimizer constraints group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="OptimizerConstraintsGroupEntryType">
                <xsd:annotation>
                    <xsd:documentation>
				An Optimizer Constraints Group.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OptimizerConstraintsGroupEntryID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-assigned ID of the optimizer constraints group entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OptimizerConstraintsGroupCode" type="cis:OptimizerConstraintsGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The optimizer constraints group which this entry is a part of.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OptimizationConstraintsOverrideEnumVal" type="cis:OptimizationConstraintOverrideDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The domain value of the optimizer constraints override file.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OptimizationConstraintOverrideFileEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for optimizationConstraintsOverrideEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time this optimizer constraints group was created.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created this optimizer constraints group.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ReferenceNumberVisibilityType">
                <xsd:annotation>
                    <xsd:documentation>
			    A reference number visibility configuration entry.
			    This structure is read-only.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemReferenceNumberVisibilityID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The system generated ID of the reference number visibility entry.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EntityTypeCode" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Entity type code for the reference number visibility entry.
					Valid values are SHIPMENT,LOAD,TRIP,BOOKING and DOCK COMMITMENT.
					To retrieve the current (i.e. active) reference number visibility entry
					for one of these entity types,
					activeFlag should be required to be true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActiveFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the reference number visibility entry is current (i.e. active).
				</xsd:documentation>
