            <xsd:element name="getUserProfile">
                <xsd:complexType>
                    <xsd:annotation>
                        <xsd:documentation>
		Profile of a user.
		</xsd:documentation>
                    </xsd:annotation>
                    <xsd:sequence>
                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
			Operation header.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="CompatibilityMode" type="cis:UserProfileCompatibilityModeEnumValType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
			User profile may be returned with some alteration when compatibility mode is TMWEBUI.
			For example, units of measurement and currency will be taken from carrier or customer if user is carrier or customer.
			This is consistent with behavior of TM Web UI. When compatibility mode is RAW the values are returned without changes.
			By default compatibility mode is TMWEBUI.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="getUserProfileResponse">
                <xsd:complexType>
                    <xsd:annotation>
                        <xsd:documentation>
		Profile of a user.
		</xsd:documentation>
                    </xsd:annotation>
                    <xsd:sequence>
                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation> 
                                Indicates if the operation was successful. May contain a list of errors. 
                        </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ResponseHeader" type="cis:ResponseHeaderType">
                            <xsd:annotation>
                                <xsd:documentation>
			Indicates if the operation was successful. May contain a list of errors.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="User" type="cis:UserType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
			Information about user.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="UserGroup" type="cis:UserGroupType">
                            <xsd:annotation>
                                <xsd:documentation>
			Information about user group of user.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="findEntities">
                <xsd:complexType>
                    <xsd:annotation>
                        <xsd:documentation>
		Defines search criteria.
		</xsd:documentation>
                    </xsd:annotation>
                    <xsd:sequence>
                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
			Operation header.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="EntityType" type="cis:TMEntityEnumValType">
                            <xsd:annotation>
                                <xsd:documentation>
			Type of entities to select.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="Select" type="cis:SelectClauseType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
			List of fields to select.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="Filter" type="cis:FilterType" minOccurs="0" maxOccurs="unbounded">
                            <xsd:annotation>
                                <xsd:documentation>
			Filtering condition for entities to select.
			Designed to express simple constraints. When you need to express complex constraints then use Condition.
			Uses implicit AND for all child members.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="Condition" type="cis:NaryExprType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
			Filtering condition for entities to select.
			Uses implicit AND for all child members.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="OrderBy" type="cis:OrderByClauseType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
			Ordering condition.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="Page" type="cis:PageClauseType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
			Support for paging in UI. This element must populated from the response
			if you need to move to the next page.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="findEntitiesResponse">
                <xsd:complexType>
                    <xsd:annotation>
                        <xsd:documentation>
		A collection of find entities responses.
