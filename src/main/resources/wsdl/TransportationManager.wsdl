                            <xsd:documentation>
					Primary tariff/service selection and sorting criteria for routing.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrimaryRoutingSelectionMethodEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for PrimaryRoutingSelectionMethodEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SecondaryRoutingSelectionMethodEnumVal" type="cis:RoutingSelectionMethodEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Secondary tariff/service selection and sorting criteria for routing.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SecondaryRoutingSelectionMethodEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for SecondaryRoutingSelectionMethodEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultCarrierTypeCode" type="cis:CarrierDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The default type of the shipping service that a carrier provides.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultCarrierTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for DefaultCarrierTypeCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCode" type="cis:LanguageDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system language.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LanguageCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for LanguageCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The country code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultBarcodeTypeCode" type="cis:BarCodeDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The default bar code type used in bar code printing for a carrier.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultBarcodeTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for DefaultBarcodeTypeCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultShipmentConsolidationClassCode" type="cis:ConsolidationClassType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The default shipment consolidation class.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultFullAddressCheckEnumVal" type="cis:FullAddressCheckEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Default address validation level..
