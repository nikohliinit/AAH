            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VolumeUtilizationPercent" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The volume utilization percentage.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PiecesUtilizationPercent" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The pieces utilization percentage.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PalletsUtilizationPercent" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The pallets utilization percentage.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LadenLengthUtilizationPercent" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
