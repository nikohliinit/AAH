                            <xsd:documentation>
				Description for ChargeAmountSubtractionEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalRatingEngineVersionCode" type="cis:ExternalEngineVersionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The external rating engine version code. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffLookAheadBackEnumVal" type="cis:TariffLookAheadEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The tariff look ahead/back type. Values are LA_AHEAD, LA_BACK, LA_DISABLED. Optional. The default value is LA_AHEAD.  Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffLookAheadBackEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for tariffLookAheadBackEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnitAdjustmentFactorOperationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether unit adjustment factor operation is MULTIPLY (otherwise it is DIVIDE). Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnitAdjustmentFactorTimingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether unit adjustment factor timing is BEFORE (otherwise it is AFTER). Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BasedOnCarrierFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the tariff charge is Based on Carrier (Surcharge Based Rating). Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResponsibleCustomerEnumVal" type="cis:ResponsibleCustomerEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The responsible customer type.  Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResponsibleCustomerEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for responsibleCustomerEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResponsibleCustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The responsible customer code.  Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PayableCarrierEnumVal" type="cis:PayableCarrierEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The payable carrier type.  Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PayableCarrierEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for payableCarrierEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PayableCarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The payable carrier code.  Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyChargeAtTripLevelFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the tariff charge applies at trip level. Always false for taridd options. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeficitRatingFreightClassCode" type="cis:FreightClassCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight class code for deficit rating. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatesByDateFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the tariff charge requires dates for its rates. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IncludeInRatingUnitsForFreightAmountFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the charge detail amount should be included into freight amount for rating units or look-up units of other charge details. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeMaximumVariancePercentPositive" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum positive percentage difference allowed in match pay.
					Field is applicable to Carrier, Customer Specific Carrier, and Generic tariff. Ignored otherwise. 
					Ignored when chargeToleranceRequiredFlag is not true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeMaximumVarianceAmountPositive" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum positive dollar difference allowed in match pay.
					Field is applicable to Carrier, Customer Specific Carrier, and Generic tariff. Ignored otherwise. 
					Ignored when chargeToleranceRequiredFlag is not true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeMaximumVariancePercentNegative" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum negative percentage difference allowed in match pay.
					Field is applicable to Carrier, Customer Specific Carrier, and Generic tariff. Ignored otherwise. 
					Ignored when chargeToleranceRequiredFlag is not true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeMaximumVarianceAmountNegative" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum negative dollar difference allowed in match pay.
					Field is applicable to Carrier, Customer Specific Carrier, and Generic tariff. Ignored otherwise. 
					Ignored when chargeToleranceRequiredFlag is not true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeToleranceRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether matching tolerance limits are required at tariff charge level. 
					Field is applicable to Carrier, Customer Specific Carrier, and Generic tariff. Ignored otherwise. 
					Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreFreightClassCrossReferenceFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the contents of FreightClassCrossReference should be ignored.  If false during change, all existing FreightClassCrossReference members of this entity will be deleted and replaced with the contents of FreightClassCrossReference. Optional. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightClassCrossReference" type="cis:FreightClassCrossReferenceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The freight class cross-references of the tariff charge. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreEquipmentTypeCrossReferenceFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the contents of EquipmentTypeCrossReference should be ignored. If false during change, all existing EquipmentTypeCrossReference members of this entity will be deleted and replaced with the contents of EquipmentTypeCrossReference. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCrossReference" type="cis:TariffEquipmentTypeCrossReferenceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The equipment type cross-references of the tariff charge. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Tariff" type="cis:TariffType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated tariff.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffService" type="cis:TariffServiceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated tariff service.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TimeDataSourceEnumVal" type="cis:TimeDataSourceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Time Data Source.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TimeDataSourceEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Time Data Source.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplicabilityEnumVal" type="cis:ApplicabilityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					indicates the applicability of this tariff charge: All, Optimization, Execution; tariff charges with applicability of All are considered during both optimization and execution; tariff charges with applicability of Optimization are not considered during Execution; tariff charges with applicability of Execution are considered during Execution; also, consideration during Optimization of tariff charges with applicability of Execution is controlled by the strategy SetChargeApplicationMode.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplicabilityEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					indicates the applicability of this tariff charge: All, Optimization, Execution; tariff charges with applicability of All are considered during both optimization and execution; tariff charges with applicability of Optimization are not considered during Execution; tariff charges with applicability of Execution are considered during Execution; also, consideration during Optimization of tariff charges with applicability of Execution is controlled by the strategy SetChargeApplicationMode.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TariffLaneRateType">
                <xsd:annotation>
                    <xsd:documentation>
				A collection of rates for a given Tariff Lane.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="TariffID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system generated numerical tariff ID. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffCode" type="cis:TariffCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The tariff code. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffEffectiveDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tariff effective date. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffExpirationDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tariff expiration date. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The carrier code. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerCode" type="cis:CustomerCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The customer code. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MasterTariffID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The master tariff ID. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffAttributeEnumVal" type="cis:TariffAttributeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tariff attribute. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    A description of the tariff. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffDivision" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The division ID of the Tariff. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffGroup" type="cis:TariffGroupDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tariff group. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateTypeEnumVal" type="cis:RateTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The rate type. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffStatusEnumVal" type="cis:TariffStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tariff status. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The tariff service code. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RestrictedUseFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the access to tariff service is restricted. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    A description of the tariff service. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceRestriction" type="cis:RestrictionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The restriction data for the Tariff Service. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    A description of the tariff charge. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RangeCode" type="cis:RangeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Range code. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffChargeCode" type="cis:ChargeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Tariff Charge code. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightClassCode" type="cis:FreightClassCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Freight Class code. Mandatory if multiple freght classes are supported by the tariff charge.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Equipment Type code. Mandatory if rates specific for equipment type are supported by the tariff charge.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BaseChargeAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The base charge. Cannot be an empty element.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumChargeAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The minimum charge. Cannot be an empty element.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumChargeAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The maximum charge. Cannot be an empty element.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfRateRanges" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The number of Rate Ranges. Read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateCode" type="cis:RateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Rate Code. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateCreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created the rate. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateCreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the rate was created. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The rating currency for the rate. Cannot be blank. Used for Create only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateEffectiveDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Effective Date for the rate.
                    Cannot be specified if the Tariff Charge is not enabled for Rates by Date.
                    Mandatory for Update if the Tariff Charge is enabled for Rates by Date.
                    Mandatory for Create if the Tariff Charge is enabled for Rates by Date and other rates exist for
                    the same tariff / service / charge / freight class / equipment type.
                    Cannot be an empty element.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateExpirationDate" type="xsd:date" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Expiration Date for the rate.
                    Cannot be specified if the Tariff Charge is not enabled for Rates by Date.
                    Mandatory for Update if the Tariff Charge is enabled for Rates by Date.
                    Mandatory for Create if the Tariff Charge is enabled for Rates by Date and other rates exist for
                    the same tariff / service / charge / freight class / equipment type.
                    Cannot be an empty element.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateUpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who updated the rate. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateUpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the rate was updated. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system generated numerical Rate ID. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					This field is currently inactive.			
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneDivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division code. Mandatory unless it can be derived from user profile, tariff lane rate template or tariff.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The origin zone ID. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The destination zone ID. Mandatory.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCode" type="cis:CommodityCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The commodity code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneTemplateCode" type="cis:LaneTemplateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Lane Template code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationCountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The destination country code. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DestinationState" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The destination state or province code. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneCreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who created the Lane. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneCreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time that the Lane was created. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneRestriction" type="cis:RestrictionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The restriction data for the Lane. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneStatusEnumVal" type="cis:LaneStatusEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The status of the Lane.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneExcludeFromAutoTenderingOverrideEnumVal" type="cis:AutoTenderingOverrideEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates if Exclude from Carrier Sequential Tendering should be enabled or disabled specifically for this Lane.
                    Ignored for customer tariffs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneAutoAcceptTenderOverrideEnumVal" type="cis:AutoAcceptTenderOverrideEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates if Tender Auto-Accept should be enabled or disabled specifically for this Lane.
                    Ignored for customer tariffs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneCarrierPerformanceEnabledFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the Carrier Performance is enabled. Optional. Ignored for customer tariffs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneServiceGradeCode" type="cis:ShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The grade for the service provided by the carrier. It is also called Carrier Performance.
                    Its value can be set only when the Carrier Performance Enabled flag is set.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneOptimizationControlEnumVal" type="cis:OptimizationControlEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates if the lane will be excluded from optimization.
                    Ignored for customer tariffs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneFreightAuctionEligibilityEnumVal" type="cis:FreightAuctionEligibilityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Type of freight auction eligibility.
                    Ignored for customer tariffs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneUpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who updated the Lane. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneUpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time that the Lane was updated. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginCountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The origin country code. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginState" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The origin state or province code. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					This field is currently inactive.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreRateRangesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    for Update only, indicates whether the contents of RateRange should be ignored; true by default.
                    Not applicable for other operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateRange" type="cis:RateRangeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The Rate Ranges of the Rate.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffLaneRateTemplateCode" type="cis:TariffLaneRateTemplateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Tariff Lane Rate Template code. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TariffLaneRateTemplateType">
                <xsd:annotation>
                    <xsd:documentation>
                A rate-lane template to be used in tariff setup.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffLaneRateTemplateCode" type="cis:TariffLaneRateTemplateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Tariff Lane Rate Template ID.
                    Mandatory for a new entry. Used to identify an existing entry.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffLaneRateTemplateDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Tariff Lane Rate Template description.
                    Mandatory for a new entry. Cannot be blank.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeAmountRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether zero is an acceptable amount for rate charges and rate range charges.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The division the entry is restricted to.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeCode" type="cis:ChargeCodesType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    An comma-separated list of master charge codes used identify tariff rates.Mandatory for a new entry. Cannot be blank.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RangeCode" type="cis:RangeCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The range ID. Mandatory for a new entry. Cannot be blank.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultZoneGroupCode" type="cis:ZoneGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The default Zone Group ID.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultSystemTariffLaneID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The default system-generated Tariff Lane ID.
                    Blank string (double-quoted space) should be provided if the value needs to be cleared.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DefaultRestrictionTemplateCode" type="cis:RestrictionTemplateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The default restriction template code.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The ID of the user who created the entry. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the user who last updated the entry.
                    This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The date and time when the Lane was created.
				    This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The date and time when the Lane was last updated.
                    This is a read-only field.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    If specified, used as a restriction for available charges and as a background filter criteria.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TariffEntityType">
                <xsd:annotation>
                    <xsd:documentation>
			A collection of entities for Tariff Setup.
			Only one type of the subsequent type-specific tariff entity collections
			is allowed at a time for creation, modification or deletion.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="TariffService" type="cis:TariffServiceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of tariff services.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffCharge" type="cis:TariffChargeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of tariff charges.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffServiceEquipment" type="cis:TariffServiceEquipmentType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of tariff service equipment types.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockSelectionConstraint" type="cis:DockSelectionConstraintType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of tariff service or tariff lane dock selection constraints.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffRateCode" type="cis:TariffRateCodeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of rate codes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Rate" type="cis:RateType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of individual tariff rates.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Lane" type="cis:LaneType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of lanes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceSurcharge" type="cis:ServiceSurchargeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of service surcharges.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeSurcharge" type="cis:ChargeSurchargeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of charge surcharges.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateSurcharge" type="cis:RateSurchargeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of rate surcharges.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LaneTemplate" type="cis:LaneTemplateType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				A collection of lane templates.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FuelSurchargeEquivalentTariffCharge" type="cis:FuelSurchargeEquivalentTariffChargeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					A collection of fuel surcharge equivalent tariff charges.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FuelSurchargePrice" type="cis:FuelSurchargePriceType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					A collection of fuel surcharge prices.
					Currently, the collection cannot have more than one element.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffLaneRateTemplate" type="cis:TariffLaneRateTemplateType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    A collection of tariff lane-rate templates.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffLaneRate" type="cis:TariffLaneRateType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                            A collection of tariff lane-rates.
                        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TariffRateCodeType">
                <xsd:annotation>
                    <xsd:documentation>
			A Rate Code.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
					The character ^ is used as a separator for the compound key.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The tariff ID. Cannot be changed for an existing Rate Code.
				Mandatory unless the data are used to create new tariff.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateCode" type="cis:RateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The rate code. Cannot be changed for an existing Rate Code.
				               Mandatory for creation, modification or deletion of a Rate Code.
				               Ignored when querying Rate Codes.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateCodeDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the Rate Code.
				Mandatory for a new Rate Code. Cannot be blank. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who created the Rate Code. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who updated the Rate Code. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the Rate Code was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the Rate Code was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreRatesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of rate should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Rate" type="cis:RateType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The rates of the Rate Code. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Tariff" type="cis:TariffType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated tariff.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TariffServiceType">
                <xsd:annotation>
                    <xsd:documentation>
			A Tariff Service.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
					The character ^ is used as a separator for the compound key.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The tariff ID. Cannot be changed for an existing Tariff Service.
				Mandatory unless the data are used to create new tariff.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The tariff service code. Cannot be changed for an existing Tariff Service.
				                         Mandatory for creation, modification or deletion of a Tariff Service.
				                         Ignored when querying Tariff Services.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A description of the tariff service. Mandatory for a new Tariff Service.
				Cannot be an empty element. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalServiceTypeCode" type="cis:ExternalServiceDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The External Service Type. Optional. Updatable. Valid values defined in system domain table.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalServiceTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for ExternalServiceTypeCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLTypeCode" type="cis:GLDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The G/L type.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GLTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for GLTypeCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AccruedExpenseOrRevenueGLAccountNumber" type="cis:GLAccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The accrued expense/revenue G/L account number. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AccruedLiabilityOrAssetGLAccountNumber" type="cis:GLAccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The accrued liability/asset G/L account number. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExpenseOrRevenueGLAccountNumber" type="cis:GLAccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The expense/revenue G/L account number. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LiabilityOrAssetGLAccountNumber" type="cis:GLAccountNumberType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The liability/asset G/L account number. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BaseChargeAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The base charge. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MinimumChargeAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The minimum charge. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumChargeAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The maximum charge. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TaxableChargeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether charges are taxable. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RestrictedUseFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the access to tariff service is restricted. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierConsolidatedRatingControlEnumVal" type="cis:CarrierConsolidationEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The consolidated rating control for carrier tariffs. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierConsolidatedRatingControlEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for carrierConsolidatedRatingControlEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GeographicLevelOfPrecisionEnumVal" type="cis:GeographicPrecisionLevelEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The geographic level of precision for consolidated rating. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GeographicLevelOfPrecisionEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for geographicLevelOfPrecisionEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerConsolidatedRatingControlEnumVal" type="cis:CustomerConsolidationEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The consolidated rating control for customer tariffs. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerConsolidatedRatingControlEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for customerConsolidatedRatingControlEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrintLabelFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether labels should be printed. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrintBOLFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether BOL should be printed. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AllowStopsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether stops are allowed. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TeamDriverFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether team driver situation applies. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrePurchasedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether pre-purchased situation applies. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ApplyDiscountOrSurchargeToMinimumOrMaximumFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether discount/surcharge applies to minimum/maximum. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssignToLoadFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether shipments can be assigned to loads. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AutoAcceptTenderFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether tender should be accepted automatically. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FaxTenderDistributionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether tender notification should be distributed by fax. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EmailTenderDistributionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether tender notification should be distributed by e-mail. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventNotificationTenderDistributionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether tender notification should be distributed by Event Notification. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrackingNumberLevelEnumVal" type="cis:TrackingLevelEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The tracking number level. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrackingNumberLevelEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for trackingNumberLevelEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContainerTrackingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether container tracking is enabled. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ManifestLoadGroupCode" type="cis:ManifestLoadGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The manifest load group code. Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SchedulingMethodEnumVal" type="cis:SchedulingMethodEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The scheduling method. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SchedulingMethodEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for schedulingMethodEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DeliveryScheduleCode" type="cis:DeliveryScheduleCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The delivery schedule code.Optional. Updatable.
				Mandatory only when SchedulingMethodEnumVal is SM_SYS_DLVY_SCHD, otherwise must be empty. 
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalDeliveryScheduleEngineVersion" type="cis:ExternalEngineVersionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The external delivery schedule engine version. 
				Mandatory only when SchedulingMethodEnumVal is SM_EXTL_DLVY_SCHD, otherwise must be empty. 
				Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExcludeFromAutoTenderingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether a load with this tariff service should be excluded from carrier sequential tendering. Cannot be blank. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExcludeFromOptimizationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether this tariff service should be excluded from optimization. Cannot be blank. Updatable.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeekendHolidaySchedulingEnumVal" type="cis:WeekendHolidaySchedulingEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The weekend holiday scheduling level. Optional. Updatable.
                                This field and businessHours will be updated only when tariff is not customer generic tariff.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeekendHolidaySchedulingEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for weekendHolidaySchedulingEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightAuctionEligibilityEnumVal" type="cis:FreightAuctionEligibilityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Type of freight auction eligibility. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightAuctionEligibilityEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for FreightAuctionEligibilityEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceTransitTimeOverridesExistFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                	Indicates whether distance and transit time overrides exist for the Tariff Service.
                	This field is read-only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="GenerateDockCommitmentsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether dock commitments will be generated during optimization. Cannot be blank. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AssignToBookingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether tendering should be allowed for a booking only. Cannot be blank. Updatable.
					Ignored for customer tariffs and planning tariffs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingServiceEnumVal" type="cis:BookingServiceEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Type of booking service. Updatable. Mandatory if AssignToBookingFlag is true for a Tariff Service.
					Ignored for customer tariffs and planning tariffs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BookingServiceEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for BookingServiceEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockSelectionConstraintDefinedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether any dock selection constraint is defined for this tariff service. Read only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceMaximumVariancePercentPositive" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum positive percentage difference allowed in match pay.
					Field is applicable to Carrier, Customer Specific Carrier, and Generic tariff. Ignored otherwise. 
					Ignored when serviceToleranceRequiredFlag is not true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceMaximumVarianceAmountPositive" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum positive dollar difference allowed in match pay.
					Field is applicable to Carrier, Customer Specific Carrier, and Generic tariff. Ignored otherwise. 
					Ignored when serviceToleranceRequiredFlag is not true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceMaximumVariancePercentNegative" type="cis:PercentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum negative percentage difference allowed in match pay.
					Field is applicable to Carrier, Customer Specific Carrier, and Generic tariff. Ignored otherwise. 
					Ignored when serviceToleranceRequiredFlag is not true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceMaximumVarianceAmountNegative" type="cis:DollarType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The maximum negative dollar difference allowed in match pay.
					Field is applicable to Carrier, Customer Specific Carrier, and Generic tariff. Ignored otherwise. 
					Ignored when serviceToleranceRequiredFlag is not true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceToleranceRequiredFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether matching tolerance limits are required at tariff service level. 
					Field is applicable to Carrier, Customer Specific Carrier, and Generic tariff. Ignored otherwise. 
					Mandatory. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CustomerFreightAuthorizationToleranceFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether matching tolerance limits are defined at customer freight authorization level. 
					Field is applicable to Carrier, Customer Specific Carrier, and Generic tariff. Ignored otherwise. 
					Ignored when serviceToleranceRequiredFlag is not true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumDistanceControlEnumVal" type="cis:TariffServiceMaximumDistanceControlEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Controls which stop maximum distance is enforced by Optimizer when qualifying candidate shipment legs to be added to a load.
                    Ignored for customer tariffs and planning tariffs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumDistanceControlEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for MaximumDistanceControlEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumDistanceForPick" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Used by Optimizer to exclude shipment legs with origin location too far from any pick or pick/drop stop when adding shipment legs to existing loads.
                    Expressed in tariff distance unit of measure.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumDistanceForDrop" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Used by Optimizer to exclude shipment legs with destination location too far from any drop or pick/drop stop when adding shipment legs to existing loads.
                    Expressed in tariff distance unit of measure.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumHoursForEarlierLoadStart" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Used by Optimizer to exclude shipment legs causing the load to start too early when adding shipment legs to existing loads.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MaximumHoursForLaterLoadArrival" type="cis:HoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Used by Optimizer to exclude shipment legs causing the load to end too late when adding shipment legs to existing loads.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InternalSchedulingEnumVal" type="cis:InternalSchedulingEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates if scheduling for internal activities is required.
                    Ignored for customer tariffs and planning tariffs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InternalSchedulingEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for InternalSchedulingEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="BusinessHours" type="cis:BusinessHoursType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                        The business hours (holiday exceptions) of the delivery schedule.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the Tariff Service was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the Tariff Service was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who created the Tariff Service. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who updated the Tariff Service. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreRestrictionFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of Restriction should be ignored.  If false during change, all existing  Restriction members of this entity will be deleted and replaced with the contents of Restriction. Optional. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Restriction" type="cis:RestrictionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The restriction data for the Tariff Service. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentAvailability" type="cis:EquipmentAvailabilityType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The equipment availability constraints.
                    The fields are not supposed to be used,
                    input is accepted only in some cases for backward compatibility.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreTariffChargeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of TariffCharge should be ignored.   If false during change, all existing TariffCharge members of this entity will be deleted and replaced with the contents of TariffCharge. Optional. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffCharge" type="cis:TariffChargeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The tariff charges. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreTariffServiceEquipmentFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of TariffServiceEquipment should be ignored.  If false during change, all existing TariffServiceEquipment members of this entity will be deleted and replaced with the contents of TariffServiceEquipment.  Optional. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffServiceEquipment" type="cis:TariffServiceEquipmentType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The equipment associated with this service.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreContactsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of contactPerson should be ignored. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ContactPerson" type="cis:ContactPersonType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
Contacts associated with the Tariff Service. Presence depends on the value of ignoreContactsFlag.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreTariffServiceCEAGroupingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of TariffServiceCEAGrouping should be ignored.  If false during change, all existing TariffServiceCEAGrouping members of this entity will be deleted and replaced with the contents of TariffServiceCEAGrouping.  Optional. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffServiceCEAGrouping" type="cis:TariffServiceCEAGroupingType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The CEA grouping entries associated with this service.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreDockSelectionConstraintFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether the contents of DockSelectionConstraint should be ignored.  If false during change, all existing DockSelectionConstraint members of this entity will be deleted and replaced with the contents of DockSelectionConstraint.  Optional. May be present for add and change operations.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockSelectionConstraint" type="cis:DockSelectionConstraintType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The dock selection constraint entries associated with this service.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreEquipmentAvailabilityDateRangeFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of EquipmentAvailabilityDateRange should be ignored. May be present for add and change operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentAvailabilityDateRange" type="cis:EquipmentAvailabilityDateRangeType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Equipment availability constraints for a date range.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Tariff" type="cis:TariffType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated tariff.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffServiceTripResourceUsageEnumVal" type="cis:TariffServiceTripResourceUsageEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates how resources are consumed by the trip: one per trip, one per load on the trip lane, one per load on each load lane; applicable to trip routing/rating only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffServiceTripResourceUsageEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for TariffServiceTripResourceUsageEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateTypeEnumVal" type="cis:RateTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates how loads on a trip are to be routed: point-to-point, round-trip; applicable to trip routing/rating only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for RateTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadRatingForLoadsOnTripsFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					 When 'true', trip rating will identify the lane/rate code for each load on the trip and use that rate code when rating that load; if 'false', trip rating will find a single lane/rate code for the entire trip and use that rate code when rating each load on the trip; applicable to trip routing/rating only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadDimensionsAsLookupFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					 When 'true', trip rating will use the load s dimensions/characteristics as the Lookup Units and Net Effect Units when rating a load on a trip; if 'false', rating will use the trip s dimensions/characteristics as the Lookup Units and Net Effect Units; trip rating will always use the load s dimensions/characteristics as the Rating Units when rating individual loads and will always use trip level values as Rating Units for trip level charges; applicable to trip routing/rating only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PointToPointCalculationForOutOfRouteAndDirectFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					 if 'true', then rating will compute Out-of-Route and Direct distance individually for each load on a point-to-point basis; values for each load will be aggregated at trip level; if 'false', (corresponds to existing functionality) Out-of-Route and Direct distance will be computed only at trip level based on the lane for the trip; applicable to trip routing/rating only.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TariffServiceCEAGroupingType">
                <xsd:annotation>
                    <xsd:documentation>
				A CEA Grouping entry for a Tariff Service.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTariffServiceCEAGroupingID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Tariff Service CEA Grouping ID. Cannot be changed for an existing Tariff Service CEA Grouping.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The tariff ID. Cannot be changed for an existing Tariff Service CEA Grouping.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The tariff service code. Cannot be changed for an existing Tariff Service CEA Grouping.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CEAGroupingTypeCode" type="cis:CEAGroupingDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The CEA Grouping Type. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CEAGroupingTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Description for CEAGroupingTypeCode. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the Tariff Service CEA Grouping was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time when the Tariff Service CEA Grouping was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who created the Tariff Service CEA Grouping. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the user who updated the Tariff Service CEA Grouping. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Tariff" type="cis:TariffType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Associated tariff.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffService" type="cis:TariffServiceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Associated tariff service.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TariffServiceEquipmentType">
                <xsd:annotation>
                    <xsd:documentation>
			A Tariff Service Equipment Type.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffServiceEquipmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The Tariff Service Equipment Type ID. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The equipment type code. Cannot be changed for an existing Tariff Service Equipment Type.
				                         Mandatory for creation, modification or deletion of a Tariff Service Equipment Type.
				                         Ignored when querying Tariff Service Equipment Types.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    A description of the equipment type. Applicable only for UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The tariff ID. Cannot be changed for an existing Tariff Service Equipment Type.
				Mandatory unless the data are used to create new tariff.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The tariff service code. Cannot be changed for an existing Tariff Service Equipment Type.
				                         Mandatory for creation, modification or deletion of a Tariff Service Equipment Type.
				                         Ignored when querying Tariff Service Equipment Types.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Priority" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Equipment Type Priority for Tariff Service. Must be a positive number.
				Mandatory for a new Tariff Service Equipment Type. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ZoneCode" type="cis:ZoneCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The Zone of Operation. Optional. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the Tariff Service Equipment Type was created. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The date and time that the Tariff Service Equipment Type was updated. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CreatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who created the Tariff Service Equipment Type. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdatedByUserCode" type="cis:UserCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
The ID of the user who updated the Tariff Service Equipment Type. This is a read-only field.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RestrictionExistFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether there are Restriction data.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Restriction" type="cis:RestrictionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The restriction data for the Tariff Service Equipment Type. Required. Updatable.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Tariff" type="cis:TariffType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Associated tariff.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TariffService" type="cis:TariffServiceType" minOccurs="0">
                        <xsd:annotation>
