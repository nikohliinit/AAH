                    <xsd:element name="FriBusinessHours2Open" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The second of four time ranges that the entity opens on Fridays.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FriBusinessHours2Close" type="xsd:time" minOccurs="0">
