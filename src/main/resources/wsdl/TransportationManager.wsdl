            <xsd:complexType name="findEntitiesType">
                <xsd:annotation>
                    <xsd:documentation>
		Defines search criteria.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Operation header.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EntityType" type="cis:TMEntityEnumValType">
                        <xsd:annotation>
                            <xsd:documentation>
			Type of entities to select.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Select" type="cis:SelectClauseType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			List of fields to select.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Filter" type="cis:FilterType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
			Filtering condition for entities to select.
			Designed to express simple constraints. When you need to express complex constraints then use Condition.
			Uses implicit AND for all child members.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Condition" type="cis:NaryExprType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Filtering condition for entities to select.
			Uses implicit AND for all child members.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OrderBy" type="cis:OrderByClauseType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Ordering condition.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Page" type="cis:PageClauseType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Support for paging in UI. This element must populated from the response
			if you need to move to the next page.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="findChildEntitiesType">
                <xsd:annotation>
                    <xsd:documentation>
		Allows to get collecting of entities that are children of a specified parent.
		Supports filtering, pagination,
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Operation header.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EntityType" type="cis:TMEntityEnumValType">
                        <xsd:annotation>
                            <xsd:documentation>
			Type of the parent entity.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Collection" type="cis:RetrieveChildCollectionType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Defines child collection in context of a parent entity.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			ID of the parent entity.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="getEntityType">
                <xsd:annotation>
                    <xsd:documentation>
		Defines what entity to load.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Operation header.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EntityType" type="cis:TMEntityEnumValType">
                        <xsd:annotation>
                            <xsd:documentation>
			Type of entities to select.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Select" type="cis:SelectClauseType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
