            <input message="cis:processMaintainEntityAttachment"/>
            <output message="cis:processMaintainEntityAttachmentResponse"/>
            <fault name="CISFault" message="cis:OperationException"/>
        </operation>
        <operation name="addEntity">
            <documentation>Create business entities which include: load-ats, consignees, distribution centers, hubs, docks, carriers, customers, zones, geographic areas, item groups, item masters, NMFCs, equipment types, domiciles, users, user groups, domicile vehicle availability, domicile equipment, container types, container type groups, incoterms, lane availability, distance/transit time overrides, master services, master charges, ranges, reference number qualifiers, states/provinces, event reasons, event status reason code associations, alert watch groups, currencies, exchange rate groups, exchange rates, location throughput groups, location throughput group capacity, booking revision rules, commodities, alternate language entity descriptions, equipment capacity degradation, loading types, item loading factors, item package levels, skeleton routes, variable loading unloading buffers, itinerary templates, G/L account designations and integration locations. The type of the entities to be created is specified in the request. The transaction may fail if Transportation Manager is unavailable, or if there is an error in the request. An error message will be published on the front bus.</documentation>
            <input message="cis:addEntity"/>
            <output message="cis:addEntityResponse"/>
            <fault name="CISFault" message="cis:OperationException"/>
        </operation>
