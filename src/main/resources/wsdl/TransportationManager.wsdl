            <xsd:element name="processScheduleRunRequestHold">
                <xsd:complexType>
                    <xsd:annotation>
                        <xsd:documentation>
                        Put scheduled batch run requests on hold.
                        </xsd:documentation>
                    </xsd:annotation>
                    <xsd:sequence>
                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                Operation header.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="HoldSameJobFlag" type="xsd:boolean" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                                  This flag controls whether to hold other requests with the same job name if the job name
                                  of the current request is not empty.
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="RequestID" type="cis:KeyStringType" maxOccurs="unbounded">
