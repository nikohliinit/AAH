                        </xsd:element>
                        <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
			ID of the entity to select. If entity does not have unique ID (like CityType)
			then use findEntities operations.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="getEntityResponse">
                <xsd:complexType>
                    <xsd:annotation>
                        <xsd:documentation>
		Returnes exactly one entity.
		</xsd:documentation>
                    </xsd:annotation>
                    <xsd:sequence>
                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation> 
                                Indicates if the operation was successful. May contain a list of errors. 
                        </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ResponseHeader" type="cis:ResponseHeaderType">
                            <xsd:annotation>
                                <xsd:documentation>
			Indicates if the operation was successful. May contain a list of errors.
			</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
