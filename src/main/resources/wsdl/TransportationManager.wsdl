                            <xsd:documentation>
                    Indicates whether resource constraints such as equipment availability and lane constraints are applied.
                    Not applicable for A/R Rate Quotation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResourceProjectTypeCode" type="cis:ResourceProjectIDDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The Resource Project ID.
                    Not applicable for A/R Rate Quotation.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ResourceProjectTypeCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for ResourceProjectTypeCode. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A memo associated with the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightByFreightClass" type="cis:WeightByFreightClassType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
				The weight by freight classes associated with the rate quotation.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ARRatingInformation" type="cis:RatingInformationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A/R rating information.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="APRatingInformation" type="cis:RatingInformationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A/P rating information.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RateQuotationItineraryPoint" type="cis:RateQuotationItineraryPointType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
