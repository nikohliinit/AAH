            <xsd:element name="processScheduleRunRequestUpdateResponse">
                <xsd:complexType>
                    <xsd:annotation>
                        <xsd:documentation>
			A collection of Schedule Run Request Update responses.
			</xsd:documentation>
                    </xsd:annotation>
                    <xsd:sequence>
                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
