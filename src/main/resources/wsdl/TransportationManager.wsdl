                    Notes to be added for this shipment.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UnitsMandatoryFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether units is required when creating shipment details. 
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="VolumeMandatoryFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether volume is required when creating shipment details. 
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SplitMethodEnumVal" type="cis:SplitMethodEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The shipment split method.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SplitMethodEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Description for splitMethodEnumVal. Read-only. Available only through UI-oriented APIs.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SplitReviewEnumVal" type="cis:SplitShipmentReviewEnumValType" minOccurs="0">
