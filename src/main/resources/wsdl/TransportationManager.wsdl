                        <xsd:annotation>
                            <xsd:documentation>
            The set of charges associated with the load. These are not returned if the load is retrieved as a condensed load, or if the caller has not requested charges and the compute charges argument is false.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ChargeOverrides" type="cis:ChargeOverrideType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                An override to a charge.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCost" type="cis:ExternalCostType" minOccurs="0" maxOccurs="unbounded">
