								</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DroppedTareWeight" type="cis:SumOfWeightType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
									Total tare weight of the dropped shipments at the stop. Expressed in base system units of measure.
								</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DroppedPieces" type="cis:QuantityExType" minOccurs="0">
