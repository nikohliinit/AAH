                            <xsd:documentation>
            The shipment legs attached to the load.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Stop" type="cis:StopType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
            The stops within the load. These are returned in delivery order
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
