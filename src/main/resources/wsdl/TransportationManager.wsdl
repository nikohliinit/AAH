                        <xsd:annotation>
                            <xsd:documentation>
                                Pick-Up Arrival reason description. Applicable only for UI-oriented APIs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PickupDepartureSEC" type="cis:SECCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Pick-Up departure reason code.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PickupDepartureEventReasonDesc" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
