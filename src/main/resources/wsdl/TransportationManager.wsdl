            The minimum order value. This is a read-only field.
            Expressed in shipment input currency.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DiscountAmount" type="cis:DollarWithNegativeType" minOccurs="0">
