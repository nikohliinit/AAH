                            <xsd:documentation>
            The actual carrier and service for this load, if using a virtual carrier such as NTE.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActualChargedAmount" type="cis:DollarWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The actual charged amount for this load, if using a virtual carrier such as NTE.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActualCurrencyType" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The actual currency type for this load, if using a virtual carrier such as NTE.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActualCurrencyTypeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Description for actualCurrencyType. Read-only. Available only through UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DriverCode" type="cis:DriverIdType" minOccurs="0">
