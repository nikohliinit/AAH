                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InternalDockScheduleStatusEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Description for InternalDockScheduleStatusEnumVal. Read-only. Available only through UI-oriented APIs.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CountOfShipments" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The total number of picked and dropped shipments for the stop. Read-only.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Appointment" type="cis:AppointmentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Appointment of the stop.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Trip" type="cis:TripType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The trip or booking this stop is on.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SkeletonRoute" type="cis:SkeletonRouteType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The skeleton route the stop is associated with.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierETADateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Estimated date/time of arrival at the stop location reported by carrier (in local time zone for the stop location).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierETAReportedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The reported date and time of carrier ETA (in local time zone for the stop location).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionModeLoadingHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The loading time based on reported information.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionModeUnloadingHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The unloading time based on reported information.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionModeWaitingHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The waiting time based on reported information.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExecutionModeWeekendHolidayBreakHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The weekend/holiday break time based on reported information.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierETALastComputedDifferenceTimeHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Computed value (in hours) represents the difference between CarrierETADateTime and EarliestToPickupDateTime (for pick stops) or EarliestToDeliveryDateTime (for pick/drop and drop stops); a positive value indicates the ETA is later than at least one shipment window serviced at this stop; a negative value indicates the ETA is earlier than at least one shipment window serviced at this stop.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActualArrivalLastComputedDifferenceTimeHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Computed value (in hours) represents the difference between PickupArrivalDateTime (for pick stops) or DeliveryArrivalDateTime (for pick/drop and drop stops) and LastComputedArrivalDateTime; a positive value indicates the reported arrival was later than planned; a negative value indicates the reported arrival was earlier than planned.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastComputedPlannedComputedDifferenceTimeHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Computed value (in hours) represents the difference between LastComputedArrivalDateTime and ActualDateTimeOfArrival; a positive value indicates computed arrival is later than planned; a negative value indicates computed arrival is earlier than planned.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastComputedAppointmentStartDifferenceTimeHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Computed value represents the difference between LastComputedArrivalDateTime and AppointmentFromDateTime for stops having an appointment; a positive value indicates the stop appointment is later than the planned arrival; a negative value indicates the stop appointment is earlier than the planned arrival.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastComputedShipmentPickupDifferenceTimeHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Computed value represents a duration (in hours) by which the last computed arrival time falls outside shipment pickup windows for the stop; a negative value indicates arrival occurs before at least one shipment pickup window opens; a positive value indicates arrival after the end of at least one shipment pickup window closes; zero indicates arrival occurs within the pickup window for all shipments on the stop.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastComputedShipmentDeliveryDifferenceTimeHours" type="cis:HoursWithNegativeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Computed value represents a duration (in hours) by which the last computed arrival time falls outside shipment delivery windows for the stop; a negative value indicates arrival occurs before at least on shipment delivery window opens; a positive value indicates arrival after the end of at least one shipment delivery window closes; zero indicates arrival occurs within the delivery window for all shipments on the stop.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierETDDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Estimated date/time of departure at the stop location reported by carrier (in local time zone for the stop location).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierETDReportedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The reported date and time of carrier ETD (in local time zone for the stop location).
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDockCommitmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The dock commitment ID for this stop; this commitment always has stop appointment associated
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="StopAppointmentType">
                <xsd:annotation>
                    <xsd:documentation>
			Details of the Stop appointment.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Internal ID. Applicable only for UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopIDTypeEnumVal" type="cis:StopIdTypeEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The type of stop identification. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The load ID or reference number. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The load tracking number. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MasterBillOfLadingNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The master BOL number. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IDsAreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				  Indicates whether the supplied IDs are load IDs or load reference numbers. If you use reference numbers for identification, they must be unique across all loads. If a supplied reference number is attached to two or more loads, this will generate an error. 	    Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SearchReferenceNumberType" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				 Reference number type by which stop can be identified.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The value of the reference number or code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemStopID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the stop. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The position of the stop within the sequence of stops of the load. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the shipping point of the stop. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The type of shipping point for the stop. Optional.
					If not specified and shippingLocationCode is specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Description for shippingLocationTypeEnumVal. Read-only. Available only through UI-oriented APIs.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="AppointmentDeleteFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether the appointment is supposed to be deleted. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Appointment" type="cis:AppointmentType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The appointment details. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="StopAppointmentEventType">
                <xsd:annotation>
                    <xsd:documentation>
			Details of the Stop appointment event - create only.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemStopID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The stop ID of the appointment the event is for. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventReasonCode" type="cis:EventCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Event reason code for this appointment event. Mandatory.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MovementDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The date and time of the event. Mandatory. 
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventText" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
								Free form text in Events describing reason codes.Optional.								
							</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="StopArrivalDepartureDataType">
                <xsd:annotation>
                    <xsd:documentation>
				An event that describes the arrival and departure times and events for a stop.
				The stop should be identified by shippingLocationCode and possibly shippingLocationTypeEnumVal,
        		or by just stopSequenceNumber.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
        The ID of the shipping point of the stop. Either ShippingLocationCode together with ShippingLocationTypeEnumVal  or StopSequenceNumber must be specified.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The type of shipping point for the stop.
					If not specified and shippingLocationCode is specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopSequenceNumber" type="cis:UnsignedLongType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
        The position of the stop within the sequence of stops of the load. Mandatory if ShippingLocationCode and ShippingLocationCodeType are not specified.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopTypeEnumVal" type="cis:SimpleStopEnumValType">
                        <xsd:annotation>
                            <xsd:documentation>
        The type of stop - PICK or DROP. Mandatory.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ArrivalDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
        The date and time of the arrival at the stop (in the Stop timezone). Optional.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ArrivalEventCode" type="cis:SECCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
        The arrival event code. Optional.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DepartureDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
        The date and time of the departure at the stop (in the Stop timezone). Optional.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DepartureEventCode" type="cis:SECCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
        The departure event code. Optional.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdateStatusFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
			Indicates whether to update the relevant statuses of stop, shipment legs, load within the transaction. Default value is 'true'. When it is false, only an event is generated and statuses are not updated.
		</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="StopConfirmType">
                <xsd:annotation>
                    <xsd:documentation>
				A request to confirm a stop.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the load containing the stop to be confirmed. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemStopID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The ID of the stop to be confirmed.
                    Mandatory if neither ShippingLocationCode nor StopSequenceNumber is specified, not allowed otherwise.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The shipping location ID of the stop.
                    Mandatory if neither SystemStopID nor StopSequenceNumber is specified, not allowed otherwise.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location type.
					If not specified and ShippingLocationCode is specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The stop sequence number.
                    Mandatory if neither SystemStopID nor ShippingLocationCode is specified, not allowed otherwise.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier code for the load. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCode" type="cis:ServiceCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The service code for the load. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The trailer equipment type code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TractorEquipmentTypeCode" type="cis:EquipmentCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The tractor equipment type.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The tractor domicile code.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DomicileTrailerCode" type="cis:DomicileCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The trailer domicile code.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MasterBillOfLadingNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The master BOL number to be used when generating the master BOL. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipConfirmDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipment confirmation date and time. Optional. The default value is the scheduled date of the stop.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PrintMasterBillOfLadingFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether to print a master BOL. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SECInformation" type="cis:SECInformationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The service event code information. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="StopConfirmReversalType">
                <xsd:annotation>
                    <xsd:documentation>
			Data for Stop Confirmation Reversal.
		</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the load containing the stop for confirmation reversal. Mandatory.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemStopID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The ID of the stop for confirmation reversal.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipping location code.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location type.
					If not specified and shippingLocationCode is specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The stop sequence number.
			</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SECInformation" type="cis:SECInformationType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The Reason Code information. Optional.
					Note that only SECCode and movementDateTime are used at this time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="StopDockCommitmentType">
                <xsd:annotation>
                    <xsd:documentation>
				Details of the dock commitment.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemDockCommitmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated dock commitment ID.
					Ignored for Create.
					Mandatory for Update, Delete and Generate Event if SystemStopID is not provided.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemStopID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The system-generated Stop ID for the stop which the dock commitment belongs to.
                    Mandatory for Update, Delete and Generate Event if SystemDockCommitmentID is not provided,
                    in this case SystemStopID will be used to identify Dock Commitment
                    together with DockCommitmentActivityTypeEnumVal if provided,
                    otherwise carrier activity type is assumed.
                    For Create or if SystemDockCommitmentID is specified for Update,
                    SystemStopID identifies the stop for the Dock Commitment to be associated with.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemDockID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated Dock ID. Mandatory for Create.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommitmentStartDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The dock commitment start date and time.
					Mandatory for Create when the dock commitment is not associated with a stop.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommitmentStartTime" type="xsd:time" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The dock commitment start time.
				    Cannot be specified together with CommitmentStartDateTime.
				    Mandatory for Create
					when CommitmentStartDateTime is not specified,
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommitmentEndDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The dock commitment end date and time.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The carrier ID of the dock commitment.
					This field is read-only if the dock commitment is associated with a load.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The division ID of the dock commitment.
					Cannot be updated.
					This field is read-only if the dock commitment is associated with a load.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LogisticsGroupCode" type="cis:LogisticGroupCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The logistics group ID of the dock commitment.
					Cannot be updated.
					This field is read-only if the dock commitment is associated with a load.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExternalCode" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					An external identifying code.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DockCommitmentActivityTypeEnumVal" type="cis:DockCommitmentActivityEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The activity type for the dock commitment.
                    Will be used together with SystemStopID to identify Dock Commitment for Update, Delete and Generate Event
                    if SystemDockCommitmentID is not provided.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					A memo associated with the dock commitment.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="IgnoreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    Indicates whether the contents of ReferenceNumberStructure should be ignored.
                    Mandatory for creating or updating the dock commitment, ignored for other operations.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReferenceNumberStructure" type="cis:ReferenceNumberType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
                    Reference numbers attached to the dock commitment. Presence depends on the value of IgnoreReferenceNumbersFlag.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="StopReSequenceDataType">
                <xsd:annotation>
                    <xsd:documentation>
				Information about stops to re-sequence on a load.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The ID of the load.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemStopID" type="cis:KeyStringType" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:documentation>
					The IDs of all existing stops of the load.
					The new sequence of stops on the load corresponds to the sequence of Stop IDs in the input.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="StopUpdateProgressDataType">
                <xsd:annotation>
                    <xsd:documentation>
			An event that describes the progress of a stop.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="CarrierCode" type="cis:CarrierCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The carrier code. Required.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The load ID or reference number. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The load tracking number. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="MasterBillOfLadingNumber" type="cis:ExternalXRefType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The master BOL number. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipping location code. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShippingLocationTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The shipping location type.
					If not specified and shippingLocationCode is specified,
					one and only one shipping location with the specified code should exist.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The stop sequential number. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Memo" type="cis:MemoType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				A memo for the stop update progress. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopEvent" type="cis:StopEventType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Information about the event. Optional.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ProofOfDelivery" type="cis:ProofOfDeliveryType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Proof of delivery information. Optional.
                Ignored unless proof of delivery is specifically requested.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TenderNotificationDataType">
                <xsd:annotation>
                    <xsd:documentation>
			Information about a load tender notification.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="PrintFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether to print a report.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FaxFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether to fax a report.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EmailFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether to email a report.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EventNotificationFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				Indicates whether to set an EDI flag in the Event Notification data.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TenderResponseByDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				    The date and time that the tender response is required by.
				    Ignored for Cancel Tender.
                    Ignored for Load Tender Update if the load belongs to a booking or is eligible for a booking.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SenderTenderContact" type="cis:LoadTenderContactType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tender contact of the sender.
                    Ignored for Load Tender Update if the load belongs to a booking or is eligible for a booking.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierTenderContact" type="cis:LoadTenderContactType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                    The tender contact of the carrier.
                    Ignored for Load Tender Update if the load belongs to a booking or is eligible for a booking.
                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TrailerActivityType">
                <xsd:annotation>
                    <xsd:documentation>
				Details of trailer activity at a stop or dock commitment.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemDockCommitmentID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated Dock Commitment ID.
					Mandatory if neither SystemStopID nor SystemLoadID is provided.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemStopID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated Stop ID.
					Mandatory if neither SystemDockCommitmentID nor SystemLoadID is provided.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system-generated Load ID.
					Mandatory if neither SystemStopID nor SystemDockCommitmentID is provided,
					ignored otherwise. 
					Both SystemLoadID and StopSequenceNumber are required to identify a stop.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="StopSequenceNumber" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The stop sequential number.
					Mandatory if neither SystemStopID nor SystemDockCommitmentID is provided,
					ignored otherwise.
					Both SystemLoadID and StopSequenceNumber are required to identify a stop.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TrailerActivityTypeEnumVal" type="cis:EventControlEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates whether Trailer Loading Unloading Started, Trailer Loading Unloading Ended,
					Driver Check-in or Driver Check-out should be performed. Other values are not allowed. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReasonCode" type="cis:SECCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The reason code for tralier activity.
					Mandatory if ReverseFlag is not true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ActivityDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The date and time for trailer activity.
					Mandatory if ReverseFlag is not true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReverseFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates a reversal for the trailer activity.
					Cannot be true if UpdateFlag is true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UpdateFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					Indicates an update for the trailer activity.
					Cannot be true if ReverseFlag is true.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TransferDivisionLoadDataType">
                <xsd:annotation>
                    <xsd:documentation>
				A collection of loads for division transfer data.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The load which will be transferred to the destination division. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The destination division which the load will be transferred to. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TransferDivisionShipmentLegDataType">
                <xsd:annotation>
                    <xsd:documentation>
				A collection of shipment legs for division transfer data.
				</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SystemShipmentLegID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The shipment leg which will be transferred to the destination division. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DivisionCode" type="cis:DivisionCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
				The destination division which the shipment leg will be transferred to. Mandatory.
				</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TripType">
                <xsd:annotation>
                    <xsd:documentation>
            A collection of continuous moving loads or a booking.
            </xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Id" type="cis:IDType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Internal ID. Applicable only for UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemTripID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            The ID code of the trip.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="EligibleForContinuousMovesFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the trip is eligible for continuous move (adding more loads).
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightTermsEnumVal" type="cis:FreightTermsType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The freight terms for the trip.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightTermsEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Description for freightTermsEnumVal. Read-only. Available only through UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfLoads" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The number of loads on the trip.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FarPointLoadID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The far point load ID.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TripStartedDateTime" type="xsd:dateTime" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The date and time that the trip was started.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfCommodityCommittedLoads" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The number of loads which commodity is committed.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CommodityCommittedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the commodity is committed at the trip level.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfCarrierCommittedLoads" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The number of loads which carrier is committed.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CarrierCommittedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the carrier is committed at the trip level.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberOfServiceCommittedLoads" type="cis:UnsignedShortType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The number of loads which service is committed.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ServiceCommittedFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether the service is committed at the trip level.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCode" type="cis:CurrencyDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The rating currency of the tariff used to rate the trip.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CurrencyCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Description for CurrencyCode. Read-only. Available only through UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemUnitOfMeasureEnumVal" type="cis:SystemUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The unit of measure system of the tariff used to rate the trip.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="SystemUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Description for SystemUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightUnitOfMeasureEnumVal" type="cis:WeightUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The weight units of the tariff used to rate the trip.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="WeightUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Description for WeightUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LengthUnitOfMeasureEnumVal" type="cis:LengthUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The length units of the tariff used to rate the trip.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LengthUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Description for LengthUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceUnitOfMeasureEnumVal" type="cis:DistanceUnitOfMeasureEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The distance units of measure of the tariff used to rate the trip.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DistanceUnitOfMeasureEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Description for DistanceUnitOfMeasureEnumVal. Read-only. Available only through UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ExchangeRate" type="cis:ExchangeRateType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The exchange rate for the rating currency of the tariff used to rate the trip.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="RatingValidFlag" type="xsd:boolean" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                Indicates whether rating result of the trip is valid.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CostCenterCode" type="cis:CostCenterDomainValueType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The cost center type.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="CostCenterCodeDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Description for costCenterCode. Read-only. Available only through UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="DirectDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The direct distance. Expressed in base system units of measure.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OutOfRouteDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The out-of-route distance. Expressed in base system units of measure.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LoadedDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The loaded distance. Expressed in base system units of measure.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LongestUnloadedDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Maximum unloaded direct distance between loads. Expressed in base system units of measure.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ReturnToOriginDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The return-to-origin distance. Expressed in base system units of measure.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The total distance for this trip. Expressed in base system units of measure.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="TotalUnloadedDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                The total unloaded distance. Expressed in base system units of measure.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="InTransitUnloadedDistance" type="cis:DistanceType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                Total in-transit unloaded direct distance. Expressed in base system units of measure.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstShippingPointTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The first shipping point type.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstShippingPointTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Description for firstShippingPointTypeEnumVal. Read-only. Available only through UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstShippingLocationCode" type="cis:ShippingLocationCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The first shipping location code.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstShippingLocationDescription" type="cis:NameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The first shipping location description (name). Available only through UI-oriented APIs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstCountryCode" type="cis:CountryCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The first shipping location country code. Available only through UI-oriented APIs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstState" type="cis:StateCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The first shipping location state or province. Available only through UI-oriented APIs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstCity" type="cis:CityNameType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The first shipping location city name. Available only through UI-oriented APIs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FirstPostalCode" type="cis:PostalCodeType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The first shipping location zip or postal code. Available only through UI-oriented APIs.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="OriginAddress" type="cis:AddressType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Address of origin location.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastShippingPointTypeEnumVal" type="cis:ShipPointEnumValType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
                                The last shipping point type.
                                </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="LastShippingPointTypeEnumDescr" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
            Description for lastShippingPointTypeEnumVal. Read-only. Available only through UI-oriented APIs.
            </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
