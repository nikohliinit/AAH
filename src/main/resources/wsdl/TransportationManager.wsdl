            <xsd:element name="processShipmentOrderRate">
                <xsd:complexType>
                    <xsd:annotation>
                        <xsd:documentation>
                A request to rate the shipments orders.
            </xsd:documentation>
                    </xsd:annotation>
                    <xsd:sequence>
                        <xsd:element name="ApiHeader" type="cis:ApiHeaderType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                Operation header.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ShipmentRateDataList" type="cis:ShipmentRateDataType" minOccurs="0" maxOccurs="unbounded">
                            <xsd:annotation>
                                <xsd:documentation>
                A sequence of shipment order rate data to be rated.</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ShipmentIDType" type="cis:ShipmentIdEnumValType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                 An enumerated value defining how the shipment should be identified.
                 
                    SI_NULL - Equivalent to omitting this field which will be defaulted to SI_NUM.
                    
                    SI_ID - The shipments are identified by their IDs.
                    
                    SI_NUM - The shipments are identified by their shipment numbers.
                    
                    SI_RFRC - The shipments are identified by their reference numbers.
                    
                    SI_RFRC_DIV - The shipments are identified by their reference numbers and Division ID.
                    If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then a division can be omitted or, if specified, should match the division to which the user is restricted.
                    
                    SI_TRKG_NUM - The shipments are identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.

                    SI_TRKG_NUM_DIV - The shipments are identified by their shipment tracking number. This is ShipmentDescription in the ShipmentType structure.
                    If a user is not restricted to a division, then a division must be specified in the input. If a user is restricted to a division, then the division can be omitted or, if specified, it should match the division to which the user is restricted.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ReferenceNumberTypeCode" type="cis:ReferenceNumDomainValueType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                  The type of reference numbers used to identify the shipments.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="SkipRatingFlag" type="xsd:boolean" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                    If set to true, rating will not be performed
                    but updates (possibly including charge overrides) will be applied.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="KeepSpotRateFlag" type="xsd:boolean" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                    If set to true, existing spot rate will be preserved.
                    Ignored if SkipRatingFlag is true.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="IgnoreChargeOverridesFlag" type="xsd:boolean" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                  Indicates to ignore the Charge overrides.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ChargeOverrides" type="cis:ChargeOverrideType" minOccurs="0" maxOccurs="unbounded">
                            <xsd:annotation>
                                <xsd:documentation>
                    An override to a change.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ReturnRoutingMessageLogFlag" type="xsd:boolean" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                    Indicates whether diagnostic messages should be generated.
                    Not allowed if more than one shipment is included in the request.
                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
