            <xsd:complexType name="TransferLaneDataType">
                <xsd:annotation>
                    <xsd:documentation>
    			Information required to transfer a tariff lane.
			</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="SourceTariffID" type="cis:KeyStringType" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>
					The system generated numerical tariff ID of the source tariff. Mandatory.
                    Also, this is a part of the business key for the source tariff lane.
                    Source tariff lane should be uniquely identified by its business key.
				</xsd:documentation>
                        </xsd:annotation>
