            The tariff ID from last shipment rating if any. Read-only.
        </xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ShipmentIsPlanningFlag" type="xsd:boolean" minOccurs="0">
